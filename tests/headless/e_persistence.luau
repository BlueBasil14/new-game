-- (e) progress persists across a server restart with the same DataStore backing.
-- Each server gets a distinct JobId (as live servers do) so the session lock is really tested.
H.boot({ jobId = "job-A" })
H.run(1)
local Arena = H.svc("ArenaService")
local Econ = H.svc("EconomyService")
local Data = H.svc("DataService")
local p = H.addPlayer({ userId = 4242, name = "Keeper" })
H.runUntil(function() return Arena.runnerIdOf(p) ~= 0 end, 10, "runner")
Econ.addCoins(p, 5000, "test", false)
H.run(0.3)
local ok = H.invoke(p, "BuyUpgrade", "speed")
H.eq(ok, true, "buy speed")
H.run(0.3)
H.invoke(p, "RedeemCode", "TURF")
local before = table.clone(Data.get(p))
before.upgrades = table.clone(before.upgrades)
H.removePlayer(p)
H.run(2)
local closed, secs = H.shutdown()
H.check(closed, "BindToClose handlers did not finish")
local stored = H.M.dsBacking.stores["PlayerData_v1/global"]["u_4242"]
H.check(stored ~= nil, "nothing stored")
H.check(stored._lock == nil, "session lock not released")

H.boot({ jobId = "job-B" })
H.run(1)
Arena = H.svc("ArenaService")
Data = H.svc("DataService")
local p2 = H.addPlayer({ userId = 4242, name = "Keeper" })
H.runUntil(function() return Arena.runnerIdOf(p2) ~= 0 or #H.S.kicks > 0 end, 30, "rejoin")
H.eq(#H.S.kicks, 0, "kicked on rejoin")
local after = Data.get(p2)
H.eq(after.coins, before.coins, "coins persisted")
H.eq(after.gems, before.gems, "gems persisted")
H.eq(after.upgrades.speed, 1, "upgrade persisted")
H.eq(after.codes.TURF, true, "code persisted")
H.eq(after.firstJoin, before.firstJoin, "firstJoin kept")
H.say("coins", after.coins, "gems", after.gems, "shutdown took", secs)
-- a second server cannot steal the live session (lock held by job-B)
local stored2 = H.M.dsBacking.stores["PlayerData_v1/global"]["u_4242"]
H.eq(stored2._lock and stored2._lock.jobId, "job-B", "lock owner")
