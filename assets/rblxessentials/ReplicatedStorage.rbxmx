            <string name="Source">-- Config.lua - loads a pack's game-owned configuration (RBLX Essentials 3.0).
--
-- A pack describes its options in `Packs/&lt;PackId&gt;/Schema` (see Schema.lua).
-- The GAME owns the values, in modules no update ever replaces:
--   ReplicatedStorage.RBLXEssentials.Config.&lt;PackId&gt;     options clients may know
--   ServerScriptService.RBLXEssentials.Config.&lt;PackId&gt;   options marked server = true
-- Both return only what the game changes; the rest comes from the schema.
-- The merged value is validated and frozen. A pack whose configuration is
-- invalid does not boot: running with an unexpected price or product id is
-- worse than a clear error that names the option.
--
-- Pure: every Instance and the require function come in through `opts`.
local Config = {}

-- What a caller passed, for error text: an Instance's ClassName, or the Luau
-- type of anything else passed by mistake (a string, a table).
local function classOf(value)
	return if typeof(value) == "Instance" then value.ClassName else typeof(value)
end

local function loadModule(requireFn, module, label, errors)
	if module == nil then
		return nil
	end
	if typeof(module) ~= "Instance" or not module:IsA("ModuleScript") then
		table.insert(errors, ("%s must be a ModuleScript, got %s"):format(label, classOf(module)))
		return nil
	end
	local ok, value = pcall(requireFn, module)
	if not ok then
		table.insert(errors, ("%s errored: %s"):format(label, tostring(value)))
		return nil
	end
	if value ~= nil and type(value) ~= "table" then
		table.insert(errors, ("%s must return a table, got %s"):format(label, type(value)))
		return nil
	end
	return value
end

local function display(value)
	if type(value) == "table" then
		return "a table"
	end
	return type(value) == "string" and ("%q"):format(value) or tostring(value)
end

-- What Config.load calls on schemaLib: anything else is not the Schema module.
local SCHEMA_FUNCTIONS = {
	"check", "serverFields", "merge", "defaults", "stripServer", "validate", "formatErrors", "freeze",
}

local function isSchemaLib(S)
	if type(S) ~= "table" then
		return false
	end
	for _, name in ipairs(SCHEMA_FUNCTIONS) do
		if type(S[name]) ~= "function" then
			return false
		end
	end
	return true
end

function Config.load(opts)
	-- Tools calls this too. The opts a caller can get wrong (side, packId,
	-- schemaLib, requireFn and the three module arguments) come back as
	-- errors, never as a silent guess or a throw: a side typo used to mean
	-- "client" and skip the server module. A game Config that makes the
	-- merge itself throw (a table that contains itself) still throws, so
	-- callers keep a pcall, as the Loader does.
	if opts.side ~= "Server" and opts.side ~= "Client" then
		return nil, { ('side must be "Server" or "Client", got %s'):format(display(opts.side)) }
	end
	if type(opts.packId) ~= "string" or opts.packId == "" then
		return nil, { ("packId must be non-empty text, got %s"):format(display(opts.packId)) }
	end
	local S = opts.schemaLib
	if opts.schemaModule == nil then
		return nil, {}
	end
	if not isSchemaLib(S) then
		return nil, { ("schemaLib must be the Kernel Schema module, got %s"):format(typeof(S)) }
	end
	if type(opts.requireFn) ~= "function" then
		return nil, { "requireFn must be a function, got " .. typeof(opts.requireFn) }
	end
	if typeof(opts.schemaModule) ~= "Instance" or not opts.schemaModule:IsA("ModuleScript") then
		return nil, { ("Schema must be a ModuleScript, got %s"):format(classOf(opts.schemaModule)) }
	end

	local okFactory, factory = pcall(opts.requireFn, opts.schemaModule)
	if not okFactory then
		return nil, { ("Schema errored: %s"):format(tostring(factory)) }
	end
	if type(factory) ~= "function" then
		return nil, { "Schema must return function(S) ... end" }
	end
	local okRoot, root = pcall(factory, S)
	if not okRoot then
		return nil, { ("Schema errored: %s"):format(tostring(root)) }
	end
	local definitionErrors = S.check(root)
	if #definitionErrors &gt; 0 then
		for index, message in ipairs(definitionErrors) do
			definitionErrors[index] = "Schema: " .. message
		end
		return nil, definitionErrors
	end

	local name = "Config." .. opts.packId
	local sharedLabel = "ReplicatedStorage.RBLXEssentials.Config." .. opts.packId
	local serverLabel = "ServerScriptService.RBLXEssentials.Config." .. opts.packId
	local errors = {}
	local shared = loadModule(opts.requireFn, opts.sharedModule, sharedLabel, errors)
	local server = nil
	if opts.side == "Server" then
		server = loadModule(opts.requireFn, opts.serverModule, serverLabel, errors)
	end
	if #errors &gt; 0 then
		return nil, errors
	end

	local serverFields = S.serverFields(root)
	for key in pairs(shared or {}) do
		if serverFields[key] then
			table.insert(errors, ("%s.%s is server-only and must not reach clients: move it to %s"):format(name, tostring(key), serverLabel))
		end
	end
	for key in pairs(server or {}) do
		if root.fields[key] ~= nil and not serverFields[key] then
			table.insert(errors, ("%s.%s is not server-only: move it to %s"):format(name, tostring(key), sharedLabel))
		end
	end
	if #errors &gt; 0 then
		table.sort(errors)
		return nil, errors
	end

	local value = S.merge(root, S.defaults(root), shared)
	if server ~= nil then
		value = S.merge(root, value, server)
	end
	local clientSide = opts.side == "Client"
	if clientSide then
		value = S.stripServer(root, value)
	end
	local problems = S.validate(root, value, name, { skipServer = clientSide })
	if #problems &gt; 0 then
		return nil, S.formatErrors(problems)
	end
	return S.freeze(value), {}
end

return Config
