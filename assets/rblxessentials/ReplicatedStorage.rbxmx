                <int64 name="SourceAssetId">-1</int64>
                <BinaryString name="Tags" />
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="38">
              <Properties>
                <string name="Name">Sources</string>
                <BinaryString name="AttributesSerialize" />
                <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
                <ContentId name="LinkedSource">
                  <null>
                  </null>
                </ContentId>
                <bool name="DefinesCapabilities">false</bool>
                <BinaryString name="SerializedOverrides">
                </BinaryString>
                <string name="Source">-- Migrations/Sources - the 2.x inputs Sound System's Migrations/FromV2
-- reads (plan B0, ruling 9; plan B1): the Settings folder; Assets.Templates,
-- which the 2.x client waited for before it started the music and took the
-- skin from; StarterGui's MusicPlayerGUI, without which 2.0.0 played no
-- music, and whose frames name the skin a migrated player shows; and the
-- three trees that hold the content Migrations/Content declares (the
-- library in SoundService, the Demo's folder in Workspace and the pack's
-- Assets). FromV2 takes nothing from those three: since plan B3a what the
-- game put next to the declared content stays live where it is, and
-- T.migrate names it (content-kept), as later installs and updates keep it
-- live (game-content-kept); they stay declared (plan B3b, ruling 13). Each
-- path is "&lt;service key&gt;/&lt;path under that service's RBLXEssentials&gt;";
-- T.migrate hands FromV2 each tree by its name, and leaves out one the
-- place lacks.
-- T.migrate's gameReaders also names a game script that quotes
-- "SoundSystem" and a source's name or the last name of its path (a
-- LocalScript that finds the music player by its 2.x path, for example);
-- when the path ends with "/", only the source's name. The three trees end
-- with "/": their last names, "SoundSystem" and "Assets", would name every
-- game script that reaches the pack by its name.
return {
	Settings = "ReplicatedStorage/Packs/SoundSystem/Settings",
	Templates = "ReplicatedStorage/Packs/SoundSystem/Assets/Templates",
	MusicPlayerGUI = "StarterGui/SoundSystem/MusicPlayerGUI",
	SoundLibrary = "SoundService/SoundSystem/",
	DemoRoot = "Workspace/SoundSystem/",
	PackAssets = "ReplicatedStorage/Packs/SoundSystem/Assets/",
	-- Plan B3b (B3a's Sources.bare): names a game script may use on their
	-- own; gameReaders names each script that does.
	bare = { "SFXEnabled", "MusicPlayerEnabled" },
}
</string>
                <int64 name="SourceAssetId">-1</int64>
                <BinaryString name="Tags" />
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">Pieces</string>
              <BinaryString name="AttributesSerialize" />
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source">-- Pieces.lua - the interface piece Sound System 3.0 drives (plain data;
-- Kernel/Contracts.lua checks it). The pack's own copy ships as
-- StarterGui.RBLXEssentials.SoundSystem.MusicPlayerGUI with RBLXE_Piece and
-- RBLXE_Contract on the ScreenGui itself: the default is 2.1.1's
-- MusicPlayer_Template_1. A fork in StarterGui.RBLXEssentials.Interface (a
-- ScreenGui of its own, as T.content.fork and T.migrate place a Layer
-- piece) replaces it: another skin, or the game's edits.
--
-- The contract requires nothing below the root: 2.x found its frames by the
-- MusicPlayerFrame tag and each frame's name is its skin's, so a path would
-- refuse forks 2.x ran. The client warns at runtime when the chosen copy
-- holds no tagged frame with Container/Buttons. The Settings panel and its
-- button (SoundSystemGUI) are not pieces: PanelId Settings belongs to
-- General UI Kit (spec D5), and that copy stays as 2.x shipped it.
return {
	MusicPlayer = {
		contract = 1,
		kind = "Layer",
		doc = "The HUD music player: a ScreenGui holding one or more frames tagged MusicPlayerFrame, each with Container/Buttons (Mute and Next) and, optionally, Container/SongName and Container/Duration. Music plays whatever this piece holds; the client wires every tagged frame in it, animates the ones marked CollapsibleMusicPlayer and disables the ScreenGui when MusicPlayer.Enabled is false.",
	},
}
</string>
              <int64 name="SourceAssetId">-1</int64>
              <BinaryString name="Tags" />
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">Schema</string>
              <BinaryString name="AttributesSerialize" />
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source">-- Schema.lua - the options a game sets for Sound System 3.0, in the
-- Kernel's Schema language (docs/kernel-api.md, section 8). The game's
-- values live in ReplicatedStorage.RBLXEssentials.Config.SoundSystem, a
-- module no update replaces; it returns only what the game changes, and
-- everything else is the default below. T.config.reference("SoundSystem")
-- prints this as a reference.
--
-- Every option is shared (plan B1, Sound rulings): 2.x kept its Settings in
-- ReplicatedStorage, where every client read them, and none is a secret.
-- The defaults are what 2.x ran: sound effects on, the music player on, and
-- each SoundGroup at the Volume it has in the game's library
-- (SoundService.RBLXEssentials.SoundSystem.SFX and Music, the game's
-- content: T.migrate keeps them).
--
-- SFXEnabled is the value at start only. 2.x read its BoolValue live, so a
-- game script could turn sound effects off while the game ran; in 3.0 the
-- live switch is the SFXEnabled attribute of ReplicatedStorage.
-- RBLXEssentials.Packs.SoundSystem, which the server sets from this option
-- when it starts unless a game script set it first, and SetSFXEnabled on
-- the pack's API.
--
-- 2.x's Music Player/Template option is gone: the music player is the
-- MusicPlayer piece (Pieces.lua), and another skin is a fork of it.
--
-- Self-contained on purpose: Tools loads this module as a clone with no
-- Parent, so it uses no `script` and requires nothing.
return function(S)
	return S.config({
		SFXEnabled = S.boolean({
			default = true,
			doc = "Sound effects on or off for every player when the server starts, unless a game script set the SFXEnabled attribute of ReplicatedStorage.RBLXEssentials.Packs.SoundSystem first. While the game runs, set that attribute to true or false, or call SetSFXEnabled on the pack's API: from the server for every player, from a client for that player only, until the server changes it (setting the value it already has reaches no client).",
		}),
		MusicPlayer = S.record({
			Enabled = S.boolean({
				default = true,
				doc = "Whether music plays and the music player shows. Read once when each player joins.",
			}),
		}, {
			doc = "The music player: the MusicPlayer piece (StarterGui.RBLXEssentials.SoundSystem.MusicPlayerGUI, or its fork in Interface) playing the tracks of the Music SoundGroup.",
		}),
		Volumes = S.record({
			SFX = S.optional(S.number({
				min = 0,
				max = 10,
				doc = "The SFX SoundGroup's Volume, set by the server when it starts. Unset, the group keeps the Volume it has in SoundService.",
			})),
			Music = S.optional(S.number({
				min = 0,
				max = 10,
				doc = "The Music SoundGroup's Volume, set by the server when it starts. Unset, the group keeps the Volume it has in SoundService.",
			})),
		}, {
			doc = "Start volumes of the two SoundGroups. Unset (the default), each group keeps the Volume it has in SoundService.RBLXEssentials.SoundSystem, as in 2.x. The groups are the game's own: a migration from 2.x keeps them live with the game's volumes, and later installs and updates keep them live too, so set these only to change the volumes at start. Players still change their own volume with the volume buttons.",
		}),
	})
end
</string>
