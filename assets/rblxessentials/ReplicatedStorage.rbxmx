        <Item class="Folder" referent="23">
          <Properties>
            <string name="Name">SoundSystem</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <Color3 name="IconTint">
              <R>0</R>
              <G>0</G>
              <B>0</B>
            </Color3>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags" />
          </Properties>
          <Item class="ModuleScript" referent="24">
            <Properties>
              <string name="Name">Client</string>
              <BinaryString name="AttributesSerialize" />
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source">-- Sound boot never blocks the Kernel loader. Groups resolve asynchronously;
-- music starts once and the MusicPlayer piece can arrive later without a
-- second track.
--
-- 3.0 (plan B1) reads ctx.config (Config.SoundSystem), never 2.x's Settings:
--   * SFXEnabled is live: the SFXEnabled attribute of the pack's
--     ReplicatedStorage folder, which the server sets from the configuration
--     when it starts (unless a game script set it first), read on every
--     sound (Switch.lua); SetSFXEnabled below changes it for this player
--     only, until the server changes it (setting the value it already has
--     reaches no client);
--   * MusicPlayer.Enabled is read once, as 2.x read MusicPlayerEnabled;
--   * the music player is the MusicPlayer piece (ctx.getPiece): the pack's
--     default ScreenGui or the game's fork of it in Interface, used as it is,
--     shown or hidden before anything else touches it. 2.x's Template option
--     and its swap from Assets.Templates are gone.
-- The positional receiver is wired before the piece is awaited, so a slow or
-- missing piece never leaves PlayAt silent.
return function(ctx)
	local SoundService = game:GetService("SoundService")

	local Backend = require(script.Backend)
	local OneShots = require(script.OneShots)
	local Loops = require(script.Loops)
	local oneShots, loops
	local alive = true
	local VolumeHandlers = require(script.VolumeHandlers)
	local MusicSystem = require(script.MusicSystem)
	local MusicPlayerHUD = require(script.MusicPlayerHUD)
	local Switch = require(script.Switch)

	local trove = ctx.kernel.Trove.new()
	trove:AttachToInstance(ctx.ui.gui)
	trove:Add(function() alive = false end)

	local sfxEnabled = Switch.new(ctx.folder, "SFXEnabled", ctx.config.SFXEnabled)

	-- ── Phase 1 (synchronous): nil-guarded placeholder volume handlers ──
	local VOLUME_ACTIONS = {
		"ToggleMusicMute", "ToggleSFXMute",
		"MusicVolumeUp", "MusicVolumeDown",
		"SFXVolumeUp", "SFXVolumeDown",
	}
	local warnedNotReady = false
	local placeholders = {}
	for _, action in ipairs(VOLUME_ACTIONS) do
		placeholders[action] = function()
			if not warnedNotReady then
				warnedNotReady = true
				warn("[SoundSystem] Volume control used before sound groups finished loading; ignored.")
			end
		end
	end
	ctx.ui:registerHandlers(placeholders)

	-- ── Phase 2 (async): groups -&gt; backend -&gt; real volume handlers -&gt;
	-- music -&gt; positional receiver -&gt; the MusicPlayer piece. Bounded (10s)
	-- waits on the SoundGroups so a broken/missing server-side install warns
	-- with a clear diagnostic instead of hanging this thread forever; the
	-- thread is spawned, so a hang here never blocks the rest of the pack's
	-- own boot (or any other pack's) either way.
	task.spawn(function()
		local root = SoundService:WaitForChild("RBLXEssentials", 10)
		local packRoot = root and root:WaitForChild("SoundSystem", 10)
		if not packRoot then
			warn("[SoundSystem] SoundService.RBLXEssentials.SoundSystem never appeared after 10s"
				.. ". Is the SoundSystem pack installed? Sound is disabled this session.")
			return
		end

		local sfxGroup = packRoot:WaitForChild("SFX", 10)
		local musicGroup = packRoot:WaitForChild("Music", 10)
		if not sfxGroup or not musicGroup then
			warn("[SoundSystem] SFX/Music SoundGroups never appeared under"
				.. " SoundService.RBLXEssentials.SoundSystem after 10s. Sound is disabled this session.")
			return
		end

		-- Do not create voices/handlers after the owning UI has been destroyed
		-- while the asynchronous sound-group lookup was still pending.
		if not alive then return end

		local backend = Backend.new({ sfxGroup = sfxGroup, sfxEnabled = sfxEnabled })
		ctx.kernel.SFX.setBackend(backend)
		oneShots = OneShots.new(sfxGroup, sfxEnabled)
		loops = Loops.new(sfxGroup, sfxEnabled)
		trove:Add(function() oneShots:destroy(); loops:destroy() end)

		-- Phase 2 handler registration: promotes the 6 actions from the
		-- Phase 1 placeholders to the real, group-backed handlers.
		ctx.ui:registerHandlers(VolumeHandlers.handlers({
			sfxGroup = sfxGroup,
			musicGroup = musicGroup,
			gui = ctx.ui.gui,
		}))
		VolumeHandlers.attach(ctx.ui.gui, sfxGroup, musicGroup, trove)

		-- Music starts on its own; the piece is mounted when it arrives.
		local music = MusicSystem.attach({
			musicGroup = musicGroup, trove = trove, enabled = { Value = ctx.config.MusicPlayer.Enabled },
		})

		-- ── Positional SFX receiver ─────────────────────────────────────
		local positional = ctx.kernel.Net.client(ctx.packId):event("PlayPositional", 30)
		if positional == nil then
			warn("[SoundSystem] The PlayPositional remote never appeared: PlayAt and PlayAtForPlayer are silent this session.")
		else
			trove:Connect(positional.OnClientEvent, function(name: string, position: Vector3, range: number?)
				backend:_onPositional(name, position, range)
			end)
		end

		-- ── The MusicPlayer piece ───────────────────────────────────────
		-- 3.2 (Kernel 3.2.0): the game deleted the MusicPlayer piece. That is
		-- its choice, not a fault: music plays with no player on screen and
		-- no warning.
		if ctx.hasPiece ~= nil and not ctx.hasPiece("MusicPlayer") then
			return
		end
		local piece = ctx.getPiece("MusicPlayer", 30)
		if not alive then return end
		if piece == nil then
			warn("[SoundSystem] The MusicPlayer piece did not arrive: music plays with no player on screen.")
			return
		end
		-- Shown or hidden first (MusicPlayer.Enabled), so a fork whose
		-- animation below throws still follows the configuration.
		music.mountGui(piece)
		-- A player on screen must hold a frame to control the music, at any
		-- depth (MusicSystem finds frames by their tag). A piece that holds no
		-- GuiObject is empty on purpose (music with no player on screen), and
		-- a hidden one needs no controls.
		if ctx.config.MusicPlayer.Enabled then
			local shows, controls = false, false
			for _, node in ipairs(piece:GetDescendants()) do
				shows = shows or node:IsA("GuiObject")
				local container = node:HasTag("MusicPlayerFrame") and node:FindFirstChild("Container")
				if container and container:FindFirstChild("Buttons") then
					controls = true
					break
				end
			end
			if shows and not controls then
				warn(("[SoundSystem] %s holds no frame tagged MusicPlayerFrame with Container/Buttons: music plays with nothing on screen to control it."):format(piece:GetFullName()))
			end
		end
		MusicPlayerHUD.attach(piece, trove, ctx.kernel.SFX)
	end)

	local function setSFXEnabled(enabled: boolean)
		assert(type(enabled) == "boolean", "SoundSystem.SetSFXEnabled takes true or false")
		ctx.folder:SetAttribute("SFXEnabled", enabled)
	end

	-- Optional client API. Existing Kernel SFX methods remain compatible.
	-- Returned Sound instances belong to the caller; destroy loops explicitly.
	return {
		PlayOneShot = function(name, options)
			if alive and oneShots then return oneShots:play(name, options) end
			return nil
		end,
		PlayLoop = function(name, options)
			if alive and loops then return loops:play(name, options) end
			return nil
		end,
		-- Sound effects on or off for this player only, until the server
		-- changes them (a server's SetSFXEnabled reaches every player; setting
		-- the value the server already has reaches no client).
		SetSFXEnabled = setSFXEnabled,
		IsSFXEnabled = function(): boolean
			return sfxEnabled.Value
		end,
	}
end
</string>
              <int64 name="SourceAssetId">-1</int64>
              <BinaryString name="Tags" />
            </Properties>
            <Item class="ModuleScript" referent="25">
              <Properties>
                <string name="Name">Backend</string>
                <BinaryString name="AttributesSerialize" />
                <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
                <ContentId name="LinkedSource">
                  <null>
                  </null>
                </ContentId>
                <bool name="DefinesCapabilities">false</bool>
                <BinaryString name="SerializedOverrides">
                </BinaryString>
                <string name="Source">--[[
	Backend.lua - client-side SFX playback backend registered with the
	kernel's SFX facade (Kernel/src/Kernel/SFX.lua calls `backend:Play(name)`
	/ `backend:PlayOverlap(name)` - note the COLON, method calls). Ported
	verbatim from v1 SFXSystem.lua (Sound System/src/ReplicatedStorage/
	RBLXEssentials/SoundSystem/SFXSystem.lua - read fully for this port):
	`Play`/`PlayOverlap` from L37-63, the positional receiver body
	(`_onPositional`) from L92-126.

	`Backend.new(deps) -&gt; backend`, `deps = { sfxGroup: SoundGroup,
	sfxEnabled: BoolValue }`. All three methods gate LIVE on
	`deps.sfxEnabled.Value` - read fresh on every call (matches v1's
	`if not sfxEnabled.Value then return end` inside each function body),
	not cached at construction, so toggling the setting at runtime takes
	effect immediately without re-registering the backend.
]]
local Workspace = game:GetService("Workspace")

local Backend = {}
Backend.__index = Backend

function Backend.new(deps: { sfxGroup: Instance, sfxEnabled: Instance })
	local self = setmetatable({}, Backend)
	self._sfxGroup = deps.sfxGroup
	self._sfxEnabled = deps.sfxEnabled
	return self
end

-- v1 SFXSystem.lua L38-46 verbatim: restart if already playing.
function Backend:Play(name: string)
	if not (self._sfxEnabled :: any).Value then
		return
	end
	local sound = self._sfxGroup:FindFirstChild(name)
	if sound and sound:IsA("Sound") then
		(sound :: Sound):Play()
	else
		warn("[SFXSystem] Sound not found:", name)
	end
end

-- v1 SFXSystem.lua L50-63 verbatim: clone so multiple can overlap, the
-- clone auto-destroys when finished.
function Backend:PlayOverlap(name: string)
	if not (self._sfxEnabled :: any).Value then
		return
	end
	local sound = self._sfxGroup:FindFirstChild(name)
	if not sound or not sound:IsA("Sound") then
		warn("[SFXSystem] Sound not found:", name)
		return
	end
	local clone = (sound :: Sound):Clone()
	clone.Parent = self._sfxGroup
	clone:Play()
	clone.Ended:Once(function()
		clone:Destroy()
	end)
end

-- v1 SFXSystem.lua L92-126 verbatim (the client-side OnClientEvent handler
-- body, extracted as a method so Client/init.lua can wire it to the kernel
-- Net event instead of SFXSystem's own require-time RemoteEvent wait).
-- `range` present -&gt; positional (anchored transparent uncollidable Part
-- named "PositionalSound" in Workspace at `position`, sound cloned into it
-- with RollOff* set for 3D falloff, part destroyed when the sound ends).
-- `range` nil -&gt; global playback, cloned straight into the SFX group (same
-- shape as PlayOverlap) so it still respects group volume/mute settings.
function Backend:_onPositional(name: string, position: Vector3, range: number?)
	if not (self._sfxEnabled :: any).Value then
		return
	end

	local source = self._sfxGroup:FindFirstChild(name)
	if not source or not source:IsA("Sound") then
		warn("[SFXSystem] PlayAt: sound not found:", name)
		return
	end

	if range then
		local part = Instance.new("Part")
		part.Name = "PositionalSound"
		part.Anchored = true
		part.CanCollide = false
		part.Transparency = 1
		part.Size = Vector3.one
		part.Position = position
		part.Parent = Workspace

		local sound = (source :: Sound):Clone()
		sound.RollOffMaxDistance = range
		sound.RollOffMinDistance = 0
		sound.RollOffMode = Enum.RollOffMode.LinearSquare
		sound.Parent = part
		sound:Play()
		sound.Ended:Once(function()
			part:Destroy()
		end)
	else
		local clone = (source :: Sound):Clone()
		clone.Parent = self._sfxGroup
		clone:Play()
		clone.Ended:Once(function()
			clone:Destroy()
		end)
	end
end

return Backend
</string>
