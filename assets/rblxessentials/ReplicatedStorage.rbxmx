            <Item class="ModuleScript" referent="31">
              <Properties>
                <string name="Name">Switch</string>
                <BinaryString name="AttributesSerialize" />
                <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
                <ContentId name="LinkedSource">
                  <null>
                  </null>
                </ContentId>
                <bool name="DefinesCapabilities">false</bool>
                <BinaryString name="SerializedOverrides">
                </BinaryString>
                <string name="Source">-- Switch.lua - a live on/off switch kept in an attribute (plan B1, Sound
-- ruling Q4). Sound System 3.0 keeps SFXEnabled in the SFXEnabled
-- attribute of its ReplicatedStorage folder: the server sets it from
-- Config.SoundSystem.SFXEnabled when it starts (unless a game script set it
-- first) and SetSFXEnabled changes it, so it reaches every client; a client
-- that sets it changes only its own copy, until the server changes it
-- (setting the value it already has reaches no client). That is how 2.x's
-- SFXEnabled BoolValue behaved.
--
-- Switch.new(folder, attribute, initial) -&gt; switch, shaped like the
-- BoolValue Backend, OneShots and Loops were written for: `switch.Value`
-- reads the attribute on every call (true only for true; `initial`, the
-- configured value, while the attribute is not set) and `switch.Changed`
-- fires when it changes.
local Switch = {}

function Switch.new(folder: Instance, attribute: string, initial: boolean)
	local switch = { Changed = folder:GetAttributeChangedSignal(attribute) }
	return setmetatable(switch, {
		__index = function(_, key)
			if key == "Value" then
				local value = folder:GetAttribute(attribute)
				if value == nil then
					return initial == true
				end
				return value == true
			end
			return nil
		end,
	})
end

return Switch
</string>
                <int64 name="SourceAssetId">-1</int64>
                <BinaryString name="Tags" />
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="32">
              <Properties>
                <string name="Name">VolumeHandlers</string>
                <BinaryString name="AttributesSerialize" />
                <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
                <ContentId name="LinkedSource">
                  <null>
                  </null>
                </ContentId>
                <bool name="DefinesCapabilities">false</bool>
                <BinaryString name="SerializedOverrides">
                </BinaryString>
                <string name="Source">-- VolumeHandlers.lua - SoundSystem's 6 volume/mute Actions, dispatched
-- through `ctx.ui:registerHandlers`. Ported from v1's
-- SoundSettingsHandlers.client.lua (Sound System/src/StarterGui/
-- RBLXEssentials/SoundSystem/SoundSettingsHandlers.client.lua) - read fully
-- for this port: 9-step VOLUME_LEVELS ladder, snap-to-nearest-then-step,
-- mute toggle with saved-volume restore, Status "ON"/"OFF" + green/red
-- BackgroundColor3 feedback on the toggle button, Volume1..Volume9 segment
-- painting inside a `VolumeFrame`, bidirectional
-- `GetPropertyChangedSignal("Volume")` sync (so the settings UI and the
-- player's own Mute button - see MusicSystem - stay in step).
--
-- `snapIndex`/`stepVolume` are pure (no `game`/`Color3`/instance access) -
-- Lune-tested against v1's exact arithmetic, see
-- tests/volumehandlers.spec.luau.
--
-- `handlers(deps)` builds and returns the 6-action table without touching
-- `Color3` or `game` itself (constructing it only reads `.Volume` off the
-- passed-in groups and closes over plain locals), so it IS Lune-tested
-- structurally (return shape: exactly these 6 keys, each a function) using
-- fake Instances built via `roblox.Instance.new`. The returned closures'
-- BODIES reference the global `Color3` (via the shared `setToggleStatus`/
-- `updateVolumeBar` helpers below) - `Color3` is not an ambient global under
-- Lune (only reachable as `require("@lune/roblox").Color3`), so - like every
-- other `attach`-adjacent behavior in this conversion (see General UI Kit
-- v2's DataBind.attach/EffectTooltip.attach) - painting is validated in
-- Studio instead (tools/v3/sound-settings). The handlers' volume arithmetic
-- IS Lune-tested by invoking them with no button and a `gui` holding no
-- toggle or bar (nothing to paint, so `Color3` is never reached), as are
-- `findToggleButtons`/`findVolumeFrames` (pure discovery).
--
-- `attach(gui, sfxGroup, musicGroup, trove)` additionally needs
-- `GetPropertyChangedSignal` (not implemented on Lune's sandboxed Instance -
-- verified empirically, see task-3-report.md) and `task.defer` (no ambient
-- `task` under Lune either), so it is entirely Studio-validated, same
-- convention as above.
--
-- Declared fix vs v1 (`docs/superpowers/specs/2026-08-06-sound-v2-
-- conversion-design.md` §5.6): v1's `findToggleButton`/`findVolumeFrame`
-- (now `findToggleButtons`/`findVolumeFrames`, every match)
-- scanned `Players.LocalPlayer.PlayerGui:GetDescendants()` (the WHOLE
-- PlayerGui). Here both scan `gui:GetDescendants()` - scoped to this pack's
-- own UI root, matching every other v2 module's discovery scoping.
local VolumeHandlers = {}

-- v1 SoundSettingsHandlers.client.lua L34, verified verbatim.
VolumeHandlers.VOLUME_LEVELS = { 0.04, 0.10, 0.19, 0.30, 0.42, 0.54, 0.68, 0.84, 1.0 }

--- Returns the index into `levels` nearest to `volume` (v1 `volumeToStep`).
--- `volume &lt;= 0` maps to `0` (silent - no segment lit, no ladder step).
--- Exact ties (equal distance to two levels) resolve to the FIRST one found
--- (v1 uses a strict `&lt;` comparison, so an equal-or-greater distance never
--- displaces the current nearest).
function VolumeHandlers.snapIndex(volume: number, levels: { number }): number
	if volume &lt;= 0 then
		return 0
	end

	local nearest, nearestDist = 1, math.huge
	for i, v in ipairs(levels) do
		local dist = math.abs(v - volume)
		if dist &lt; nearestDist then
			nearest, nearestDist = i, dist
		end
	end
	return nearest
end

--- Snaps `current` to its nearest ladder step (via `snapIndex`), moves
--- `delta` steps, clamps the result to `[0, #levels]`, and returns the
--- resulting Volume value - `0` for step `0` (silent). Pure extraction of
--- v1 `adjustVolume`'s step arithmetic (v1 also mutated `group.Volume` and
--- repainted the bar in the same function; that side-effecting part lives in
--- `handlers` below, this half is just the number).
function VolumeHandlers.stepVolume(current: number, delta: number, levels: { number }): number
	local step = VolumeHandlers.snapIndex(current, levels)
	local newStep = math.max(0, math.min(#levels, step + delta))
	return newStep &gt; 0 and levels[newStep] or 0
end

-- ════════════════════════════════════════════════════════════════════
-- Shared paint/discovery helpers (used by both `handlers` and `attach`)
-- ════════════════════════════════════════════════════════════════════

-- Color3 is referenced only inside these function BODIES (never at module
-- scope) so merely `require`-ing/`luau.load`-ing this module never touches
-- the global - see the module-level note above.
local function setToggleStatus(button: Instance?, muted: boolean)
	if not button then
		return
	end
	local status = button:FindFirstChild("Status")
	if status then
		(status :: any).Text = muted and "OFF" or "ON"
	end
	(button :: any).BackgroundColor3 = muted and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(85, 255, 0)
end

local function updateVolumeBar(volumeFrame: Instance?, volume: number)
	if not volumeFrame then
		return
	end
	local lit = VolumeHandlers.snapIndex(volume, VolumeHandlers.VOLUME_LEVELS)
	for i = 1, #VolumeHandlers.VOLUME_LEVELS do
		local frame = volumeFrame:FindFirstChild("Volume" .. i)
		if frame then
			(frame :: any).BackgroundColor3 = i &lt;= lit and Color3.fromRGB(85, 255, 0) or Color3.fromRGB(74, 74, 74)
			;(frame :: any).BackgroundTransparency = i &lt;= lit and 0 or 0.5
		end
	end
end

-- Declared-fix discovery (see module note): scoped to `gui:GetDescendants()`.
-- EVERY match, not the first: the Kernel shell can hold two Settings panels.
-- When Sound System's unstamped 2.x copy is adopted before the Kernel's
-- piece decision reaches the client, the General UI Kit piece deposes it
-- (MenuSystem hides it and leaves it in Menus, "deposed by the 3.0 piece"),
-- and a first-match scan painted that hidden copy only: the visible toggle
-- stayed ON after the player's Mute and the visible bars never moved
-- (reported from the owner's Player, 3.0.0). Painting a hidden copy too is
-- harmless. Pure (GetDescendants/IsA/GetAttribute only) - Lune-tested.
function VolumeHandlers.findToggleButtons(gui: Instance, action: string): { Instance }
	local found = {}
	for _, d in ipairs(gui:GetDescendants()) do
		if d:IsA("GuiButton") and d:GetAttribute("Action") == action then
			table.insert(found, d)
		end
	end
	return found
end

function VolumeHandlers.findVolumeFrames(gui: Instance, groupName: string): { Instance }
	local found = {}
	for _, d in ipairs(gui:GetDescendants()) do
		if d:GetAttribute("VolumeGroup") == groupName then
			local frame = d:FindFirstChild("VolumeFrame")
			if frame then
				table.insert(found, frame)
			end
		end
	end
	return found
end

local function paintGroup(gui: Instance, group: Instance, groupName: string, toggleAction: string)
	local volume = (group :: any).Volume
	for _, button in ipairs(VolumeHandlers.findToggleButtons(gui, toggleAction)) do
		setToggleStatus(button, volume == 0)
	end
	for _, frame in ipairs(VolumeHandlers.findVolumeFrames(gui, groupName)) do
		updateVolumeBar(frame, volume)
	end
end

-- ════════════════════════════════════════════════════════════════════
-- Handlers
-- ════════════════════════════════════════════════════════════════════

--- Builds the 6 Actions this pack dispatches through
--- `ctx.ui:registerHandlers`: `ToggleMusicMute`, `ToggleSFXMute`,
--- `MusicVolumeUp`, `MusicVolumeDown`, `SFXVolumeUp`, `SFXVolumeDown`.
--- `deps = { sfxGroup: SoundGroup, musicGroup: SoundGroup, gui: Instance }`.
--- The v1 saved-volume-on-mute state (`savedMusicVolume`/`savedSFXVolume`)
--- becomes a closure-local per call, seeded from the live group exactly like
--- v1 (`group.Volume &gt; 0 and group.Volume or 1`). A volume step that leaves
--- the group audible also becomes the saved volume, so the toggle unmutes to
--- the last level the player chose even when the music player's Mute (not
--- this toggle) silenced it. A step up from silent unmutes; every toggle and
--- bar in `gui` is repainted after each action.
function VolumeHandlers.handlers(deps: { sfxGroup: Instance, musicGroup: Instance, gui: Instance })
	local sfxGroup, musicGroup, gui = deps.sfxGroup, deps.musicGroup, deps.gui

	local savedMusicVolume = (musicGroup :: any).Volume &gt; 0 and (musicGroup :: any).Volume or 1
	local savedSFXVolume = (sfxGroup :: any).Volume &gt; 0 and (sfxGroup :: any).Volume or 1

	local function paintMusic()
		paintGroup(gui, musicGroup, "Music", "ToggleMusicMute")
	end
	local function paintSFX()
		paintGroup(gui, sfxGroup, "SFX", "ToggleSFXMute")
	end

	return {
		ToggleMusicMute = function(button: Instance?)
			if (musicGroup :: any).Volume &gt; 0 then
				savedMusicVolume = (musicGroup :: any).Volume
				;(musicGroup :: any).Volume = 0
			else
				(musicGroup :: any).Volume = savedMusicVolume
			end
			setToggleStatus(button, (musicGroup :: any).Volume == 0)
			paintMusic()
		end,

		ToggleSFXMute = function(button: Instance?)
			if (sfxGroup :: any).Volume &gt; 0 then
				savedSFXVolume = (sfxGroup :: any).Volume
				;(sfxGroup :: any).Volume = 0
			else
				(sfxGroup :: any).Volume = savedSFXVolume
			end
			setToggleStatus(button, (sfxGroup :: any).Volume == 0)
			paintSFX()
		end,

		MusicVolumeUp = function(_button: Instance?)
			local v = VolumeHandlers.stepVolume((musicGroup :: any).Volume, 1, VolumeHandlers.VOLUME_LEVELS)
			;(musicGroup :: any).Volume = v
			savedMusicVolume = v &gt; 0 and v or savedMusicVolume
			paintMusic()
		end,

		MusicVolumeDown = function(_button: Instance?)
			local v = VolumeHandlers.stepVolume((musicGroup :: any).Volume, -1, VolumeHandlers.VOLUME_LEVELS)
			;(musicGroup :: any).Volume = v
			savedMusicVolume = v &gt; 0 and v or savedMusicVolume
			paintMusic()
		end,

		SFXVolumeUp = function(_button: Instance?)
			local v = VolumeHandlers.stepVolume((sfxGroup :: any).Volume, 1, VolumeHandlers.VOLUME_LEVELS)
			;(sfxGroup :: any).Volume = v
			savedSFXVolume = v &gt; 0 and v or savedSFXVolume
			paintSFX()
		end,

		SFXVolumeDown = function(_button: Instance?)
			local v = VolumeHandlers.stepVolume((sfxGroup :: any).Volume, -1, VolumeHandlers.VOLUME_LEVELS)
			;(sfxGroup :: any).Volume = v
			savedSFXVolume = v &gt; 0 and v or savedSFXVolume
			paintSFX()
		end,
	}
end

-- ════════════════════════════════════════════════════════════════════
-- Init + external sync
-- ════════════════════════════════════════════════════════════════════

--- Wires initial paint + bidirectional `Volume` sync for both groups, scoped
--- to `gui`. `trove` owns the connections (the kernel Trove, passed in
--- already-constructed by the caller) so cleanup on respawn/reload is
--- automatic. The Settings panel usually reaches `gui` AFTER this runs (the
--- Kernel adopts General UI Kit's piece when it arrives), so a toggle or a
--- volume bar added to `gui` later is painted as it arrives, instead of
--- showing the asset's ON and full bars until the first volume change.
--- Needs `GetPropertyChangedSignal` and `task.defer`, neither available
--- under Lune's sandboxed Instance/globals - validated in Studio
--- (tools/v3/sound-settings), not Lune-tested (see module note above).
function VolumeHandlers.attach(gui: Instance, sfxGroup: Instance, musicGroup: Instance, trove: any)
	local function syncMusic()
		paintGroup(gui, musicGroup, "Music", "ToggleMusicMute")
	end

	local function syncSFX()
		paintGroup(gui, sfxGroup, "SFX", "ToggleSFXMute")
	end

	task.defer(function()
		syncMusic()
		syncSFX()
	end)

	trove:Connect(musicGroup:GetPropertyChangedSignal("Volume"), syncMusic)
	trove:Connect(sfxGroup:GetPropertyChangedSignal("Volume"), syncSFX)

	-- One deferred repaint per batch of arrivals (an adopted panel brings
	-- its whole subtree through DescendantAdded at once).
	local pending = false
	trove:Connect(gui.DescendantAdded, function(d: Instance)
		if pending then
			return
		end
		local action = d:GetAttribute("Action")
		if d:GetAttribute("VolumeGroup") ~= nil or action == "ToggleMusicMute" or action == "ToggleSFXMute" then
			pending = true
			task.defer(function()
				pending = false
				syncMusic()
				syncSFX()
			end)
		end
	end)
end

return VolumeHandlers
