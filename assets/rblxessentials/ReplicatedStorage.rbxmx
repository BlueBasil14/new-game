            <string name="Source">-- Contracts.lua - interface piece contracts (RBLX Essentials 3.0).
--
-- A pack declares, in `Packs/&lt;PackId&gt;/Pieces`, every piece of interface it
-- drives and what that piece must contain. The declaration is plain data:
--
--   return {
--       CodesPanel = {
--           contract = 1,              -- bumped only by an incompatible change
--           kind = "Panel",            -- Panel | HudButton | HudWidget | Billboard | Layer
--           doc = "Panel for typing and redeeming codes.",
--           requires = { { path = "Container/Button", class = "GuiButton" } },
--           optional = { { path = "Container/ErrorText", class = "TextLabel" } },
--       },
--       CodesButton = { contract = 1, kind = "HudButton", doc = "...", opens = "CodesPanel" },
--   }
--
-- Kernel 3.0.1: `standsInFor = "&lt;PackId&gt;.&lt;Name&gt;"` marks a stand-in, a copy
-- of a piece another pack owns (the General UI Kit's Codes menu stands in
-- for CodesSystem.CodesPanel). validateSpecs checks its shape and that it
-- names another pack; Pieces.plan refuses the stand-in when the owner piece
-- is declared, and checks that both have the same kind.
--
-- A piece root carries RBLXE_Piece = "&lt;PackId&gt;.&lt;Name&gt;" and RBLXE_Contract.
-- The same check runs in the Kernel (which copy to use) and in Tools (before
-- Play), so both always agree. Pure: Instances come in as arguments.
local Contracts = {}

-- Layer (plan B0): a ScreenGui that is itself the piece, such as a layer of
-- notification templates; like a Billboard piece it is its own entry in
-- Interface, never inside another ScreenGui.
Contracts.KINDS = {
	Panel = "GuiObject",
	HudButton = "GuiButton",
	HudWidget = "GuiObject",
	Billboard = "BillboardGui",
	Layer = "ScreenGui",
}
Contracts.PIECE_ATTRIBUTE = "RBLXE_Piece"
Contracts.CONTRACT_ATTRIBUTE = "RBLXE_Contract"

-- What MenuSystem needs to adopt and open a piece, checked on every piece of
-- that kind on top of its declared `requires`: a Panel is adopted through its
-- UI_Panel tag and registered under its PanelId; a HudButton is adopted
-- through its UI_Interactable tag and opens its panel with
-- Action = "TogglePanel" and TargetPanel. Without these a piece could win on
-- the server and still be unusable on every client. Tags are read with
-- Instance:HasTag, which @lune/roblox implements, so the check stays pure.
Contracts.IMPLICIT = {
	Panel = { tag = "UI_Panel", attributes = { PanelId = true } },
	HudButton = { tag = "UI_Interactable", attributes = { Action = "TogglePanel", TargetPanel = true } },
}

local function validateEntries(prefix, list, label, errors)
	if list == nil then
		return
	end
	if type(list) ~= "table" then
		table.insert(errors, ("%s.%s must be a list"):format(prefix, label))
		return
	end
	for index, entry in ipairs(list) do
		if type(entry) ~= "table" or type(entry.path) ~= "string" or entry.path == ""
			or type(entry.class) ~= "string" or entry.class == "" then
			table.insert(errors, ("%s.%s[%d] needs a non-empty path and class"):format(prefix, label, index))
		end
	end
end

function Contracts.validateSpecs(packId, specs)
	if type(specs) ~= "table" then
		return { ("%s.Pieces must return a table"):format(packId) }
	end
	local errors = {}
	for name, spec in pairs(specs) do
		local prefix = ("%s.Pieces.%s"):format(packId, tostring(name))
		if type(name) ~= "string" or not name:match("^[%a][%w_]*$") then
			table.insert(errors, ("%s: piece names must start with a letter and use letters, digits or _"):format(prefix))
		elseif type(spec) ~= "table" then
			table.insert(errors, ("%s must be a table"):format(prefix))
		else
			if type(spec.contract) ~= "number" or spec.contract &lt; 1 or spec.contract % 1 ~= 0 then
				table.insert(errors, ("%s.contract must be a whole number &gt;= 1"):format(prefix))
			end
			if Contracts.KINDS[spec.kind] == nil then
				table.insert(errors, ("%s.kind must be Panel, HudButton, HudWidget, Billboard or Layer"):format(prefix))
			end
			if type(spec.doc) ~= "string" or spec.doc == "" then
				table.insert(errors, ("%s.doc is required"):format(prefix))
			end
			validateEntries(prefix, spec.requires, "requires", errors)
			validateEntries(prefix, spec.optional, "optional", errors)
			if spec.opens ~= nil and (type(spec.opens) ~= "string" or specs[spec.opens] == nil) then
				table.insert(errors, ("%s.opens must name another piece of %s"):format(prefix, packId))
			end
			if spec.standsInFor ~= nil then
				local ownerPack, ownerName = nil, nil
				if type(spec.standsInFor) == "string" then
					ownerPack, ownerName = Contracts.splitId(spec.standsInFor)
				end
				if ownerPack == nil or ownerPack == packId or not ownerName:match("^[%a][%w_]*$") then
					table.insert(errors, ('%s.standsInFor must be "&lt;PackId&gt;.&lt;Name&gt;" naming a piece of another pack'):format(prefix))
				end
			end
		end
	end
	table.sort(errors)
	return errors
end

function Contracts.resolve(root, path)
	local node = root
	for segment in string.gmatch(path, "[^/]+") do
		node = node:FindFirstChild(segment)
		if node == nil then
			return nil
		end
	end
	return node
end

local function display(value)
	if type(value) == "string" then
		return ("%q"):format(value)
	elseif type(value) == "table" then
		return "a table"
	end
	return tostring(value)
end

-- What makes a spec unusable for check. validateSpecs already rejects all of
-- it for a pack's own Pieces module, but Tools also checks pieces against
-- specs nobody validated, and a check answers with problems, never a throw.
local function specProblems(spec)
	local function problem(name, expected, found)
		return { path = "(spec)", problem = "spec", name = name, expected = expected, found = display(found) }
	end
	if type(spec) ~= "table" then
		return { problem("spec", "a table", spec) }
	end
	local problems = {}
	if Contracts.KINDS[spec.kind] == nil then
		table.insert(problems, problem("kind", "Panel, HudButton, HudWidget, Billboard or Layer", spec.kind))
	end
	if type(spec.contract) ~= "number" or spec.contract &lt; 1 or spec.contract % 1 ~= 0 then
		table.insert(problems, problem("contract", "a whole number &gt;= 1", spec.contract))
	end
	for _, label in ipairs({ "requires", "optional" }) do
		local list = spec[label]
		if list ~= nil and type(list) ~= "table" then
			table.insert(problems, problem(label, "a list", list))
		elseif list ~= nil then
			for index, entry in ipairs(list) do
				if type(entry) ~= "table" or type(entry.path) ~= "string" or entry.path == ""
					or type(entry.class) ~= "string" or entry.class == "" then
					table.insert(problems, problem(("%s[%d]"):format(label, index), "a non-empty path and class", entry))
				end
			end
		end
	end
	return problems
end

function Contracts.check(root, spec)
	local problems = specProblems(spec)
	if typeof(root) ~= "Instance" then
		table.insert(problems, { path = "(root)", problem = "root", expected = "an Instance", found = display(root) })
	end
	if #problems &gt; 0 then
		return problems
	end
	local rootClass = Contracts.KINDS[spec.kind]
	if not root:IsA(rootClass) then
		table.insert(problems, { path = "(root)", problem = "wrong class", expected = rootClass, found = root.ClassName })
	end
	local declared = root:GetAttribute(Contracts.CONTRACT_ATTRIBUTE)
	if declared ~= spec.contract then
		table.insert(problems, { path = "(root)", problem = "contract", expected = spec.contract, found = declared })
	end
	local implicit = Contracts.IMPLICIT[spec.kind]
	if implicit ~= nil then
		if not root:HasTag(implicit.tag) then
			table.insert(problems, { path = "(root)", problem = "tag", expected = implicit.tag })
		end
		local names = {}
		for name in pairs(implicit.attributes) do
			table.insert(names, name)
		end
		table.sort(names)
		for _, name in ipairs(names) do
			local want = implicit.attributes[name]
			local value = root:GetAttribute(name)
			if want == true then
				if type(value) ~= "string" or value == "" then
					table.insert(problems, { path = "(root)", problem = "attribute", name = name, expected = "non-empty text", found = value })
				end
			elseif value ~= want then
				table.insert(problems, { path = "(root)", problem = "attribute", name = name, expected = ("%q"):format(want), found = value })
			end
		end
	end
	for _, entry in ipairs(spec.requires or {}) do
		local found = Contracts.resolve(root, entry.path)
		if found == nil then
			table.insert(problems, { path = entry.path, problem = "missing", expected = entry.class })
		elseif not found:IsA(entry.class) then
			table.insert(problems, { path = entry.path, problem = "wrong class", expected = entry.class, found = found.ClassName })
		end
	end
	for _, entry in ipairs(spec.optional or {}) do
		local found = Contracts.resolve(root, entry.path)
		if found ~= nil and not found:IsA(entry.class) then
			table.insert(problems, { path = entry.path, problem = "wrong class", expected = entry.class, found = found.ClassName })
		end
	end
	return problems
end

function Contracts.formatProblems(problems)
	local parts = {}
	for _, p in ipairs(problems) do
		if p.problem == "missing" then
			table.insert(parts, ("missing %s (%s)"):format(p.path, p.expected))
		elseif p.problem == "contract" then
			table.insert(parts, ("contract version %s, expected %s"):format(tostring(p.found), tostring(p.expected)))
		elseif p.problem == "tag" then
			table.insert(parts, ("missing tag %s"):format(tostring(p.expected)))
		elseif p.problem == "attribute" then
			local found = type(p.found) == "string" and ("%q"):format(p.found) or tostring(p.found)
			table.insert(parts, ("attribute %s is %s, expected %s"):format(p.name, found, tostring(p.expected)))
		elseif p.problem == "spec" then
			table.insert(parts, ("invalid contract: %s is %s, expected %s"):format(p.name, p.found, p.expected))
		elseif p.problem == "root" then
			table.insert(parts, ("piece root is %s, expected %s"):format(p.found, p.expected))
		else
			table.insert(parts, ("%s is %s, expected %s"):format(p.path, tostring(p.found), tostring(p.expected)))
		end
	end
	return table.concat(parts, "; ")
end

function Contracts.splitId(pieceId)
	return string.match(pieceId, "^([^.]+)%.([^.]+)$")
end

return Contracts
