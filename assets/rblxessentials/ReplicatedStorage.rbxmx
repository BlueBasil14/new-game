              <string name="Source">--!strict

local RunService = game:GetService("RunService")

export type Trove = {
	Extend: (self: Trove) -&gt; Trove,
	Clone: &lt;T&gt;(self: Trove, instance: T &amp; Instance) -&gt; T,
	Construct: &lt;T, A...&gt;(self: Trove, class: Constructable&lt;T, A...&gt;, A...) -&gt; T,
	Connect: (self: Trove, signal: SignalLike | RBXScriptSignal, fn: (...any) -&gt; ...any) -&gt; ConnectionLike,
	BindToRenderStep: (self: Trove, name: string, priority: number, fn: (dt: number) -&gt; ()) -&gt; (),
	AddPromise: &lt;T&gt;(self: Trove, promise: T &amp; PromiseLike) -&gt; T,
	Add: &lt;T&gt;(self: Trove, object: T &amp; Trackable, cleanupMethod: string?) -&gt; T,
	Remove: &lt;T&gt;(self: Trove, object: T &amp; Trackable) -&gt; boolean,
	Clean: (self: Trove) -&gt; (),
	WrapClean: (self: Trove) -&gt; () -&gt; (),
	AttachToInstance: (self: Trove, instance: Instance) -&gt; RBXScriptConnection,
	Destroy: (self: Trove) -&gt; (),
}

type TroveInternal = Trove &amp; {
	_objects: { any },
	_cleaning: boolean,
	_findAndRemoveFromObjects: (self: TroveInternal, object: any, cleanup: boolean) -&gt; boolean,
	_cleanupObject: (self: TroveInternal, object: any, cleanupMethod: string?) -&gt; (),
}

--[=[
	@within Trove
	@type Trackable Instance | RBXScriptConnection | ConnectionLike | PromiseLike | thread | ((...any) -&gt; ...any) | Destroyable | DestroyableLowercase | Disconnectable | DisconnectableLowercase
	Represents all trackable objects by Trove.
]=]
export type Trackable =
	Instance
	| RBXScriptConnection
	| ConnectionLike
	| PromiseLike
	| thread
	| ((...any) -&gt; ...any)
	| Destroyable
	| DestroyableLowercase
	| Disconnectable
	| DisconnectableLowercase

--[=[
	@within Trove
	@interface ConnectionLike
	.Connected boolean
	.Disconnect (self) -&gt; ()
]=]
type ConnectionLike = {
	Connected: boolean,
	Disconnect: (self: ConnectionLike) -&gt; (),
}

--[=[
	@within Trove
	@interface SignalLike
	.Connect (self, callback: (...any) -&gt; ...any) -&gt; ConnectionLike
	.Once (self, callback: (...any) -&gt; ...any) -&gt; ConnectionLike
]=]
type SignalLike = {
	Connect: (self: SignalLike, callback: (...any) -&gt; ...any) -&gt; ConnectionLike,
	Once: (self: SignalLike, callback: (...any) -&gt; ...any) -&gt; ConnectionLike,
}

--[=[
	@within Trove
	@interface PromiseLike
	.getStatus (self) -&gt; string
	.finally (self, callback: (...any) -&gt; ...any) -&gt; PromiseLike
	.cancel (self) -&gt; ()
]=]
type PromiseLike = {
	getStatus: (self: PromiseLike) -&gt; string,
	finally: (self: PromiseLike, callback: (...any) -&gt; ...any) -&gt; PromiseLike,
	cancel: (self: PromiseLike) -&gt; (),
}

--[=[
	@within Trove
	@type Constructable { new: (A...) -&gt; T } | (A...) -&gt; T
]=]
type Constructable&lt;T, A...&gt; = { new: (A...) -&gt; T } | (A...) -&gt; T

--[=[
	@within Trove
	@interface Destroyable
	.disconnect (self) -&gt; ()
]=]
type Destroyable = {
	Destroy: (self: Destroyable) -&gt; (),
}

--[=[
	@within Trove
	@interface DestroyableLowercase
	.disconnect (self) -&gt; ()
]=]
type DestroyableLowercase = {
	destroy: (self: DestroyableLowercase) -&gt; (),
}

--[=[
	@within Trove
	@interface Disconnectable
	.disconnect (self) -&gt; ()
]=]
type Disconnectable = {
	Disconnect: (self: Disconnectable) -&gt; (),
}

--[=[
	@within Trove
	@interface DisconnectableLowercase
	.disconnect (self) -&gt; ()
]=]
type DisconnectableLowercase = {
	disconnect: (self: DisconnectableLowercase) -&gt; (),
}

local FN_MARKER = newproxy()
local THREAD_MARKER = newproxy()
local GENERIC_OBJECT_CLEANUP_METHODS = table.freeze({ "Destroy", "Disconnect", "destroy", "disconnect" })

local function GetObjectCleanupFunction(object: any, cleanupMethod: string?)
	local t = typeof(object)

	if t == "function" then
		return FN_MARKER
	elseif t == "thread" then
		return THREAD_MARKER
	end

	if cleanupMethod then
		return cleanupMethod
	end

	if t == "Instance" then
		return "Destroy"
	elseif t == "RBXScriptConnection" then
		return "Disconnect"
	elseif t == "table" then
		for _, genericCleanupMethod in GENERIC_OBJECT_CLEANUP_METHODS do
			if typeof(object[genericCleanupMethod]) == "function" then
				return genericCleanupMethod
			end
		end
	end

	error(`failed to get cleanup function for object {t}: {object}`, 3)
end

local function AssertPromiseLike(object: any)
	if
		typeof(object) ~= "table"
		or typeof(object.getStatus) ~= "function"
		or typeof(object.finally) ~= "function"
		or typeof(object.cancel) ~= "function"
	then
		error("did not receive a promise as an argument", 3)
	end
end

--[=[
	@class Trove
	A Trove is helpful for tracking any sort of object during
	runtime that needs to get cleaned up at some point.
]=]
local Trove = {}
Trove.__index = Trove

--[=[
	@return Trove
	Constructs a Trove object.

	```lua
	local trove = Trove.new()
	```
]=]
function Trove.new(): Trove
	local self = setmetatable({}, Trove)

	self._objects = {}
	self._cleaning = false

	return (self :: any) :: Trove
end

--[=[
	@method Add
	@within Trove
	@param object any -- Object to track
	@param cleanupMethod string? -- Optional cleanup name override
	@return object: any
	Adds an object to the trove. Once the trove is cleaned or
	destroyed, the object will also be cleaned up.

	The following types are accepted (e.g. `typeof(object)`):

	| Type | Cleanup |
	| ---- | ------- |
	| `Instance` | `object:Destroy()` |
	| `RBXScriptConnection` | `object:Disconnect()` |
	| `function` | `object()` |
	| `thread` | `task.cancel(object)` |
	| `table` | `object:Destroy()` _or_ `object:Disconnect()` _or_ `object:destroy()` _or_ `object:disconnect()` |
	| `table` with `cleanupMethod` | `object:&lt;cleanupMethod&gt;()` |

	Returns the object added.

	```lua
	-- Add a part to the trove, then destroy the trove,
	-- which will also destroy the part:
	local part = Instance.new("Part")
	trove:Add(part)
	trove:Destroy()

	-- Add a function to the trove:
	trove:Add(function()
		print("Cleanup!")
	end)
	trove:Destroy()

	-- Standard cleanup from table:
	local tbl = {}
	function tbl:Destroy()
		print("Cleanup")
	end
	trove:Add(tbl)

	-- Custom cleanup from table:
	local tbl = {}
	function tbl:DoSomething()
		print("Do something on cleanup")
	end
	trove:Add(tbl, "DoSomething")
	```
]=]
function Trove.Add(self: TroveInternal, object: Trackable, cleanupMethod: string?): any
	if self._cleaning then
		error("cannot call trove:Add() while cleaning", 2)
	end

	local cleanup = GetObjectCleanupFunction(object, cleanupMethod)
	table.insert(self._objects, { object, cleanup })

	return object
end

--[=[
	@method Clone
	@within Trove
	@return Instance
	Clones the given instance and adds it to the trove. Shorthand for
	`trove:Add(instance:Clone())`.

	```lua
	local clonedPart = trove:Clone(somePart)
	```
]=]
function Trove.Clone(self: TroveInternal, instance: Instance): Instance
	if self._cleaning then
		error("cannot call trove:Clone() while cleaning", 2)
	end

	return self:Add(instance:Clone())
end

--[=[
	@method Construct
	@within Trove
	@param class { new(Args...) -&gt; T } | (Args...) -&gt; T
	@param ... Args...
	@return T
	Constructs a new object from either the
	table or function given.

	If a table is given, the table's `new`
	function will be called with the given
	arguments.

	If a function is given, the function will
	be called with the given arguments.

	The result from either of the two options
	will be added to the trove.

	This is shorthand for `trove:Add(SomeClass.new(...))`
	and `trove:Add(SomeFunction(...))`.

	```lua
	local Signal = require(somewhere.Signal)

	-- All of these are identical:
	local s = trove:Construct(Signal)
	local s = trove:Construct(Signal.new)
	local s = trove:Construct(function() return Signal.new() end)
	local s = trove:Add(Signal.new())

	-- Even Roblox instances can be created:
	local part = trove:Construct(Instance, "Part")
	```
]=]
function Trove.Construct&lt;T, A...&gt;(self: TroveInternal, class: Constructable&lt;T, A...&gt;, ...: A...)
	if self._cleaning then
		error("Cannot call trove:Construct() while cleaning", 2)
	end

	local object = nil
	local t = type(class)
	if t == "table" then
		object = (class :: any).new(...)
	elseif t == "function" then
		object = (class :: any)(...)
	end

	return self:Add(object)
end

--[=[
	@method Connect
	@within Trove
	@param signal RBXScriptSignal
	@param fn (...: any) -&gt; ()
	@return RBXScriptConnection
	Connects the function to the signal, adds the connection
	to the trove, and then returns the connection.

	This is shorthand for `trove:Add(signal:Connect(fn))`.

	```lua
	trove:Connect(workspace.ChildAdded, function(instance)
		print(instance.Name .. " added to workspace")
	end)
	```
]=]
function Trove.Connect(self: TroveInternal, signal: SignalLike, fn: (...any) -&gt; ...any)
	if self._cleaning then
		error("Cannot call trove:Connect() while cleaning", 2)
	end

	return self:Add(signal:Connect(fn))
end

--[=[
	@method BindToRenderStep
	@within Trove
	@param name string
	@param priority number
	@param fn (dt: number) -&gt; ()
	Calls `RunService:BindToRenderStep` and registers a function in the
	trove that will call `RunService:UnbindFromRenderStep` on cleanup.

	```lua
	trove:BindToRenderStep("Test", Enum.RenderPriority.Last.Value, function(dt)
		-- Do something
	end)
	```
]=]
function Trove.BindToRenderStep(self: TroveInternal, name: string, priority: number, fn: (dt: number) -&gt; ())
	if self._cleaning then
		error("cannot call trove:BindToRenderStep() while cleaning", 2)
	end

	RunService:BindToRenderStep(name, priority, fn)

	self:Add(function()
		RunService:UnbindFromRenderStep(name)
	end)
end

--[=[
	@method AddPromise
	@within Trove
	@param promise Promise
	@return Promise
	Gives the promise to the trove, which will cancel the promise if the trove is cleaned up or if the promise
	is removed. The exact promise is returned, thus allowing chaining.

	```lua
	trove:AddPromise(doSomethingThatReturnsAPromise())
		:andThen(function()
			print("Done")
		end)
	-- Will cancel the above promise (assuming it didn't resolve immediately)
	trove:Clean()

	local p = trove:AddPromise(doSomethingThatReturnsAPromise())
	-- Will also cancel the promise
	trove:Remove(p)
	```

	:::caution Promise v4 Only
	This is only compatible with the [roblox-lua-promise](https://eryn.io/roblox-lua-promise/) library, version 4.
	:::
]=]
function Trove.AddPromise(self: TroveInternal, promise: PromiseLike)
	if self._cleaning then
		error("cannot call trove:AddPromise() while cleaning", 2)
	end
	AssertPromiseLike(promise)

	if promise:getStatus() == "Started" then
		promise:finally(function()
			if self._cleaning then
				return
			end
			self:_findAndRemoveFromObjects(promise, false)
		end)

		self:Add(promise, "cancel")
	end

	return promise
end

--[=[
	@method Remove
	@within Trove
	@param object any
	Removes the object from the Trove and cleans it up.

	```lua
	local part = Instance.new("Part")
	trove:Add(part)
	trove:Remove(part)
	```
]=]
function Trove.Remove(self: TroveInternal, object: Trackable): boolean
	if self._cleaning then
		error("cannot call trove:Remove() while cleaning", 2)
	end

	return self:_findAndRemoveFromObjects(object, true)
end

--[=[
	@method Extend
	@within Trove
	@return Trove
	Creates and adds another trove to itself. This is just shorthand
	for `trove:Construct(Trove)`. This is useful for contexts where
	the trove object is present, but the class itself isn't.

	:::note
	This does _not_ clone the trove. In other words, the objects in the
	trove are not given to the new constructed trove. This is simply to
	construct a new Trove and add it as an object to track.
	:::

	```lua
	local trove = Trove.new()
	local subTrove = trove:Extend()

	trove:Clean() -- Cleans up the subTrove too
	```
]=]
function Trove.Extend(self: TroveInternal)
	if self._cleaning then
		error("cannot call trove:Extend() while cleaning", 2)
	end

	return self:Construct(Trove)
end

--[=[
	@method Clean
	@within Trove
	Cleans up all objects in the trove. This is
	similar to calling `Remove` on each object
	within the trove. The ordering of the objects
	removed is _not_ guaranteed.

	```lua
	trove:Clean()
	```
]=]
function Trove.Clean(self: TroveInternal)
	if self._cleaning then
		return
	end

	self._cleaning = true

	for _, obj in self._objects do
		self:_cleanupObject(obj[1], obj[2])
	end

	table.clear(self._objects)
	self._cleaning = false
end

--[=[
	@method WrapClean
	@within Trove
	Returns a function that wraps the trove's `Clean()`
	method. Calling the returned function will clean up
	the trove.

	This is often useful in contexts where functions
	are the primary mode for cleaning up an environment,
	such as in many "observer" patterns.

	```lua
	local cleanup = trove:WrapClean()

	-- Sometime later...
	cleanup()
	```

	```lua
	-- Common observer pattern example:
	someObserver(function()
		local trove = Trove.new()
		-- Foo
		return trove:WrapClean()
	end)
	```
]=]
function Trove.WrapClean(self: TroveInternal)
	return function()
		self:Clean()
	end
end

function Trove._findAndRemoveFromObjects(self: TroveInternal, object: any, cleanup: boolean): boolean
	local objects = self._objects

	for i, obj in objects do
		if obj[1] == object then
			local n = #objects
			objects[i] = objects[n]
			objects[n] = nil

			if cleanup then
				self:_cleanupObject(obj[1], obj[2])
			end

			return true
		end
	end

	return false
end

function Trove._cleanupObject(_self: TroveInternal, object: any, cleanupMethod: string?)
	if cleanupMethod == FN_MARKER then
		task.spawn(object)
	elseif cleanupMethod == THREAD_MARKER then
		pcall(task.cancel, object)
	else
		object[cleanupMethod](object)
	end
end

--[=[
	@method AttachToInstance
	@within Trove
	@param instance Instance
	@return RBXScriptConnection
	Attaches the trove to a Roblox instance. Once this
	instance is removed from the game (parent or ancestor's
	parent set to `nil`), the trove will automatically
	clean up.

	This inverses the ownership of the Trove object, and should
	only be used when necessary. In other words, the attached
	instance dictates when the trove is cleaned up, rather than
	the trove dictating the cleanup of the instance.

	:::caution
	Will throw an error if `instance` is not a descendant
	of the game hierarchy.
	:::

	```lua
	trove:AttachToInstance(somePart)
	trove:Add(function()
		print("Cleaned")
	end)

	-- Destroying the part will cause the trove to clean up, thus "Cleaned" printed:
	somePart:Destroy()
	```
]=]
function Trove.AttachToInstance(self: TroveInternal, instance: Instance)
	if self._cleaning then
		error("cannot call trove:AttachToInstance() while cleaning", 2)
	elseif not instance:IsDescendantOf(game) then
		error("instance is not a descendant of the game hierarchy", 2)
	end

	return self:Connect(instance.Destroying, function()
		self:Destroy()
	end)
end

--[=[
	@method Destroy
	@within Trove
	Alias for `trove:Clean()`.

	```lua
	trove:Destroy()
	```
]=]
function Trove.Destroy(self: TroveInternal)
	self:Clean()
end

return {
	new = Trove.new,
}
</string>
              <int64 name="SourceAssetId">-1</int64>
              <BinaryString name="Tags" />
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">SFX</string>
            <BinaryString name="AttributesSerialize" />
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source">-- Sound facade. Packs call SFX:Play(name) freely; it is a no-op until a sound
-- backend registers (Sound System v2 calls setBackend from its client init).
local SFX = {}
local backend = nil

function SFX:Play(name)
	if backend then
		backend:Play(name)
	end
end

function SFX:PlayOverlap(name)
	if backend then
		backend:PlayOverlap(name)
	end
end

function SFX.setBackend(b)
	backend = b
end

return SFX
</string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags" />
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Schema</string>
            <BinaryString name="AttributesSerialize" />
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source">-- Schema.lua - declarative configuration schemas (RBLX Essentials 3.0).
--
-- A pack describes the options the GAME may set in `Packs/&lt;PackId&gt;/Schema`,
-- a ModuleScript returning `function(S) return S.config({ ... }) end`, where
-- `S` is this module. One schema serves three readers:
--   * the Kernel at boot: defaults plus validation of the game's Config modules;
--   * Tools in Studio: the same validation, before anyone presses Play;
--   * the reference generator: every field carries a `doc`.
--
-- Values are plain Luau data. The only merge rule: `config`, `record` and
-- `map` merge key by key; a `list` and every scalar are replaced whole (list
-- items still receive their own record defaults).
--
-- Plan A3:
--   * a `server = true` option, and everything under it, has no `default`:
--     this module sits in ReplicatedStorage, so a default would reach every
--     client (RT-10). Such an option is required or S.optional, and the game
--     sets it in the server Config module; a server list starts empty;
--   * any node may carry `check = function(value) -&gt; { { field?, message } }`
--     with a `checkDoc` that states the rule: a constraint over several
--     fields ("Target is required when Type is Stat"), run by validate once
--     the value passed every type check below it.
--
-- Plan B0 (phase B, before the Kernel 3.0.0 API freeze):
--   * S.color: a Color3 (typeof) with finite channels, written in a Config
--     module as Color3.fromRGB(r, g, b);
--   * S.tree: a nested table of text keys whose values are finite numbers,
--     text, true/false or tables of the same kind (at most TREE_DEPTH
--     levels, never a table inside itself), such as a starting profile. It
--     is a value, not a group: a game's tree replaces the default whole;
--   * pinned = true on an option outside lists and maps (never the root):
--     T.migrate refuses a game module whose value there differs from the
--     migrated one, and force never lifts it (a DataStore version, where
--     another value starts every player on an empty profile). The Kernel
--     only checks the flag and lists it in describe.
--
-- Pure: no `game`, no Instances, no yields.
local Schema = {}

-- The kinds whose value has no default of its own when the schema gives
-- none (describe's `required`): every kind but the groups and collections.
local SCALAR = {
	number = true, string = true, boolean = true, enum = true,
	id = true, dataPath = true, utcDate = true, color = true, tree = true,
}
local KNOWN = {
	number = true, string = true, boolean = true, enum = true, id = true,
	dataPath = true, utcDate = true, color = true, tree = true, list = true,
	map = true, record = true, config = true, optional = true,
}
-- How deep an S.tree may nest (plan B0).
Schema.TREE_DEPTH = 32
local ID_NAMES = { asset = "an asset id", product = "a developer product id", gamePass = "a game pass id" }
local DAYS_IN_MONTH = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 }

-- ── constructors ─────────────────────────────────────────────────────

local function build(kind, opts, extra)
	local node = { kind = kind }
	if opts ~= nil then
		assert(type(opts) == "table", "schema options must be a table")
		for key, value in pairs(opts) do
			node[key] = value
		end
	end
	if extra ~= nil then
		for key, value in pairs(extra) do
			node[key] = value
		end
	end
	return node
end

function Schema.number(opts) return build("number", opts) end
function Schema.integer(opts) return build("number", opts, { integer = true }) end
function Schema.string(opts) return build("string", opts) end
function Schema.boolean(opts) return build("boolean", opts) end
function Schema.enum(values, opts) return build("enum", opts, { values = values }) end
function Schema.assetId(opts) return build("id", opts, { idKind = "asset" }) end
function Schema.productId(opts) return build("id", opts, { idKind = "product" }) end
function Schema.gamePassId(opts) return build("id", opts, { idKind = "gamePass" }) end
function Schema.dataPath(opts) return build("dataPath", opts) end
function Schema.utcDate(opts) return build("utcDate", opts) end
function Schema.color(opts) return build("color", opts) end
function Schema.tree(opts) return build("tree", opts) end
function Schema.list(item, opts) return build("list", opts, { item = item }) end
function Schema.map(value, opts) return build("map", opts, { value = value }) end
function Schema.record(fields, opts) return build("record", opts, { fields = fields }) end
function Schema.config(fields, opts) return build("config", opts, { fields = fields }) end
function Schema.optional(inner) return { kind = "optional", inner = inner } end

-- ── helpers ──────────────────────────────────────────────────────────

local function unwrap(node)
	if type(node) == "table" and node.kind == "optional" then
		return node.inner
	end
	return node
end

local function copy(value)
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for key, item in pairs(value) do
		out[key] = copy(item)
	end
	return out
end
Schema.copy = copy

local function sortedKeys(t)
	local keys = {}
	for key in pairs(t) do
		table.insert(keys, key)
	end
	table.sort(keys, function(a, b)
		return tostring(a) &lt; tostring(b)
	end)
	return keys
end

local function childPath(path, key)
	if type(key) == "number" then
		return ("%s[%d]"):format(path, key)
	end
	if type(key) == "string" and key:match("^[%a_][%w_]*$") then
		return path == "" and key or (path .. "." .. key)
	end
	return ("%s[%q]"):format(path, tostring(key))
end
Schema.childPath = childPath

local function isArray(t)
	local count = 0
	for key in pairs(t) do
		if type(key) ~= "number" or key &lt; 1 or key % 1 ~= 0 then
			return false
		end
		count += 1
	end
	for i = 1, count do
		if t[i] == nil then
			return false
		end
	end
	return true
end

local function isDataPath(text)
	if type(text) ~= "string" or text == "" then
		return false
	end
	for segment in (text .. "."):gmatch("(.-)%.") do
		if not segment:match("^[%a_][%w_]*$") then
			return false
		end
	end
	return true
end

function Schema.parseUtcDate(text)
	if type(text) ~= "string" then
		return nil
	end
	local y, m, d = text:match("^(%d%d%d%d)%-(%d%d)%-(%d%d)$")
	if y == nil then
		return nil
	end
	local year, month, day = tonumber(y), tonumber(m), tonumber(d)
	if month &lt; 1 or month &gt; 12 then
		return nil
	end
	local days = DAYS_IN_MONTH[month]
	if month == 2 and ((year % 4 == 0 and year % 100 ~= 0) or year % 400 == 0) then
		days = 29
	end
	if day &lt; 1 or day &gt; days then
		return nil
	end
	return year, month, day
end

local function distance(a, b)
	local la, lb = #a, #b
	if la == 0 then return lb end
	if lb == 0 then return la end
	local previous = {}
	for j = 0, lb do
		previous[j] = j
	end
	for i = 1, la do
		local current = { [0] = i }
		local ca = a:sub(i, i):lower()
		for j = 1, lb do
			local cost = (ca == b:sub(j, j):lower()) and 0 or 1
			current[j] = math.min(previous[j] + 1, current[j - 1] + 1, previous[j - 1] + cost)
		end
		previous = current
	end
	return previous[lb]
end

local function suggest(key, fields)
	local best, bestDistance = nil, nil
	for _, name in ipairs(sortedKeys(fields)) do
		local d = distance(key, name)
		if d &lt;= 2 and (bestDistance == nil or d &lt; bestDistance) then
			best, bestDistance = name, d
		end
	end
	return best
end

-- ── validation ───────────────────────────────────────────────────────

local function push(problems, path, message)
	table.insert(problems, { path = path, message = message })
end

-- validateTree(value, path, problems, seen, depth): S.tree's rule. Every
-- bad entry is reported at its own path; a key that is not text is shown
-- with tostring (childPath's %d would throw on 1.5).
local function validateTree(value, path, problems, seen, depth)
	if type(value) ~= "table" then
		return push(problems, path, "must be a table of text keys")
	end
	if seen[value] then
		return push(problems, path, "contains itself")
	end
	if depth &gt; Schema.TREE_DEPTH then
		return push(problems, path, ("is nested deeper than %d levels"):format(Schema.TREE_DEPTH))
	end
	seen[value] = true
	for _, key in ipairs(sortedKeys(value)) do
		local item = value[key]
		local at = if type(key) == "string" then childPath(path, key) else ("%s[%s]"):format(path, tostring(key))
		if type(key) ~= "string" then
			push(problems, at, "keys must be text")
		elseif type(item) == "number" then
			if item ~= item or item == math.huge or item == -math.huge then
				push(problems, at, "must be a finite number")
			end
		elseif type(item) == "table" then
			validateTree(item, at, problems, seen, depth + 1)
		elseif type(item) ~= "string" and type(item) ~= "boolean" then
			push(problems, at, "must be a number, text, true/false or a table")
		end
	end
	seen[value] = nil
end

local validateNode

-- runCheck(node, value, path, problems): the node's own `check`. Each item it
-- returns is { field?, message }: `field` is a key, or a list of keys, under
-- the node's path. Inside a pcall, so a rule that throws is a problem.
local function runCheck(node, value, path, problems)
	local ok, found = pcall(node.check, value)
	if not ok then
		return push(problems, path, ("could not be checked: %s"):format(tostring(found)))
	end
	if type(found) ~= "table" then
		return
	end
	for _, item in ipairs(found) do
		if type(item) == "table" and type(item.message) == "string" then
			local at = path
			local field = item.field
			if type(field) == "table" then
				for _, key in ipairs(field) do
					at = childPath(at, key)
				end
			elseif field ~= nil then
				at = childPath(at, field)
			end
			push(problems, at, item.message)
		end
	end
end

local validateShape
validateNode = function(node, value, path, problems, opts)
	if node.kind == "optional" then
		if value == nil then
			return
		end
		return validateNode(node.inner, value, path, problems, opts)
	end
	-- A node's own rule runs only over a value that passed every type check
	-- below it: a rule over fields that are already wrong is noise.
	local before = #problems
	validateShape(node, value, path, problems, opts)
	if type(node.check) == "function" and #problems == before then
		runCheck(node, value, path, problems)
	end
end

validateShape = function(node, value, path, problems, opts)
	if value == nil then
		return push(problems, path, "is required")
	end
	local kind = node.kind
	if kind == "number" then
		if type(value) ~= "number" or value ~= value then
			return push(problems, path, "must be a number")
		end
		if node.integer and value % 1 ~= 0 then
			return push(problems, path, "must be a whole number")
		end
		if node.min ~= nil and value &lt; node.min then
			return push(problems, path, ("must be &gt;= %s"):format(tostring(node.min)))
		end
		if node.max ~= nil and value &gt; node.max then
			return push(problems, path, ("must be &lt;= %s"):format(tostring(node.max)))
		end
	elseif kind == "string" then
		if type(value) ~= "string" then
			return push(problems, path, "must be text")
		end
		if node.minLength ~= nil and #value &lt; node.minLength then
			if node.minLength == 1 then
				return push(problems, path, "must not be empty")
			end
			return push(problems, path, ("must have at least %d characters"):format(node.minLength))
		end
		if node.maxLength ~= nil and #value &gt; node.maxLength then
			return push(problems, path, ("must have at most %d characters"):format(node.maxLength))
		end
		if node.pattern ~= nil then
			-- pcall: validate can run on a schema Schema.check never saw, and a
			-- malformed pattern must be reported, never thrown.
			local ok, matched = pcall(string.match, value, node.pattern)
			if not ok then
				return push(problems, path, ("cannot be checked against pattern %s: %s"):format(tostring(node.pattern), tostring(matched)))
			end
			if matched == nil then
				return push(problems, path, ("must match %s"):format(node.patternDoc or node.pattern))
			end
		end
	elseif kind == "boolean" then
		if type(value) ~= "boolean" then
			return push(problems, path, "must be true or false")
		end
	elseif kind == "enum" then
		if type(node.values) ~= "table" or type(value) ~= "string" or table.find(node.values, value) == nil then
			return push(problems, path, ("must be one of: %s"):format(table.concat(node.values or {}, ", ")))
		end
	elseif kind == "id" then
		if type(value) ~= "number" or value % 1 ~= 0 or value &lt; 0 then
			return push(problems, path, ("must be %s: a whole number, 0 for none"):format(ID_NAMES[node.idKind] or "an id"))
		end
	elseif kind == "dataPath" then
		if not isDataPath(value) then
			return push(problems, path, "must be a data path like Stats.Cash")
		end
	elseif kind == "utcDate" then
		if Schema.parseUtcDate(value) == nil then
			return push(problems, path, "must be a UTC date written YYYY-MM-DD")
		end
	elseif kind == "color" then
		if typeof(value) ~= "Color3" then
			return push(problems, path, "must be a Color3 (Color3.fromRGB(r, g, b))")
		end
		-- LuaText cannot write a NaN or infinite channel, so T.config and
		-- T.migrate would fail later on a value the Kernel took.
		for _, channel in ipairs({ value.R, value.G, value.B }) do
			if channel ~= channel or channel == math.huge or channel == -math.huge then
				return push(problems, path, "must have finite channels")
			end
		end
	elseif kind == "tree" then
		validateTree(value, path, problems, {}, 1)
	elseif kind == "list" then
		if type(value) ~= "table" or not isArray(value) then
			return push(problems, path, "must be a list")
		end
		if node.minItems ~= nil and #value &lt; node.minItems then
			push(problems, path, ("must have at least %d entries"):format(node.minItems))
		end
		if node.maxItems ~= nil and #value &gt; node.maxItems then
			push(problems, path, ("must have at most %d entries"):format(node.maxItems))
		end
		for index, item in ipairs(value) do
			validateNode(node.item, item, childPath(path, index), problems, opts)
		end
	elseif kind == "map" then
		if type(value) ~= "table" then
			return push(problems, path, "must be a table")
		end
		for _, key in ipairs(sortedKeys(value)) do
			if type(key) ~= "string" then
				push(problems, path, "keys must be text")
			else
				validateNode(node.value, value[key], childPath(path, key), problems, opts)
			end
		end
	elseif kind == "record" or kind == "config" then
		if type(value) ~= "table" then
			return push(problems, path, "must be a table")
		end
		for _, key in ipairs(sortedKeys(value)) do
			if type(key) ~= "string" or node.fields[key] == nil then
				local hint = type(key) == "string" and suggest(key, node.fields) or nil
				push(problems, childPath(path, key),
					hint and ("is not a known option (did you mean %s?)"):format(hint) or "is not a known option")
			end
		end
		for _, name in ipairs(sortedKeys(node.fields)) do
			local field = node.fields[name]
			if not (kind == "config" and opts.skipServer and unwrap(field).server == true) then
				validateNode(field, value[name], childPath(path, name), problems, opts)
			end
		end
	end
end

function Schema.validate(root, value, rootPath, opts)
	local problems = {}
	validateNode(root, value, rootPath or "", problems, opts or {})
	return problems
end

function Schema.formatErrors(problems)
	local out = {}
	for _, problem in ipairs(problems) do
		table.insert(out, ("%s: %s"):format(problem.path, problem.message))
	end
	return out
end

-- ── defaults and merge ───────────────────────────────────────────────

function Schema.defaults(node)
	local kind = node.kind
	if kind == "optional" then
		if node.inner.default ~= nil then
			return Schema.defaults(node.inner)
		end
		return nil
	elseif kind == "record" or kind == "config" then
		local out = {}
		for name, field in pairs(node.fields) do
			out[name] = Schema.defaults(field)
		end
		return out
	elseif kind == "list" or kind == "map" then
		return Schema.merge(node, nil, node.default or {})
	end
	return copy(node.default)
end

function Schema.merge(node, base, override)
	if override == nil then
		return copy(base)
	end
	local n = unwrap(node)
	if type(override) ~= "table" then
		return copy(override)
	end
	if n.kind == "list" then
		local out = {}
		for index, item in ipairs(override) do
			out[index] = Schema.merge(n.item, Schema.defaults(n.item), item)
		end
		for key, item in pairs(override) do
			if out[key] == nil then
				out[key] = copy(item) -- kept so validation can reject a non-list
			end
		end
		return out
	end
	if n.kind ~= "record" and n.kind ~= "config" and n.kind ~= "map" then
		return copy(override)
	end
	local out = type(base) == "table" and copy(base) or {}
	for key, item in pairs(override) do
		local child = if n.kind == "map" then n.value else n.fields[key]
		if child == nil then
			out[key] = copy(item) -- unknown option: kept so validation reports it
		else
			local current = out[key]
			if current == nil then
				current = Schema.defaults(child)
			end
			out[key] = Schema.merge(child, current, item)
		end
	end
	return out
end

-- ── server-only options ──────────────────────────────────────────────

function Schema.serverFields(root)
	local set = {}
	for name, field in pairs(root.fields) do
		if unwrap(field).server == true then
			set[name] = true
		end
	end
	return set
end

function Schema.stripServer(root, value)
	local out = copy(value)
	for name in pairs(Schema.serverFields(root)) do
		out[name] = nil
	end
	return out
end

-- ── patterns ─────────────────────────────────────────────────────────

-- Luau rejects a malformed pattern only when string.match reaches the bad
-- item, so a probe on one subject lets most of them through ("a[" never
-- fails on "") and they throw later, on the game's value. patternError
-- walks the whole pattern once with the matcher's own rules (lstrlib) and
-- returns the reason the first bad item gives, or nil when every item is
-- well formed.
local MAX_CAPTURES = 32 -- LUA_MAXCAPTURES

-- setEnd(pattern, i) -&gt; the index after the ']' that closes a set whose
-- first character is at i, or nil. As in the matcher, the first character
-- after '[' or '[^' always belongs to the set, so "[]]" and "[^]]" are sets
-- holding ']', and a '%' inside a set escapes the character after it.
local function setEnd(pattern, i)
	local n = #pattern
	if string.sub(pattern, i, i) == "^" then
		i += 1
	end
	repeat
		if i &gt; n then
			return nil
		end
		local c = string.sub(pattern, i, i)
		i += 1
		if c == "%" and i &lt;= n then
			i += 1
		end
	until string.sub(pattern, i, i) == "]"
	return i + 1
end

function Schema.patternError(pattern)
	if type(pattern) ~= "string" then
		return "pattern must be text"
	end
	local n = #pattern
	local i = if string.sub(pattern, 1, 1) == "^" then 2 else 1
	local closed = {} -- closed[k] becomes true when capture k gets its ')'
	local open = {} -- captures still open, innermost last
	while i &lt;= n do
		local c = string.sub(pattern, i, i)
		if c == "(" then
			table.insert(closed, false)
			if #closed &gt; MAX_CAPTURES then
				return "too many captures"
			end
			table.insert(open, #closed)
			i += 1
		elseif c == ")" then
			local index = table.remove(open)
			if index == nil then
				return "invalid pattern capture"
			end
			closed[index] = true
			i += 1
		elseif c == "[" then
			local after = setEnd(pattern, i + 1)
			if after == nil then
				return "missing ']'"
			end
			i = after
		elseif c == "%" then
			if i == n then
				return "ends with '%'"
			end
			local nextChar = string.sub(pattern, i + 1, i + 1)
			if nextChar == "b" then
				if i + 3 &gt; n then
					return "missing arguments to '%b'"
				end
				i += 4
			elseif nextChar == "f" then
				if string.sub(pattern, i + 2, i + 2) ~= "[" then
					return "missing '[' after '%f'"
				end
				local after = setEnd(pattern, i + 3)
				if after == nil then
					return "missing ']'"
				end
				i = after
			elseif string.find(nextChar, "^%d$") then
				if closed[tonumber(nextChar)] ~= true then
					return "invalid capture index %" .. nextChar
				end
				i += 2
			else
				i += 2
			end
		else
			i += 1
		end
	end
	if #open &gt; 0 then
		return "unfinished capture"
	end
	return nil
end

-- ── schema definition check ──────────────────────────────────────────

local function isCount(value)
	return type(value) == "number" and value &gt;= 0 and value % 1 == 0
end

-- The option values validation relies on. A wrong type here would make
-- validation misbehave (a number compared with a string, a boolean
-- concatenated into a message) and a malformed pattern would only fail on
-- the game's value, so the schema is rejected instead.
local function checkOptions(node, path, errors)
	for _, option in ipairs({ "min", "max" }) do
		if node[option] ~= nil and (type(node[option]) ~= "number" or node[option] ~= node[option]) then
			table.insert(errors, ("%s: %s must be a number"):format(path, option))
		end
	end
	for _, option in ipairs({ "minLength", "maxLength", "minItems", "maxItems" }) do
		if node[option] ~= nil and not isCount(node[option]) then
			table.insert(errors, ("%s: %s must be a whole number &gt;= 0"):format(path, option))
		end
	end
	if node.pattern ~= nil then
		if type(node.pattern) ~= "string" then
			table.insert(errors, ("%s: pattern must be text"):format(path))
		else
			local reason = Schema.patternError(node.pattern)
			if reason ~= nil then
				table.insert(errors, ("%s: pattern is not a valid Luau pattern (%s)"):format(path, reason))
			end
		end
	end
	if node.kind == "enum" then
		if type(node.values) ~= "table" or not isArray(node.values) then
			table.insert(errors, ("%s: enum needs a list of text values"):format(path))
		elseif #node.values == 0 then
			table.insert(errors, ("%s: enum needs at least one value"):format(path))
		else
			for _, value in ipairs(node.values) do
				if type(value) ~= "string" then
					table.insert(errors, ("%s: enum values must be text"):format(path))
					break
				end
			end
		end
	end
	if node.check ~= nil then
		local where = if path == "" then "the schema" else path
		if type(node.check) ~= "function" then
			table.insert(errors, ("%s: check must be a function"):format(where))
		elseif type(node.checkDoc) ~= "string" or node.checkDoc == "" then
			table.insert(errors, ("%s: check needs a checkDoc that says its rule"):format(where))
		end
	end
	if node.pinned ~= nil and type(node.pinned) ~= "boolean" then
		table.insert(errors, ("%s: pinned must be true or false"):format(if path == "" then "the schema" else path))
	end
end

-- Validates what the node gives the game when the game leaves it out: its
-- default, with list items and map values filled in from their own
-- defaults, exactly as Config.load merges it. On a group (only reached for
-- an S.optional group, see checkNode) the default is the switch that makes
-- the group present, built by Schema.defaults from its fields' defaults and
-- never from the switch's values: the switch must be `{}`, since values in
-- it would be dropped without a word, and the group it switches on must be
-- valid. In a pcall, because a default the merge cannot copy (a table that
-- contains itself) must become an error in the list, not a throw.
local function checkDefault(node, path, errors)
	local problems = {}
	local ok, err = pcall(function()
		if node.kind == "record" or node.kind == "config" then
			if type(node.default) ~= "table" then
				validateNode(node, node.default, path, problems, {})
			else
				if next(node.default) ~= nil then
					push(problems, path, "an optional group's default only switches it on, its values are not used;"
						.. " give each field its own default and use default = {}")
				end
				validateNode(node, Schema.defaults(node), path, problems, {})
			end
		else
			validateNode(node, Schema.defaults(node), path, problems, {})
		end
	end)
	if not ok then
		table.insert(errors, ("default of %s: cannot be checked (%s)"):format(path, tostring(err)))
		return
	end
	local seen = {}
	for _, problem in ipairs(problems) do
		local line = ("default of %s: %s"):format(problem.path, problem.message)
		if not seen[line] then
			seen[line] = true
			table.insert(errors, line)
		end
	end
end

-- `server` is true under a server-only option: nothing there may carry a
-- default (RT-10). `collection` is true under a list item or a map value:
-- nothing there may be pinned (plan B0), since T.migrate compares a pinned
-- option at one path.
local function checkNode(node, path, errors, topLevel, optional, server, collection)
	if type(node) ~= "table" or type(node.kind) ~= "string" or not KNOWN[node.kind] then
		table.insert(errors, ("%s is not a schema node"):format(path))
		return
	end
	if node.kind == "optional" then
		return checkNode(node.inner, path, errors, topLevel, true, server, collection)
	end
	local kind = node.kind
	local before = #errors
	if node.server == true and not topLevel then
		table.insert(errors, ("%s: server = true is only allowed on top-level options"):format(path))
	end
	if node.pinned == true and collection then
		table.insert(errors, ("%s: pinned is only allowed outside lists and maps"):format(path))
	elseif node.pinned == true and path == "" then
		-- The root has no describe row, so T.migrate would never see the flag.
		table.insert(errors, "the schema: pinned is only allowed on options")
	end
	local serverOnly = server == true or (topLevel and node.server == true)
	checkOptions(node, path, errors)
	if kind == "list" then
		checkNode(node.item, path .. "[]", errors, false, nil, serverOnly, true)
	elseif kind == "map" then
		checkNode(node.value, path .. ".&lt;key&gt;", errors, false, nil, serverOnly, true)
	elseif kind == "record" or kind == "config" then
		if type(node.fields) ~= "table" then
			table.insert(errors, ("%s: needs a table of fields"):format(path))
		else
			for _, name in ipairs(sortedKeys(node.fields)) do
				local field = node.fields[name]
				local fieldPath = childPath(path, name)
				local inner = unwrap(field)
				if type(inner) ~= "table" or type(inner.doc) ~= "string" or inner.doc == "" then
					table.insert(errors, ("%s needs a doc"):format(fieldPath))
				end
				checkNode(field, fieldPath, errors, kind == "config", nil, serverOnly, collection)
			end
		end
	end
	if node.default == nil then
		return
	end
	if serverOnly then
		table.insert(errors, ("%s: a server-only option has no default: the Schema reaches every client, and so would its default. Leave it out (S.optional, or required) and set the value in the server Config module")
			:format(path))
		return
	end
	if (kind == "record" or kind == "config") and not optional then
		-- Schema.defaults builds a group from its fields and reads a group's
		-- default only when the group is S.optional, as the switch that makes
		-- it present. Anywhere else the default has no effect at all.
		table.insert(errors, ("%s: default has no effect on a group that is not optional, give each field its own default")
			:format(path == "" and "the schema" or path))
	elseif #errors == before then
		-- Only on a sound node: a bad option or child is exactly what would
		-- make validating the default throw or report noise.
		checkDefault(node, path, errors)
	end
end

function Schema.check(root)
	if type(root) ~= "table" or root.kind ~= "config" then
		return { "the schema must be S.config({...})" }
	end
	local errors = {}
	checkNode(root, "", errors, false)
	return errors
end

-- ── describe (reference documentation) ───────────────────────────────

local function typeName(node)
	local kind = node.kind
	if kind == "number" then
		local parts = { node.integer and "whole number" or "number" }
		if node.min ~= nil then table.insert(parts, "&gt;= " .. tostring(node.min)) end
		if node.max ~= nil then table.insert(parts, "&lt;= " .. tostring(node.max)) end
		return table.concat(parts, ", ")
	elseif kind == "string" then
		return "text"
	elseif kind == "boolean" then
		return "true/false"
	elseif kind == "enum" then
		return "one of " .. table.concat(node.values or {}, " | ")
	elseif kind == "id" then
		return ID_NAMES[node.idKind] or "an id"
	elseif kind == "dataPath" then
		return "data path (e.g. Stats.Cash)"
	elseif kind == "utcDate" then
		return "UTC date YYYY-MM-DD"
	elseif kind == "color" then
		return "color (Color3)"
	elseif kind == "tree" then
		return "tree (text keys; numbers, text, true/false or nested tables)"
	elseif kind == "record" then
		return "group"
	end
	return kind
end

-- LuaText's number rule: a whole number as %d, else the shortest %.&lt;p&gt;g
-- that reads back exactly (a float32 channel needs up to 17 digits).
local function exactNumber(value)
	if value == math.floor(value) and math.abs(value) &lt; 2 ^ 53 then
		return ("%d"):format(value)
	end
	for precision = 1, 17 do
		local text = ("%." .. precision .. "g"):format(value)
		if tonumber(text) == value then
			return text
		end
	end
	return ("%.17g"):format(value)
end

local function show(value)
	if value == nil then
		return ""
	end
	if typeof(value) == "Color3" then
		-- LuaText's rule (plan B0, planning decision 9): fromRGB only when
		-- every channel is exactly a whole 1/255 step as fromRGB makes it (a
		-- float32), else Color3.new with each channel's exact value.
		local channels, steps = { value.R, value.G, value.B }, {}
		for index, channel in ipairs(channels) do
			local step = math.round(channel * 255)
			if steps ~= nil and step &gt;= 0 and step &lt;= 255 and string.unpack("&lt;f", string.pack("&lt;f", step / 255)) == channel then
				steps[index] = step
			else
				steps = nil
			end
		end
		if steps ~= nil then
			return ("Color3.fromRGB(%d, %d, %d)"):format(steps[1], steps[2], steps[3])
		end
		return ("Color3.new(%s, %s, %s)"):format(exactNumber(channels[1]), exactNumber(channels[2]), exactNumber(channels[3]))
	end
	if type(value) == "string" then
		return ("%q"):format(value)
	end
	if type(value) == "table" then
		local count = 0
		for _ in pairs(value) do
			count += 1
		end
		return count == 0 and "{}" or ("{%d entries}"):format(count)
	end
	return tostring(value)
end

-- The limits a reader needs that `typeName` does not already say: text
-- length and pattern, and list sizes. Worded like the validation messages.
local function plural(count, one, many)
	return ("%d %s"):format(count, count == 1 and one or many)
end

local function constraintsOf(node)
	local out = {}
	if node.kind == "string" then
		if node.minLength == 1 then
			table.insert(out, "not empty")
		elseif node.minLength ~= nil then
			table.insert(out, "at least " .. plural(node.minLength, "character", "characters"))
		end
		if node.maxLength ~= nil then
			table.insert(out, "at most " .. plural(node.maxLength, "character", "characters"))
		end
		if node.pattern ~= nil then
			table.insert(out, "matches " .. tostring(node.patternDoc or node.pattern))
		end
	elseif node.kind == "list" then
		if node.minItems ~= nil then
			table.insert(out, "at least " .. plural(node.minItems, "entry", "entries"))
		end
		if node.maxItems ~= nil then
			table.insert(out, "at most " .. plural(node.maxItems, "entry", "entries"))
		end
	end
	if type(node.checkDoc) == "string" and node.checkDoc ~= "" then
		table.insert(out, node.checkDoc)
	end
	return out
end

-- describe(root) -&gt; rows, one per option, in path order:
--   { path, type, default, doc, server, required,     -- display fields
--     optional, value, example, constraints,          -- for templates and Tools
--     pinned }                                        -- plan B0, for T.migrate
-- `default` is the display text the reference prints. `value` is the
-- default itself, a fresh copy, with the defaults of nested fields filled in
-- (Schema.defaults), nil when there is none. `example` is a copy of the
-- option's `example`. `constraints` lists the limits `type` does not say.
function Schema.describe(root)
	local rows = {}
	-- A list item or a map value is a structural node, not required to carry
	-- its own doc (Schema.check does not demand one there). Its row falls
	-- back to the list/map's own doc; an explicit doc on the item still wins.
	local function walk(node, path, server, parentDoc)
		local optional = node.kind == "optional"
		local n = unwrap(node)
		local isServer = server or n.server == true
		if path ~= "" then
			local doc = n.doc
			if doc == nil or doc == "" then
				doc = parentDoc
			end
			table.insert(rows, {
				path = path,
				type = typeName(n),
				default = show(n.default),
				doc = doc or "",
				server = isServer,
				required = (not optional) and n.default == nil and SCALAR[n.kind] == true,
				optional = optional,
				value = Schema.defaults(node),
				example = copy(n.example),
				constraints = constraintsOf(n),
				pinned = n.pinned == true,
			})
		end
		if n.kind == "record" or n.kind == "config" then
			for _, name in ipairs(sortedKeys(n.fields)) do
				walk(n.fields[name], childPath(path, name), isServer, nil)
			end
		elseif n.kind == "list" then
			walk(n.item, path .. "[]", isServer, n.doc)
		elseif n.kind == "map" then
			walk(n.value, path .. ".&lt;key&gt;", isServer, n.doc)
		end
	end
	walk(root, "", false, nil)
	return rows
end

-- ── freeze ───────────────────────────────────────────────────────────

function Schema.freeze(value)
	if type(value) ~= "table" or table.isfrozen(value) then
		return value
	end
	for _, item in pairs(value) do
		Schema.freeze(item)
	end
	return table.freeze(value)
end

return Schema
</string>
            <int64 name="SourceAssetId">-1</int64>
