              <string name="Name">FontWarmup</string>
              <BinaryString name="AttributesSerialize" />
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source">-- FontWarmup.lua - Kernel 3.2.0: every pack's menus keep all their letters on
-- a first Play.
--
-- On a cold font cache (the first Play of a fresh Studio, a new player) a
-- CanvasGroup that renders before its font has loaded bakes its texture with
-- glyphs missing, and it never re-renders when the font arrives: "10 INGOTS"
-- gone or a black blob, "49" as "9", "X2 CASH" as "CAS". Measured in Studio:
-- a GroupTransparency nudge does not re-render one, nor does anything done
-- while it is hidden or off-screen; its own Visible off for one frame does.
-- General UI Kit 3.2.0 fixed this in its Warmup for its own panels only; the
-- Kernel now does it for every pack's panels and HUD buttons (Codes, Easy
-- Pet, Sound, Time Rewards, Roulette...), with or without the kit:
--   * track(root): MenuSystem hands it every panel and HUD button it adopts
--     or registers, and KernelClient the PlayerGui.RBLXEssentials root. The
--     fonts of families not seen yet are preloaded in a thread of their own
--     (ContentProvider:PreloadAsync on one text object per family, then
--     TextService:GetTextBoundsAsync per family), each batch waited for at
--     most PRELOAD_TIMEOUT seconds: nothing on screen ever waits for it;
--   * panel(panel): the first time the panel is on screen (at once if it
--     is), once the fonts are in (or the cap passed), its shown CanvasGroups
--     are re-rendered after each REFRESH_DELAYS entry (a text size drawn for
--     the first time gets its glyphs a few frames late);
--   * other(root): the same for the shown CanvasGroups under a HUD button
--     or a layer that is not a panel, once the fonts are in;
--   * wait(): yields until the batches started so far are done (each at
--     most PRELOAD_TIMEOUT seconds): General UI Kit's Warmup waits on it
--     before its reveal pass instead of preloading again.
-- refresh never touches a panel or button root's Visible (packs listen to a
-- panel's Visible): a root that is itself a CanvasGroup (the Codes, Rewards
-- and DailyRewards panels are) is re-rendered by a change inside it, an
-- empty, invisible Frame "RBLXE_Redraw" for one frame. Inside, it moves only
-- the CanvasGroups' Visible: a tween
-- driving a CanvasGroup's GroupTransparency, Size or Position keeps running,
-- and a CanvasGroup something else hid or showed during its frame off is
-- left as that change made it. tests/fontwarmup.spec.luau.
local FontWarmup = {}
FontWarmup.__index = FontWarmup

FontWarmup.PRELOAD_TIMEOUT = 8 -- seconds a batch of fonts is waited for at most.
FontWarmup.REFRESH_DELAYS = { 0.5, 1 } -- seconds after a panel is shown (or the fonts are in), then after that.

local function service(name: string): any
	local ok, found = pcall(function()
		return game:GetService(name)
	end)
	return if ok then found else nil
end

local function isText(node: Instance): boolean
	return node:IsA("TextLabel") or node:IsA("TextButton") or node:IsA("TextBox")
end

--- fontTargets(roots, seen?) -&gt; one TextLabel/TextButton/TextBox per font
--- family found at or below `roots` that `seen` (family -&gt; true, updated)
--- does not hold yet: what PreloadAsync needs to load each font once.
function FontWarmup.fontTargets(roots: { Instance }, seen: { [string]: boolean }?): { Instance }
	local list = {}
	seen = seen or {}
	local function consider(node)
		if isText(node) then
			local ok, family = pcall(function()
				return (node :: any).FontFace.Family
			end)
			if ok and type(family) == "string" and not (seen :: any)[family] then
				(seen :: any)[family] = true
				table.insert(list, node)
			end
		end
	end
	for _, root in ipairs(roots) do
		consider(root)
		for _, node in ipairs(root:GetDescendants()) do
			consider(node)
		end
	end
	return list
end

--- canvasGroups(root) -&gt; the CanvasGroups below `root` (never `root` itself).
function FontWarmup.canvasGroups(root: Instance): { Instance }
	local out = {}
	for _, node in ipairs(root:GetDescendants()) do
		if node:IsA("CanvasGroup") then
			table.insert(out, node)
		end
	end
	return out
end

--- refresh(groups, step?) -&gt; how many it put back: each shown CanvasGroup
--- goes off for one step (default: a RenderStepped frame) and on again, so
--- it re-renders its texture; one something else changed meanwhile is left
--- as that change made it.
function FontWarmup.refresh(groups: { Instance }, step: (() -&gt; ())?): number
	local off = {}
	for _, group in ipairs(groups) do
		if group.Parent ~= nil and (group :: any).Visible then
			(group :: any).Visible = false
			table.insert(off, group)
		end
	end
	if #off == 0 then
		return 0
	end
	if step ~= nil then
		step()
	else
		game:GetService("RunService").RenderStepped:Wait()
	end
	local restored = 0
	for _, group in ipairs(off) do
		if (group :: any).Visible == false then
			(group :: any).Visible = true
			restored += 1
		end
	end
	return restored
end

--- whenShown(panel, fn): fn() in a thread of its own once `panel` is
--- shown (at once when it is), then never again for it.
function FontWarmup.whenShown(panel: Instance, fn: () -&gt; ())
	if (panel :: any).Visible then
		task.spawn(fn)
		return
	end
	local connection
	connection = panel:GetPropertyChangedSignal("Visible"):Connect(function()
		if (panel :: any).Visible and connection ~= nil then
			connection:Disconnect()
			connection = nil
			task.spawn(fn)
		end
	end)
end

--- new() -&gt; the client's warm-up (one per session, KernelClient's).
function FontWarmup.new()
	local self = setmetatable({}, FontWarmup)
	self._seen = {}
	self._pending = 0
	self._deadline = 0
	self._panels = setmetatable({}, { __mode = "k" })
	self._others = setmetatable({}, { __mode = "k" })
	return self
end

--- track(root): preloads the fonts of families not seen yet at or below
--- `root`, in a thread of its own. Never yields.
function FontWarmup:track(root: Instance)
	local targets = FontWarmup.fontTargets({ root }, self._seen)
	if #targets == 0 then
		return
	end
	self._pending += 1
	self._deadline = math.max(self._deadline, os.clock() + FontWarmup.PRELOAD_TIMEOUT)
	task.spawn(function()
		local ContentProvider, TextService = service("ContentProvider"), service("TextService")
		if ContentProvider then
			pcall(ContentProvider.PreloadAsync, ContentProvider, targets)
		end
		if TextService then
			for _, target in ipairs(targets) do
				pcall(function()
					local params = Instance.new("GetTextBoundsParams")
					params.Text = "0"
					params.Font = (target :: any).FontFace
					params.Size = 14
					params.Width = 1000
					TextService:GetTextBoundsAsync(params)
				end)
			end
		end
		self._pending -= 1
	end)
end

--- ready() -&gt; whether every batch started so far is done.
function FontWarmup:ready(): boolean
	return self._pending &lt;= 0
end

--- wait() -&gt; whether the fonts are in: yields until every batch started so
--- far is done, or the latest batch's PRELOAD_TIMEOUT passed.
function FontWarmup:wait(): boolean
	while self._pending &gt; 0 and os.clock() &lt; self._deadline do
		task.wait(0.1)
	end
	return self._pending &lt;= 0
end

local function frame()
	game:GetService("RunService").RenderStepped:Wait()
end

-- redrawOnce(root): the shown CanvasGroups inside `root` go off for one
-- frame together; a root that is itself a shown CanvasGroup gets an empty,
-- invisible Frame "RBLXE_Redraw" inside it for that same frame (a change
-- inside re-renders it), never a change to its own properties.
local function redrawOnce(root: Instance)
	local helper = nil
	if root:IsA("CanvasGroup") and (root :: any).Visible then
		helper = Instance.new("Frame")
		helper.Name = "RBLXE_Redraw"
		helper.BackgroundTransparency = 1
		helper.Size = UDim2.new()
		helper.Parent = root
	end
	local stepped = false
	FontWarmup.refresh(FontWarmup.canvasGroups(root), function()
		frame()
		stepped = true
	end)
	if helper ~= nil then
		if not stepped then
			frame()
		end
		helper:Destroy()
	end
end

local function redraw(self, root: Instance)
	self:wait()
	for _, delay in ipairs(FontWarmup.REFRESH_DELAYS) do
		task.wait(delay)
		if root.Parent == nil then
			return
		end
		redrawOnce(root)
	end
end

--- panel(panel): tracks its fonts, then re-renders its CanvasGroups the
--- first time it is on screen (see above). Once per panel.
function FontWarmup:panel(panel: Instance)
	if self._panels[panel] then
		return
	end
	self._panels[panel] = true
	self:track(panel)
	FontWarmup.whenShown(panel, function()
		redraw(self, panel)
	end)
end

--- other(root): tracks its fonts, then re-renders its shown CanvasGroups
--- once the fonts are in (a HUD button, a layer that is not a panel). Once
--- per root.
function FontWarmup:other(root: Instance)
	if self._others[root] then
		return
	end
	self._others[root] = true
	self:track(root)
	if #FontWarmup.canvasGroups(root) == 0 and not root:IsA("CanvasGroup") then
		return
	end
	task.spawn(redraw, self, root)
end

return FontWarmup
</string>
              <int64 name="SourceAssetId">-1</int64>
              <BinaryString name="Tags" />
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="15">
            <Properties>
              <string name="Name">MenuSystem</string>
              <BinaryString name="AttributesSerialize" />
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source">-- Runtime menu system. Replaces v1's install-time MenusGUI merge
-- (GUIManager + ToggleListener + GUIBridge) with runtime registration.
local CollectionService = game:GetService("CollectionService")
local ContentProvider = game:GetService("ContentProvider")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local SFX = require(script.Parent.Parent.SFX)
local buildShell = require(script.Parent.Shell)
local PanelAnimations = require(script.Parent.PanelAnimations)

local TOOLTIP_OFFSET_X = 15
local TOOLTIP_OFFSET_Y = 78
local TOOLTIP_THROTTLE_INTERVAL = 0.016
local ICON_HOVER_SCALE = UDim2.new(1.05, 0, 1.05, 0)
local ICON_DEFAULT_SCALE = UDim2.new(1, 0, 1, 0)
local ICON_HOVER_TWEEN_TIME = 0.1
local ICON_LEAVE_TWEEN_TIME = 0.3
local TOGGLE_COLOR_ON = Color3.fromRGB(85, 255, 0)
local TOGGLE_COLOR_OFF = Color3.fromRGB(255, 50, 50)

-- AdoptPriority is buyer-editable (Studio attribute), so it may arrive as a
-- non-numeric type (e.g. a String) instead of the expected number. Both call
-- sites coerce through this helper rather than trusting the raw attribute -
-- a non-numeric value is treated as priority 0 instead of crashing the
-- table.sort comparator / the &lt;= comparison in _adoptCandidate.
local function readAdoptPriority(inst)
	return tonumber(inst:GetAttribute("AdoptPriority")) or 0
end

-- Deterministic adoption order: highest AdoptPriority first, ties broken by
-- original GetTagged() encounter order (not Luau's unstable table.sort) so a
-- lower-priority duplicate is NEVER reparented during a sweep - it always
-- loses to a higher-priority sibling already processed first, regardless of
-- CollectionService's return order.
local function sortByAdoptPriority(list)
	local decorated = {}
	for i, inst in ipairs(list) do
		decorated[i] = { inst = inst, priority = readAdoptPriority(inst), index = i }
	end
	table.sort(decorated, function(a, b)
		if a.priority ~= b.priority then
			return a.priority &gt; b.priority
		end
		return a.index &lt; b.index
	end)
	local out = {}
	for i, d in ipairs(decorated) do
		out[i] = d.inst
	end
	return out
end

-- Async (task.spawn) image warm-up shared by both panel-acquisition paths:
-- registerPanel's clone (below) and the panel branch of adoption
-- (_adoptCandidate, "parity restoration" fix - adopted panels used to skip
-- this entirely, causing first-open texture pop-in for every StarterGui-
-- shipped panel post-edit-time-GUI-migration). Interactables are NOT
-- preloaded (registerPanel never did for addInteractable's clones either -
-- this only restores parity with registerPanel's own existing behavior, not
-- a new scope).
local function preloadPanelImages(panel)
	task.spawn(function()
		local images = {}
		for _, desc in ipairs(panel:GetDescendants()) do
			if desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
				table.insert(images, desc)
			end
		end
		if #images &gt; 0 then
			ContentProvider:PreloadAsync(images)
		end
	end)
end

local MenuSystem = {}
MenuSystem.__index = MenuSystem

function MenuSystem.new(playerGui, opts)
	local self = setmetatable({}, MenuSystem)
	self._playerGui = playerGui
	-- 3.0: the Kernel's piece runtime (UI/Pieces.lua). When present, every
	-- adoption candidate is offered to it first; nil keeps 2.x behavior.
	self._pieces = opts and opts.pieces or nil
	-- 3.2.0: the client's font warm-up (UI/FontWarmup.lua), KernelClient's.
	-- Every adopted or registered panel and HUD button goes through it, so
	-- each pack's CanvasGroups keep their letters on a first Play. Packs may
	-- wait on it (ui.fonts:wait()); nil in specs and older callers.
	self.fonts = opts and opts.fonts or nil
	self._mouse = Players.LocalPlayer:GetMouse()
	self.gui = buildShell(playerGui)
	self._menus = self.gui.Menus
	self._interactables = self.gui.Interactables.Container
	self._tooltip = self.gui.Tooltip
	self._handlers = {}
	self._panels = {}
	self._panelPriority = {}
	self._panelScrollers = {}
	self._interactableRegistry = {}
	self._interactablePriority = {}
	self._animations = {}
	self._wired = {}
	self._toggled = {}

	for name, fn in pairs(PanelAnimations) do
		self._animations[name] = fn
	end

	for _, desc in ipairs(self.gui:GetDescendants()) do
		self:_wireDescendant(desc)
	end
	self.gui.DescendantAdded:Connect(function(desc)
		self:_wireDescendant(desc)
	end)

	for _, button in ipairs(CollectionService:GetTagged("UI_Toggle")) do
		self:_wireToggle(button)
	end
	CollectionService:GetInstanceAddedSignal("UI_Toggle"):Connect(function(button)
		self:_wireToggle(button)
	end)

	-- Edit-time GUI adoption (StarterGui-shipped panels/interactables). Must
	-- run after the shell + wiring above exist so reparenting into Menus /
	-- Interactables.Container flows through the DescendantAdded wiring path
	-- automatically (no separate wiring code needed for adopted instances).
	-- self:_safeAdopt pcall-wraps each candidate: MenuSystem.new runs BEFORE
	-- Loader.boot in KernelClient, so an uncaught error here would take down
	-- the whole client ecosystem, not just adoption - one bad tag must never
	-- do that.
	for _, inst in ipairs(sortByAdoptPriority(CollectionService:GetTagged("UI_Panel"))) do
		self:_safeAdopt(inst, "Panel")
	end
	CollectionService:GetInstanceAddedSignal("UI_Panel"):Connect(function(inst)
		self:_safeAdopt(inst, "Panel")
	end)

	for _, inst in ipairs(sortByAdoptPriority(CollectionService:GetTagged("UI_Interactable"))) do
		self:_safeAdopt(inst, "Interactable")
	end
	CollectionService:GetInstanceAddedSignal("UI_Interactable"):Connect(function(inst)
		self:_safeAdopt(inst, "Interactable")
	end)

	return self
end

-- ── handlers ─────────────────────────────────────────────────────────

function MenuSystem:registerHandlers(handlers)
	for action, fn in pairs(handlers) do
		self._handlers[action] = fn
	end
end

function MenuSystem:dispatch(action, button)
	local fn = self._handlers[action]
	if fn then
		fn(button)
	else
		warn("[RBLXE UI] No handler registered for action:", action)
	end
end

function MenuSystem:registerAnimation(name, fn)
	self._animations[name] = fn
end

-- ── panels ───────────────────────────────────────────────────────────

function MenuSystem:registerPanel(template)
	local panel = template:Clone()
	panel.Visible = false
	if self.fonts ~= nil then
		self.fonts:track(panel)
	end
	panel.Parent = self._menus
	self._panels[panel.Name] = panel
	if self.fonts ~= nil then
		self.fonts:panel(panel)
	end
	local scrollers = {}
	for _, desc in ipairs(panel:GetDescendants()) do
		if desc:IsA("ScrollingFrame") then
			table.insert(scrollers, desc)
		end
	end
	self._panelScrollers[panel.Name] = scrollers
	preloadPanelImages(panel)
	return panel
end

function MenuSystem:getPanel(name)
	return self._panels[name]
end

--- The HUD button that actually opens `panelName` - the one this system
--- REGISTERED, not merely one that carries the attribute.
---
--- Packs need this to put a notification badge on their own button, and until
--- 2026-08-25 every one of them scanned the shell for the first GuiButton with
--- a matching `TargetPanel`. That is wrong whenever two packs ship a fallback
--- button for the same panel: the loser of the priority contest is hidden but
--- LEFT IN THE CONTAINER when it was adopted before the winner arrived (see
--- `_adoptCandidate`'s "deposed" branch), so the scan could - and did, for
--- Easy Pet System's Pets button - return an invisible button and light a
--- badge nobody could see. Which of the two a scan hits depends on sweep
--- order, so the packs that appeared to work were only lucky.
function MenuSystem:getInteractable(panelName)
	return self._interactableRegistry["TogglePanel:" .. tostring(panelName)]
end

--- A 3.0 interface piece, already resolved by the Kernel: the game's Interface
--- override when it satisfies its contract, otherwise the pack's default.
--- `pieceId` is "&lt;PackId&gt;.&lt;Name&gt;" (packs use ctx.getPiece("&lt;Name&gt;")). Yields
--- up to `timeout` seconds (default 10) for it to reach PlayerGui. A Panel or
--- HudButton piece (tagged UI_Panel / UI_Interactable) is only useful once
--- this menu adopted it; if it did not, the piece is still returned but a
--- warning says why the menu cannot open it, instead of failing silently.
function MenuSystem:getPiece(pieceId, timeout)
	if self._pieces == nil then
		return nil
	end
	local piece = self._pieces:get(pieceId, timeout)
	if piece ~= nil then
		local tag = (CollectionService:HasTag(piece, "UI_Panel") and "UI_Panel")
			or (CollectionService:HasTag(piece, "UI_Interactable") and "UI_Interactable")
			or nil
		-- M-d: the kind in the server's decision marks a menu piece even when
		-- it lacks its tag (a default that fails its contract).
		local kind = if self._pieces.kindOf ~= nil then self._pieces:kindOf(pieceId) else nil
		local menuPiece = tag ~= nil or kind == "Panel" or kind == "HudButton"
		if menuPiece and not self:_holds(piece) then
			-- A piece that has just arrived is adopted from its own tag signal:
			-- give that one frame before warning.
			task.wait()
			if not self:_holds(piece) then
				warn(("[RBLXE] UI: piece %s (%s) was not adopted by the menu; nothing can open it"):format(pieceId, tag or kind))
			end
		end
	end
	return piece
end

--- Kernel 3.2.0: whether the piece has a copy to use. False for a piece the
--- game deleted (the server's plan found no copy), true without the piece
--- runtime or in 2.x legacy mode. Never yields.
function MenuSystem:hasPiece(pieceId)
	if self._pieces == nil or self._pieces.has == nil then
		return true
	end
	return self._pieces:has(pieceId)
end

-- Whether `inst` holds a registry slot (an adopted or registered panel or
-- interactable), by identity.
function MenuSystem:_holds(inst)
	for _, registry in ipairs({ self._panels, self._interactableRegistry }) do
		for _, registered in pairs(registry) do
			if registered == inst then
				return true
			end
		end
	end
	return false
end

function MenuSystem:openPanel(name)
	local menu = self._panels[name]
	if not menu or menu.Visible then return end
	SFX:Play("Press")
	menu.Visible = true
	local animFn = self._animations[menu:GetAttribute("Animation") or "Bounce"]
	if animFn then animFn(menu) end
	for _, sf in ipairs(self._panelScrollers[name] or {}) do
		sf.CanvasPosition = Vector2.zero
	end
	if menu:GetAttribute("Exclusive") ~= false then
		for otherName, otherMenu in pairs(self._panels) do
			if otherName ~= name and otherMenu.Visible and otherMenu:GetAttribute("Exclusive") ~= false then
				otherMenu.Visible = false
			end
		end
	end
end

function MenuSystem:closePanel(name)
	local menu = self._panels[name]
	if menu then menu.Visible = false end
end

function MenuSystem:togglePanel(name)
	local menu = self._panels[name]
	if not menu then return end
	if menu.Visible then
		SFX:Play("Press")
		menu.Visible = false
	else
		self:openPanel(name)
	end
end

function MenuSystem:addInteractable(template)
	local button = template:Clone()
	button.Parent = self._interactables
	return button
end

-- ── adoption (edit-time GUI: StarterGui-shipped panels/interactables) ──

-- interactableKey(inst) -&gt; the identity two packs' HUD buttons are deduped
-- by. A button that toggles a panel IS that panel's button, whatever the
-- instance happens to be called, so the key is the panel it opens.
--
-- It used to be `inst.Name`, which only ever worked by coincidence: General
-- UI Kit and Easy Pet System both shipped a fallback "Shop" button and both
-- happened to name it after the panel. Renaming General UI Kit's buttons to
-- "Shop Button" etc. (2026-08-21) broke that coincidence instantly - the two
-- stopped colliding, both got adopted, and the HUD would have shown two Shop
-- buttons side by side, each opening the same panel. Keying off what the
-- button DOES cannot be broken by a rename.
--
-- Anything that is not a panel toggle (a pack's own custom Action, or a
-- decorative interactable with none) falls back to the name: there is
-- nothing better to compare, and two of those are not obviously duplicates.
local function interactableKey(inst)
	if inst:GetAttribute("Action") == "TogglePanel" then
		local target = inst:GetAttribute("TargetPanel")
		if type(target) == "string" and target ~= "" then
			return "TogglePanel:" .. target
		end
	end
	return inst.Name
end

local ADOPT_KIND = {
	Panel = { tag = "UI_Panel", container = "_menus", registry = "_panels", priorities = "_panelPriority" },
	Interactable = { tag = "UI_Interactable", container = "_interactables", registry = "_interactableRegistry", priorities = "_interactablePriority" },
}

-- Entry point for both the sweep (GetTagged) and late-arrival
-- (GetInstanceAddedSignal) paths. Exposed (not local-only) so specs can
-- drive it directly where there is no natural way to simulate a scenario
-- through the tag-add signal (e.g. reentrancy guard).
function MenuSystem:_adoptCandidate(inst, kind)
	local cfg = ADOPT_KIND[kind]
	if not cfg then return end
	-- A UI_Panel/UI_Interactable tag on a non-GuiObject (Folder, ScreenGui,
	-- UIStroke, ...) is not a valid candidate - bail before touching any
	-- GuiObject-only property (Visible, below) that would error on it.
	if not inst:IsA("GuiObject") then return end
	-- Only adopt from the local player's own PlayerGui tree, and never
	-- re-adopt something already living inside our own shell (avoids
	-- re-registration loops for anything CollectionService reports again).
	if not inst:IsDescendantOf(self._playerGui) or inst:IsDescendantOf(self.gui) then
		return
	end

	-- 3.0 pieces: a copy the Kernel did not choose (the default behind a valid
	-- Interface override, or the reverse, or a clone a pack made) is never
	-- adopted. Instances without RBLXE_Piece are always admitted, so 2.x GUIs
	-- keep the priority path below.
	if self._pieces ~= nil and not self._pieces:admit(inst) then
		return
	end

	local registry = self[cfg.registry]
	local priorities = self[cfg.priorities]
	local name = (kind == "Panel" and inst:GetAttribute("PanelId")) or interactableKey(inst)
	local priority = readAdoptPriority(inst)
	local existingPriority = priorities[name]
	local incumbent = registry[name]
	local chosen = self._pieces ~= nil and self._pieces:chose(inst)

	if chosen then
		-- The Kernel already decided this piece: it takes the slot whatever
		-- the AdoptPriority of a 2.x copy, which is deposed (hidden) instead.
		-- Two chosen pieces on one key is a declaration conflict: the first
		-- keeps the slot and both are named.
		local pieceId = inst:GetAttribute("RBLXE_Piece")
		if incumbent ~= nil and incumbent ~= inst and self._pieces:chose(incumbent) then
			inst.Visible = false
			warn(("[RBLXE] UI: pieces %s and %s both use %s '%s'; %s keeps it, %s is left unadopted")
				:format(tostring(incumbent:GetAttribute("RBLXE_Piece")), tostring(pieceId), cfg.tag, tostring(name),
					tostring(incumbent:GetAttribute("RBLXE_Piece")), tostring(pieceId)))
			return
		end
		if incumbent ~= nil and incumbent ~= inst then
			warn(("[RBLXE] UI: %s '%s' %s deposed by the 3.0 piece %s")
				:format(cfg.tag, tostring(name), incumbent:GetFullName(), tostring(pieceId)))
		end
		priority = math.huge
	elseif incumbent ~= nil and self._pieces ~= nil and self._pieces:chose(incumbent) then
		-- A 2.x copy arriving after the piece: the slot stays with the piece.
		inst.Visible = false
		warn(("[RBLXE] UI: %s '%s' %s left unadopted: the slot belongs to the 3.0 piece %s")
			:format(cfg.tag, tostring(name), inst:GetFullName(), tostring(incumbent:GetAttribute("RBLXE_Piece"))))
		return
	elseif existingPriority ~= nil and priority &lt;= existingPriority then
		-- Loses to the incumbent (strictly lower, or a tie): left in place,
		-- unadopted, hidden so a dangling duplicate is never visible/clickable.
		inst.Visible = false
		if incumbent ~= nil and incumbent.Parent == nil then
			warn(("[RBLXE] duplicate %s '%s' left unadopted (priority): the incumbent was destroyed"):format(cfg.tag, name))
		else
			warn(("[RBLXE] duplicate %s '%s' left unadopted (priority)"):format(cfg.tag, name))
		end
		return
	end

	-- A higher-priority late arrival swaps the registration: the previously
	-- registered instance (if any) is deposed - hide it so it doesn't stay
	-- visible/reachable (an open panel, or a still-clickable interactable)
	-- after losing its registry slot, symmetric with the sweep-loser path.
	local previous = registry[name]
	if previous and previous ~= inst then
		previous.Visible = false
	end

	-- 3.2.0: its fonts start loading before anything sees it in the shell
	-- (a pack listening to Menus.ChildAdded may wait on ui.fonts).
	if self.fonts ~= nil then
		self.fonts:track(inst)
	end
	inst.Parent = self[cfg.container]
	if kind == "Panel" then
		inst.Visible = false -- panels default closed; interactables stay visible
	end
	registry[name] = inst
	priorities[name] = priority
	if self.fonts ~= nil then
		if kind == "Panel" then
			self.fonts:panel(inst)
		else
			self.fonts:other(inst)
		end
	end

	if kind == "Panel" then
		local scrollers = {}
		for _, desc in ipairs(inst:GetDescendants()) do
			if desc:IsA("ScrollingFrame") then
				table.insert(scrollers, desc)
			end
		end
		self._panelScrollers[name] = scrollers
		-- Parity restoration (M3 review fix): registerPanel always warmed up
		-- its clone's images; adopted panels must get the identical treatment
		-- - otherwise every StarterGui-shipped panel (GUK's 13, EPS's own)
		-- loses this warm-up entirely post edit-time-GUI-migration, causing
		-- first-open texture pop-in that registerPanel-based panels never had.
		preloadPanelImages(inst)
	end
end

-- Safety net around _adoptCandidate: MenuSystem.new runs before Loader.boot,
-- so any uncaught error here would kill client boot entirely. A malformed
-- candidate (or anything else unexpected) is logged and skipped instead.
function MenuSystem:_safeAdopt(inst, kind)
	local ok, err = pcall(self._adoptCandidate, self, inst, kind)
	if not ok then
		warn(("[RBLXE] adoption failed for '%s': %s"):format(inst.Name, tostring(err)))
	end
end

function MenuSystem:_findAncestorPanel(instance)
	local current = instance.Parent
	while current and current ~= self.gui do
		-- Identity lookup, not a Name-keyed probe: adopted panels register
		-- under their PanelId attribute, which may differ from the
		-- instance's own Name - self._panels[current.Name] would miss those.
		for _, panel in pairs(self._panels) do
			if panel == current then
				return current
			end
		end
		current = current.Parent
	end
	return nil
end

-- Action routing. Real clicks call this from _wireButton; tests call it
-- directly because Activated cannot be fired programmatically.
function MenuSystem:_onButtonActivated(button)
	local action = button:GetAttribute("Action")
	if not action or action == "" then return end
	if action == "TogglePanel" then
		self:togglePanel(button:GetAttribute("TargetPanel") or "")
	elseif action == "ClosePanel" then
		local target = button:GetAttribute("TargetPanel") or ""
		if target ~= "" then
			self:closePanel(target)
		else
			local ancestor = self:_findAncestorPanel(button)
			if ancestor then ancestor.Visible = false end
		end
	else
		self:dispatch(action, button)
	end
end

-- ── wiring (Task 8 fills these in) ───────────────────────────────────

function MenuSystem:_wireDescendant(desc)
	if desc:IsA("GuiButton") then
		self:_wireButton(desc)
	elseif desc:IsA("GuiObject") then
		self:_wireDecoration(desc)
	end
end

function MenuSystem:_wireButton(button)
	if self._wired[button] then return end
	self._wired[button] = true
	if CollectionService:HasTag(button, "UI_Toggle") then return end
	-- A blocker is a GuiButton only so that it SINKS input - the invisible
	-- full-screen sheet a modal panel puts behind itself so clicks never
	-- reach what it covers. It is not something the player presses, so it
	-- gets no press sound, no hover sound, no icon tween and no tooltip.
	-- Reported by the user against Roulette System's Spin: "cada vez que
	-- clico el fondo del menu Spin suena el SFX de click". Declared with a
	-- tag rather than inferred: 100 GuiButtons across the shipped v2 assets
	-- carry neither a tag nor an Action (Teleport zones, Claim buttons,
	-- Equip/Merge/Delete, the music player's Next/Mute - all wired by pack
	-- code and all of them SHOULD click), so there is no property of a
	-- blocker to detect. It still sinks input exactly as before: absorbing
	-- clicks is what a GuiButton does, not something this wiring conferred.
	if CollectionService:HasTag(button, "UI_Blocker") then return end

	button.Activated:Connect(function()
		SFX:Play(button:GetAttribute("BuySound") and "Buy_1" or "Press")
		self:_onButtonActivated(button)
	end)

	local icon = button:FindFirstChild("Icon")
	button.MouseEnter:Connect(function()
		SFX:Play("Hover")
		if icon then
			icon:TweenSize(ICON_HOVER_SCALE, Enum.EasingDirection.Out, Enum.EasingStyle.Quint, ICON_HOVER_TWEEN_TIME, true)
		end
		if button:GetAttribute("ShowTooltip") then
			self._tooltip.Visible = true
			self._tooltip.ButtonName.Text = button:GetAttribute("TooltipText") or button.Name
		end
	end)
	local lastTooltipMove = 0
	button.MouseMoved:Connect(function()
		if button:GetAttribute("ShowTooltip") then
			local now = tick()
			if now - lastTooltipMove &lt; TOOLTIP_THROTTLE_INTERVAL then return end
			lastTooltipMove = now
			self._tooltip.Position = UDim2.fromOffset(
				self._mouse.X + TOOLTIP_OFFSET_X, self._mouse.Y + TOOLTIP_OFFSET_Y)
		end
	end)
	button.MouseLeave:Connect(function()
		if icon then
			icon:TweenSize(ICON_DEFAULT_SCALE, Enum.EasingDirection.Out, Enum.EasingStyle.Quint, ICON_LEAVE_TWEEN_TIME, true)
		end
		if button:GetAttribute("ShowTooltip") then
			self._tooltip.Visible = false
		end
	end)
end

function MenuSystem:_wireDecoration(element)
	if self._wired[element] then return end
	local animation = element:GetAttribute("Animation")
	if not animation then return end
	if element.Parent == self._menus then return end -- panels use Animation for their open-anim
	self._wired[element] = true
	if animation == "Rotate" then
		local speed = element:GetAttribute("Speed") or 15
		TweenService:Create(element,
			TweenInfo.new(speed, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1),
			{ Rotation = 360 }):Play()
	elseif animation == "HoverBob" then
		local basePos = element.Position
		element.MouseEnter:Connect(function()
			element:TweenPosition(basePos - UDim2.fromScale(0, 0.03),
				Enum.EasingDirection.Out, Enum.EasingStyle.Quint, 0.2, true)
		end)
		element.MouseLeave:Connect(function()
			element:TweenPosition(basePos,
				Enum.EasingDirection.Out, Enum.EasingStyle.Quint, 0.2, true)
		end)
	end
end

function MenuSystem:_wireToggle(button)
	if not button:IsA("GuiButton") then return end
	if not button:IsDescendantOf(self._playerGui) then return end -- ignore RS/asset templates
	if self._toggled[button] then return end
	local state = { isEnabled = true }
	self._toggled[button] = state
	local function setVisual()
		button.BackgroundColor3 = state.isEnabled and TOGGLE_COLOR_ON or TOGGLE_COLOR_OFF
		local status = button:FindFirstChild("Status")
		if status then status.Text = state.isEnabled and "ON" or "OFF" end
	end
	setVisual()
	button.MouseButton1Click:Connect(function()
		state.isEnabled = not state.isEnabled
		setVisual()
		local action = button:GetAttribute("Action")
		if action then self:dispatch(action, button) end
	end)
end

return MenuSystem
</string>
              <int64 name="SourceAssetId">-1</int64>
              <BinaryString name="Tags" />
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="16">
            <Properties>
              <string name="Name">PanelAnimations</string>
              <BinaryString name="AttributesSerialize" />
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source">-- PanelAnimations loader
-- Each child ModuleScript is an animation: its name maps to the Animation
-- attribute on UI_Panel, and it must return function(menu: GuiObject).
local Animations = {}

for _, child in ipairs(script:GetChildren()) do
	if child:IsA("ModuleScript") then
		local ok, fn = pcall(require, child)
		if ok and type(fn) == "function" then
			Animations[child.Name] = fn
		end
	end
end

return Animations
</string>
              <int64 name="SourceAssetId">-1</int64>
              <BinaryString name="Tags" />
            </Properties>
            <Item class="ModuleScript" referent="17">
              <Properties>
                <string name="Name">Bounce</string>
                <BinaryString name="AttributesSerialize" />
                <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
                <ContentId name="LinkedSource">
                  <null>
                  </null>
                </ContentId>
                <bool name="DefinesCapabilities">false</bool>
                <BinaryString name="SerializedOverrides">
                </BinaryString>
                <string name="Source">-- Bounce animation: drops from slightly above with Back easing and a small random rotation.
--
-- Works on ANY GuiObject. It used to bail out on anything that was not a
-- CanvasGroup - a guard with nothing behind it, since the animation only ever
-- touches Position and Rotation and never GroupTransparency. Two of General
-- UI Kit's thirteen shipped panels are plain Frames (TradeRequest, Spin), and
-- both ask for Bounce, so both opened with a hard cut and no animation at all
-- while every CanvasGroup panel bounced. Found 2026-08-21 via the plugin's
-- new MENUS Preview button; the guard is removed rather than the panels
-- converted, because a CanvasGroup rasterizes its descendants into a canvas
-- its own size and both panels have content that deliberately overhangs
-- (TradeRequest's Icon at x=-0.07/y=-0.22, Spin's CoinsEffect spawn line at
-- y=-0.1) - converting them would have cropped it.
local TweenService = game:GetService("TweenService")

local DURATION   = 0.5
local OFFSET_Y   = 0.02  -- how far above the resting position the panel starts

return function(menu: GuiObject)
	local origPos = menu.Position
	menu.Position = UDim2.new(origPos.X.Scale, origPos.X.Offset, origPos.Y.Scale - OFFSET_Y, origPos.Y.Offset)
	menu.Rotation = math.random(2) == 1 and 1 or -1

	menu:TweenPosition(
		origPos,
		Enum.EasingDirection.Out, Enum.EasingStyle.Back, DURATION, true
	)
	TweenService:Create(
		menu,
		TweenInfo.new(DURATION, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ Rotation = 0 }
	):Play()
end
</string>
                <int64 name="SourceAssetId">-1</int64>
                <BinaryString name="Tags" />
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="18">
            <Properties>
              <string name="Name">Pieces</string>
              <BinaryString name="AttributesSerialize" />
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source">-- Pieces.lua - interface pieces (RBLX Essentials 3.0).
--
-- A pack declares the pieces of interface it drives in `Packs/&lt;PackId&gt;/Pieces`
-- (see Contracts.lua). Each piece has one DEFAULT copy, shipped by the pack
-- under StarterGui.RBLXEssentials.&lt;PackId&gt;, and may have one OVERRIDE, owned
-- by the game, under StarterGui.RBLXEssentials.Interface (a theme's piece or
-- a fork). Piece roots carry RBLXE_Piece = "&lt;PackId&gt;.&lt;Name&gt;".
--
-- The server decides once, at boot (`plan`), which copy each piece uses: a
-- valid override, else the default. Each decision is published as the
-- relative path of the chosen instance under the RBLXEssentials root (for
-- example "Interface/ThemeGui/Panel" or "Demo/DemoGui/Panel"), together with
-- the path of every other candidate copy the server saw for that id (the
-- refused ones), reaching every client in the RBLXE_PieceWinners attribute
-- (`encodeDecisions`/`decodeDecisions`). The client (`runtime`) admits only
-- the first instance of a piece whose own path under its nearest
-- RBLXEssentials ancestor matches the winner, and retires the copies that
-- arrive at a refused path or as a second copy at the winner path, so no pack
-- ever holds a copy that is later replaced (the 434 failure). Any other
-- instance carrying RBLXE_Piece (a clone a pack makes at runtime: a toast, a
-- billboard per adornee, a registerPanel copy) is not admitted but is left
-- alone: clones belong to the pack that made them.
--
-- The server makes StarterGui.RBLXEssentials survive character respawns
-- before `plan` runs (UI/RootPersistence.lua), so a piece admitted here
-- stays the same instance for the whole session.
--
-- Pure: every Instance, require function and scheduler comes in as an argument.
local Pieces = {}

Pieces.PIECE_ATTRIBUTE = "RBLXE_Piece"
Pieces.SOURCE_ATTRIBUTE = "RBLXE_Source"
Pieces.WINNERS_ATTRIBUTE = "RBLXE_PieceWinners"
Pieces.LEGACY = "legacy"
Pieces.INTERFACE = "Interface"
Pieces.ROOT = "RBLXEssentials"
-- StarterGui.RBLXEssentials.Interface.Custom holds what the 2.1 to 3.0
-- migration kept without managing it (T.migrate: retired panels and
-- buttons). Nothing there is a candidate for any piece, here or in Tools.
Pieces.CUSTOM = "Custom"
-- How long getPiece waits for PlayerGui.RBLXEssentials (it arrives with the
-- first character) before its own timeout starts counting (RT-4).
Pieces.ROOT_WAIT = 120

local function pieceIdOf(inst)
	local id = inst:GetAttribute(Pieces.PIECE_ATTRIBUTE)
	if type(id) == "string" and id ~= "" then
		return id
	end
	return nil
end

local function sortedKeys(t)
	local keys = {}
	for key in pairs(t) do
		table.insert(keys, key)
	end
	table.sort(keys)
	return keys
end

-- ── declarations ─────────────────────────────────────────────────────

-- collectDeclarations(...) -&gt; (declarations, warnings, failures). `failures`
-- maps the id of a pack whose Pieces module errors or is invalid to the
-- reason its boot fails with (RT-6): its pieces can never be resolved, so
-- the Loader fails it instead of letting it drive an interface nobody sees.
function Pieces.collectDeclarations(packsFolder, requireFn, contracts)
	local declarations, warnings, failures = {}, {}, {}
	for _, packFolder in ipairs(packsFolder:GetChildren()) do
		local module = packFolder:FindFirstChild("Pieces")
		if module ~= nil and module:IsA("ModuleScript") then
			local ok, specs = pcall(requireFn, module)
			if not ok then
				local message = ("%s.Pieces errored: %s"):format(packFolder.Name, tostring(specs))
				table.insert(warnings, message)
				failures[packFolder.Name] = "invalid Pieces: " .. message
			else
				local errors = contracts.validateSpecs(packFolder.Name, specs)
				if #errors &gt; 0 then
					for _, message in ipairs(errors) do
						table.insert(warnings, message)
					end
					failures[packFolder.Name] = "invalid Pieces:\n    " .. table.concat(errors, "\n    ")
				else
					declarations[packFolder.Name] = specs
				end
			end
		end
	end
	table.sort(warnings)
	return declarations, warnings, failures
end

-- ── server plan ──────────────────────────────────────────────────────

-- byId keeps the first copy of each id (sorted by full name); all keeps
-- every copy, so the plan can publish the paths of the ones it refuses.
local function index(list, origin, warnings, all)
	table.sort(list, function(a, b)
		return a:GetFullName() &lt; b:GetFullName()
	end)
	local byId = {}
	for _, inst in ipairs(list) do
		local id = pieceIdOf(inst)
		all[id] = all[id] or {}
		table.insert(all[id], inst)
		if byId[id] ~= nil then
			table.insert(warnings, ("%s: more than one %s piece; using %s"):format(id, origin, byId[id]:GetFullName()))
		else
			byId[id] = inst
		end
	end
	return byId
end

-- The attribute that ties each piece kind to MenuSystem: a Panel is
-- registered under its PanelId, a HudButton opens its TargetPanel. An
-- Interface override must keep the default copy's value, or the button that
-- opens the panel (and every pack that asks for it) would miss it.
local IDENTITY = { Panel = "PanelId", HudButton = "TargetPanel" }

local function nonEmptyText(value)
	if type(value) == "string" and value ~= "" then
		return value
	end
	return nil
end

local function quoted(value)
	if type(value) == "string" then
		return ("%q"):format(value)
	end
	return tostring(value)
end

-- The path of `inst` under `root`, as the names of every node strictly
-- between them, joined by "/" (for example "Interface/ThemeGui/Panel").
local function relativePath(inst, root)
	local segments = {}
	local node = inst
	while node ~= nil and node ~= root do
		table.insert(segments, 1, node.Name)
		node = node.Parent
	end
	return table.concat(segments, "/")
end

-- winners maps each declared piece id to the relative path of the instance
-- chosen to satisfy it; a piece with nothing valid to use has no entry.
-- refused maps every id seen under the root, declared or not, to the paths
-- of its other copies (the default behind a valid override, a rejected
-- override, duplicates, copies of an id no pack declares): the client
-- retires exactly those, and nothing else.
function Pieces.plan(args)
	local contracts = args.contracts
	local root = args.root
	local interface = root and root:FindFirstChild(Pieces.INTERFACE)
	local custom = interface and interface:FindFirstChild(Pieces.CUSTOM)
	local defaultList, overrideList = {}, {}
	if root ~= nil then
		for _, inst in ipairs(root:GetDescendants()) do
			if pieceIdOf(inst) ~= nil and not (custom ~= nil and inst:IsDescendantOf(custom)) then
				if interface ~= nil and inst:IsDescendantOf(interface) then
					table.insert(overrideList, inst)
				else
					table.insert(defaultList, inst)
				end
			end
		end
	end

	local warnings, copies = {}, {}
	local defaults = index(defaultList, "default", warnings, copies)
	local overrides = index(overrideList, "Interface", warnings, copies)
	local declared, order, chosen, fromInterface, kinds = {}, {}, {}, {}, {}
	local detail = {}

	-- Stand-ins (Kernel 3.0.1): a piece with standsInFor = "&lt;PackId&gt;.&lt;Name&gt;"
	-- steps aside when that owner piece is declared. It gets no candidate at
	-- all, so its default and every Interface copy land in `refused` below.
	-- An owner of another kind keeps its piece and the stand-in is refused
	-- with a warning. A HudButton that opens a replaced panel is replaced
	-- with it ("a stand-in's opens follows its panel").
	local replaced = {}
	for _, packId in ipairs(sortedKeys(args.declarations)) do
		local specs = args.declarations[packId]
		for _, name in ipairs(sortedKeys(specs)) do
			local spec = specs[name]
			local ownerId = spec.standsInFor
			if type(ownerId) == "string" then
				local ownerPack, ownerName = contracts.splitId(ownerId)
				local ownerSpecs = ownerPack ~= nil and ownerPack ~= packId and args.declarations[ownerPack] or nil
				local owner = ownerSpecs ~= nil and ownerSpecs[ownerName] or nil
				if type(owner) == "table" then
					local id = packId .. "." .. name
					replaced[id] = true
					if owner.kind == spec.kind then
						table.insert(detail, ("%s stands in for %s: replaced (owner installed)"):format(id, ownerId))
					else
						table.insert(warnings, ("%s stands in for %s, a %s: a %s cannot stand in for it, refused")
							:format(id, ownerId, tostring(owner.kind), tostring(spec.kind)))
					end
				end
			end
		end
	end
	local followed = true
	while followed do
		followed = false
		for _, packId in ipairs(sortedKeys(args.declarations)) do
			local specs = args.declarations[packId]
			for _, name in ipairs(sortedKeys(specs)) do
				local id = packId .. "." .. name
				local opens = specs[name].opens
				if not replaced[id] and type(opens) == "string" and replaced[packId .. "." .. opens] then
					replaced[id] = true
					followed = true
					table.insert(detail, ("%s opens %s.%s: refused with its panel"):format(id, packId, opens))
				end
			end
		end
	end

	-- Pass 1: each piece's contract, and an override's identity (PanelId or
	-- TargetPanel) against its default.
	for _, packId in ipairs(sortedKeys(args.declarations)) do
		local specs = args.declarations[packId]
		for _, name in ipairs(sortedKeys(specs)) do
			local spec = specs[name]
			local id = packId .. "." .. name
			declared[id] = { packId = packId, spec = spec }
			if replaced[id] then
				continue
			end
			kinds[id] = spec.kind
			table.insert(order, id)
			local default = defaults[id]
			if default ~= nil then
				local problems = contracts.check(default, spec)
				if #problems &gt; 0 then
					table.insert(warnings, ("%s: default piece does not satisfy its contract: %s"):format(id, contracts.formatProblems(problems)))
				end
			end
			chosen[id] = default
			local override = overrides[id]
			if override ~= nil then
				local reason = nil
				local problems = contracts.check(override, spec)
				if #problems &gt; 0 then
					reason = contracts.formatProblems(problems)
				else
					local attribute = IDENTITY[spec.kind]
					local want = attribute ~= nil and default ~= nil and nonEmptyText(default:GetAttribute(attribute)) or nil
					local got = attribute ~= nil and override:GetAttribute(attribute) or nil
					if want ~= nil and got ~= want then
						reason = ("%s is %s, the default's is %s"):format(attribute, quoted(got), quoted(want))
					end
				end
				if reason == nil then
					chosen[id] = override
					fromInterface[id] = true
				else
					table.insert(warnings, ("%s: Interface piece rejected, using the default: %s"):format(id, reason))
				end
			end
		end
	end

	-- Pass 2: `opens`. The chosen HudButton must target the PanelId of the
	-- chosen copy of the panel it opens, or it would open nothing.
	for _, id in ipairs(order) do
		local entry = declared[id]
		local opens = entry.spec.opens
		local panel = opens ~= nil and chosen[entry.packId .. "." .. opens] or nil
		if panel ~= nil and chosen[id] ~= nil then
			local panelId = panel:GetAttribute("PanelId")
			local function mismatch(button)
				local target = button:GetAttribute("TargetPanel")
				if target ~= panelId then
					return ("TargetPanel is %s but %s.%s has PanelId %s"):format(quoted(target), entry.packId, opens, quoted(panelId))
				end
				return nil
			end
			local reason = mismatch(chosen[id])
			if reason ~= nil and fromInterface[id] then
				table.insert(warnings, ("%s: Interface piece rejected, using the default: %s"):format(id, reason))
				fromInterface[id] = nil
				chosen[id] = defaults[id]
				reason = chosen[id] ~= nil and mismatch(chosen[id]) or nil
			end
			if reason ~= nil then
				table.insert(warnings, ("%s: default piece does not satisfy its contract: %s"):format(id, reason))
			end
		end
	end

	-- Kernel 3.2.0: a declared piece with no copy at all (no default, no
	-- Interface copy; a stand-in replaced by its owner is not in `order`)
	-- is the game's choice: it deleted the piece. It is `removed`, printed
	-- in one line and never warned; the client answers getPiece for it at
	-- once. A copy that exists but cannot be used still warns.
	local winners, refused, removed, removedIds = {}, {}, {}, {}
	local total, interfaceCount = #order, 0
	for _, id in ipairs(order) do
		local inst = chosen[id]
		if inst == nil and copies[id] == nil then
			removed[id] = true
			table.insert(removedIds, id)
		elseif inst == nil then
			table.insert(warnings, ("%s: no piece available (no valid Interface piece and no default)"):format(id))
		else
			winners[id] = relativePath(inst, root)
			if fromInterface[id] then
				interfaceCount += 1
				table.insert(detail, ("%s &lt;- Interface (%s)"):format(id, tostring(inst:GetAttribute(Pieces.SOURCE_ATTRIBUTE) or "custom")))
			end
		end
	end
	for _, id in ipairs(sortedKeys(copies)) do
		local seen = {}
		for _, inst in ipairs(copies[id]) do
			local path = relativePath(inst, root)
			if inst ~= chosen[id] and path ~= winners[id] and not seen[path] then
				seen[path] = true
				refused[id] = refused[id] or {}
				table.insert(refused[id], path)
			end
		end
		if refused[id] ~= nil then
			table.sort(refused[id])
		end
	end
	for _, id in ipairs(sortedKeys(overrides)) do
		if declared[id] == nil then
			table.insert(warnings, ("%s: Interface piece ignored, no installed pack declares it (%s)"):format(id, overrides[id]:GetFullName()))
		end
	end
	table.sort(warnings)

	local lines = {}
	if total &gt; 0 then
		local removedCount = #removedIds
		table.insert(lines, ("%d pieces: %d from Interface, %d default%s"):format(total, interfaceCount, total - interfaceCount - removedCount,
			if removedCount &gt; 0 then (", %d removed"):format(removedCount) else ""))
		for _, line in ipairs(detail) do
			table.insert(lines, line)
		end
		if removedCount &gt; 0 then
			table.sort(removedIds)
			table.insert(lines, "removed by the game: " .. table.concat(removedIds, ", "))
		end
	end
	-- 3.2.0: the stand-ins an installed owner replaced travel to clients, so
	-- a client says so in one line instead of warning once per copy.
	local standIns = {}
	for id in pairs(replaced) do
		standIns[id] = true
	end
	return { winners = winners, refused = refused, removed = removed, kinds = kinds, standIns = standIns, lines = lines, warnings = warnings }
end

-- The RBLXE_PieceWinners value: the plan's winners and refused paths as JSON.
-- `jsonEncode` is HttpService:JSONEncode in the Kernel; the server calls this
-- inside the same pcall as the plan, so a value JSON cannot encode (an
-- instance name that is not valid UTF-8, for example) falls back to LEGACY
-- instead of stopping the server script.
function Pieces.encodeDecisions(plan, jsonEncode)
	-- `removed` travels as a sorted list (an empty map would encode as []).
	local removed = sortedKeys(plan.removed or {})
	-- 3.2.0: `standIns` likewise (the stand-ins their owner replaced).
	local standIns = sortedKeys(plan.standIns or {})
	return jsonEncode({ winners = plan.winners, refused = plan.refused or {}, kinds = plan.kinds or {}, removed = removed, standIns = standIns })
end

-- The client side of encodeDecisions. Returns { winners, refused }, or nil
-- when the server sent no usable decision (missing, LEGACY, not JSON, or not
-- the { winners, refused } shape): every piece is then adopted as in 2.x.
-- An empty winners map encodes as "[]" and decodes to an empty table.
function Pieces.decodeDecisions(encoded, jsonDecode)
	if type(encoded) ~= "string" or encoded == Pieces.LEGACY then
		return nil
	end
	local ok, decoded = pcall(jsonDecode, encoded)
	if not ok or type(decoded) ~= "table" or type(decoded.winners) ~= "table" then
		return nil
	end
	local refused = decoded.refused
	if type(refused) ~= "table" then
		refused = {}
	end
	local kinds = decoded.kinds
	if type(kinds) ~= "table" then
		kinds = {}
	end
	-- Kernel 3.2.0: the ids the game deleted (an older server sends none).
	local removed = {}
	if type(decoded.removed) == "table" then
		for _, id in ipairs(decoded.removed) do
			if type(id) == "string" then
				removed[id] = true
			end
		end
	end
	-- 3.2.0: the stand-ins their owner replaced (an older server sends none).
	local standIns = {}
	if type(decoded.standIns) == "table" then
		for _, id in ipairs(decoded.standIns) do
			if type(id) == "string" then
				standIns[id] = true
			end
		end
	end
	return { winners = decoded.winners, refused = refused, kinds = kinds, removed = removed, standIns = standIns }
end

-- strays(starterGui, root) -&gt; warnings (M-c): every RBLXE_Piece instance in
-- StarterGui outside StarterGui.RBLXEssentials. Nothing resolves or retires
-- it, so it shows on every client as it is. The server says so once at boot
-- (Kernel.server.lua) and T.validate says it in Studio. A clone a pack makes
-- at runtime never reaches StarterGui, so it never warns.
function Pieces.strays(starterGui, root)
	local warnings = {}
	if starterGui == nil then
		return warnings
	end
	for _, inst in ipairs(starterGui:GetDescendants()) do
		local id = pieceIdOf(inst)
		if id ~= nil and not (root ~= nil and (inst == root or inst:IsDescendantOf(root))) then
			table.insert(warnings, ("%s: %s is outside StarterGui.%s: the Kernel never uses it, and it shows on screen as it is")
				:format(id, inst:GetFullName(), Pieces.ROOT))
		end
	end
	table.sort(warnings)
	return warnings
end

-- ── client runtime ───────────────────────────────────────────────────

function Pieces.originOf(inst)
	local node = inst.Parent
	while node ~= nil do
		if node.Name == Pieces.INTERFACE and node.Parent ~= nil and node.Parent.Name == Pieces.ROOT then
			return "Interface"
		end
		node = node.Parent
	end
	return "Default"
end

-- The path of `inst` under its nearest ancestor named Pieces.ROOT
-- ("RBLXEssentials"), matching what the server published in `plan`'s
-- winners. Nil when `inst` has no such ancestor at all.
local function pathUnderRoot(inst)
	local segments = {}
	local node = inst
	while node ~= nil do
		local parent = node.Parent
		if parent == nil then
			return nil
		end
		table.insert(segments, 1, node.Name)
		if parent.Name == Pieces.ROOT then
			return table.concat(segments, "/")
		end
		node = parent
	end
	return nil
end

local Runtime = {}
Runtime.__index = Runtime

-- decisions is what decodeDecisions returns (or a plan result): winners maps
-- a piece id to the relative path (relativePath/pathUnderRoot) of the
-- instance chosen to satisfy it, refused maps an id to the paths of the
-- copies the server refused. decisions == nil means the server sent no
-- decision at all: 2.x adoption for every piece.
function Pieces.runtime(decisions, opts)
	opts = opts or {}
	local self = setmetatable({}, Runtime)
	self._winners = decisions and decisions.winners or nil
	self._refused = {}
	for id, paths in pairs(decisions and decisions.refused or {}) do
		if type(paths) == "table" then
			local set = {}
			for _, path in ipairs(paths) do
				set[path] = true
			end
			self._refused[id] = set
		end
	end
	self._admitted = {}
	self._decided = setmetatable({}, { __mode = "k" })
	self._kinds = decisions and decisions.kinds or {}
	self._removed = decisions and decisions.removed or {}
	self._standIns = decisions and decisions.standIns or {}
	self._standInsSaid = false
	self._noDecision = {}
	-- RT-4: getPiece counts its timeout only once PlayerGui.RBLXEssentials
	-- exists. attach() records the PlayerGui; without one (a spec) the root
	-- counts as arrived.
	self._playerGui = opts.playerGui
	self._rootWait = opts.rootWait or Pieces.ROOT_WAIT
	self._wait = opts.wait or function(seconds)
		return seconds
	end
	self._warn = opts.warn or function() end
	self._print = opts.print or function() end
	self._defer = opts.defer or function(fn)
		fn()
	end
	return self
end

-- The declared kind of a piece id ("Panel", "HudButton", ...) as the
-- server's decision carries it, or nil. MenuSystem:getPiece warns from it
-- about a menu piece it never adopted, even one that lacks its tag (M-d).
function Runtime:kindOf(pieceId)
	local kind = self._kinds[pieceId]
	return if type(kind) == "string" then kind else nil
end

-- Kernel 3.2.0: whether the game deleted this piece (the server's plan
-- found no copy of it), and whether it has a copy to use (true in 2.x
-- legacy mode, where nothing was decided). ctx.hasPiece asks `has`.
function Runtime:isRemoved(pieceId)
	return self._removed[pieceId] == true
end

function Runtime:has(pieceId)
	if self._winners == nil then
		return true
	end
	return self._winners[pieceId] ~= nil
end

-- One warning per id the server's decision does not contain (T-G, M5): no
-- installed pack declares it, or no copy of it was usable.
-- 3.2.0: a stand-in its owner replaced (General UI Kit's Codes, Spin,
-- Rewards, DailyRewards and Pets buttons and panels, with those packs
-- installed) is expected, not wrong: the first one prints ONE line for the
-- session naming every replaced stand-in of the decision, and none warns.
-- Anything else (no installed pack declares the id, or no copy of it is
-- usable) still warns once per id.
function Runtime:_warnNoDecision(id, where)
	if self._noDecision[id] then
		return
	end
	self._noDecision[id] = true
	if self._standIns[id] then
		if not self._standInsSaid then
			self._standInsSaid = true
			local ids = {}
			for standIn in pairs(self._standIns) do
				table.insert(ids, standIn)
			end
			table.sort(ids)
			self._print(("[RBLXE] UI: %d stand-ins step aside for their packs' own pieces (by design): %s"):format(#ids, table.concat(ids, ", ")))
		end
		return
	end
	self._warn(("[RBLXE] UI: piece %s has no decision from the server (no installed pack declares it, or no copy of it is usable)%s")
		:format(id, if where ~= nil then ("; %s is not used"):format(where) else ""))
end

function Runtime:_retire(inst)
	pcall(function()
		if inst:IsA("GuiObject") then
			inst.Visible = false
		elseif inst:IsA("LayerCollector") then
			inst.Enabled = false
		end
	end)
	-- Deferred: the clone may still be mid-parenting when it is refused.
	self._defer(function()
		inst:Destroy()
	end)
end

-- Decides once per instance (the answer is cached, so a later move into the
-- MenuSystem shell cannot change it) and returns whether it may be used.
-- Only copies competing for the id are retired: one at a path the server
-- refused, or a second one at the winner path. Any other instance carrying
-- RBLXE_Piece (a clone a pack made) is refused but left alone.
function Runtime:admit(inst)
	local cached = self._decided[inst]
	if cached ~= nil then
		return cached
	end
	local id = pieceIdOf(inst)
	local admitted = true
	if id ~= nil then
		if self._winners == nil then
			self._admitted[id] = self._admitted[id] or inst
		else
			local winnerPath = self._winners[id]
			local path = pathUnderRoot(inst)
			if winnerPath == nil then
				admitted = false
				-- A clone of a piece the game deleted is the pack's: no word.
				if not self._removed[id] then
					self:_warnNoDecision(id, inst:GetFullName())
				end
				local refused = self._refused[id]
				if path ~= nil and refused ~= nil and refused[path] then
					self:_retire(inst)
				end
			elseif path ~= nil and path == winnerPath then
				local incumbent = self._admitted[id]
				if incumbent == nil then
					self._admitted[id] = inst
				else
					admitted = false
					if incumbent.Parent == nil then
						self._warn(("[RBLXE] UI: piece %s was destroyed; its new copy %s is refused (pieces are admitted once per session)")
							:format(id, inst:GetFullName()))
					else
						-- M-b: never removed without a word.
						self._warn(("[RBLXE] UI: piece %s: a second copy arrived at %s and was removed; the first copy keeps the piece")
							:format(id, inst:GetFullName()))
					end
					self:_retire(inst)
				end
			else
				admitted = false
				local refused = self._refused[id]
				if path ~= nil and refused ~= nil and refused[path] then
					self:_retire(inst)
				end
			end
		end
	end
	self._decided[inst] = admitted
	return admitted
end

-- Whether `inst` is the copy the server's decision chose for its id (always
-- false in 2.x legacy mode, where nothing was decided). MenuSystem adopts
-- such a piece over any 2.x panel or button with the same key.
function Runtime:chose(inst)
	if self._winners == nil then
		return false
	end
	local id = pieceIdOf(inst)
	return id ~= nil and self._admitted[id] == inst
end

function Runtime:attach(playerGui)
	self._playerGui = playerGui
	local function consider(inst)
		if pieceIdOf(inst) ~= nil then
			self:admit(inst)
		end
	end
	for _, inst in ipairs(playerGui:GetDescendants()) do
		consider(inst)
	end
	return playerGui.DescendantAdded:Connect(consider)
end

-- get(pieceId, timeout?) -&gt; the admitted piece, or nil. An id the server's
-- decision does not contain returns at once (M5): no copy of it will ever be
-- admitted. Otherwise the timeout (default 10 s) counts only while
-- PlayerGui.RBLXEssentials exists (RT-4): the root arrives with the first
-- character, which a slow client or a pack like DatastorePurchaseSystem can
-- delay; waiting for the root is bounded by rootWait on its own.
function Runtime:get(pieceId, timeout)
	-- Kernel 3.2.0: a piece the game deleted answers nil at once, silently.
	if self._removed[pieceId] then
		return nil
	end
	if self._winners ~= nil and self._winners[pieceId] == nil then
		self:_warnNoDecision(pieceId, nil)
		return nil
	end
	local limit = timeout or 10
	local elapsed, waitedForRoot = 0, 0
	while true do
		local found = self._admitted[pieceId]
		if found ~= nil and found.Parent ~= nil then
			return found
		end
		local rootHere = self._playerGui == nil or self._playerGui:FindFirstChild(Pieces.ROOT) ~= nil
		if rootHere and elapsed &gt;= limit then
			break
		end
		if not rootHere and waitedForRoot &gt;= self._rootWait then
			self._warn(("[RBLXE] UI: piece %s: PlayerGui.%s did not arrive within %ss (the player has no character yet?)")
				:format(pieceId, Pieces.ROOT, tostring(self._rootWait)))
			return nil
		end
		local step = self._wait(0.1)
		step = if type(step) == "number" and step &gt; 0 then step else 0.1
		if rootHere then
			elapsed += step
		else
			waitedForRoot += step
		end
	end
	self._warn(("[RBLXE] UI: piece %s did not appear within %ss"):format(pieceId, tostring(limit)))
	return nil
end

return Pieces
</string>
              <int64 name="SourceAssetId">-1</int64>
              <BinaryString name="Tags" />
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="19">
            <Properties>
              <string name="Name">RootPersistence</string>
              <BinaryString name="AttributesSerialize" />
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source">-- RootPersistence.lua - keeps StarterGui.RBLXEssentials alive across
-- character respawns (Kernel 2.1.1).
--
-- WHY: Roblox resets PlayerGui on every character spawn. Each StarterGui
-- child is destroyed and cloned again unless it is a top-level
-- LayerCollector with ResetOnSpawn = false. The installer creates
-- StarterGui.RBLXEssentials as a Folder, which has no ResetOnSpawn, so the
-- whole tree was destroyed on the server and cloned again on every respawn
-- (the ResetOnSpawn = false of each pack ScreenGui nested inside is
-- ignored: only top-level LayerCollectors count). That server-side Destroy
-- replicates to every instance the client had moved out of the tree,
-- including every panel and HUD button MenuSystem adopted into
-- RBLXEssentialsGUI, so after the first death the menus and the HUD buttons
-- were gone. Diagnosed natively on 2026-09-23.
--
-- The server calls persist once at boot, before packs load, to turn a
-- non-ScreenGui root into a ScreenGui with ResetOnSpawn = false. The root
-- instance itself is replaced (the old Folder is destroyed), but the new one
-- keeps its name, attributes, tags and children, so every
-- PlayerGui.RBLXEssentials.&lt;PackId&gt;.&lt;Gui&gt; path stays the same: look the root
-- up by name after boot. The holder is neutral (no insets, no safe-area
-- clipping), so it adds no layout of its own, and the pack ScreenGuis nested
-- inside keep rendering as independent layers.
--
-- Pure: no `game` access. `create` is Instance.new and `enums` is Enum,
-- both injected so Lune specs can pass @lune/roblox's versions.
local RootPersistence = {}

RootPersistence.ROOT = "RBLXEssentials"

-- The nearest ancestor of `inst` (not `inst` itself) that is a GuiObject or
-- a LayerCollector, or nil when there is none.
local function nearestGuiAncestor(inst)
	local node = inst.Parent
	while node ~= nil do
		if node:IsA("GuiObject") or node:IsA("LayerCollector") then
			return node
		end
		node = node.Parent
	end
	return nil
end

-- Reports every instance under the root whose behavior changes now that the
-- root persists instead of resetting on spawn:
--   * client code (a LocalScript, or a Script with RunContext Client) now
--     runs once per session instead of on every respawn;
--   * a nested LayerCollector that asked to reset on spawn no longer does;
--   * only when the old root was not a LayerCollector (a Folder, which
--     renders nothing): a GuiObject with no GuiObject or LayerCollector
--     between it and the root now renders. Only the top of each such subtree
--     is reported, so a Frame &gt; Folder &gt; Frame chain gives one warning. When
--     the old root was already a ScreenGui, those objects were already
--     rendering, so they are not reported.
local function audit(root, enums, warnings, rootWasLayerCollector)
	for _, inst in ipairs(root:GetDescendants()) do
		if inst:IsA("LocalScript") or (inst:IsA("Script") and inst.RunContext == enums.RunContext.Client) then
			table.insert(warnings, ("%s: now runs once per session instead of on every respawn"):format(inst:GetFullName()))
		elseif inst:IsA("LayerCollector") then
			if inst.ResetOnSpawn == true then
				table.insert(warnings, ("%s: no longer resets on spawn"):format(inst:GetFullName()))
			end
		elseif inst:IsA("GuiObject") then
			if not rootWasLayerCollector and nearestGuiAncestor(inst) == root then
				table.insert(warnings, ("%s: now renders (it has no ScreenGui of its own)"):format(inst:GetFullName()))
			end
		end
	end
end

-- Makes StarterGui.RBLXEssentials survive respawn. Returns (root, warnings);
-- root is nil only when StarterGui has no RBLXEssentials child.
function RootPersistence.persist(starterGui, create, enums)
	local warnings = {}
	local root = starterGui:FindFirstChild(RootPersistence.ROOT)

	local matches = 0
	for _, child in ipairs(starterGui:GetChildren()) do
		if child.Name == RootPersistence.ROOT then
			matches += 1
		end
	end
	if matches &gt; 1 and root ~= nil then
		table.insert(warnings, ("more than one StarterGui child is named %s; only %s was made persistent")
			:format(RootPersistence.ROOT, root:GetFullName()))
	end

	if root == nil then
		return nil, warnings
	end

	if root:IsA("ScreenGui") then
		-- Already converted, or the root may already be a ScreenGui if the
		-- game replaced it by hand: only make sure it survives respawn, and
		-- audit only when that is a change. Its GuiObjects already rendered.
		if root.ResetOnSpawn then
			root.ResetOnSpawn = false
			audit(root, enums, warnings, true)
		end
		table.sort(warnings)
		return root, warnings
	end

	local holder = create("ScreenGui")
	holder.Name = RootPersistence.ROOT
	holder.ResetOnSpawn = false
	holder.ScreenInsets = enums.ScreenInsets.None
	holder.ClipToDeviceSafeArea = false
	holder.SafeAreaCompatibility = enums.SafeAreaCompatibility.None
	for key, value in pairs(root:GetAttributes()) do
		holder:SetAttribute(key, value)
	end
	for _, tag in ipairs(root:GetTags()) do
		holder:AddTag(tag)
	end

	local moved = {}
	local moveOk, moveErr = pcall(function()
		for _, child in ipairs(root:GetChildren()) do
			child.Parent = holder
			table.insert(moved, child)
		end
	end)
	if not moveOk then
		-- Put back whatever already moved, so nothing is left orphaned.
		local stranded = {}
		for _, child in ipairs(moved) do
			local backOk = pcall(function()
				child.Parent = root
			end)
			if not backOk then
				table.insert(stranded, child)
			end
		end
		if #stranded == 0 then
			holder:Destroy()
		else
			-- Destroying the holder would destroy these children with it.
			for _, child in ipairs(stranded) do
				table.insert(warnings, ("%s could not be returned to %s"):format(child.Name, RootPersistence.ROOT))
			end
		end
		table.insert(warnings, ("%s: root not made persistent; menus, HUD buttons and pack interfaces may stop working after a respawn (%s)")
			:format(RootPersistence.ROOT, tostring(moveErr)))
		table.sort(warnings)
		return root, warnings
	end

	-- Parented before the Folder is destroyed, with no yield in between, so
	-- the moved children always have a root.
	holder.Parent = starterGui
	root:Destroy()

	audit(holder, enums, warnings, false)
	table.sort(warnings)
	return holder, warnings
end

return RootPersistence
