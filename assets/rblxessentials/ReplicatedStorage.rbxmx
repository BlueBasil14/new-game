            <Item class="ModuleScript" referent="28">
              <Properties>
                <string name="Name">MusicPlayerHUD</string>
                <BinaryString name="AttributesSerialize" />
                <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
                <ContentId name="LinkedSource">
                  <null>
                  </null>
                </ContentId>
                <bool name="DefinesCapabilities">false</bool>
                <BinaryString name="SerializedOverrides">
                </BinaryString>
                <string name="Source">-- Animates authored templates only. Visibility never owns music playback.
local MusicPlayerHUD = {}

-- Use rest dimensions, never transient UIScale bounds, to center tiled artwork.
function MusicPlayerHUD.tileBounds(width, height, tile)
	local w = math.ceil(width / tile - 1e-6) * tile
	local h = math.ceil(height / tile - 1e-6) * tile
	return w / width, h / height, (1 - w / width) / 2, (1 - h / height) / 2
end

function MusicPlayerHUD.attach(gui, trove, sfx)
	local TweenService = game:GetService("TweenService")
	local mounted = {}
	local function mount(dock)
		if mounted[dock] or not dock:GetAttribute("CollapsibleMusicPlayer") then return end
		local panel, open = dock:FindFirstChild("Container"), dock:FindFirstChild("OpenMusicPlayer")
		local hide = panel and panel:FindFirstChild("HideMusicPlayer")
		local scale = panel and panel:FindFirstChild("PanelScale")
		-- 3.0 (plan B1): a fork may lack the open button's PressScale;
		-- revealOpen used to throw there, before the piece was mounted.
		if not (open and hide and scale and open:FindFirstChild("PressScale")) then return end
		local scope = trove:Extend()
		mounted[dock] = scope
		local alive, revision, revealing = true, 0, false
		local active = {}
		scope:Add(function()
			alive = false
			revision += 1
			for _, animation in active do animation:Cancel() end
			mounted[dock] = nil
		end)
		local function tween(object, duration, value, done, inward)
			if active[object] then active[object]:Cancel() end
			local animation = TweenService:Create(object, TweenInfo.new(duration,
				Enum.EasingStyle.Quad, inward and Enum.EasingDirection.In or Enum.EasingDirection.Out), {Scale = value})
			active[object] = animation
			animation.Completed:Once(function(status)
				if active[object] == animation then active[object] = nil end
				if alive and status == Enum.PlaybackState.Completed and done then done() end
			end)
			animation:Play()
		end
		local function revealOpen()
			open.Visible = true
			revealing = true
			open.PressScale.Scale = 0
			tween(open.PressScale, .2, 1, function() revealing = false end)
		end
		local function expand(show)
			revision += 1
			local stamp = revision
			dock:SetAttribute("Expanded", show)
			if show then
				if active[open.PressScale] then active[open.PressScale]:Cancel() end
				revealing = false
				open.Visible = false
				if not panel.Visible then scale.Scale = 0 end
				panel.Visible = true
				tween(scale, .22, 1)
			else
				tween(scale, .22, 0, function()
					if stamp ~= revision then return end
					panel.Visible = false
					revealOpen()
				end, true)
			end
		end
		panel.Visible = false
		scale.Scale = 0
		dock:SetAttribute("Expanded", false)
		scope:Connect(open.Activated, function() expand(true) end)
		scope:Connect(hide.Activated, function() expand(false) end)
		local textures, labels = {}, {}
		for _, node in dock:GetDescendants() do
			if node:IsA("GuiButton") then
				local press = node:FindFirstChild("PressScale")
				if press then
					local function feedback(value, duration)
						if node == open and revealing then return end
						tween(press, duration, value)
					end
					scope:Connect(node.MouseEnter, function()
						feedback(1.035, .12)
						if sfx then sfx:Play("Hover") end
					end)
					scope:Connect(node.MouseLeave, function() feedback(1, .12) end)
					scope:Connect(node.MouseButton1Down, function() feedback(.95, .06) end)
					scope:Connect(node.MouseButton1Up, function() feedback(1, .12) end)
				end
				scope:Connect(node.Activated, function() if sfx then sfx:Play("Press") end end)
			elseif node:IsA("ImageLabel") and node:GetAttribute("StudsTile") then
				table.insert(textures, node)
			elseif node:IsA("TextLabel") and node:GetAttribute("MusicTextSize") then
				table.insert(labels, node)
			end
		end
		local function resize()
			if not alive or not dock.Parent then return end
			local factor = dock.AbsoluteSize.X / (dock:GetAttribute("DesignWidth") or 384)
			if factor &lt;= 0 then return end
			for _, texture in textures do
				local w = texture:GetAttribute("RestWidth") * factor
				local h = texture:GetAttribute("RestHeight") * factor
				local sx, sy, px, py = MusicPlayerHUD.tileBounds(w, h, 75)
				texture.TileSize = UDim2.fromOffset(75, 75)
				texture.Size = UDim2.fromScale(sx, sy)
				texture.Position = UDim2.fromScale(px, py)
			end
			for _, label in labels do
				label.TextSize = math.max(1, label:GetAttribute("MusicTextSize") * factor)
			end
		end
		scope:Connect(dock:GetPropertyChangedSignal("AbsoluteSize"), resize)
		resize()
		task.defer(resize)
		revealOpen()
	end
	for _, dock in gui:GetChildren() do mount(dock) end
	trove:Connect(gui.ChildAdded, mount)
	trove:Connect(gui.ChildRemoved, function(dock)
		if mounted[dock] then mounted[dock]:Destroy() end
	end)
end

return MusicPlayerHUD
</string>
