<?xml version='1.0' encoding='utf-8'?>
<roblox version="4"><Item class="Folder" referent="RBLXE_ServerScriptService"><Properties><string name="Name">RBLXEssentials</string></Properties><Item class="Script" referent="314">
        <Properties>
          <string name="Name">Kernel</string>
          <BinaryString name="AttributesSerialize" />
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <bool name="Disabled">false</bool>
          <ContentId name="LinkedSource">
            <null>
            </null>
          </ContentId>
          <token name="RunContext">0</token>
          <bool name="DefinesCapabilities">false</bool>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <string name="Source">-- RBLX Essentials Kernel - server boot. The only Script in the ecosystem.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local HttpService = game:GetService("HttpService")

local kernelFolder = ReplicatedStorage:WaitForChild("RBLXEssentials"):WaitForChild("Kernel")
local RootPersistence = require(kernelFolder.UI.RootPersistence)

-- Run first, in its own pcall, before any other require or work: make
-- StarterGui.RBLXEssentials survive character respawns (see
-- UI/RootPersistence.lua) before any character spawns. Guarded: a failure
-- here must never stop the packs from booting, and the piece decision below
-- then uses the Folder root as it is.
local persistOk, persistResult, persistWarnings = pcall(RootPersistence.persist, StarterGui, Instance.new, Enum)
local uiRoot
if persistOk then
	uiRoot = persistResult
	for _, message in ipairs(persistWarnings) do
		warn("[RBLXE] UI root: " .. message)
	end
else
	warn("[RBLXE] could not make StarterGui.RBLXEssentials persistent; menus, HUD buttons and pack interfaces may stop working after a respawn: " .. tostring(persistResult))
	uiRoot = StarterGui:FindFirstChild("RBLXEssentials")
end

local Pieces = require(kernelFolder.UI.Pieces)
local Loader = require(kernelFolder.Loader)
local Version = require(kernelFolder.Version)
local Net = require(kernelFolder.Net)
local SFX = require(kernelFolder.SFX)
local Notify = require(kernelFolder.Notify)
local Signal = require(kernelFolder.Signal)
local Trove = require(kernelFolder.Packages.Trove)
local Schema = require(kernelFolder.Schema)
local Config = require(kernelFolder.Config)
local Contracts = require(kernelFolder.Contracts)

local ssRoot = script.Parent -- ServerScriptService/RBLXEssentials
local rsRoot = ReplicatedStorage.RBLXEssentials
local sharedPacks = rsRoot:WaitForChild("Packs")

rsRoot:SetAttribute("RBLXE_KernelVersion", Version)

-- 3.0 pieces: decide once, here, which copy of every declared interface piece
-- the game uses (a valid StarterGui.RBLXEssentials.Interface override, else the
-- pack's default) and publish it for every client, before any pack boots. The
-- JSON encoding runs inside the same pcall: whatever fails here falls back to
-- LEGACY and never stops the server script before Loader.boot.
-- RT-6: packs whose Pieces declaration is invalid; the Loader fails them.
local pieceFailures = {}
local planOk, encodedOrError = pcall(function()
	local declarations, declarationWarnings, declarationFailures = Pieces.collectDeclarations(sharedPacks, require, Contracts)
	pieceFailures = declarationFailures
	local plan = Pieces.plan({
		declarations = declarations,
		root = uiRoot,
		contracts = Contracts,
	})
	for _, message in ipairs(declarationWarnings) do
		warn("[RBLXE] UI: " .. message)
	end
	for _, message in ipairs(Pieces.strays(StarterGui, uiRoot)) do
		warn("[RBLXE] UI: " .. message)
	end
	for _, line in ipairs(plan.lines) do
		print("[RBLXE] UI: " .. line)
	end
	for _, message in ipairs(plan.warnings) do
		warn("[RBLXE] UI: " .. message)
	end
	return Pieces.encodeDecisions(plan, function(value)
		return HttpService:JSONEncode(value)
	end)
end)
if planOk then
	rsRoot:SetAttribute(Pieces.WINNERS_ATTRIBUTE, encodedOrError)
else
	warn("[RBLXE] UI: piece resolution failed, pieces keep 2.x adoption: " .. tostring(encodedOrError))
	rsRoot:SetAttribute(Pieces.WINNERS_ATTRIBUTE, Pieces.LEGACY)
end

local report = Loader.boot({
	side = "Server",
	sharedPacks = sharedPacks,
	serverPacks = ssRoot:WaitForChild("Packs"),
	kernelApi = { Version = Version, Trove = Trove, Signal = Signal, Net = Net, SFX = SFX, Notify = Notify },
	configLib = Config,
	schemaLib = Schema,
	configRoots = { shared = rsRoot:FindFirstChild("Config"), server = ssRoot:FindFirstChild("Config") },
	pieceFailures = pieceFailures,
	extensions = ssRoot:FindFirstChild("Extensions"),
})

-- RT-5: tell every client which packs did not start here. A reason that may
-- quote server-only values (an invalid configuration, a server module's
-- error) reaches clients as a fixed text (Loader.encodeServerReport); the
-- warnings below print it whole in the server output. The encoding and
-- the attribute write share one pcall: a report that cannot be published
-- must never stop the rest of this boot (the warnings below and
-- RBLXE_ServerBooted).
local reportOk, reportError = pcall(function()
	local encodedReport = Loader.encodeServerReport(report, function(value)
		return HttpService:JSONEncode(value)
	end)
	rsRoot:SetAttribute(Loader.SERVER_REPORT_ATTRIBUTE, encodedReport)
end)
if not reportOk then
	warn("[RBLXE] could not publish the boot report for clients; each client waits 30s for it, then boots every pack: " .. tostring(reportError))
end

print(Loader.formatReport("Server", report))
for id, reason in pairs(report.failed) do
	warn(string.format("[RBLXE] %s failed: %s", id, reason))
end
for id, reason in pairs(report.skipped) do
	warn(string.format("[RBLXE] %s skipped: %s", id, reason))
end
for _, notice in ipairs(report.notices or {}) do
	warn("[RBLXE] " .. notice)
end
ssRoot:SetAttribute("RBLXE_ServerBooted", true)
</string>
          <int64 name="SourceAssetId">-1</int64>
