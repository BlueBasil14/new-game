          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">Loader</string>
            <BinaryString name="AttributesSerialize" />
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source">-- Boots installed packs in dependency order. Shared by Kernel (server) and
-- KernelClient. Pure: all roots come in via opts, so tests can point it at
-- fixture folders.
--
-- Plan B0 (phase B, before the Kernel 3.0.0 API freeze), in every ctx:
--   * companion(packId): another installed pack's frozen configuration for
--     this side and, once it booted, its API (handle:api()), or nil when
--     that pack is not installed. Optional by definition, like the Notify
--     and SFX facades: no manifest declaration, and never an instance path
--     into another pack;
--   * extension(name, defaults) / extensions(defaults): the game's own
--     modules for this pack, in &lt;Service&gt;.RBLXEssentials.Extensions.&lt;PackId&gt;
--     (a game zone no update or uninstall touches), before the pack's own
--     shipped ones in `defaults`;
--   * settings: only for a pack without a Schema (a game's own pack), with
--     a deprecation notice in report.notices; a pack with a Schema reads
--     ctx.config (and a notice says so when it still has a Settings folder).
local Loader = {}

-- RT-5: after its boot the server publishes which packs did not start, in
-- this attribute of ReplicatedStorage.RBLXEssentials (JSON { failed,
-- skipped }), so each client skips them instead of waiting on remotes a
-- server module never creates.
Loader.SERVER_REPORT_ATTRIBUTE = "RBLXE_ServerReport"

-- The report is attribute data, which Roblox does not store past a size
-- limit, while a reason can be long (a stack traceback, every configuration
-- error of a pack). The limit is PackFormat.HASHES_MAX_LENGTH's. A report
-- over it is encoded again with each reason cut to SERVER_REPORT_REASON_LENGTH
-- bytes, then with no reasons: clients need the ids, and the server output
-- keeps every reason whole.
Loader.SERVER_REPORT_MAX_LENGTH = 100000
Loader.SERVER_REPORT_REASON_LENGTH = 500

local DROPPED_REASON = "see the server output"

-- What clients read instead of a reason that may quote server-only values
-- (Loader.boot marks it in report.private): an invalid configuration names
-- the server Config's values (a repeated code, the text a check quoted), and
-- a server module's error can hold anything it read. The server output keeps
-- every reason whole; clients only need to know the pack did not start.
local PRIVATE_REASONS = {
	configuration = "invalid configuration (the server output names each problem; server-only values are never sent to clients)",
	error = "it errored while starting (the server output has the error; server-only values are never sent to clients)",
}

-- cutReason(reason) -&gt; the reason, or its first SERVER_REPORT_REASON_LENGTH
-- bytes (never ending inside a UTF-8 character) and a note that it was cut.
local function cutReason(reason)
	local text = tostring(reason)
	local stop = Loader.SERVER_REPORT_REASON_LENGTH
	if #text &lt;= stop then
		return text
	end
	-- step back over continuation bytes (0x80 to 0xBF) so the cut falls
	-- between two characters
	while stop &gt; 0 and string.byte(text, stop + 1) &gt;= 0x80 and string.byte(text, stop + 1) &lt; 0xC0 do
		stop -= 1
	end
	return string.sub(text, 1, stop) .. " ... (cut; the server output has it whole)"
end

local function mapReasons(map, reasonFor)
	local out = {}
	for id, reason in pairs(map) do
		out[id] = reasonFor(reason)
	end
	return out
end

-- publicFailed(report) -&gt; report.failed as clients may read it: each reason
-- report.private marks is replaced with its PRIVATE_REASONS text.
local function publicFailed(report)
	local private = if type(report.private) == "table" then report.private else {}
	local out = {}
	for id, reason in pairs(report.failed) do
		local kind = private[id]
		out[id] = if kind ~= nil then (PRIVATE_REASONS[kind] or DROPPED_REASON) else reason
	end
	return out
end

-- encodeServerReport(report, jsonEncode) -&gt; JSON { failed, skipped } of at
-- most SERVER_REPORT_MAX_LENGTH bytes, for every client: a reason
-- report.private marks never leaves the server (publicFailed). Errors when
-- the ids alone do not fit: a client must never skip a shortened list.
function Loader.encodeServerReport(report, jsonEncode)
	report = { failed = publicFailed(report), skipped = report.skipped }
	local encoded = jsonEncode({ failed = report.failed, skipped = report.skipped })
	if #encoded &lt;= Loader.SERVER_REPORT_MAX_LENGTH then
		return encoded
	end
	encoded = jsonEncode({ failed = mapReasons(report.failed, cutReason), skipped = mapReasons(report.skipped, cutReason) })
	if #encoded &lt;= Loader.SERVER_REPORT_MAX_LENGTH then
		return encoded
	end
	local function dropped()
		return DROPPED_REASON
	end
	encoded = jsonEncode({ failed = mapReasons(report.failed, dropped), skipped = mapReasons(report.skipped, dropped) })
	if #encoded &lt;= Loader.SERVER_REPORT_MAX_LENGTH then
		return encoded
	end
	error(string.format("the boot report is too long even without its reasons (%d bytes, limit %d)",
		#encoded, Loader.SERVER_REPORT_MAX_LENGTH), 0)
end

-- decodeServerReport(encoded, jsonDecode) -&gt; { failed, skipped } or nil when
-- there is no usable report. HttpService writes an empty map as [], which
-- decodes to an empty table.
function Loader.decodeServerReport(encoded, jsonDecode)
	if type(encoded) ~= "string" then
		return nil
	end
	local ok, decoded = pcall(jsonDecode, encoded)
	if not ok or type(decoded) ~= "table" then
		return nil
	end
	return {
		failed = if type(decoded.failed) == "table" then decoded.failed else {},
		skipped = if type(decoded.skipped) == "table" then decoded.skipped else {},
	}
end

-- xpcall error handler: appends a stack traceback to the error message when
-- `debug.traceback` is available (real Roblox + the Lune test harness both
-- have it), falling back to a plain tostring() if some sandboxed environment
-- doesn't provide `debug`.
local function tracebackHandler(err)
	if debug and debug.traceback then
		return debug.traceback(tostring(err), 2)
	end
	return tostring(err)
end

local function readManifests(sharedPacks, requireImpl)
	local manifests, errors = {}, {}
	for _, packFolder in ipairs(sharedPacks:GetChildren()) do
		local manifestModule = packFolder:FindFirstChild("manifest")
		if not manifestModule or not manifestModule:IsA("ModuleScript") then
			errors[packFolder.Name] = "no manifest ModuleScript"
			continue
		end
		local ok, manifest = pcall(requireImpl, manifestModule)
		if not ok then
			errors[packFolder.Name] = "manifest error: " .. tostring(manifest)
			continue
		end
		if type(manifest) ~= "table" or type(manifest.id) ~= "string" then
			errors[packFolder.Name] = "manifest must return a table with a string id"
			continue
		end
		if manifest.id ~= packFolder.Name then
			errors[packFolder.Name] = string.format("manifest id %q does not match folder name", manifest.id)
			continue
		end
		manifest = table.clone(manifest)
		manifest.deps = manifest.deps or {}
		manifest.folder = packFolder
		manifests[manifest.id] = manifest
	end
	return manifests, errors
end

local function resolveOrder(manifests)
	local skipped = {}

	-- transitively drop packs whose declared deps are not installed
	local changed = true
	while changed do
		changed = false
		for id, m in pairs(manifests) do
			if not skipped[id] then
				for _, dep in ipairs(m.deps) do
					if not manifests[dep] or skipped[dep] then
						-- Whether dep is simply absent, or exists but was itself already
						-- skipped by an earlier fixed-point pass, the reason is the same:
						-- this pack can't run because dep isn't available. Cycle detection
						-- (and the "dependency cycle" reason) happens later, in the
						-- post-Kahn indegree sweep below -- never here.
						skipped[id] = "missing dependency: " .. dep
						changed = true
						break
					end
				end
			end
		end
	end

	-- Kahn topological sort (alphabetical tie-break for determinism)
	local order, indegree, dependents = {}, {}, {}
	for id in pairs(manifests) do
		if not skipped[id] then indegree[id] = 0 end
	end
	for id, m in pairs(manifests) do
		if not skipped[id] then
			for _, dep in ipairs(m.deps) do
				indegree[id] += 1
				dependents[dep] = dependents[dep] or {}
				table.insert(dependents[dep], id)
			end
		end
	end
	local queue = {}
	for id, deg in pairs(indegree) do
		if deg == 0 then table.insert(queue, id) end
	end
	table.sort(queue)
	while #queue &gt; 0 do
		local id = table.remove(queue, 1)
		table.insert(order, id)
		for _, dependent in ipairs(dependents[id] or {}) do
			indegree[dependent] -= 1
			if indegree[dependent] == 0 then
				local pos = #queue + 1
				for i, q in ipairs(queue) do
					if dependent &lt; q then pos = i break end
				end
				table.insert(queue, pos, dependent)
			end
		end
	end
	for id, deg in pairs(indegree) do
		if deg &gt; 0 and not skipped[id] then
			skipped[id] = "dependency cycle"
		end
	end
	return order, skipped
end

-- moduleNamed(parent, name): the first ModuleScript child called `name`,
-- past any other child of that name (FindFirstChild would stop at a Folder).
local function moduleNamed(parent, name)
	for _, child in ipairs(parent and parent:GetChildren() or {}) do
		if child.Name == name and child:IsA("ModuleScript") then
			return child
		end
	end
	return nil
end

-- extension(root, packId, name, defaults?) -&gt; (module?, from?): the game's
-- module &lt;root&gt;.&lt;packId&gt;.&lt;name&gt; ("game"), else defaults.&lt;name&gt; ("pack");
-- only a ModuleScript counts. `root` is the side's Extensions folder.
function Loader.extension(root, packId, name, defaults)
	local found = moduleNamed(root and root:FindFirstChild(packId), name)
	if found ~= nil then
		return found, "game"
	end
	local shipped = moduleNamed(defaults, name)
	if shipped ~= nil then
		return shipped, "pack"
	end
	return nil, nil
end

-- extensions(root, packId, defaults?) -&gt; { { name, module, from } }: every
-- module of both, one per name: the pack's own in their order (the game's
-- module winning a name it shares), then the game's additions in theirs.
function Loader.extensions(root, packId, defaults)
	local list, taken = {}, {}
	local own = root and root:FindFirstChild(packId)
	for _, child in ipairs(defaults and defaults:GetChildren() or {}) do
		if child:IsA("ModuleScript") and not taken[child.Name] then
			taken[child.Name] = true
			local module, from = Loader.extension(root, packId, child.Name, defaults)
			table.insert(list, { name = child.Name, module = module, from = from })
		end
	end
	for _, child in ipairs(own and own:GetChildren() or {}) do
		if child:IsA("ModuleScript") and not taken[child.Name] then
			taken[child.Name] = true
			table.insert(list, { name = child.Name, module = child, from = "game" })
		end
	end
	return list
end

function Loader.boot(opts)
	local requireImpl = opts.requireFn or require
	-- report.private[id]: why report.failed[id] may quote server-only values
	-- ("configuration" or "error"); encodeServerReport never sends such a
	-- reason to clients, and the server output prints it whole.
	-- report.notices: one line per pack that still gets ctx.settings (plan
	-- B0), or whose Settings folder its Schema leaves unread, printed once
	-- by the Kernel scripts.
	local report = { booted = {}, failed = {}, skipped = {}, private = {}, notices = {} }
	local manifests, manifestErrors = readManifests(opts.sharedPacks, requireImpl)
	for name, err in pairs(manifestErrors) do
		report.failed[name] = err
	end
	local order, skipped = resolveOrder(manifests)
	for id, reason in pairs(skipped) do
		report.skipped[id] = reason
	end

	local apis = {}
	-- Each pack's configuration is loaded once, on its own turn below or
	-- earlier through a companion handle, and shared by both.
	local configs = {}
	local function loadConfig(packId)
		local cached = configs[packId]
		if cached ~= nil then
			return cached
		end
		local m = manifests[packId]
		local configRoots = opts.configRoots or {}
		local ok, value, errors = pcall(opts.configLib.load, {
			packId = packId,
			side = opts.side,
			requireFn = requireImpl,
			schemaLib = opts.schemaLib,
			schemaModule = m.folder:FindFirstChild("Schema"),
			sharedModule = configRoots.shared and configRoots.shared:FindFirstChild(packId) or nil,
			serverModule = configRoots.server and configRoots.server:FindFirstChild(packId) or nil,
		})
		cached = { ok = ok, value = value, errors = errors }
		configs[packId] = cached
		return cached
	end
	-- One frozen handle per companion (plan B0, ruling 4).
	local companions = {}
	local function companionOf(packId)
		local handle = companions[packId]
		if handle ~= nil then
			return handle
		end
		-- No config for a pack whose pieces failed on this side or, on a
		-- client, one the server failed or skipped (nothing it declares is in
		-- force there). Otherwise its config, even for a pack this side skips
		-- or that fails later: handle.api() says whether it booted. The
		-- handle is made once, at the first call.
		local stopped = (opts.pieceFailures ~= nil and opts.pieceFailures[packId] ~= nil)
			or (opts.serverReport ~= nil and (opts.serverReport.failed[packId] ~= nil or opts.serverReport.skipped[packId] ~= nil))
		local config = nil
		if opts.configLib and not stopped then
			local loaded = loadConfig(packId)
			if loaded.ok and type(loaded.errors) == "table" and #loaded.errors == 0 then
				config = loaded.value
			end
		end
		handle = table.freeze({
			id = packId,
			version = manifests[packId].version,
			config = config,
			api = function()
				return apis[packId]
			end,
		})
		companions[packId] = handle
		return handle
	end
	for _, id in ipairs(order) do
		local m = manifests[id]
		local blockedBy
		for _, dep in ipairs(m.deps) do
			if report.failed[dep] or (report.skipped[dep] and not apis[dep]) then
				blockedBy = dep
				break
			end
		end
		if blockedBy then
			report.skipped[id] = "dependency failed: " .. blockedBy
			continue
		end

		-- 3.0 (RT-6): a pack whose Pieces declaration is invalid does not
		-- boot: its pieces can never be resolved (Pieces.collectDeclarations).
		local pieceFailure = opts.pieceFailures and opts.pieceFailures[id]
		if pieceFailure ~= nil then
			report.failed[id] = pieceFailure
			continue
		end
		-- 3.0 (RT-5): on a client, a pack that did not start on the server
		-- does not start either: it would wait for remotes nobody creates.
		local serverReason = opts.serverReport and (opts.serverReport.failed[id] or opts.serverReport.skipped[id])
		if serverReason ~= nil then
			report.failed[id] = "did not start on the server: " .. tostring(serverReason)
			continue
		end

		-- 3.0: game-owned configuration (Config.lua). A pack whose configuration
		-- is invalid fails like a pack whose init errors, so its dependents are
		-- skipped instead of booting against a half-configured dependency.
		-- The load runs in its own pcall: a schema or a Config module that
		-- makes the load throw (a self-referencing table, anything Schema.check
		-- did not foresee) fails this pack alone, never the rest of the boot.
		-- A companion handle may have loaded it already (loadConfig).
		local config = nil
		if opts.configLib then
			local loaded = loadConfig(id)
			if not loaded.ok then
				report.failed[id] = "invalid configuration: " .. tostring(loaded.value)
				report.private[id] = "configuration"
				continue
			end
			if #loaded.errors &gt; 0 then
				report.failed[id] = "invalid configuration:\n    " .. table.concat(loaded.errors, "\n    ")
				report.private[id] = "configuration"
				continue
			end
			config = loaded.value
		end

		local module
		if opts.side == "Server" then
			module = opts.serverPacks and opts.serverPacks:FindFirstChild(id)
		else
			module = m.folder:FindFirstChild("Client")
		end
		if not module or not module:IsA("ModuleScript") then
			-- pack ships no code for this side - still counts as booted
			apis[id] = {}
			table.insert(report.booted, id)
			continue
		end

		-- A pack with a Schema reads ctx.config and gets no ctx.settings; a
		-- pack without one (a game's own pack) keeps its 2.x Settings folder,
		-- and the report says once that this is deprecated (plan B0, ruling 5).
		-- A Settings folder next to a Schema (a hand copy: T.update never
		-- takes a 2.x pack to 3.x) is not read, and the report says so.
		local settings = nil
		if m.folder:FindFirstChild("Schema") == nil then
			settings = m.folder:FindFirstChild("Settings")
			if settings ~= nil then
				table.insert(report.notices, string.format(
					"%s reads its 2.x Settings through ctx.settings, which is deprecated: an official pack stops using it when it is updated to 3.x; a game's own pack should move to a Schema and ctx.config", id))
			end
		elseif m.folder:FindFirstChild("Settings") ~= nil then
			table.insert(report.notices, string.format(
				"%s has a Schema, so its Settings folder is not read: the pack runs on Config.%s. Set there any value the game changed in Settings, then delete that folder", id, id))
		end
		local ctx = {
			packId = id,
			version = m.version,
			folder = m.folder,
			serverFolder = (opts.side == "Server") and module or nil,
			settings = settings,
			config = config,
			-- Plan B0: another installed pack's config and API (nil when it is
			-- not installed), and the game's own modules for this pack.
			companion = function(otherId)
				if type(otherId) ~= "string" or otherId == id or manifests[otherId] == nil then
					return nil
				end
				return companionOf(otherId)
			end,
			extension = function(name, defaults)
				return Loader.extension(opts.extensions, id, name, defaults)
			end,
			extensions = function(defaults)
				return Loader.extensions(opts.extensions, id, defaults)
			end,
			kernel = opts.kernelApi,
			ui = opts.ui,
			-- 3.0: this pack's own interface piece, already resolved by the Kernel.
			getPiece = opts.ui and function(name, timeout)
				return opts.ui:getPiece(id .. "." .. name, timeout)
			end or nil,
			-- Kernel 3.2.0: whether this pack's piece has a copy to use (false
			-- when the game deleted it), so the pack skips wiring it. Client
			-- only: the server never asks about pieces.
			hasPiece = opts.ui and function(name)
				return opts.ui:hasPiece(id .. "." .. name)
			end or nil,
			require = function(depId)
				local declared = false
				for _, dep in ipairs(m.deps) do
					if dep == depId then declared = true break end
				end
				assert(declared, string.format(
					"[RBLXE] %s tried to require %s without declaring it in manifest.deps", id, depId))
				return apis[depId]
			end,
		}

		local ok, initOrErr = xpcall(requireImpl, tracebackHandler, module)
		if ok and type(initOrErr) ~= "function" then
			ok, initOrErr = false, "module must return function(ctx)"
		end
		if ok then
			local api
			ok, api = xpcall(initOrErr, tracebackHandler, ctx)
			if ok then
				apis[id] = api or {}
				table.insert(report.booted, id)
			else
				report.failed[id] = tostring(api)
				report.private[id] = "error"
			end
		else
			report.failed[id] = tostring(initOrErr)
			report.private[id] = "error"
		end
	end
	return report
end

function Loader.formatReport(side, report)
	local function keys(map)
		local out = {}
		for k in pairs(map) do table.insert(out, k) end
		table.sort(out)
		return table.concat(out, ",")
	end
	return string.format("[RBLXE] %s booted: %s | failed: %s | skipped: %s",
		side, table.concat(report.booted, ","), keys(report.failed), keys(report.skipped))
end

return Loader
</string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags" />
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Net</string>
            <BinaryString name="AttributesSerialize" />
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source">-- Per-pack remote namespaces under RS/RBLXEssentials/Kernel/Remotes/&lt;PackId&gt;/.
-- Server creates on demand; clients wait for the server to create.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

local function kernelFolder()
	return ReplicatedStorage:WaitForChild("RBLXEssentials"):WaitForChild("Kernel")
end

local function serverGet(packId, className, name)
	local kernel = kernelFolder()
	local root = kernel:FindFirstChild("Remotes")
	if not root then
		root = Instance.new("Folder"); root.Name = "Remotes"; root.Parent = kernel
	end
	local packFolder = root:FindFirstChild(packId)
	if not packFolder then
		packFolder = Instance.new("Folder"); packFolder.Name = packId; packFolder.Parent = root
	end
	local remote = packFolder:FindFirstChild(name)
	if remote then
		if remote.ClassName ~= className then
			error(string.format("[RBLXE Net] %s/%s already exists as %s", packId, name, remote.ClassName))
		end
		return remote
	end
	remote = Instance.new(className)
	remote.Name = name
	remote.Parent = packFolder
	return remote
end

function Net.server(packId)
	assert(RunService:IsServer(), "[RBLXE Net] Net.server is server-only")
	return {
		event = function(_, name) return serverGet(packId, "RemoteEvent", name) end,
		func = function(_, name) return serverGet(packId, "RemoteFunction", name) end,
	}
end

function Net.client(packId)
	assert(RunService:IsClient(), "[RBLXE Net] Net.client is client-only")

	-- waitFor(parent, name, deadline) -&gt; the child, or nil once `deadline`
	-- (an os.clock time) has passed. Waits in slices of at most 10 s and
	-- warns once when it has to wait longer than one slice, instead of
	-- yielding with no word. Without a deadline it waits as long as it
	-- takes, as 2.x packs expect.
	local function waitFor(parent, name, deadline)
		local child = parent:FindFirstChild(name)
		local warned = false
		while child == nil do
			local slice = 10
			if deadline ~= nil then
				local left = deadline - os.clock()
				if left &lt;= 0 then
					return nil
				end
				slice = math.min(slice, left)
			end
			child = parent:WaitForChild(name, slice)
			if child == nil and not warned and (deadline == nil or os.clock() &lt; deadline) then
				warned = true
				warn(string.format(
					"[RBLXE] Net.client(%q) still waiting for %s.%s. Is the pack's server module installed and started?",
					packId, parent:GetFullName(), name))
			end
		end
		return child
	end

	-- lookup(name, timeout?) -&gt; the remote, or nil with a warning once
	-- `timeout` seconds have passed (RT-5): one deadline for the Remotes
	-- folder, the pack's folder and the remote itself.
	local function lookup(name, timeout)
		local deadline = if type(timeout) == "number" then os.clock() + timeout else nil
		local remotes = waitFor(kernelFolder(), "Remotes", deadline)
		local packFolder = remotes and waitFor(remotes, packId, deadline)
		local remote = packFolder and waitFor(packFolder, name, deadline)
		if remote == nil then
			warn(string.format(
				"[RBLXE] Net.client(%q): remote %q did not appear within %ss; the pack's server module did not start or never creates it",
				packId, name, tostring(timeout)))
		end
		return remote
	end
	return {
		event = function(_, name, timeout) return lookup(name, timeout) end,
		func = function(_, name, timeout) return lookup(name, timeout) end,
	}
end

return Net
