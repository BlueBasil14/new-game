						<string name="Name">controllers</string>
					</Properties>
					<Item class="ModuleScript" referent="RBX00000000000000000000000000000023">
						<Properties>
							<string name="Name">ArenaClient</string>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Receives arena replication (snapshot, 10 Hz deltas, events), owns the client Grid and trail
-- lists, fills ClientState.arena and drives TurfRenderer.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Remotes = require(Shared.Remotes)
local Types = require(Shared.Types)
local ClientState = require(script.Parent.Parent.ClientState)
local TurfRenderer = require(script.Parent.TurfRenderer)
local CameraController = require(script.Parent.CameraController)

local ArenaClient = {}

local CHANGED_INTERVAL = 0.25 -- arenaChanged at most 4 Hz
local RUNNER_INFO_REMOTE = "RunnerInfo"
local RUNNER_INFO_TIMEOUT = 5

local started = false
local grid: Grid.Grid? = nil
local trails: { [number]: { number } } = {}
local alive: { [number]: boolean } = {}
-- Client os.clock() at which each runner's spawn shield ends (see spawn handling).
local shieldEnds: { [number]: number } = {}

local pendingDeltas: { { cells: buffer, trails: { Types.TrailDelta } } } = {}
local pendingEvents: { Types.ArenaEvent } = {}

local changedScheduled = false
local lastChanged = -math.huge
local lastShare = -1

ArenaClient.trails = trails
ArenaClient.alive = alive
ArenaClient.shieldEnds = shieldEnds

function ArenaClient.getGrid(): Grid.Grid?
	return grid
end

local function refreshCounts()
	local arena = ClientState.arena
	local g = grid
	if not g then
		return
	end
	arena.totalCells = g.total
	table.clear(arena.cells)
	for id in arena.runners do
		arena.cells[id] = g:count(id)
	end
	local myId = arena.myId
	local share = if myId then g:count(myId) / g.total else 0
	if share ~= lastShare then
		lastShare = share
		CameraController.setTurfShare(share)
	end
end

local function flushChanged()
	changedScheduled = false
	lastChanged = os.clock()
	refreshCounts()
	ClientState.arenaChanged:Fire()
end

local function markChanged()
	if changedScheduled then
		return
	end
	changedScheduled = true
	local wait = math.max(0, lastChanged + CHANGED_INTERVAL - os.clock())
	task.delay(wait, flushChanged)
end

-- Server shield times use the server's clock, whose base the client cannot know for certain:
-- epoch-like values are compared with GetServerTimeNow, anything else falls back to the base shield.
local function shieldEndFor(shieldUntil: number): number
	local now = os.clock()
	if shieldUntil > 1e9 then
		return now + math.max(0, shieldUntil - workspace:GetServerTimeNow())
	end
	return now + Config.Arena.SpawnShield
end

local function applyTrailDelta(d: Types.TrailDelta)
	local id = d.id
	local list = trails[id]
	if d.clear and list then
		table.clear(list)
	end
	local append = d.append
	if #append > 0 then
		local target = list or {}
		trails[id] = target
		table.move(append, 1, #append, #target + 1, target)
	end
	TurfRenderer.trailDelta(d)
end

local function applyDelta(cells: buffer, trailDeltas: { Types.TrailDelta })
	local g = grid
	if not g then
		table.insert(pendingDeltas, { cells = cells, trails = trailDeltas })
		return
	end
	if buffer.len(cells) >= 2 then
		local changed = g:applyDelta(cells)
		if #changed > 0 then
			TurfRenderer.cellsChanged(changed)
			markChanged()
		end
	end
	for _, d in trailDeltas do
		applyTrailDelta(d)
	end
end

local function isLocal(info: Types.RunnerInfo): boolean
	return info.userId ~= 0 and info.userId == Players.LocalPlayer.UserId
end

local function handleEvent(ev: Types.ArenaEvent)
	if not grid then
		table.insert(pendingEvents, ev)
		return
	end
	local arena = ClientState.arena
	if ev.kind == "spawn" then
		local info = ev.runner
		local id = info.id
		arena.runners[id] = info
		alive[id] = true
		shieldEnds[id] = shieldEndFor(ev.shieldUntil)
		if isLocal(info) then
			arena.myId = id
		end
		if id == arena.myId then
			arena.alive = true
		end
		TurfRenderer.runnerChanged(id)
	elseif ev.kind == "despawn" then
		local id = ev.id
		arena.runners[id] = nil
		arena.cells[id] = nil
		alive[id] = nil
		shieldEnds[id] = nil
		trails[id] = nil
		TurfRenderer.removeRunner(id)
		if id == arena.myId then
			arena.alive = false
		end
	elseif ev.kind == "cut" then
		alive[ev.victim] = false
		if ev.victim == arena.myId then
			arena.alive = false
		end
	elseif ev.kind == "king" then
		arena.kingId = ev.id
	elseif ev.kind == "claim" then
		TurfRenderer.claimFlash(ev.id, ev.stolen > 0)
	end
	markChanged()
	ClientState.arenaEvent:Fire(ev)
end

local function applySnapshot(rle: buffer, runners: { Types.RunnerInfo }, yourRunnerId: number?)
	local g = Grid.decodeRLE(rle)
	grid = g
	local arena = ClientState.arena
	-- Snapshots list pending (cut, awaiting Second Chance) runners too; a re-sent snapshot (first
	-- Request is often DeclineSecondChance/Respawn) must not mark our cut runner alive again.
	local prevId = arena.myId
	local wasCut = prevId ~= nil and alive[prevId] == false
	table.clear(arena.runners)
	table.clear(arena.cells)
	table.clear(alive)
	table.clear(trails)
	for _, info in runners do
		arena.runners[info.id] = info
		alive[info.id] = true
		if yourRunnerId == nil and isLocal(info) then
			yourRunnerId = info.id
		end
	end
	arena.myId = yourRunnerId
	arena.alive = yourRunnerId ~= nil and arena.runners[yourRunnerId :: number] ~= nil
	if wasCut and yourRunnerId == prevId and arena.alive then
		alive[prevId :: number] = false
		arena.alive = false
	end
	arena.totalCells = g.total
	TurfRenderer.applySnapshot(g)

	-- Deltas/events that overtook the snapshot. Delta owners are final values, so replaying is safe.
	local deltas = table.clone(pendingDeltas)
	table.clear(pendingDeltas)
	for _, d in deltas do
		applyDelta(d.cells, d.trails)
	end
	local events = table.clone(pendingEvents)
	table.clear(pendingEvents)
	for _, ev in events do
		handleEvent(ev)
	end
	markChanged()
end

local function applyRunnerInfo(list: { Types.RunnerInfo })
	local arena = ClientState.arena
	for _, info in list do
		arena.runners[info.id] = info
		if isLocal(info) then
			arena.myId = info.id
		end
		TurfRenderer.runnerChanged(info.id)
	end
	markChanged()
end

function ArenaClient.start()
	if started then
		return
	end
	started = true
	TurfRenderer.start()

	local folder = ReplicatedStorage:WaitForChild(Remotes.Folder)
	local snapshotRemote = folder:WaitForChild(Remotes.ArenaSnapshot) :: RemoteEvent
	local deltaRemote = folder:WaitForChild(Remotes.ArenaDelta) :: RemoteEvent
	local eventRemote = folder:WaitForChild(Remotes.ArenaEvent) :: RemoteEvent

	snapshotRemote.OnClientEvent:Connect(applySnapshot)
	deltaRemote.OnClientEvent:Connect(applyDelta)
	eventRemote.OnClientEvent:Connect(handleEvent)

	task.spawn(function()
		local remote = folder:WaitForChild(RUNNER_INFO_REMOTE, RUNNER_INFO_TIMEOUT)
		if remote and remote:IsA("RemoteEvent") then
			remote.OnClientEvent:Connect(applyRunnerInfo)
		end
	end)

	-- Startup ping (GAP-27): lets the server re-send the snapshot once our listeners exist.
	task.spawn(function()
		ClientState.request("Ready")
	end)
end

return ArenaClient
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX00000000000000000000000000000024">
						<Properties>
							<string name="Name">CameraController</string>
							<ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local CameraController = {}
CameraController.shakeEnabled = true

local BIND_NAME = "TurfLoopCamera"
local SMOOTH = 8 -- exponential follow rate
local FULL_SHARE = 0.25

local started = false
local share = 0
local distance: number = Config.Camera.MaxDistance
local focus: Vector3? = nil
local fovPunch = 0
local shakeStrength = 0
local shakeTime = 0
local shakeTotal = 0

function CameraController.setTurfShare(s: number)
	share = math.clamp(s, 0, 1)
end

-- Smoothed world point the camera looks at (nil before the character exists).
function CameraController.getFocus(): Vector3?
	return focus
end

function CameraController.punch(amount: number)
	fovPunch = math.max(fovPunch, amount)
end

function CameraController.shake(strength: number, seconds: number)
	if not CameraController.shakeEnabled or seconds <= 0 then
		return
	end
	shakeStrength = math.max(shakeStrength * (shakeTime / math.max(shakeTotal, 0.001)), strength)
	shakeTime = seconds
	shakeTotal = seconds
end

local function getRoot(): BasePart?
	local char = Players.LocalPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function step(dt: number)
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	cam.CameraType = Enum.CameraType.Scriptable

	local root = getRoot()
	if root then
		local target = root.Position
		local alpha = 1 - math.exp(-SMOOTH * dt)
		focus = if focus then (focus :: Vector3):Lerp(target, alpha) else target
	end
	local f = focus
	if not f then
		return
	end

	local wanted = Config.Camera.MinDistance + (Config.Camera.MaxDistance - Config.Camera.MinDistance) * math.clamp(share / FULL_SHARE, 0, 1)
	distance += (wanted - distance) * (1 - math.exp(-2 * dt))

	local pitch = math.rad(Config.Camera.Pitch)
	-- Camera sits south (+Z) of the focus looking north (-Z), so +X is screen-right.
	local pos = f + Vector3.new(0, math.sin(pitch), math.cos(pitch)) * distance
	local cf = CFrame.lookAt(pos, f)

	if shakeTime > 0 then
		shakeTime = math.max(0, shakeTime - dt)
		local k = shakeStrength * (shakeTime / math.max(shakeTotal, 0.001))
		cf += Vector3.new((math.random() - 0.5) * 2 * k, (math.random() - 0.5) * 2 * k, (math.random() - 0.5) * 2 * k)
	end
	cam.CFrame = cf

	fovPunch -= fovPunch * (1 - math.exp(-10 * dt))
	cam.FieldOfView = Config.Camera.FieldOfView - fovPunch
end

function CameraController.start()
	if started then
		return
	end
	started = true
	RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value + 1, step)
end

return CameraController
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX00000000000000000000000000000025">
						<Properties>
							<string name="Name">FeedbackController</string>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Non-UI game feel from GDD G6: trail danger, claim/cut/death/king/spawn feedback and SFX.
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local SoundIds = require(Shared.SoundIds)
local Types = require(Shared.Types)
local ClientState = require(script.Parent.Parent.ClientState)
local ArenaClient = require(script.Parent.ArenaClient)
local CameraController = require(script.Parent.CameraController)
local TurfRenderer = require(script.Parent.TurfRenderer)

local FeedbackController = {}

-- UI layers set this to show announcements (text, kind "info" | "good" | "bad").
FeedbackController.onToast = nil :: ((text: string, kind: string) -> ())?

local DANGER_INTERVAL = 0.2 -- 5 Hz
local HEARTBEAT_INTERVAL = 0.8
local VIGNETTE_WIDTH = 0.18
local VIGNETTE_MIN = 0.25
local VIGNETTE_MAX = 0.65
local VIGNETTE_HZ = 1.5
local POPUP_TIME = 0.9
local POPUP_RISE = 6
local POPUP_HEIGHT = 3
local REWARD_MATCH_WINDOW = 1.5
local SHAKE_MAX = 0.6
local SHAKE_TIME = 0.35
local PUNCH_FOV = 8 -- G6: FOV 70 -> 62 -> 70
local DESAT_HOLD = 0.3
local DESAT_RECOVER = 0.2
local POP_CELLS = 20
local POP_MAX = 12
local POP_STEP = 0.06
local POP_GAP = 0.05
local CONFETTI_COUNT = 60
local BEAM_HEIGHT = 40
local BEAM_WIDTH = 1.5
local BEAM_RESOLVE = 0.5
local SHIELD_SIZE = 7
local SOUND_POOL = 4
local MUSIC_VOLUME = 0.15
local FIRST_POPUP_SCALE = 2.5
local OTHER_BURST_SCALE = 0.4
local OTHER_BURST_RANGE = 150 -- studs from the camera focus
local OTHER_BURST_SLOTS = 8
local CUBE_COUNT = 24
local CUBE_SIZE = 0.8
local CUBE_FLIGHT = 0.4
local CUBE_SEARCH = 12 -- cells around the victim
local CUBE_TRIES = 96
local CROWN_DROP = 8 -- studs the crown falls
local CROWN_DROP_TIME = 0.35
local CROWN_SPIKES = 5
local CROWN_RADIUS = 0.55
local CROWN_RETRY = 0.5
local BAND_ROT = CFrame.Angles(0, 0, math.rad(90)) -- cylinder axis is X; stand it upright

local CONFETTI_MIN_CELLS = Config.Income.CaptureBonus[1].MinCells
local SHAKE_FULL_CELLS = Config.Income.CaptureBonus[#Config.Income.CaptureBonus].MinCells
local FLOOR = Config.Arena.FloorY
local DANGER_COLOR = Color3.fromHex(Config.Colors.Danger)
local COIN_COLOR = Color3.fromHex(Config.Colors.Yellow)
local GEM_COLOR = Color3.fromHex(Config.Colors.Gem)
local STROKE_COLOR = Color3.fromHex(Config.Colors.UiDark)

type Preset = {
	count: number,
	speed: NumberRange,
	lifetime: NumberRange,
	size: NumberSequence,
	transparency: NumberSequence,
	spread: Vector2,
	accel: Vector3,
	drag: number,
	light: number,
	rot: NumberRange,
	shape: Enum.ParticleEmitterShape,
}

-- Capture-effect cosmetics keyed by Catalog effect id; shapes differ by motion, not texture.
local PRESETS: { [string]: Preset } = {
	sparkle = {
		count = 30,
		speed = NumberRange.new(4, 10),
		lifetime = NumberRange.new(0.4, 0.8),
		size = NumberSequence.new(0.6, 0),
		transparency = NumberSequence.new(0, 0.6),
		spread = Vector2.new(180, 180),
		accel = Vector3.new(0, 2, 0),
		drag = 3,
		light = 1,
		rot = NumberRange.new(-180, 180),
		shape = Enum.ParticleEmitterShape.Sphere,
	},
	fireworks = {
		count = 50,
		speed = NumberRange.new(25, 35),
		lifetime = NumberRange.new(0.8, 1.2),
		size = NumberSequence.new(0.5, 0.1),
		transparency = NumberSequence.new(0, 1),
		spread = Vector2.new(60, 60),
		accel = Vector3.new(0, -30, 0),
		drag = 2,
		light = 1,
		rot = NumberRange.new(0, 0),
		shape = Enum.ParticleEmitterShape.Box,
	},
	bubbles = {
		count = 20,
		speed = NumberRange.new(2, 5),
		lifetime = NumberRange.new(1.5, 2.5),
		size = NumberSequence.new(0.8, 1.6),
		transparency = NumberSequence.new(0.3, 1),
		spread = Vector2.new(180, 180),
		accel = Vector3.new(0, 6, 0),
		drag = 1,
		light = 0.2,
		rot = NumberRange.new(0, 0),
		shape = Enum.ParticleEmitterShape.Sphere,
	},
	lightning = {
		count = 40,
		speed = NumberRange.new(40, 60),
		lifetime = NumberRange.new(0.15, 0.3),
		size = NumberSequence.new(0.4, 0),
		transparency = NumberSequence.new(0, 0.2),
		spread = Vector2.new(180, 180),
		accel = Vector3.zero,
		drag = 0,
		light = 1,
		rot = NumberRange.new(0, 0),
		shape = Enum.ParticleEmitterShape.Box,
	},
	hearts = {
		count = 24,
		speed = NumberRange.new(6, 10),
		lifetime = NumberRange.new(1, 1.6),
		size = NumberSequence.new(1.2, 0.4),
		transparency = NumberSequence.new(0, 1),
		spread = Vector2.new(35, 35),
		accel = Vector3.new(0, 4, 0),
		drag = 2,
		light = 0.5,
		rot = NumberRange.new(-30, 30),
		shape = Enum.ParticleEmitterShape.Box,
	},
}

local CONFETTI_COLORS = { 1, 3, 7, 11 } -- indices into Config.Colors.Players

local started = false
local effectsFolder: Folder? = nil
local vignetteEdges: { Frame } = {}
local colorCorrection: ColorCorrectionEffect? = nil
local beam: BasePart? = nil
local rng = Random.new()
local musicSound: Sound? = nil
local firstClaimShown = false
local questReady: { [string]: boolean } = {}
local questSeeded = false
local otherBursts: { { anchor: BasePart, pe: ParticleEmitter } } = {}
local otherBurstNext = 0
type Cube = { part: BasePart, from: Vector3, t0: number }
local cubePool: { BasePart } = {}
local flyingCubes: { Cube } = {}
type Crown = { model: Model, base: BasePart, head: BasePart, kingId: number, t0: number, landed: boolean }
local crown: Crown? = nil
local crownTryAt = 0

local soundPools: { [string]: { Sound } } = {}
local soundNext: { [string]: number } = {}

local dangerAcc = 0
local dangerOn = false
local dangerId: number? = nil
local nextBeat = 0
local lastTrailLen = 0
local lastCutAt = -math.huge
local lastDesatAt = -math.huge

local kingTarget: PVInstance? = nil
local kingResolveAt = 0
type Shield = { part: BasePart, ends: number }
local shields: { [number]: Shield } = {}

local function settings(): { music: boolean, sfx: boolean, shake: boolean, lowDetail: boolean }?
	local profile = ClientState.profile
	return if profile then profile.settings else nil
end

function FeedbackController.play(name: string, pitch: number?)
	local id = SoundIds[name]
	if not id or id == 0 then
		return
	end
	local s = settings()
	if s and not s.sfx then
		return
	end
	local pool = soundPools[name]
	if not pool then
		pool = {}
		soundPools[name] = pool
	end
	local k = (soundNext[name] or 0) % SOUND_POOL + 1
	soundNext[name] = k
	local list = pool :: { Sound }
	local snd = list[k]
	if not snd then
		local created = Instance.new("Sound")
		created.Name = name
		created.SoundId = "rbxassetid://" .. id
		created.Parent = SoundService
		list[k] = created
		snd = created
	end
	snd.PlaybackSpeed = pitch or 1
	snd.TimePosition = 0
	snd:Play()
end

local function runnerInstance(id: number): PVInstance?
	local info = ClientState.arena.runners[id]
	if not info then
		return nil
	end
	if info.isBot then
		local bots = workspace:FindFirstChild("Bots")
		local rig = bots and bots:FindFirstChild(tostring(id))
		if rig and rig:IsA("PVInstance") then
			return rig
		end
		return nil
	end
	local player = Players:GetPlayerByUserId(info.userId)
	local char = player and player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function cellWorld(cx: number, cy: number, height: number): Vector3?
	local g = ArenaClient.getGrid()
	if not g then
		return nil
	end
	local wx, wz = g:cellToWorld(cx, cy)
	return Vector3.new(wx, FLOOR + height, wz)
end

local function tempAnchor(pos: Vector3, lifetime: number): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.CFrame = CFrame.new(pos)
	p.Parent = effectsFolder
	Debris:AddItem(p, lifetime)
	return p
end

local function popup(pos: Vector3, text: string, color: Color3, scale: number?)
	local anchor = tempAnchor(pos, POPUP_TIME + 0.1)
	local bb = Instance.new("BillboardGui")
	local k = scale or 1
	bb.Size = UDim2.fromOffset(160 * k, 56 * k)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Adornee = anchor
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeColor3 = STROKE_COLOR
	label.TextStrokeTransparency = 0
	label.Parent = bb
	bb.Parent = anchor
	TweenService:Create(anchor, TweenInfo.new(POPUP_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		CFrame = anchor.CFrame + Vector3.new(0, POPUP_RISE, 0),
	}):Play()
	TweenService:Create(label, TweenInfo.new(POPUP_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()
end

local function configureEmitter(pe: ParticleEmitter, preset: Preset, color: ColorSequence)
	pe.Enabled = false
	pe.Rate = 0
	pe.Color = color
	pe.Speed = preset.speed
	pe.Lifetime = preset.lifetime
	pe.Size = preset.size
	pe.Transparency = preset.transparency
	pe.SpreadAngle = preset.spread
	pe.Acceleration = preset.accel
	pe.Drag = preset.drag
	pe.LightEmission = preset.light
	pe.Rotation = preset.rot
	pe.RotSpeed = preset.rot
	pe.Shape = preset.shape
	pe.EmissionDirection = Enum.NormalId.Top
end

local function lowDetail(): boolean
	local s = settings()
	return s ~= nil and s.lowDetail
end

local function burst(pos: Vector3, effectId: string, scale: number?)
	local preset = PRESETS[effectId] or PRESETS.sparkle
	local item = Catalog.byId(effectId)
	local a = if item then Color3.fromHex(item.colorA) else COIN_COLOR
	local b = if item and item.colorB then Color3.fromHex(item.colorB) else a
	local anchor = tempAnchor(pos, preset.lifetime.Max + 0.5)
	local pe = Instance.new("ParticleEmitter")
	configureEmitter(pe, preset, ColorSequence.new(a, b))
	pe.Parent = anchor
	local n = if lowDetail() then preset.count // 2 else preset.count
	pe:Emit(math.max(1, math.floor(n * (scale or 1))))
end

-- Other runners' capture effect: a fixed ring of reusable emitters, reduced count, no Instance churn.
local function burstOther(pos: Vector3, effectId: string)
	local folder = effectsFolder
	if not folder then
		return
	end
	local preset = PRESETS[effectId] or PRESETS.sparkle
	local item = Catalog.byId(effectId)
	local a = if item then Color3.fromHex(item.colorA) else COIN_COLOR
	local b = if item and item.colorB then Color3.fromHex(item.colorB) else a
	otherBurstNext = otherBurstNext % OTHER_BURST_SLOTS + 1
	local slot = otherBursts[otherBurstNext]
	if not slot then
		local anchor = Instance.new("Part")
		anchor.Name = "OtherBurst"
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.CanTouch = false
		anchor.CanQuery = false
		anchor.CastShadow = false
		anchor.Transparency = 1
		anchor.Size = Vector3.new(1, 1, 1)
		local pe = Instance.new("ParticleEmitter")
		pe.Parent = anchor
		anchor.Parent = folder
		slot = { anchor = anchor, pe = pe }
		otherBursts[otherBurstNext] = slot
	end
	local s = slot :: { anchor: BasePart, pe: ParticleEmitter }
	s.anchor.CFrame = CFrame.new(pos)
	configureEmitter(s.pe, preset, ColorSequence.new(a, b))
	s.pe:Emit(math.max(1, math.floor(preset.count * OTHER_BURST_SCALE)))
end

local confettiPreset: Preset = {
	count = CONFETTI_COUNT,
	speed = NumberRange.new(20, 30),
	lifetime = NumberRange.new(1.2, 1.8),
	size = NumberSequence.new(0.5, 0.4),
	transparency = NumberSequence.new(0, 0.8),
	spread = Vector2.new(50, 50),
	accel = Vector3.new(0, -25, 0),
	drag = 1.5,
	light = 0,
	rot = NumberRange.new(-360, 360),
	shape = Enum.ParticleEmitterShape.Box,
}

local function confetti(pos: Vector3)
	local anchor = tempAnchor(pos, confettiPreset.lifetime.Max + 0.5)
	local per = (if lowDetail() then CONFETTI_COUNT // 2 else CONFETTI_COUNT) // #CONFETTI_COLORS
	for _, idx in CONFETTI_COLORS do
		local pe = Instance.new("ParticleEmitter")
		configureEmitter(pe, confettiPreset, ColorSequence.new(Color3.fromHex(Config.Colors.Players[idx])))
		pe.Parent = anchor
		pe:Emit(per)
	end
end

local function myRootPosition(): Vector3?
	local char = Players.LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end
	return nil
end

local function desaturate()
	local cc = colorCorrection
	local now = os.clock()
	if not cc or now - lastDesatAt < DESAT_HOLD + DESAT_RECOVER then
		return
	end
	lastDesatAt = now
	cc.Saturation = -1
	cc.Enabled = true
	task.delay(DESAT_HOLD, function()
		local tween = TweenService:Create(cc, TweenInfo.new(DESAT_RECOVER), { Saturation = 0 })
		tween.Completed:Connect(function(state)
			if state == Enum.PlaybackState.Completed and cc.Saturation > -0.01 then
				cc.Enabled = false
			end
		end)
		tween:Play()
	end)
end

local function setDanger(on: boolean, id: number?)
	if on == dangerOn and id == dangerId then
		return
	end
	if dangerId then
		TurfRenderer.setTrailDanger(dangerId, false)
	end
	dangerOn = on and id ~= nil
	dangerId = if dangerOn then id else nil
	if dangerOn then
		TurfRenderer.setTrailDanger(id :: number, true)
		nextBeat = 0
	end
	for _, f in vignetteEdges do
		f.Visible = dangerOn
	end
end

local function checkDanger()
	local arena = ClientState.arena
	local myId = arena.myId
	local g = ArenaClient.getGrid()
	local trail = if myId then ArenaClient.trails[myId] else nil
	local n = if trail then #trail else 0
	if n > 0 and lastTrailLen == 0 and arena.alive then
		FeedbackController.play("trailStart")
	end
	lastTrailLen = n
	if not (g and myId and trail and arena.alive and n > 0) then
		setDanger(false, nil)
		return
	end
	local size = g.size
	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	for _, i in trail do
		local x, y = i % size, i // size
		minX, maxX = math.min(minX, x), math.max(maxX, x)
		minY, maxY = math.min(minY, y), math.max(maxY, y)
	end
	local r = Config.Arena.TrailDangerRadius
	local r2 = r * r
	local now = os.clock()
	local found = false
	for id in arena.runners do
		if id ~= myId and ArenaClient.alive[id] and (ArenaClient.shieldEnds[id] or 0) <= now then
			local inst = runnerInstance(id)
			if inst then
				local pos = inst:GetPivot().Position
				local px, py = g:worldToCell(pos.X, pos.Z)
				if px >= minX - r and px <= maxX + r and py >= minY - r and py <= maxY + r then
					for _, i in trail do
						local dx, dy = i % size - px, i // size - py
						if dx * dx + dy * dy <= r2 then
							found = true
							break
						end
					end
				end
			end
		end
		if found then
			break
		end
	end
	setDanger(found, myId)
end

local function onClaim(ev: { id: number, cells: number, neutral: number, stolen: number, cx: number, cy: number })
	local cells = ev.cells
	local steps = math.clamp(math.ceil(cells / POP_CELLS), 1, POP_MAX)
	for k = 0, steps - 1 do
		task.delay(k * POP_GAP, FeedbackController.play, "claimPop", 1 + POP_STEP * k)
	end
	if ev.stolen > 0 then
		FeedbackController.play("stealCrunch")
	end
	local s = settings()
	if s and s.shake then
		CameraController.shake(SHAKE_MAX * math.clamp(cells / SHAKE_FULL_CELLS, 0, 1), SHAKE_TIME)
	end
	local pos = cellWorld(ev.cx, ev.cy, 1)
	if not pos then
		return
	end
	-- G7.3: the very first capture of a new player always gets confetti and an oversized popup.
	local profile = ClientState.profile
	local first = not firstClaimShown and profile ~= nil and not profile.tutorialDone
	if first then
		firstClaimShown = true
		popup(pos + Vector3.new(0, POPUP_HEIGHT, 0), "+" .. cells, COIN_COLOR, FIRST_POPUP_SCALE)
	end
	if cells >= CONFETTI_MIN_CELLS or first then
		FeedbackController.play("bigClaim")
		confetti(pos)
	end
	local info = ClientState.arena.runners[ev.id]
	burst(pos, if info then info.effect else "sparkle")
end

-- Capture effect of another runner's claim: reduced, skipped in low detail and when far from the camera focus.
local function onOtherClaim(ev: { id: number, cells: number, neutral: number, stolen: number, cx: number, cy: number })
	if lowDetail() then
		return
	end
	local pos = cellWorld(ev.cx, ev.cy, 1)
	local focus = CameraController.getFocus()
	if not pos or not focus then
		return
	end
	local d = pos - focus
	if Vector3.new(d.X, 0, d.Z).Magnitude > OTHER_BURST_RANGE then
		return
	end
	local info = ClientState.arena.runners[ev.id]
	burstOther(pos, if info then info.effect else "sparkle")
end

-- Turf shatter: small cubes in the victim's colour fly from their former turf to the killer.
local function cubeFor(index: number): BasePart?
	local p = cubePool[index]
	if p then
		return p
	end
	local folder = effectsFolder
	if not folder then
		return nil
	end
	local created = Instance.new("Part")
	created.Name = "ShatterCube"
	created.Anchored = true
	created.CanCollide = false
	created.CanTouch = false
	created.CanQuery = false
	created.CastShadow = false
	created.Size = Vector3.new(CUBE_SIZE, CUBE_SIZE, CUBE_SIZE)
	created.Material = Enum.Material.SmoothPlastic
	cubePool[index] = created
	return created
end

local function shatterTurf(victim: number)
	if lowDetail() or #flyingCubes > 0 then
		return
	end
	local g = ArenaClient.getGrid()
	local folder = effectsFolder
	local root = myRootPosition()
	if not (g and folder and root) then
		return
	end
	local inst = runnerInstance(victim)
	local origin = if inst then inst:GetPivot().Position else root
	local ox, oy = g:worldToCell(origin.X, origin.Z)
	local color = TurfRenderer.colorOf(victim)
	local now = os.clock()
	local made = 0
	for _ = 1, CUBE_TRIES do
		if made >= CUBE_COUNT then
			break
		end
		local x = ox + rng:NextInteger(-CUBE_SEARCH, CUBE_SEARCH)
		local y = oy + rng:NextInteger(-CUBE_SEARCH, CUBE_SEARCH)
		if g:inBounds(x, y) and g:get(x, y) == victim then
			local part = cubeFor(made + 1)
			if part then
				made += 1
				local wx, wz = g:cellToWorld(x, y)
				local from = Vector3.new(wx, FLOOR + 1, wz)
				part.Color = color
				part.CFrame = CFrame.new(from)
				part.Parent = folder
				table.insert(flyingCubes, { part = part, from = from, t0 = now })
			end
		end
	end
end

local function runnerName(id: number): string
	local info = ClientState.arena.runners[id]
	return if info then info.name else "?"
end

local function onSpawn(info: Types.RunnerInfo)
	local id = info.id
	if id == ClientState.arena.myId then
		FeedbackController.play("respawnWhoosh")
	end
	local old = shields[id]
	if old then
		old.part:Destroy()
		shields[id] = nil
	end
	if info.isBot then
		return
	end
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(SHIELD_SIZE, SHIELD_SIZE, SHIELD_SIZE)
	p.Material = Enum.Material.ForceField
	p.Color = GEM_COLOR
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	shields[id] = { part = p, ends = ArenaClient.shieldEnds[id] or os.clock() }
end

local function removeCrown()
	local c = crown
	crown = nil
	if c then
		c.model:Destroy()
	end
end

local function onEvent(ev: Types.ArenaEvent)
	local arena = ClientState.arena
	local myId = arena.myId
	if ev.kind == "claim" then
		if ev.id == myId then
			onClaim(ev)
		else
			onOtherClaim(ev)
		end
	elseif ev.kind == "cut" then
		if ev.killer == myId then
			lastCutAt = os.clock()
			CameraController.punch(PUNCH_FOV)
			FeedbackController.play("snip")
			shatterTurf(ev.victim)
		end
		if ev.victim == myId then
			FeedbackController.play("deathPop")
			desaturate()
		end
	elseif ev.kind == "king" then
		kingTarget = nil
		kingResolveAt = 0
		removeCrown()
		if ev.id ~= 0 then
			FeedbackController.play("crownFanfare")
			local toast = FeedbackController.onToast
			if toast then
				toast(if ev.id == myId then "You are the King!" else runnerName(ev.id) .. " is the King!", "good")
			end
		end
	elseif ev.kind == "fullMap" then
		-- Announced by the server's Toast remote (ArenaService.onFullMap); a second toast here duplicated it.
	elseif ev.kind == "spawn" then
		onSpawn(ev.runner)
	elseif ev.kind == "despawn" then
		local sh = shields[ev.id]
		if sh then
			sh.part:Destroy()
			shields[ev.id] = nil
		end
	end
end

local function onReward(payload: { coins: number?, gems: number?, reason: string, cx: number?, cy: number? })
	local coins, gems = payload.coins, payload.gems
	local text: string, color: Color3
	if coins and coins > 0 then
		text, color = "+" .. math.floor(coins), COIN_COLOR
	elseif gems and gems > 0 then
		text, color = "+" .. math.floor(gems) .. " gems", GEM_COLOR
	else
		return
	end
	local pos: Vector3? = nil
	local cx, cy = payload.cx, payload.cy
	if cx and cy then
		pos = cellWorld(cx, cy, POPUP_HEIGHT)
	elseif os.clock() - lastCutAt < REWARD_MATCH_WINDOW then
		local root = myRootPosition()
		pos = if root then root + Vector3.new(0, POPUP_HEIGHT, 0) else nil
	end
	if pos then
		popup(pos, text, color)
	end
end

-- Head part of a runner: the character's Head for players, the Head of the rig under workspace.Bots for bots.
local function headOf(id: number): BasePart?
	local info = ClientState.arena.runners[id]
	if not info then
		return nil
	end
	local owner: Instance? = nil
	if info.isBot then
		local bots = workspace:FindFirstChild("Bots")
		owner = bots and bots:FindFirstChild(tostring(id))
	else
		local player = Players:GetPlayerByUserId(info.userId)
		owner = player and player.Character
	end
	local head = owner and owner:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head
	end
	return nil
end

local function crownPart(model: Model, size: Vector3, shape: Enum.PartType): Part
	local p = Instance.new("Part")
	p.Shape = shape
	p.Size = size
	p.Anchored = true -- until the drop-in lands
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Massless = true
	p.Material = Enum.Material.Metal
	p.Color = COIN_COLOR
	p.Parent = model
	return p
end

local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = a
end

-- Crown for the King: gold band plus CROWN_SPIKES ball spikes (6 Parts), dropped onto the head.
local function attachCrown(kingId: number, head: BasePart)
	local model = Instance.new("Model")
	model.Name = "KingCrown"
	model:SetAttribute("Placeholder", "M3")
	local band = crownPart(model, Vector3.new(0.4, CROWN_RADIUS * 2.2, CROWN_RADIUS * 2.2), Enum.PartType.Cylinder)
	model.PrimaryPart = band
	band.CFrame = BAND_ROT
	for i = 1, CROWN_SPIKES do
		local a = (i - 1) / CROWN_SPIKES * math.pi * 2
		local spike = crownPart(model, Vector3.new(0.35, 0.35, 0.35), Enum.PartType.Ball)
		spike.CFrame = CFrame.new(math.cos(a) * CROWN_RADIUS, 0.3, math.sin(a) * CROWN_RADIUS)
		weld(band, spike)
	end
	local rest = head.CFrame * CFrame.new(0, head.Size.Y * 0.5 + 0.3, 0)
	model:PivotTo(rest * CFrame.new(0, CROWN_DROP, 0) * BAND_ROT)
	model.Parent = head
	crown = { model = model, base = band, head = head, kingId = kingId, t0 = os.clock(), landed = false }
end

local function stepCrown(now: number, kingId: number)
	local c = crown
	if c and (c.kingId ~= kingId or not c.model:IsDescendantOf(workspace)) then
		removeCrown()
		c = nil
	end
	if not c then
		if kingId ~= 0 and now >= crownTryAt then
			crownTryAt = now + CROWN_RETRY
			local head = headOf(kingId)
			if head then
				attachCrown(kingId, head)
			end
		end
		return
	end
	local rest = c.head.CFrame * CFrame.new(0, c.head.Size.Y * 0.5 + 0.3, 0)
	if c.landed then
		return
	end
	local a = math.clamp((now - c.t0) / CROWN_DROP_TIME, 0, 1)
	local eased = a * a -- accelerate like a fall
	c.model:PivotTo(rest * CFrame.new(0, CROWN_DROP * (1 - eased), 0) * BAND_ROT)
	if a >= 1 then
		-- Landed: release the anchors and weld the band to the head.
		c.landed = true
		for _, d in c.model:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = false
			end
		end
		weld(c.head, c.base)
	end
end

local function stepCubes(now: number)
	local n = #flyingCubes
	if n == 0 then
		return
	end
	local root = myRootPosition()
	for i = n, 1, -1 do
		local cube = flyingCubes[i]
		local a = (now - cube.t0) / CUBE_FLIGHT
		if a >= 1 or not root then
			cube.part.Parent = nil
			table.remove(flyingCubes, i)
		else
			cube.part.CFrame = CFrame.new(cube.from:Lerp(root, a * a))
		end
	end
end

local function startMusic()
	local id = SoundIds.arenaMusic
	if not id or id == 0 then
		return
	end
	local s = settings()
	local want = s ~= nil and s.music
	local snd = musicSound
	if want then
		if not snd then
			local created = Instance.new("Sound")
			created.Name = "ArenaMusic"
			created.SoundId = "rbxassetid://" .. id
			created.Looped = true
			created.Volume = MUSIC_VOLUME
			created.Parent = SoundService
			musicSound = created
			snd = created
		end
		if not (snd :: Sound).Playing then
			(snd :: Sound):Play()
		end
	elseif snd and snd.Playing then
		snd:Stop()
	end
end

-- Plays questComplete when a quest newly becomes claimable (the first profile only seeds the state).
local function checkQuests()
	local profile = ClientState.profile
	if not profile then
		return
	end
	local newly = false
	for _, entry in profile.quests.list do
		local def = ClientState.quest(entry.id)
		local ready = def ~= nil and not entry.claimed and entry.progress >= def.target
		if ready and not questReady[entry.id] and questSeeded then
			newly = true
		end
		questReady[entry.id] = ready
	end
	questSeeded = true
	if newly then
		FeedbackController.play("questComplete")
	end
end

local function step(dt: number)
	local now = os.clock()
	dangerAcc += dt
	if dangerAcc >= DANGER_INTERVAL then
		dangerAcc = 0
		checkDanger()
	end

	if dangerOn then
		local t = 0.5 + 0.5 * math.sin(now * VIGNETTE_HZ * 2 * math.pi)
		local transparency = VIGNETTE_MIN + (VIGNETTE_MAX - VIGNETTE_MIN) * t
		for _, f in vignetteEdges do
			f.BackgroundTransparency = transparency
		end
		if now >= nextBeat then
			nextBeat = now + HEARTBEAT_INTERVAL
			FeedbackController.play("heartbeat")
		end
	end

	stepCubes(now)

	stepCrown(now, ClientState.arena.kingId)

	local b = beam
	if b then
		local kingId = ClientState.arena.kingId
		if kingId ~= 0 and now >= kingResolveAt then
			kingResolveAt = now + BEAM_RESOLVE
			kingTarget = runnerInstance(kingId)
		end
		local target = if kingId ~= 0 then kingTarget else nil
		if target and target.Parent then
			b.CFrame = CFrame.new(target:GetPivot().Position + Vector3.new(0, BEAM_HEIGHT * 0.5 + 3, 0))
			if b.Parent ~= effectsFolder then
				b.Parent = effectsFolder
			end
		elseif b.Parent then
			b.Parent = nil
		end
	end

	for id, sh in shields do
		local inst = if now < sh.ends then runnerInstance(id) else nil
		if now >= sh.ends then
			sh.part:Destroy()
			shields[id] = nil
		elseif inst then
			sh.part.CFrame = inst:GetPivot()
			if sh.part.Parent ~= effectsFolder then
				sh.part.Parent = effectsFolder
			end
		end
	end
end

local function buildVignette()
	local gui = Instance.new("ScreenGui")
	gui.Name = "FeedbackVignette"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = -10
	local w = VIGNETTE_WIDTH
	-- UIGradient rotation picks which edge is opaque: 0 left, 180 right, 90 top, -90 bottom.
	local edges = {
		{ UDim2.fromScale(0, 0), UDim2.fromScale(w, 1), 0 },
		{ UDim2.fromScale(1 - w, 0), UDim2.fromScale(w, 1), 180 },
		{ UDim2.fromScale(0, 0), UDim2.fromScale(1, w), 90 },
		{ UDim2.fromScale(0, 1 - w), UDim2.fromScale(1, w), -90 },
	}
	for _, e in edges do
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.BackgroundColor3 = DANGER_COLOR
		f.BackgroundTransparency = VIGNETTE_MIN
		f.Position = e[1] :: UDim2
		f.Size = e[2] :: UDim2
		f.Visible = false
		local gradient = Instance.new("UIGradient")
		gradient.Rotation = e[3] :: number
		gradient.Transparency = NumberSequence.new(0, 1)
		gradient.Parent = f
		f.Parent = gui
		table.insert(vignetteEdges, f)
	end
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
end

function FeedbackController.start()
	if started then
		return
	end
	started = true

	local folder = Instance.new("Folder")
	folder.Name = "Feedback"
	folder.Parent = workspace
	effectsFolder = folder

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "DeathDesaturate"
	cc.Enabled = false
	cc.Parent = Lighting
	colorCorrection = cc

	local b = Instance.new("Part")
	b.Name = "KingBeam"
	b.Anchored = true
	b.CanCollide = false
	b.CanTouch = false
	b.CanQuery = false
	b.CastShadow = false
	b.Material = Enum.Material.Neon
	b.Color = COIN_COLOR
	b.Transparency = 0.35
	b.Size = Vector3.new(BEAM_WIDTH, BEAM_HEIGHT, BEAM_WIDTH)
	beam = b

	task.spawn(buildVignette)

	local function readSettings()
		local s = settings()
		if s then
			CameraController.shakeEnabled = s.shake
		end
		startMusic()
		checkQuests()
	end
	ClientState.profileChanged:Connect(readSettings)
	readSettings()

	ClientState.arenaEvent:Connect(onEvent)
	ClientState.reward:Connect(onReward)
	ClientState.death:Connect(desaturate)
	RunService.Heartbeat:Connect(step)
end

return FeedbackController
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX00000000000000000000000000000026">
						<Properties>
							<string name="Name">HudController</string>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Always-on HUD: wallet, map %, boost/weekend chips, leaderboard, kill feed, button rail, playtime bar.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Types = require(Shared.Types)
local Catalog = require(Shared.Catalog)
local Formulas = require(Shared.Formulas)
local Remotes = require(Shared.Remotes)
local UiKit = require(script.Parent.Parent.ui.UiKit)
local ClientState = require(script.Parent.Parent.ClientState)
local PanelController = require(script.Parent.PanelController)
local ArenaClient = require(script.Parent.ArenaClient)
local TurfRenderer = require(script.Parent.TurfRenderer)
local FeedbackController = require(script.Parent.FeedbackController)

local S = {
	coinsIcon = "C",
	gemsIcon = "G",
	crownsIcon = "K",
	mapLabel = "MAP",
	percent = "%.1f%%",
	boost = "%dx %s",
	weekend = "%dx WEEKEND",
	kingMark = "K",
	starterBadge = "!",
	cutFeed = "%s cut %s",
	unknownRunner = "Someone",
	timeFormat = "%d:%02d",
	claimed = "OK",
	rewardClaimed = "Reward claimed",
	rail = {
		{ panel = "Upgrades", text = "Upgrades" },
		{ panel = "Shop", text = "Shop" },
		{ panel = "Quests", text = "Quests" },
		{ panel = "Daily", text = "Daily" },
		{ panel = "Rebirth", text = "Rebirth" },
		{ panel = "Codes", text = "Codes" },
		{ panel = "Settings", text = "Settings" },
	},
}

local BOARD_ROWS = 8
local MAX_FEED = 4
local FEED_SECONDS = 5
local FEED_FADE = 0.5
local ROLL_SECONDS = 0.5
local TICK_SECONDS = 0.5
local COIN_TICK_INTERVAL = 0.1 -- coinTick plays at most 10 times per second while the wallet rolls
local MINI_BLOCK = 8 -- cells per minimap block side
local MINI_HEIGHT = 0.16 -- fraction of screen height
local MINI_BLOCKS_PER_TICK = 100
local MINI_DOT = 7
local MINI_DOT_PERIOD = 0.1
local MINI_BLOCK_EVERY = 5 -- dot periods per block refresh (2 Hz)

local theme = UiKit.theme
local PANEL_BG = Color3.fromHex(Config.Colors.UiDark)

local started = false
local railButtons: { [string]: TextButton } = {}

local function formatTime(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format(S.timeFormat, seconds // 60, seconds % 60)
end

local function escapeRich(text: string): string
	return (string.gsub(text, "[<>&]", ""))
end

local function playerColorHex(colorIndex: number): string
	return Config.Colors.Players[colorIndex] or Config.Colors.UiLight
end

local VIP_GOLD_HEX = Config.Colors.Yellow

-- RunnerInfo.vip is added by the server later; nil counts as false.
local function isVip(runner: Types.RunnerInfo): boolean
	return (runner :: any).vip == true
end

local function currencyColor(currency: string): Color3
	return if currency == "gems" then theme.Gem else theme.Yellow
end

-- Wallet ------------------------------------------------------------------------------------

local function walletRow(parent: Frame, order: number, icon: string, color: Color3): TextLabel
	local row = UiKit.frame({
		Name = "Row" .. order,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 0.3),
		LayoutOrder = order,
		parent = parent,
	})
	local badge = UiKit.frame({
		Name = "Badge",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromScale(0.16, 0.9),
		BackgroundColor3 = color,
		parent = row,
	})
	UiKit.corner(badge, 100)
	UiKit.aspect(badge, 1)
	local mark = UiKit.label({
		Text = icon,
		TextColor3 = theme.UiDark,
		Size = UDim2.fromScale(0.7, 0.7),
		Position = UDim2.fromScale(0.15, 0.15),
		parent = badge,
	})
	mark.Name = "Mark"
	return UiKit.label({
		Name = "Value",
		Text = "0",
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.fromScale(0.78, 0.8),
		Position = UDim2.fromScale(0.22, 0.1),
		parent = row,
	})
end

local function buildWallet(gui: ScreenGui)
	local wallet = UiKit.frame({
		Name = "Wallet",
		Position = UDim2.fromScale(0.012, 0.02),
		Size = UDim2.fromScale(0.17, 0.16),
		BackgroundColor3 = PANEL_BG,
		BackgroundTransparency = 0.25,
		parent = gui,
	})
	UiKit.corner(wallet, 12)
	UiKit.padding(wallet, 0.03)
	UiKit.list(wallet, { Padding = UDim.new(0.03, 0) })

	local labels = {
		coins = walletRow(wallet, 1, S.coinsIcon, theme.Yellow),
		gems = walletRow(wallet, 2, S.gemsIcon, theme.Gem),
		crowns = walletRow(wallet, 3, S.crownsIcon, theme.Pink),
	}
	local shown: { [string]: number } = {}
	local lastTick = -math.huge
	local function tickFormat(n: number): string
		local now = os.clock()
		if now - lastTick >= COIN_TICK_INTERVAL then
			lastTick = now
			FeedbackController.play("coinTick")
		end
		return UiKit.formatNumber(n)
	end

	local function update()
		local p = ClientState.profile
		if p == nil then
			return
		end
		local values = { coins = p.coins, gems = p.gems, crowns = p.crowns }
		for key, label in labels do
			local new = values[key]
			local old = shown[key]
			if old == nil then
				UiKit.rollNumber(label, new, new, 0)
			elseif old ~= new then
				UiKit.rollNumber(label, old, new, ROLL_SECONDS, if key == "coins" then tickFormat else nil)
			end
			shown[key] = new
		end
	end
	ClientState.profileChanged:Connect(update)
	update()
end

-- Top centre: map %, boost chip, weekend chip -----------------------------------------------

local function chip(parent: Instance, name: string, width: number, color: Color3, order: number): (Frame, TextLabel, TextLabel)
	local f = UiKit.frame({
		Name = name,
		Size = UDim2.fromScale(width, 1),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.15,
		LayoutOrder = order,
		parent = parent,
	})
	UiKit.corner(f, 12)
	local top = UiKit.label({
		Name = "Main",
		Size = UDim2.fromScale(0.9, 0.55),
		Position = UDim2.fromScale(0.05, 0.05),
		parent = f,
	})
	local sub = UiKit.label({
		Name = "Sub",
		Size = UDim2.fromScale(0.9, 0.3),
		Position = UDim2.fromScale(0.05, 0.64),
		TextTransparency = 0.25,
		parent = f,
	})
	return f, top, sub
end

local function buildTopCentre(gui: ScreenGui)
	local holder = UiKit.frame({
		Name = "TopCentre",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.02),
		Size = UDim2.fromScale(0.34, 0.09),
		parent = gui,
	})
	UiKit.list(holder, {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0.02, 0),
	})

	local _, mapMain, mapSub = chip(holder, "Map", 0.34, PANEL_BG, 1)
	mapSub.Text = S.mapLabel
	mapMain.Text = string.format(S.percent, 0)

	local boostChip, boostMain, boostSub = chip(holder, "Boost", 0.3, theme.Pink, 2)
	boostChip.Visible = false
	boostSub.Text = ""

	local weekendChip, weekendMain, _ = chip(holder, "Weekend", 0.3, theme.Success, 3)
	weekendChip.Visible = false
	weekendMain.Text = string.format(S.weekend, Config.Income.WeekendMultiplier)
	weekendMain.TextColor3 = theme.UiDark
	weekendMain.Size = UDim2.fromScale(0.9, 0.7)
	weekendMain.Position = UDim2.fromScale(0.05, 0.15)

	local lastPct = -1
	local function updateMap()
		local pct = math.floor(ClientState.myShare() * 1000 + 0.5) / 10
		if pct ~= lastPct then
			lastPct = pct
			mapMain.Text = string.format(S.percent, pct)
		end
	end
	ClientState.arenaChanged:Connect(updateMap)

	local function updateTimers()
		local now = ClientState.serverNow()
		local p = ClientState.profile
		local left = if p then p.boostUntil - now else 0
		if left > 0 then
			boostChip.Visible = true
			boostMain.Text = string.format(S.boost, Config.Income.BoostMultiplier, formatTime(left))
		else
			boostChip.Visible = false
		end
		weekendChip.Visible = Formulas.isWeekendUTC(now)
	end
	return updateTimers, updateMap
end

-- Leaderboard -------------------------------------------------------------------------------

type BoardRow = {
	root: Frame,
	crown: Frame,
	swatch: Frame,
	name: TextLabel,
	percent: TextLabel,
}

type BoardEntry = { id: number, runner: Types.RunnerInfo, cells: number }

local function buildLeaderboard(gui: ScreenGui)
	local board = UiKit.frame({
		Name = "Leaderboard",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(0.988, 0.02),
		Size = UDim2.fromScale(0.2, 0.33),
		parent = gui,
	})
	UiKit.list(board, { Padding = UDim.new(0.008, 0) })

	local rows: { BoardRow } = {}
	for i = 1, BOARD_ROWS do
		local root = UiKit.frame({
			Name = "Row" .. i,
			Size = UDim2.fromScale(1, 0.115),
			BackgroundColor3 = PANEL_BG,
			BackgroundTransparency = 0.35,
			LayoutOrder = i,
			Visible = false,
			parent = board,
		})
		UiKit.corner(root, 8)
		local crown = UiKit.frame({
			Name = "Crown",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0.015, 0.5),
			Size = UDim2.fromScale(0.09, 0.7),
			BackgroundColor3 = theme.Yellow,
			Visible = false,
			parent = root,
		})
		UiKit.corner(crown, 100)
		UiKit.aspect(crown, 1)
		UiKit.label({
			Text = S.kingMark,
			TextColor3 = theme.UiDark,
			Size = UDim2.fromScale(0.7, 0.7),
			Position = UDim2.fromScale(0.15, 0.15),
			parent = crown,
		})
		local swatch = UiKit.frame({
			Name = "Swatch",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0.125, 0.5),
			Size = UDim2.fromScale(0.09, 0.62),
			parent = root,
		})
		UiKit.corner(swatch, 4)
		UiKit.aspect(swatch, 1)
		local name = UiKit.label({
			Name = "Name",
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.fromScale(0.45, 0.7),
			Position = UDim2.fromScale(0.24, 0.15),
			parent = root,
		})
		local percent = UiKit.label({
			Name = "Percent",
			TextXAlignment = Enum.TextXAlignment.Right,
			Size = UDim2.fromScale(0.26, 0.7),
			Position = UDim2.fromScale(0.72, 0.15),
			parent = root,
		})
		rows[i] = { root = root, crown = crown, swatch = swatch, name = name, percent = percent }
	end

	local function update()
		local arena = ClientState.arena
		local list: { BoardEntry } = {}
		for id, runner in arena.runners do
			table.insert(list, { id = id, runner = runner, cells = arena.cells[id] or 0 })
		end
		table.sort(list, function(a: BoardEntry, b: BoardEntry)
			if a.cells ~= b.cells then
				return a.cells > b.cells
			end
			return a.id < b.id
		end)
		for i, row in rows do
			local entry = list[i]
			if entry == nil then
				row.root.Visible = false
			else
				row.root.Visible = true
				row.swatch.BackgroundColor3 = Color3.fromHex(playerColorHex(entry.runner.colorIndex))
				row.name.Text = entry.runner.name
				row.name.TextColor3 = if isVip(entry.runner) then theme.Yellow else theme.UiLight
				row.percent.Text = string.format(S.percent, entry.cells / arena.totalCells * 100)
				row.crown.Visible = entry.id == arena.kingId
				local mine = entry.id == arena.myId
				row.root.BackgroundColor3 = if mine then theme.Yellow else PANEL_BG
				row.root.BackgroundTransparency = if mine then 0.55 else 0.35
			end
		end
	end
	ClientState.arenaChanged:Connect(update)
end

-- Kill feed ---------------------------------------------------------------------------------

local function buildKillFeed(gui: ScreenGui)
	local feed = UiKit.frame({
		Name = "KillFeed",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(0.988, 0.36),
		Size = UDim2.fromScale(0.2, 0.2),
		parent = gui,
	})
	UiKit.list(feed, { Padding = UDim.new(0.02, 0), HorizontalAlignment = Enum.HorizontalAlignment.Right })

	local entries: { Frame } = {}
	local counter = 0

	local function tag(id: number): string
		local runner = ClientState.arena.runners[id]
		if runner == nil then
			return S.unknownRunner
		end
		local hex = if isVip(runner) then VIP_GOLD_HEX else playerColorHex(runner.colorIndex)
		return string.format('<font color="%s">%s</font>', hex, escapeRich(runner.name))
	end

	local function remove(entry: Frame)
		local i = table.find(entries, entry)
		if i then
			table.remove(entries, i)
		end
		entry:Destroy()
	end

	ClientState.arenaEvent:Connect(function(event: Types.ArenaEvent)
		if event.kind ~= "cut" then
			return
		end
		counter += 1
		local mine = event.killer == ClientState.arena.myId or event.victim == ClientState.arena.myId
		local entry = UiKit.frame({
			Name = "Entry",
			Size = UDim2.fromScale(1, 0.2),
			BackgroundColor3 = if mine then theme.Pink else PANEL_BG,
			BackgroundTransparency = 0.3,
			LayoutOrder = counter,
			parent = feed,
		})
		UiKit.corner(entry, 8)
		local label = UiKit.label({
			Text = string.format(S.cutFeed, tag(event.killer), tag(event.victim)),
			RichText = true,
			Size = UDim2.fromScale(0.94, 0.7),
			Position = UDim2.fromScale(0.03, 0.15),
			parent = entry,
		})
		table.insert(entries, entry)
		while #entries > MAX_FEED do
			remove(entries[1])
		end
		task.delay(FEED_SECONDS - FEED_FADE, function()
			if entry.Parent == nil then
				return
			end
			TweenService:Create(entry, TweenInfo.new(FEED_FADE), { BackgroundTransparency = 1 }):Play()
			TweenService:Create(label, TweenInfo.new(FEED_FADE), { TextTransparency = 1 }):Play()
			task.wait(FEED_FADE)
			if entry.Parent then
				remove(entry)
			end
		end)
	end)
end

-- Button rail -------------------------------------------------------------------------------

local function buildRail(gui: ScreenGui): (() -> ())
	local rail = UiKit.frame({
		Name = "Rail",
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.012, 0.2),
		Size = UDim2.fromScale(0.075, 0.42),
		parent = gui,
	})
	UiKit.list(rail, { Padding = UDim.new(0.014, 0) })

	local dots: { [string]: Frame } = {}
	for i, def in S.rail do
		local b = UiKit.button({
			text = def.text,
			color = theme.Yellow,
			size = UDim2.fromScale(1, 0.13),
			parent = rail,
			onClick = function()
				PanelController.sound("click")
				PanelController.open(def.panel)
			end,
		})
		b.Name = def.panel
		b.LayoutOrder = i
		railButtons[def.panel] = b
		if def.panel == "Shop" then
			local badge = UiKit.frame({
				Name = "StarterBadge",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.94, 0.08),
				Size = UDim2.fromScale(0.24, 0.24),
				BackgroundColor3 = theme.Pink,
				Visible = false,
				parent = b,
			})
			UiKit.corner(badge, 100)
			UiKit.aspect(badge, 1)
			UiKit.stroke(badge, theme.UiLight, 2)
			UiKit.label({
				Text = S.starterBadge,
				Size = UDim2.fromScale(0.7, 0.7),
				Position = UDim2.fromScale(0.15, 0.15),
				parent = badge,
			})
			dots.Shop = badge
		end
		if def.panel == "Daily" or def.panel == "Quests" then
			local dot = UiKit.frame({
				Name = "Dot",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.94, 0.08),
				Size = UDim2.fromScale(0.2, 0.2),
				BackgroundColor3 = theme.Danger,
				Visible = false,
				parent = b,
			})
			UiKit.corner(dot, 100)
			UiKit.aspect(dot, 1)
			UiKit.stroke(dot, theme.UiLight, 2)
			dots[def.panel] = dot
		end
	end

	return function()
		local daily = dots.Daily
		if daily then
			daily.Visible = ClientState.dailyState().canClaim
		end
		local quests = dots.Quests
		if quests then
			quests.Visible = ClientState.questClaimable()
		end
		local shop = dots.Shop
		if shop then
			shop.Visible = ClientState.starterOfferOpen()
		end
	end
end

-- Minimap -----------------------------------------------------------------------------------

local function runnerPosition(id: number): Vector3?
	local info = ClientState.arena.runners[id]
	if not info then
		return nil
	end
	local inst: Instance? = nil
	if info.isBot then
		local bots = workspace:FindFirstChild("Bots")
		inst = bots and bots:FindFirstChild(tostring(id))
	else
		local player = Players:GetPlayerByUserId(info.userId)
		local char = player and player.Character
		inst = char and char:FindFirstChild("HumanoidRootPart")
	end
	if inst and inst:IsA("PVInstance") then
		return inst:GetPivot().Position
	end
	return nil
end

-- Square overview of the arena: one Frame per MINI_BLOCK x MINI_BLOCK cells (built once), coloured by
-- the majority owner of the block's 4 centre cells. Blocks refresh round-robin at 2 Hz.
local function buildMinimap(gui: ScreenGui)
	local blocks = Config.Arena.GridSize // MINI_BLOCK
	local neutral = PANEL_BG:Lerp(theme.UiLight, 0.12)
	local root = UiKit.frame({
		Name = "Minimap",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(0.988, 0.78),
		Size = UDim2.fromScale(MINI_HEIGHT, MINI_HEIGHT),
		BackgroundColor3 = PANEL_BG,
		BackgroundTransparency = 0.2,
		ClipsDescendants = true,
		parent = gui,
	})
	UiKit.corner(root, 8)
	UiKit.aspect(root, 1)

	local frames: { Frame } = {}
	local shown: { Color3 } = {}
	local step = 1 / blocks
	for by = 0, blocks - 1 do
		for bx = 0, blocks - 1 do
			local i = by * blocks + bx + 1
			frames[i] = UiKit.frame({
				Name = "B" .. i,
				Position = UDim2.fromScale(bx * step, by * step),
				Size = UDim2.fromScale(step, step),
				BackgroundColor3 = neutral,
				parent = root,
			})
			shown[i] = neutral
		end
	end

	local function makeDot(name: string, color: Color3, z: number): Frame
		local d = UiKit.frame({
			Name = name,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(MINI_DOT, MINI_DOT),
			BackgroundColor3 = color,
			ZIndex = z,
			Visible = false,
			parent = root,
		})
		UiKit.corner(d, 100)
		return d
	end
	local kingDot = makeDot("King", theme.Yellow, 2)
	local meDot = makeDot("Me", theme.UiLight, 3)

	local samples: { number } = { 0, 0, 0, 0 }
	local half = MINI_BLOCK // 2
	local cursor = 0
	local lastGrid: any = nil

	local function refreshBlock(g: any, i: number)
		local bx, by = (i - 1) % blocks, (i - 1) // blocks
		local x0, y0 = bx * MINI_BLOCK + half - 1, by * MINI_BLOCK + half - 1
		samples[1], samples[2] = g:get(x0, y0), g:get(x0 + 1, y0)
		samples[3], samples[4] = g:get(x0, y0 + 1), g:get(x0 + 1, y0 + 1)
		local best, bestN = 0, 0
		for k = 1, 4 do
			local o = samples[k]
			if o ~= 0 then
				local n = 0
				for j = 1, 4 do
					if samples[j] == o then
						n += 1
					end
				end
				if n > bestN then
					best, bestN = o, n
				end
			end
		end
		local color = if best == 0 then neutral else TurfRenderer.colorOf(best)
		if shown[i] ~= color then
			shown[i] = color
			frames[i].BackgroundColor3 = color
		end
	end

	local function placeDot(dot: Frame, g: any, pos: Vector3?)
		if pos == nil then
			dot.Visible = false
			return
		end
		local cx, cy = g:worldToCell(pos.X, pos.Z)
		dot.Position = UDim2.fromScale((cx + 0.5) / g.size, (cy + 0.5) / g.size)
		dot.Visible = true
	end

	task.spawn(function()
		local periods = 0
		while true do
			task.wait(MINI_DOT_PERIOD)
			local profile = ClientState.profile
			local low = profile ~= nil and profile.settings.lowDetail
			root.Visible = not low
			local g: any = ArenaClient.getGrid()
			if low or g == nil then
				continue
			end
			periods += 1
			if g ~= lastGrid then
				lastGrid = g
				for i = 1, #frames do
					refreshBlock(g, i)
				end
			elseif periods % MINI_BLOCK_EVERY == 0 then
				for _ = 1, MINI_BLOCKS_PER_TICK do
					cursor = cursor % #frames + 1
					refreshBlock(g, cursor)
				end
			end
			local arena = ClientState.arena
			local myId = arena.myId
			placeDot(meDot, g, if myId and arena.alive then runnerPosition(myId) else nil)
			placeDot(kingDot, g, if arena.kingId ~= 0 then runnerPosition(arena.kingId) else nil)
		end
	end)
end

-- Playtime reward bar -----------------------------------------------------------------------

type Node = { wrap: Frame, button: TextButton, stroke: UIStroke, time: TextLabel }

local function buildPlaytime(gui: ScreenGui): (() -> ())
	local count = #Catalog.playtime
	local function nodeX(i: number): number
		return (i - 0.5) / count
	end

	local bar = UiKit.frame({
		Name = "Playtime",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 0.985),
		Size = UDim2.fromScale(0.4, 0.12),
		parent = gui,
	})
	local track = UiKit.frame({
		Name = "Track",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.31),
		Size = UDim2.fromScale(1, 0.1),
		BackgroundColor3 = PANEL_BG,
		BackgroundTransparency = 0.2,
		parent = bar,
	})
	UiKit.corner(track, 100)
	local fill = UiKit.frame({
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = theme.Yellow,
		parent = track,
	})
	UiKit.corner(fill, 100)

	local nodes: { Node } = {}
	local busy = false
	for i, def in Catalog.playtime do
		local wrap = UiKit.frame({
			Name = "Node" .. i,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(nodeX(i), 0),
			Size = UDim2.fromScale(0.1, 0.62),
			BackgroundTransparency = 1,
			parent = bar,
		})
		UiKit.aspect(wrap, 1)
		local button = UiKit.button({
			text = "",
			color = PANEL_BG,
			size = UDim2.fromScale(1, 1),
			parent = wrap,
			onClick = function()
				local session = ClientState.session
				local sec = ClientState.serverNow() - session.joinedAt
				if busy or session.playtimeClaimed[i] == true or sec < def.seconds then
					return
				end
				busy = true
				local ok, result = ClientState.request(Remotes.Requests.ClaimPlaytime, i)
				busy = false
				if ok then
					PanelController.sound("reward")
					UiKit.toast(PanelController.rewardText(result, S.rewardClaimed), theme.Success)
				else
					PanelController.sound("error")
					UiKit.toast(PanelController.errorText(result), theme.Danger)
				end
			end,
		})
		local corner = button:FindFirstChildOfClass("UICorner")
		if corner then
			corner.CornerRadius = UDim.new(0.5, 0)
		end
		local stroke = UiKit.stroke(button, currencyColor(def.currency), 3)
		local time = UiKit.label({
			Name = "Time",
			Text = formatTime(def.seconds),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(nodeX(i), 0.7),
			Size = UDim2.fromScale(0.14, 0.28),
			TextTransparency = 0.2,
			parent = bar,
		})
		nodes[i] = { wrap = wrap, button = button, stroke = stroke, time = time }
	end

	local function fillFraction(sec: number): number
		local prevSec, prevX = 0, 0
		for i, def in Catalog.playtime do
			if sec < def.seconds then
				return prevX + (nodeX(i) - prevX) * (sec - prevSec) / (def.seconds - prevSec)
			end
			prevSec, prevX = def.seconds, nodeX(i)
		end
		return nodeX(count)
	end

	return function()
		local session = ClientState.session
		local sec = ClientState.serverNow() - session.joinedAt
		fill.Size = UDim2.fromScale(fillFraction(math.max(0, sec)), 1)
		for i, def in Catalog.playtime do
			local node = nodes[i]
			local claimed = session.playtimeClaimed[i] == true
			local ready = not claimed and sec >= def.seconds
			if claimed then
				node.button.Text = S.claimed
				node.button.BackgroundColor3 = theme.Success
				node.button.TextColor3 = theme.UiDark
				node.stroke.Enabled = false
			elseif ready then
				node.button.Text = UiKit.formatNumber(def.amount)
				node.button.BackgroundColor3 = currencyColor(def.currency)
				node.button.TextColor3 = theme.UiDark
				node.stroke.Enabled = true
				node.stroke.Color = theme.UiLight
			else
				node.button.Text = UiKit.formatNumber(def.amount)
				node.button.BackgroundColor3 = PANEL_BG
				node.button.TextColor3 = theme.UiLight
				node.stroke.Enabled = true
				node.stroke.Color = currencyColor(def.currency)
			end
			if ready then
				UiKit.pulse(node.wrap)
			else
				UiKit.stopPulse(node.wrap)
			end
			node.time.Text = formatTime(def.seconds)
		end
	end
end

local HudController = {}

-- Rail button by panel name ("Upgrades", "Shop", ...); nil until the HUD is built.
function HudController.getRailButton(name: string): TextButton?
	return railButtons[name]
end

function HudController.start()
	if started then
		return
	end
	started = true
	ClientState.start()

	local gui = UiKit.screenGui("Hud", 10)
	buildWallet(gui)
	local updateTimers, updateMap = buildTopCentre(gui)
	buildLeaderboard(gui)
	buildKillFeed(gui)
	buildMinimap(gui)
	local updateDots = buildRail(gui)
	local updatePlaytime = buildPlaytime(gui)

	local function updateAll()
		updateTimers()
		updateDots()
		updatePlaytime()
	end
	ClientState.profileChanged:Connect(updateAll)
	updateMap()
	updateAll()

	task.spawn(function()
		while true do
			task.wait(TICK_SECONDS)
			updateAll()
		end
	end)
end

return HudController
