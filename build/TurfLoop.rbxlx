              <string name="Source">-- Builds the kernel's ScreenGui shell programmatically - the kernel ships no
-- Studio-only GUI assets. Packs contribute their own panels via registerPanel.
return function(playerGui)
	local gui = Instance.new("ScreenGui")
	gui.Name = "RBLXEssentialsGUI"
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 5
	-- Parity with v1 MenusGUI: ignore topbar inset to prevent coordinate
	-- shift of scale-positioned content and mouse-follow tooltip.
	gui.IgnoreGuiInset = true

	local menus = Instance.new("Frame")
	menus.Name = "Menus"
	menus.BackgroundTransparency = 1
	menus.Size = UDim2.fromScale(1, 1)
	-- Panels draw ABOVE the HUD. This frame and the interactables layer are
	-- effective render siblings under the ScreenGui - `Interactables` below
	-- is a Folder, not a GuiObject, so it creates no stacking context of its
	-- own and `Container` is compared straight against this frame. Both used
	-- to sit at the default ZIndex 1: a tie, broken only by the order the
	-- children happen to be parented in, which put the HUD on top. Any
	-- full-screen panel then rendered UNDER the nav icons at the left HUD
	-- spot - reported against Roulette System's Spin, whose panel dims the
	-- whole screen at BackgroundTransparency 0.5 and is the first v2 panel
	-- big enough to reach that strip at all. Explicit ranks remove the tie
	-- instead of relying on parenting order. Anything a pack clones in as a
	-- sibling group (GUK's Effects/InviteFriends) keeps the default 1 and so
	-- also stays below panels; the Tooltip (50) still wins over everything.
	menus.ZIndex = 10
	menus.Parent = gui

	-- Folder, not Frame: matches v1 (EC's designed MenusGUI.Interactables) -
	-- layout-transparent, so GuiObject children (Container, and any
	-- pack-cloned sibling groups) size/position relative to the ScreenGui
	-- instead of compressing into an invented strip. Folders have no
	-- Size/Position/AnchorPoint to set.
	local interactables = Instance.new("Folder")
	interactables.Name = "Interactables"
	interactables.Parent = gui

	-- Geometry below matches GUK v2's designed Container (EC lineage;
	-- General UI Kit v2/src/StarterGui/GeneralUIKit/GeneralUIKitGUI.rbxm -&gt;
	-- Interactables.Container pre-M1-unwrap, verified directly by a Lune
	-- probe against `git show 8b0e864:"General UI Kit v2/src/
	-- ReplicatedStorage/GeneralUIKit/Assets/Interactables.rbxm"` - see
	-- task-M1-report.md's I2 fix section for the probe output) as the
	-- kernel default for ALL packs, designed or not: since Task M1, GUK
	-- ships its 10 nav buttons directly adopted into THIS Container (no
	-- pack ever overwrites this geometry anymore - the old "GUK v2
	-- overwrites this after cloning its layout" comment this replaced is
	-- stale post-M1).
	local container = Instance.new("Frame")
	container.Name = "Container"
	container.BackgroundTransparency = 1
	container.AnchorPoint = Vector2.new(0, 0.5)
	container.Position = UDim2.fromScale(0.01, 0.5)
	container.Size = UDim2.fromScale(0.2, 0.38)
	-- Explicit even though it equals the Frame default: this is the low half
	-- of the rank documented on `menus.ZIndex` above, and a silent default is
	-- exactly what produced the tie in the first place.
	container.ZIndex = 1
	container.Parent = interactables

	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromScale(0.24, 0.24)
	grid.CellPadding = UDim2.fromScale(0.03, 0.01)
	grid.FillDirection = Enum.FillDirection.Vertical
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Left
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = container

	-- The designed Container parents this directly to the FRAME, not to the
	-- UIGridLayout (a UIAspectRatioConstraint parented to a UIGridLayout has
	-- no effect on anything - verified via the probe above: it does nothing
	-- there, which is why this was a real, not merely cosmetic, v1-parity
	-- bug prior to this fix).
	local aspect = Instance.new("UIAspectRatioConstraint")
	aspect.AspectRatio = 0.9341463446617126
	aspect.AspectType = Enum.AspectType.FitWithinMaxSize
	aspect.DominantAxis = Enum.DominantAxis.Height
	aspect.Parent = container

	local tooltip = Instance.new("Frame")
	tooltip.Name = "Tooltip"
	tooltip:SetAttribute("TooltipType", "Button")
	tooltip.Visible = false
	tooltip.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	tooltip.BackgroundTransparency = 0.15
	tooltip.BorderSizePixel = 0
	tooltip.Size = UDim2.fromOffset(140, 34)
	tooltip.ZIndex = 50
	tooltip.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = tooltip

	local label = Instance.new("TextLabel")
	label.Name = "ButtonName"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Text = ""
	label.ZIndex = 51
	label.Parent = tooltip

	gui.Parent = playerGui
	return gui
end
