                <BinaryString name="SerializedOverrides">
                </BinaryString>
                <string name="Source">-- Migrations/Interface - generated by node tools/v3/b-release/run.mjs fingerprints SoundSystem (plan B0)
-- from tools/v3/b-release/packs/SoundSystem.json and fingerprints computed in Studio.
-- Do not edit it: change the descriptor and run that command again.
--   derived: per piece, the properties and attributes a 2.x action wrote
--     from Settings, never counted as an edit (or a function of the
--     configuration that returns them);
--   conditional: for such a function, every rule it may return and the
--     published values of what they name (Migrate.conditionalValues);
--   published: per piece, "&lt;PackId&gt;@&lt;version&gt; &lt;element&gt;" of every published
--     2.x copy and its fingerprint (Migrate.pieceFingerprint);
--   foreign: this pack's own 2.x copies of other packs' pieces, each on its
--     owner piece's slot (key); standIn, when present, is this pack's own
--     piece that stands in for that owner piece (Kernel 3.0.1 standsInFor).
return {
	conditional = {},
	derived = {},
	foreign = {},
	published = {
		MusicPlayer = {
			["SoundSystem@2.1.0 StarterGui/SoundSystem/MusicPlayerGUI"] = "f2:e4023159:0bc1aed4",
			["SoundSystem@2.1.1 StarterGui/SoundSystem/MusicPlayerGUI"] = "f2:e4023159:0bc1aed4",
		},
	},
}
</string>
