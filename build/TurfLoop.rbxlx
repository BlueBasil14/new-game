                <string name="Source">-- Migrations/FromV2 - Sound System 2.x to the 3.0 configuration (plan B1,
-- Sound rulings). T.migrate reads the 2.x sources Migrations/Sources names
-- into plain data (plugins/Official/Tools/Core/Tree.lua: node = { name,
-- class, value?, attributes, children, deep? }) and calls
-- FromV2({ Settings = node?, Templates = node?, MusicPlayerGUI = node?,
-- SoundLibrary = node?, DemoRoot = node?, PackAssets = node? }, ctx),
-- ctx = { packId, fromVersion, find }; a source the place lacks is absent.
-- FromV2 takes nothing from the last three: since plan B3a what the game put
-- next to the content Migrations/Content declares stays live, and T.migrate
-- names it (content-kept), so FromV2 no longer notes it (plan B3b). Pure:
-- data in, data out; no game, no Instances, no script.
--
-- Returns (config, notes, sources, refusals). config always holds
-- SFXEnabled and MusicPlayer.Enabled; Volumes stays unset (2.x read each
-- SoundGroup's own Volume, which Tree.read does not read; the migration and
-- later updates keep the groups live, and a note says so).
-- notes = { { path, message, fix?, action?, search? } } says what 2.x did
-- with each value that is not carried as it stood, and what the migration
-- cannot keep; a note whose message asks for an action (a search of the
-- game's scripts, an edit the user decides) gives its own fix, which
-- T.migrate reports in place of its generic one (B3b acceptance R1); one
-- that asks the user before an edit is marked action = true, which
-- T.migrate reports as migration-action, and the live SFXEnabled note
-- gives the names T.migrate searches the game's scripts for (search), which
-- decides it (B3b acceptance R2); sources =
-- { [option] = 2.x instance }; refusals is always empty: Sound 2.x booted
-- with any Settings (its client failed later, in a thread of its own), so
-- nothing is refused (ruling 3).
--
-- It mirrors the 2.x client exactly (2.0.0's, and 2.1.0's and 2.1.1's,
-- which are the same code); tests/fromv2.spec runs every published client
-- and server on the same trees and compares what played. The client waited
-- for its inputs in this order, in one spawned thread, and a step that
-- failed stopped everything after it:
--   1. Settings.SFXEnabled: WaitForChild with no timeout. Settings or
--      SFXEnabled missing: no sound effect, no music, no positional sound
--      ever. Then every sound read `.Value` by truthiness (any value but
--      false or nil was on); an instance with no Value made every sound
--      effect call throw.
--   2. Assets.Templates, then Settings."Music Player", its Template (its
--      Value read at once) and its MusicPlayerEnabled: WaitForChild with no
--      timeout. Any of them missing, or a Value that threw: the sound
--      effects stayed as step 1 left them, but no music played and the
--      positional receiver (PlayAt, PlayAtForPlayer) was never wired.
--   3. Assets.Templates:FindFirstChild(Template's Value): only text or a
--      number is a name; anything else threw, as in step 2.
--   4. 2.0.0 only: PlayerGui's copy of StarterGui's MusicPlayerGUI, 10 s at
--      most. Without it no music played; the sound effects and the
--      positional receiver, wired after that wait, still worked. (2.1
--      started the music without it.)
--   5. MusicPlayerEnabled: 2.1 read it by truthiness; 2.0.0 also wrote it to
--      MusicPlayerGUI.Enabled, which takes only true or false, so on 2.0.0
--      any other value threw, as in step 2.
-- Wherever the client stopped before the music, StarterGui's MusicPlayerGUI
-- still reached the screen, unwired.
-- The server's Demo part Play checked SFXEnabled on its own: only a Value
-- equal to false silenced it, so a missing SFXEnabled or an ObjectValue
-- with no target still played it. 3.0 plays it only when sound effects
-- are on, and says so where that differs.
--
-- Template is not carried: 3.0 has no Template option and no Apply
-- Template action (ruling Q3). The music player is the MusicPlayer piece,
-- the StarterGui copy as it stands, forked by T.migrate when it differs
-- from 3.0's; the note names the skin 2.x showed, and whether StarterGui's
-- copy holds a frame of that name.
local VALUE_BASES = {
	BoolValue = true, BrickColorValue = true, CFrameValue = true, Color3Value = true, DoubleConstrainedValue = true,
	IntConstrainedValue = true, IntValue = true, NumberValue = true, ObjectValue = true, RayValue = true,
	StringValue = true, Vector3Value = true,
}
-- The classes that are not values but have a Value property a script can
-- read (Roblox's reflection database): a number or text, which 2.x read and
-- Tree.read does not keep. Either one counts as on, and is a valid name.
local UNREADABLE = { KeyframeMarker = true, NumberPose = true }
local GUI_PATH = "StarterGui.RBLXEssentials.SoundSystem.MusicPlayerGUI"
local LIBRARY = "SoundService.RBLXEssentials.SoundSystem"

local function child(node, name)
	for _, item in ipairs(node and node.children or {}) do
		if item.name == name then
			return item
		end
	end
	return nil
end

-- valueOf(node) -&gt; (kind, value): what 2.x's `inst.Value` gave.
--   "value"       a value's Value (nil when an ObjectValue has no target);
--   "instance"    an Instance: an ObjectValue's target (Tree.read keeps it
--                 as a path), or the child named Value of an instance that
--                 is not a value;
--   "unreadable"  the Value property of a class in UNREADABLE;
--   "error"       no Value at all: `.Value` threw.
local function valueOf(node)
	if node.value ~= nil then
		return if node.class == "ObjectValue" then "instance" else "value", node.value
	end
	if VALUE_BASES[node.class] then
		return "value", nil
	end
	if UNREADABLE[node.class] then
		return "unreadable", nil
	end
	if child(node, "Value") ~= nil then
		return "instance", child(node, "Value")
	end
	return "error", nil
end

local function truthy(kind, value)
	return kind == "instance" or kind == "unreadable" or (kind == "value" and value ~= nil and value ~= false)
end

local function describe(node, kind, value)
	if kind == "instance" then
		return if node.class == "ObjectValue" then "an ObjectValue pointing at an instance" else ("a %s with a child named Value"):format(node.class)
	end
	if kind == "unreadable" or kind == "error" then
		return ("a %s"):format(node.class)
	end
	if value == nil then
		return "an ObjectValue with no target"
	end
	if type(value) == "string" then
		return ("a %s %q"):format(node.class, value)
	end
	return ("a %s %s"):format(node.class, tostring(value))
end

local LIVE = "2.x read SFXEnabled live, so a game script could turn sound effects off while the game ran by setting it. In 3.0 SFXEnabled is the value when the server starts; the live switch is the SFXEnabled attribute of ReplicatedStorage.RBLXEssentials.Packs.SoundSystem (true or false), or SetSFXEnabled on the pack's API: from the server for every player, from a client for that player only. The Settings folder is gone in 3.0: a script that still reads or sets Settings.SFXEnabled or Music Player.MusicPlayerEnabled stops with an error or waits forever. T.migrate searches every script of the game for SFXEnabled and MusicPlayerEnabled: each one that uses either must use SetSFXEnabled/IsSFXEnabled or the attribute instead"
-- The fixes of the notes that ask for an action (B3b acceptance R1).
-- B3b acceptance R2: T.migrate makes the live note's search itself (its
-- `search`, the names Sources.bare declares too) over every script of the
-- place, once the run is done: none found, the note is a migration-note
-- with "Nothing to do: no script of the game uses SFXEnabled or
-- MusicPlayerEnabled."; found, a migration-action whose fix names each
-- script, then LIVE_FIX. Until then (a run that stopped) it is an action.
local LIVE_SEARCH = { "SFXEnabled", "MusicPlayerEnabled" }
local LIVE_FIX = "Switch each use of SFXEnabled to the SFXEnabled attribute of ReplicatedStorage.RBLXEssentials.Packs.SoundSystem or SetSFXEnabled/IsSFXEnabled, and MusicPlayerEnabled to MusicPlayer.Enabled in Config.SoundSystem (read when the server starts); ask the user before editing one"
local SKIN_NOTHING = "Nothing to do: T.describe({ pack = \"SoundSystem\" }) names the music player copy the Kernel uses"
local SKIN_FIX = "Ask the user whether players should see the skin 2.x showed; only then edit the fork in StarterGui.RBLXEssentials.Interface as this note says, never the pack's own MusicPlayerGUI"
local HIDDEN_FIX = "Nothing to do: the music plays with no player on screen, as in 2.1. To show the player, ask the user, then remove that hidden fork: T.content.deactivate(\"SoundSystem.MusicPlayer\")"
local DEMO = "The Demo part Play, which 2.x's server still played, is silent in 3.0 too"
local NO_MUSIC = "so the 2.x client stopped there, after the sound effects and before the music player and the positional receiver: the game had no music, and PlayAt and PlayAtForPlayer were silent. Carried as MusicPlayer.Enabled = false; 3.0 plays positional sounds whenever sound effects are on"
-- The library's groups (rulings Q1 and Q5; plan B3a): the migration keeps
-- them live, the same instances, and so does every later install or
-- update. B3b acceptance R3 review: Tools cannot compare a SoundGroup, so
-- T.migrate's report lists them as kept as 2.x had them, unverified, never
-- as the game's change, and this note's first sentence, its line in that
-- report, says the same. Always said, since Tools reads neither a
-- SoundGroup's Volume nor what refers to it.
local VOLUMES = "The SFX and Music SoundGroups stay live as 2.x had them, the same instances with their Volumes, and later updates keep them; Tools cannot compare them to tell whether the game changed them. They are marked RBLXE_GameContent: a later install or update keeps them live and names them (game-content-kept). Volumes.SFX and Volumes.Music in the config module, when set, win when the server starts"

return function(input, ctx)
	local config, notes, sources, refusals = {}, {}, {}, {}
	local function note(path, message, fix, action)
		table.insert(notes, { path = path, message = message, fix = fix, action = action })
	end
	input = if type(input) == "table" then input else {}
	local function finish()
		note(LIBRARY, VOLUMES)
		return config, notes, sources, refusals
	end
	local settings, templates, gui = input.Settings, input.Templates, input.MusicPlayerGUI
	local legacy = ctx ~= nil and ctx.fromVersion == "2.0.0"
	local release = if legacy then "2.0.0" else "2.1"
	-- Where the client stopped before the music, StarterGui's copy still
	-- reached the screen, unwired; 3.0 hides it.
	local unwired = if gui ~= nil
		then (". %s still showed StarterGui's music player, unwired; 3.0 hides it (MusicPlayer.Enabled = false)"):format(release)
		else ""
	local root = if settings ~= nil then settings.name else "Settings"
	config.SFXEnabled = false
	config.MusicPlayer = { Enabled = false }

	-- 1. SFXEnabled
	local sfxNode = child(settings, "SFXEnabled")
	if sfxNode == nil then
		local path = if settings == nil then root else root .. ".SFXEnabled"
		note(path, ("is missing, so the 2.x client %s and started no audio: no sound effect, no music and no positional sound (PlayAt, PlayAtForPlayer). %s. Carried as SFXEnabled = false and MusicPlayer.Enabled = false: set them in the config module to turn audio on%s"):format(
			if settings == nil then "failed at once" else "waited for it forever", DEMO, unwired))
		return finish()
	end
	local sfxPath = root .. ".SFXEnabled"
	sources.SFXEnabled = sfxPath
	local sfxKind, sfxValue = valueOf(sfxNode)
	if sfxKind == "error" then
		note(sfxPath, ("is %s with no Value: every 2.x sound effect call threw, and so did every menu button, which plays a sound first. Carried as off"):format(describe(sfxNode, sfxKind)))
	else
		config.SFXEnabled = truthy(sfxKind, sfxValue)
		if sfxKind == "value" and sfxValue == nil then
			note(sfxPath, ("is %s: 2.x read nil, so sound effects were off. %s. Carried as off"):format(describe(sfxNode, sfxKind, sfxValue),
				"The Demo part Play, which 2.x's server still played, is silent in 3.0"))
		elseif sfxNode.class ~= "BoolValue" then
			note(sfxPath, ("is %s: 2.x read it by truthiness (any value but false or nil is on): carried as %s"):format(
				describe(sfxNode, sfxKind, sfxValue), if config.SFXEnabled then "on" else "off"))
		end
	end
	table.insert(notes, { path = sfxPath, message = LIVE, fix = LIVE_FIX, action = true, search = table.clone(LIVE_SEARCH) })

	-- 2. Assets.Templates, "Music Player", its Template and MusicPlayerEnabled
	local function stop(path, why)
		note(path, ("%s, %s%s"):format(why, NO_MUSIC, unwired))
		return finish()
	end
	if templates == nil then
		return stop("Assets.Templates", "is missing: the 2.x client waited for it forever")
	end
	local playerNode = child(settings, "Music Player")
	local playerPath = root .. ".Music Player"
	if playerNode == nil then
		return stop(playerPath, "is missing: the 2.x client waited for it forever")
	end
	local templateNode = child(playerNode, "Template")
	local templatePath = playerPath .. ".Template"
	if templateNode == nil then
		return stop(templatePath, "is missing: the 2.x client waited for it forever")
	end
	local templateKind, templateValue = valueOf(templateNode)
	if templateKind == "error" then
		return stop(templatePath, ("is %s with no Value: reading it threw"):format(describe(templateNode, templateKind)))
	end
	local enabledNode = child(playerNode, "MusicPlayerEnabled")
	local enabledPath = playerPath .. ".MusicPlayerEnabled"
	if enabledNode == nil then
		return stop(enabledPath, "is missing: the 2.x client waited for it forever")
	end

	-- 3. the skin's name
	local isName = templateKind == "unreadable" or (templateKind == "value" and (type(templateValue) == "string" or type(templateValue) == "number"))
	if not isName then
		return stop(templatePath, ("is %s: Assets.Templates:FindFirstChild could not take it as a name, and threw"):format(
			describe(templateNode, templateKind, templateValue)))
	end

	-- 4. 2.0.0 waited 10 s for PlayerGui's copy of StarterGui's MusicPlayerGUI.
	if legacy and gui == nil then
		note(GUI_PATH, "is missing: 2.0.0 waited 10 s for its PlayerGui copy and never started the music without it, while sound effects and PlayAt still played. Carried as MusicPlayer.Enabled = false: 3.0 places its default music player, hidden while MusicPlayer.Enabled is false")
	else
		-- 5. MusicPlayerEnabled
		sources["MusicPlayer.Enabled"] = enabledPath
		local enabledKind, enabledValue = valueOf(enabledNode)
		if enabledKind == "error" then
			return stop(enabledPath, ("is %s with no Value: reading it threw"):format(describe(enabledNode, enabledKind)))
		end
		if legacy and not (enabledKind == "value" and type(enabledValue) == "boolean") then
			return stop(enabledPath, ("is %s: 2.0.0 wrote it to MusicPlayerGUI.Enabled, which takes only true or false, and that threw"):format(
				describe(enabledNode, enabledKind, enabledValue)))
		end
		config.MusicPlayer.Enabled = truthy(enabledKind, enabledValue)
		if enabledKind == "value" and enabledValue == nil then
			note(enabledPath, ("is %s: 2.x read nil, so no music played, and 2.1 left the music player on screen, unwired. Carried as off: 3.0 hides it"):format(
				describe(enabledNode, enabledKind, enabledValue)))
		elseif enabledNode.class ~= "BoolValue" then
			note(enabledPath, ("is %s: 2.x read it by truthiness (any value but false or nil is on): carried as %s"):format(
				describe(enabledNode, enabledKind, enabledValue), if config.MusicPlayer.Enabled then "on" else "off"))
		end
		if gui == nil and config.MusicPlayer.Enabled then
			note(GUI_PATH, "is missing: 2.1 played the music with no player on screen. T.migrate keeps it that way: a hidden fork of the 3.0 default music player takes its place (deleted-kept-hidden: Enabled = false, and Visible = false on each frame directly in it, since the client sets Enabled from MusicPlayer.Enabled), so the music plays with nothing on screen. To show the player, remove that fork: T.content.deactivate(\"SoundSystem.MusicPlayer\")",
				HIDDEN_FIX)
		end
	end

	-- The skin 2.x showed, and what 3.0 shows instead. skinFix: the note's
	-- fix, which asks the user first where the note says to edit the fork.
	local shown
	local skinFix = SKIN_NOTHING
	if gui == nil then
		shown = "StarterGui held no MusicPlayerGUI, so 2.x showed no skin"
	elseif templateKind == "unreadable" then
		shown = ("Tools cannot read the Value of a %s, so which skin 2.x showed is not known"):format(templateNode.class)
	else
		local wanted = tostring(templateValue)
		local named = child(templates, wanted)
		local chosen = if named ~= nil then named else (templates.children or {})[1]
		if chosen == nil then
			shown = "Assets.Templates was empty, so 2.x showed no skin"
		else
			local how = if legacy
				then ("2.0.0 always replaced MusicPlayerGUI's frame with a clean copy of %s from Assets.Templates"):format(chosen.name)
				else ("2.1 showed %s: StarterGui's copy when MusicPlayerGUI held a frame of that name tagged MusicPlayerFrame (Apply Template put it there), otherwise a clean copy from Assets.Templates"):format(chosen.name)
			if named == nil then
				how ..= (" (no skin is named %q, so it fell back to the first one in Assets.Templates)"):format(wanted)
			end
			local holds = child(gui, chosen.name) ~= nil
			if legacy then
				how ..= (". The migrated player is StarterGui's copy as it stands, which T.migrate forks (a 2.0.0 copy never matches 3.0's)%s: to show what 2.0.0 showed, edit that fork in StarterGui.RBLXEssentials.Interface and put a copy of Assets.Templates.%s in it in place of its frame"):format(
					if holds then (", and its %s is StarterGui's frame, not that clean copy"):format(chosen.name) else "", chosen.name)
				skinFix = SKIN_FIX
			elseif holds then
				how ..= (". StarterGui's MusicPlayerGUI holds a frame named %s: the migrated player is that copy as it stands"):format(chosen.name)
			else
				how ..= (". StarterGui's MusicPlayerGUI holds no frame named %s, so the migrated player shows its own frame instead: edit the fork T.migrate placed in StarterGui.RBLXEssentials.Interface (or, if there is none, fork it with T.content.fork(\"SoundSystem.MusicPlayer\")) and put a copy of Assets.Templates.%s in it in place of its frame"):format(
					chosen.name, chosen.name)
				skinFix = SKIN_FIX
			end
			shown = how
		end
	end
	note(templatePath, ("is not carried: 3.0 has no Template option and no Apply Template action. The music player is the MusicPlayer piece, StarterGui.RBLXEssentials.SoundSystem.MusicPlayerGUI as it stands, which T.migrate forks into StarterGui.RBLXEssentials.Interface when it differs from 3.0's (a skin applied with Apply Template, or the game's edits). %s"):format(shown),
		skinFix, if skinFix == SKIN_FIX then true else nil)
	return finish()
end
</string>
                <int64 name="SourceAssetId">-1</int64>
                <BinaryString name="Tags" />
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="36">
              <Properties>
                <string name="Name">Interface</string>
                <BinaryString name="AttributesSerialize" />
                <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
                <ContentId name="LinkedSource">
                  <null>
