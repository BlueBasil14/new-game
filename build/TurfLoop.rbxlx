				<Item class="ModuleScript" referent="RBX00000000000000000000000000000016">
					<Properties>
						<string name="Name">AnalyticsService</string>
						<ProtectedString name="Source">--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Analytics = {}

local CUSTOM_KEYS = { "CustomField01", "CustomField02", "CustomField03" }

function Analytics.log(player: Player?, event: string, fields: { [string]: any }?)
	if player == nil then
		return
	end
	local target: Player = player
	local payload: { [string]: string }? = nil
	if fields ~= nil then
		-- Roblox only accepts Enum.AnalyticsCustomFieldKeys names (CustomField01..03) as keys;
		-- field names are sorted so each event maps them to the same slot every time.
		local names: { string } = {}
		for key in pairs(fields) do
			table.insert(names, key)
		end
		table.sort(names)
		local out: { [string]: string } = {}
		for i = 1, math.min(#names, #CUSTOM_KEYS) do
			out[CUSTOM_KEYS[i]] = tostring(fields[names[i]])
		end
		payload = out
	end
	local ok = pcall(function()
		game:GetService("AnalyticsService"):LogCustomEvent(target, event, 1, payload)
	end)
	if not ok and payload ~= nil then
		pcall(function()
			game:GetService("AnalyticsService"):LogCustomEvent(target, event, 1)
		end)
	end
end

function Analytics.funnel(player: Player, step: number, name: string)
	pcall(function()
		game:GetService("AnalyticsService"):LogOnboardingFunnelStepEvent(player, step, name)
	end)
end

-- Funnel step logged at most once per player per session (GDD G12: join, first capture, first upgrade,
-- first death, respawn, minute 10).
local funnelSeen: { [Player]: { [number]: boolean } } = {}

function Analytics.funnelOnce(player: Player, step: number, name: string)
	local seen = funnelSeen[player]
	if seen == nil then
		seen = {}
		funnelSeen[player] = seen
	end
	local set = seen :: { [number]: boolean }
	if set[step] then
		return
	end
	set[step] = true
	Analytics.funnel(player, step, name)
end

game:GetService("Players").PlayerRemoving:Connect(function(player: Player)
	funnelSeen[player] = nil
end)

return Analytics
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000000000000000000000000000017">
					<Properties>
						<string name="Name">ArenaService</string>
						<ProtectedString name="Source">--!strict
-- Authoritative arena (GDD G2, G11.6): owns the ArenaSim, reads character positions on a fixed
-- tick, applies movement checks, pays out sim events and replicates state. See docs/API_arena.md.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ArenaSim = require(Shared.ArenaSim)
local Config = require(Shared.Config)
local Formulas = require(Shared.Formulas)
local Remotes = require(Shared.Remotes)
local Types = require(Shared.Types)

local AnalyticsService = require(script.Parent.AnalyticsService)
local BadgeService = require(script.Parent.BadgeService)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local LeaderboardService = require(script.Parent.LeaderboardService)
local MonetizationService = require(script.Parent.MonetizationService)
local RewardService = require(script.Parent.RewardService)
local ShopService = require(script.Parent.ShopService)
local UpgradeService = require(script.Parent.UpgradeService)

local S = {
	crownRushWon = "You won the Crown Rush Trail! Equip it in the Shop.",
}

type RunnerInfo = Types.RunnerInfo
type ArenaEvent = Types.ArenaEvent
type Runner = ArenaSim.Runner
type Cell = { x: number, y: number }

type PState = {
	player: Player,
	joinClock: number,
	gentleUntil: number, -- os.clock(); bots stay gentle until then (counts lifetime play, not this session)
	id: number, -- 0 = no runner
	character: Model?,
	hrp: BasePart?,
	humanoid: Humanoid?,
	connections: { RBXScriptConnection },
	charConnections: { RBXScriptConnection },
	walkSpeed: number,
	prevWalkSpeed: number,
	speedGraceUntil: number,
	lastPos: Vector3?,
	lastTime: number,
	slack: number, -- rolling speed-slack budget in studs (Config.Security.SpeedSlack)
	overTicks: number,
	strikes: { number },
	exemptUntil: number,
	settleTarget: Vector3?,
	settleTries: number,
	deathTime: number,
	lifeStart: number,
	lifeCoins: number,
	lifeKills: number,
	pendingUntil: number?,
	secondChanceUsed: boolean,
	respawning: boolean,
	autoRespawn: boolean, -- cut without a Second Chance offer: respawn after RespawnDelay without a request
	kingAccum: number,
	ready: boolean,
}

local STEP = 1 / Config.Arena.TickRate
local DELTA_PERIOD = 1 / Config.Arena.DeltaRate
local CELL = Config.Arena.CellSize
local HALF = Config.Arena.GridSize * CELL / 2
local FLOOR_Y = Config.Arena.FloorY

local MAX_CATCHUP_STEPS = 5
-- After a server teleport the client keeps reporting its old position for a few frames.
local TELEPORT_EXEMPT = 0.5
local SETTLE_RADIUS = 2 * CELL
local SETTLE_RETRIES = 5
local SPEED_DROP_GRACE = 1 -- seconds the old speed stays allowed after WalkSpeed drops (client lag)
local MAX_SPEED_WINDOW = 1 -- caps the allowance after a long stand-still
local BELOW_FLOOR = 6
local ABOVE_FLOOR = 20
-- Cut players wait anchored under the floor; the chase camera then still sits above the arena.
local HIDE_DEPTH = 20
-- Seconds the victim's turf is held after the prompt. A purchase in flight cannot be detected (the client
-- opens the dialog), so this stays generous.
local SECOND_CHANCE_GRACE = 12
local ZERO_TURF_RECYCLE = 2
local IDLE_RESPAWN = 30 -- server respawns a released player who never sent Respawn
local CHARACTER_WAIT = 10
local MAP_BADGES = { { pct = 10, key = "map10" }, { pct = 50, key = "map50" } }

local ArenaService = {}

local rng = Random.new()
local sim = ArenaSim.new({
	rng = function(): number
		return rng:NextNumber()
	end,
})

ArenaService.sim = sim
-- Bot target positions in cell units (floored by the sim), written by BotService in preStep.
ArenaService.botPositions = {} :: { [number]: Cell }
-- Single hook run at the start of every sim tick, before positions are read (BotService).
ArenaService.preStep = nil :: ((now: number, dt: number) -&gt; ())?

local eventListeners: { (ArenaEvent) -&gt; () } = {}
-- Callbacks run synchronously, in order, for every drained sim event (after ArenaService handled it).
ArenaService.onEvent = {
	Connect = function(_self: any, fn: (ArenaEvent) -&gt; ())
		table.insert(eventListeners, fn)
		return {
			Disconnect = function()
				local i = table.find(eventListeners, fn)
				if i then
					table.remove(eventListeners, i)
				end
			end,
		}
	end,
}

local states: { [Player]: PState } = {}
local playerById: { [number]: PState } = {}
local orphans: { [number]: boolean } = {} -- runners of players who left, removed after LeaveNeutralDelay
local zeroSince: { [number]: number } = {}
local remotes: { [string]: RemoteEvent } = {}
local started = false

function ArenaService.now(): number
	return os.clock()
end

local function remote(name: string): RemoteEvent
	local r = remotes[name]
	if r == nil then
		local folder = ReplicatedStorage:WaitForChild(Remotes.Folder)
		r = folder:WaitForChild(name) :: RemoteEvent
		remotes[name] = r
	end
	return r :: RemoteEvent
end

-- Only clients that have received a snapshot get incremental updates.
local function broadcast(name: string, ...: any)
	local r = remote(name)
	for player, st in states do
		if st.ready and player.Parent ~= nil then
			r:FireClient(player, ...)
		end
	end
end

local function liveInfos(): { RunnerInfo }
	local out = {}
	for _, r in sim:runners() do
		if r.alive or r.pending then
			table.insert(out, r.info)
		end
	end
	return out
end

function ArenaService.freeColorIndex(): number
	local used: { [number]: boolean } = {}
	local runners = sim:runners()
	for _, r in runners do
		used[r.info.colorIndex] = true
	end
	local n = #Config.Colors.Players
	for i = 1, n do
		if not used[i] then
			return i
		end
	end
	return 1 + #runners % n
end

-- Player runner ids whose session is still inside the bots' gentle window (GDD G7.6).
function ArenaService.gentleRunnerIds(now: number): { number }
	local out = {}
	for id, st in playerById do
		if now &lt; st.gentleUntil then
			table.insert(out, id)
		end
	end
	return out
end

-- replication --------------------------------------------------------------------------------

local function flushDeltas()
	local changes = sim:drainCellChanges()
	local trails = sim:drainTrailDeltas()
	if #changes &gt; 0 or #trails &gt; 0 then
		broadcast(Remotes.ArenaDelta, sim.grid:encodeIndices(changes), trails)
	end
end

local function sendSnapshot(player: Player)
	local st = states[player]
	if st == nil then
		return
	end
	-- Flush first so deltas already queued are not re-applied on top of the snapshot's trails.
	flushDeltas()
	remote(Remotes.ArenaSnapshot):FireClient(player, sim.grid:encodeRLE(), liveInfos(), if st.id ~= 0 then st.id else nil)
	local trails = {}
	for _, r in sim:runners() do
		if r.alive or r.pending then
			table.insert(trails, { id = r.id, clear = true, append = table.clone(r.trail) })
		end
	end
	remote(Remotes.ArenaDelta):FireClient(player, sim.grid:encodeIndices({}), trails)
	st.ready = true
end

-- Called by the request router on a client's first Request (its UI is listening by then).
function ArenaService.clientReady(player: Player)
	if states[player] ~= nil then
		sendSnapshot(player)
	end
end

-- characters ---------------------------------------------------------------------------------

local function cellCFrame(st: PState, cx: number, cy: number): CFrame
	local wx, wz = sim.grid:cellToWorld(cx, cy)
	local lift = 3
	local hrp, humanoid = st.hrp, st.humanoid
	if hrp ~= nil and humanoid ~= nil then
		lift = math.max(humanoid.HipHeight, 2) + hrp.Size.Y / 2 + 0.5
	end
	return CFrame.new(wx, FLOOR_Y + lift, wz)
end

local function teleport(st: PState, target: CFrame, now: number)
	local char, hrp = st.character, st.hrp
	if char == nil or hrp == nil then
		return
	end
	char:PivotTo(target)
	hrp.AssemblyLinearVelocity = Vector3.zero
	st.exemptUntil = now + TELEPORT_EXEMPT
	st.settleTarget = target.Position
	st.lastPos = nil
	st.overTicks = 0
	st.slack = Config.Security.SpeedSlack
end

local function placeAtCell(st: PState, cx: number, cy: number, now: number)
	local hrp, humanoid = st.hrp, st.humanoid
	if hrp == nil or humanoid == nil then
		return
	end
	hrp.Anchored = false
	humanoid.WalkSpeed = st.walkSpeed
	st.settleTries = 0
	teleport(st, cellCFrame(st, cx, cy), now)
	-- Anchoring (hideCharacter) drops network ownership; hand control back to the player.
	pcall(function()
		hrp:SetNetworkOwner(st.player)
	end)
end

local function hideCharacter(st: PState)
	local char, hrp, humanoid = st.character, st.hrp, st.humanoid
	if char == nil or hrp == nil or humanoid == nil then
		return
	end
	humanoid.WalkSpeed = 0
	hrp.Anchored = true
	local p = hrp.Position
	char:PivotTo(CFrame.new(p.X, FLOOR_Y - HIDE_DEPTH, p.Z))
	st.settleTarget = nil
	st.lastPos = nil
end

local function resetLife(st: PState, now: number)
	st.lifeStart = now
	st.lifeCoins = 0
	st.lifeKills = 0
	st.secondChanceUsed = false
	st.pendingUntil = nil
	st.respawning = false
	st.autoRespawn = false
	st.kingAccum = 0
	st.overTicks = 0
end

local function removePlayerRunner(st: PState, now: number)
	local id = st.id
	if id == 0 then
		return
	end
	st.id = 0
	st.pendingUntil = nil
	playerById[id] = nil
	zeroSince[id] = nil
	sim:removeRunner(id, now)
end

-- Gold DisplayName tag above the head for VIP players; removed when absent.
local function applyVipTag(st: PState)
	local head = if st.character ~= nil then st.character:FindFirstChild("Head") else nil
	if head == nil then
		return
	end
	local old = head:FindFirstChild("VipTag")
	if old ~= nil then
		old:Destroy()
	end
	if not EconomyService.hasPass(st.player, "vip") then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "VipTag"
	gui.Size = UDim2.fromOffset(200, 40)
	gui.StudsOffset = Vector3.new(0, 2.5, 0)
	gui.AlwaysOnTop = true
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = Color3.fromHex(Config.Colors.Yellow)
	label.TextStrokeTransparency = 0.4
	label.Text = st.player.DisplayName
	label.Parent = gui
	gui.Parent = head
end

-- Single source of a player's WalkSpeed: upgrade level times the 2x Speed pass. The speed check reads
-- st.walkSpeed, so owners are allowed exactly what they are given.
local function playerWalkSpeed(player: Player): number
	local speed = UpgradeService.walkSpeed(player)
	local profile = DataService.get(player)
	if EconomyService.hasPass(player, "doubleSpeed") or (profile ~= nil and profile.speedBoostUntil &gt; os.time()) then
		speed *= Config.Passes.doubleSpeed.SpeedMultiplier
	end
	return speed
end

-- Re-reads the VIP pass into RunnerInfo, refreshes the world tag and re-broadcasts (pass bought or loaded).
function ArenaService.refreshVip(player: Player)
	local st = states[player]
	if st == nil then
		return
	end
	applyVipTag(st)
	local r = if st.id ~= 0 then sim:runner(st.id) else nil
	if r ~= nil then
		r.info.vip = EconomyService.hasPass(player, "vip")
		broadcast(Remotes.RunnerInfo, liveInfos())
	end
end

local function addPlayerRunner(st: PState, now: number)
	local player = st.player
	local profile = DataService.get(player)
	if profile == nil or st.character == nil or st.id ~= 0 then
		return
	end
	local info: RunnerInfo = {
		id = 0,
		userId = player.UserId,
		name = player.DisplayName,
		colorIndex = ArenaService.freeColorIndex(),
		skin = profile.equipped.skin,
		trail = profile.equipped.trail,
		effect = profile.equipped.effect,
		isBot = false,
		vip = EconomyService.hasPass(player, "vip"),
	}
	local id = sim:addRunner(info, UpgradeService.startPatch(player), UpgradeService.shieldSeconds(player), now)
	st.id = id
	playerById[id] = st
	applyVipTag(st)
	st.walkSpeed = playerWalkSpeed(player)
	resetLife(st, now)
	local r = sim:runner(id)
	if r ~= nil then
		placeAtCell(st, r.x, r.y, now)
	end
	sendSnapshot(player)
end

-- Character died (Reset, or the server reloaded it). A pending victim is released through the sim
-- first so the killer keeps the KillerShare; a death while alive starts the respawn delay.
local function onDied(st: PState)
	local now = os.clock()
	local r = if st.id ~= 0 then sim:runner(st.id) else nil
	if r ~= nil then
		if r.pending then
			st.pendingUntil = nil
			sim:releaseVictim(st.id)
		elseif r.alive then
			st.deathTime = now
		end
	end
	removePlayerRunner(st, now)
	st.character, st.hrp, st.humanoid = nil, nil, nil
end

-- Elimination with no killer (failed movement authority): the runner is removed, so its trail is
-- cleared and all its turf goes neutral, and the character is reloaded. The new character gets a
-- runner only after RespawnDelay (onCharacter), so this is never faster than a normal death.
local function eliminate(st: PState, now: number)
	removePlayerRunner(st, now)
	st.deathTime = now
	st.character, st.hrp, st.humanoid = nil, nil, nil
	local player = st.player
	task.spawn(function()
		local ok, err = pcall(player.LoadCharacter, player)
		if not ok then
			warn("[ArenaService] LoadCharacter failed:", err)
		end
	end)
end

local function onCharacter(st: PState, char: Model)
	for _, c in st.charConnections do
		c:Disconnect()
	end
	table.clear(st.charConnections)
	st.character, st.hrp, st.humanoid = nil, nil, nil
	local player = st.player
	local humanoid = char:WaitForChild("Humanoid", CHARACTER_WAIT)
	local hrp = char:WaitForChild("HumanoidRootPart", CHARACTER_WAIT)
	if humanoid == nil or hrp == nil or not humanoid:IsA("Humanoid") or not hrp:IsA("BasePart") then
		return
	end
	local deadline = os.clock() + CHARACTER_WAIT
	while char.Parent == nil and os.clock() &lt; deadline do
		task.wait()
		if player.Character ~= char or states[player] ~= st then
			return
		end
	end
	-- One frame so the engine's own spawn placement does not override our teleport.
	task.wait()
	if player.Character ~= char or states[player] ~= st or char.Parent == nil then
		return
	end
	-- A character reloaded after a death (Reset, elimination) waits out the normal respawn delay.
	local remaining = st.deathTime + Config.Arena.RespawnDelay - os.clock()
	if remaining &gt; 0 then
		task.wait(remaining)
		if player.Character ~= char or states[player] ~= st or char.Parent == nil then
			return
		end
	end
	local hum = humanoid :: Humanoid
	hum.JumpPower = 0
	hum.JumpHeight = 0
	st.character, st.hrp, st.humanoid = char, hrp :: BasePart, hum
	table.insert(
		st.charConnections,
		hum.Died:Connect(function()
			if st.character == char then
				onDied(st)
			end
		end)
	)
	local now = os.clock()
	removePlayerRunner(st, now) -- stale runner from a previous character, if any
	addPlayerRunner(st, now)
end

-- anti-exploit (G11.6) --------------------------------------------------------------------------

local function addStrike(st: PState, now: number)
	local strikes = st.strikes
	local i = 1
	while i &lt;= #strikes do
		if now - strikes[i] &gt; Config.Security.StrikeWindow then
			table.remove(strikes, i)
		else
			i += 1
		end
	end
	table.insert(strikes, now)
	if #strikes &gt;= Config.Security.KickStrikes then
		st.player:Kick("Movement check failed. Please rejoin.")
	end
end

local function snapBack(st: PState, r: Runner, now: number)
	st.settleTries = 0
	teleport(st, cellCFrame(st, r.x, r.y), now)
end

-- G11.6: out of bounds is a strike. With an open trail it is an elimination with no killer (never a
-- free escape from a cut); otherwise the runner is sent to the cell of its own turf nearest its last
-- accepted cell (its last cell when it owns nothing).
local function outOfBounds(st: PState, r: Runner, now: number)
	addStrike(st, now)
	if #r.trail &gt; 0 then
		eliminate(st, now)
		return
	end
	local bx, by, bd = r.x, r.y, math.huge
	local x0, y0, x1, y1 = sim.grid:bounds(r.id)
	if x0 and y0 and x1 and y1 then
		local size = sim.size
		for y = y0, y1 do
			for x = x0, x1 do
				if sim.grid:getIndex(y * size + x) == r.id then
					local d = (x - r.x) ^ 2 + (y - r.y) ^ 2
					if d &lt; bd then
						bx, by, bd = x, y, d
					end
				end
			end
		end
	end
	-- Move the sim position too, so the next step does not walk a line from the old cell.
	r.x, r.y = bx, by
	snapBack(st, r, now)
end

local function speedAllowance(st: PState, now: number): number
	if now &lt; st.speedGraceUntil then
		return math.max(st.walkSpeed, st.prevWalkSpeed)
	end
	return st.walkSpeed
end

-- Writes the runner's target cell into positions only when the movement is accepted.
local function readPlayer(st: PState, r: Runner, now: number, positions: { [number]: Cell })
	local hrp = st.hrp
	if hrp == nil or hrp.Parent == nil or hrp.Anchored then
		return
	end
	local pos = hrp.Position
	-- NaN or inf fails no comparison below and would throw inside the sim: drop the tick.
	local sum = pos.X + pos.Y + pos.Z
	if sum ~= sum or sum == math.huge or sum == -math.huge then
		addStrike(st, now)
		return
	end
	local target = st.settleTarget
	if target ~= nil then
		local dx, dz = pos.X - target.X, pos.Z - target.Z
		if dx * dx + dz * dz &lt;= SETTLE_RADIUS * SETTLE_RADIUS then
			-- The teleport has landed: from here every normal check applies, even inside the window.
			st.settleTarget = nil
			st.lastPos, st.lastTime = pos, now
		elseif now &lt; st.exemptUntil then
			-- The client still reports its pre-teleport position for a few frames.
			return
		elseif st.settleTries &lt; SETTLE_RETRIES then
			st.settleTries += 1
			teleport(st, CFrame.new(target), now)
			return
		else
			-- Never accept a position the client refused to leave.
			eliminate(st, now)
			return
		end
	end
	if
		math.abs(pos.X) &gt; HALF + CELL
		or math.abs(pos.Z) &gt; HALF + CELL
		or pos.Y &lt; FLOOR_Y - BELOW_FLOOR
		or pos.Y &gt; FLOOR_Y + ABOVE_FLOOR
	then
		outOfBounds(st, r, now)
		return
	end
	local last = st.lastPos
	if last == nil then
		st.lastPos, st.lastTime = pos, now
		return
	end
	-- Compared against the last ACCEPTED position, so held ticks widen the allowance (lag-safe).
	local dx, dz = pos.X - last.X, pos.Z - last.Z
	local distSq = dx * dx + dz * dz
	if distSq &lt; 1e-4 then
		-- No new replicated position (or standing still): keep lastTime so a replication stall
		-- followed by a catch-up burst is measured over the real elapsed time.
		st.overTicks = 0
		local cx, cy = sim.grid:worldToCell(pos.X, pos.Z)
		positions[r.id] = { x = cx, y = cy }
		return
	end
	local elapsed = math.min(now - st.lastTime, MAX_SPEED_WINDOW)
	local base = Config.Security.SpeedTolerance * speedAllowance(st, now) * elapsed
	-- Jitter slack is a small rolling budget (refilled per second), not a per-tick bonus, so the
	-- sustained limit stays near tolerance x speed. One late or bunched packet fits in the budget.
	local slack = math.min(st.slack + Config.Security.SpeedSlackRefill * elapsed, Config.Security.SpeedSlack)
	local allowed = base + slack
	if distSq &gt; allowed * allowed then
		st.overTicks += 1
		if st.overTicks &gt;= Config.Security.SpeedStrikeTicks then
			snapBack(st, r, now)
			addStrike(st, now)
		end
		return
	end
	st.slack = slack - math.max(math.sqrt(distSq) - base, 0)
	st.overTicks = 0
	st.lastPos, st.lastTime = pos, now
	local cx, cy = sim.grid:worldToCell(pos.X, pos.Z)
	positions[r.id] = { x = cx, y = cy }
end

-- event handling -------------------------------------------------------------------------------

local function onClaim(e: any, now: number)
	local st = playerById[e.id]
	if st == nil then
		return
	end
	local player = st.player
	local coins = EconomyService.onCapture(player, e.neutral, e.stolen)
	st.lifeCoins += coins
	local pct = sim:share(e.id) * 100
	RewardService.progress(player, "cells", e.cells, "add")
	RewardService.progress(player, "bigCapture", e.cells, "max")
	RewardService.progress(player, "mapPct", pct, "max")
	local applied, firstCapture, totalCells, best = false, false, 0, 0
	DataService.update(player, function(p)
		applied = true
		firstCapture = p.stats.captures == 0
		p.stats.cells += e.cells
		p.stats.captures += 1
		if pct &gt; p.stats.bestPct then
			p.stats.bestPct = pct
		end
		totalCells, best = p.stats.cells, p.stats.bestPct
	end)
	if applied then
		LeaderboardService.submit(player, "cells", totalCells)
		LeaderboardService.submit(player, "bestPct", best)
	end
	BadgeService.award(player, "firstLoop")
	for _, b in MAP_BADGES do
		if pct &gt;= b.pct then
			BadgeService.award(player, b.key)
		end
	end
	remote(Remotes.Reward):FireClient(player, { coins = coins, reason = "capture", cx = e.cx, cy = e.cy })
	AnalyticsService.log(player, "capture", { cells = e.cells, stolen = e.stolen })
	AnalyticsService.funnelOnce(player, 2, "first_capture")
	if firstCapture then
		AnalyticsService.log(player, "first_capture", { seconds = math.floor(now - st.joinClock) })
	end
end

local function onCut(e: any, now: number)
	local victimRunner = sim:runner(e.victim)
	local killerRunner = sim:runner(e.killer)
	local victimWasBot = victimRunner ~= nil and victimRunner.info.isBot
	local killerWasBot = killerRunner ~= nil and killerRunner.info.isBot

	local ks = playerById[e.killer]
	if ks ~= nil then
		local player = ks.player
		local coins = EconomyService.onKill(player, e.victimCells, e.victimWasKing)
		ks.lifeCoins += coins
		ks.lifeKills += 1
		RewardService.progress(player, "kills", 1, "add")
		local kills: number? = nil
		DataService.update(player, function(p)
			p.stats.kills += 1
			kills = p.stats.kills
		end)
		if kills ~= nil then
			LeaderboardService.submit(player, "kills", kills)
		end
		BadgeService.award(player, "firstCut")
		remote(Remotes.Reward):FireClient(player, { coins = coins, reason = "kill" })
		AnalyticsService.log(player, "cut", { victimWasBot = victimWasBot })
	end

	local vs = playerById[e.victim]
	if vs == nil then
		-- Bots and runners of players who left: split their turf now (BotService also does this for bots).
		sim:releaseVictim(e.victim)
		return
	end
	local player = vs.player
	vs.deathTime = now
	DataService.update(player, function(p)
		p.stats.deaths += 1
	end)
	hideCharacter(vs)
	local canSecondChance = Config.Ids.Products.secondChance ~= 0
		and sim:share(e.victim) &gt;= Config.Products.secondChance.MinMapShare
		and not vs.secondChanceUsed
	local lifeSeconds = math.floor(now - vs.lifeStart)
	remote(Remotes.Death):FireClient(player, {
		coins = vs.lifeCoins,
		cells = e.victimCells,
		lifeSeconds = lifeSeconds,
		kills = vs.lifeKills,
		canSecondChance = canSecondChance,
		killerName = if killerRunner ~= nil then killerRunner.info.name else nil,
	})
	AnalyticsService.log(player, "death", { cells = e.victimCells, lifeSeconds = lifeSeconds, killerWasBot = killerWasBot })
	AnalyticsService.funnelOnce(player, 4, "first_death")
	if canSecondChance then
		vs.pendingUntil = now + Config.Products.secondChance.PromptSeconds + SECOND_CHANCE_GRACE
	else
		vs.autoRespawn = true
		sim:releaseVictim(e.victim)
	end
end

local function onFullMap(e: any)
	local r = sim:runner(e.id)
	local st = playerById[e.id]
	if st ~= nil then
		EconomyService.onFullMap(st.player)
		BadgeService.award(st.player, "map100")
	end
	local name = if r ~= nil then r.info.name else "Someone"
	remote(Remotes.Toast):FireAllClients(name .. " captured the WHOLE map!", "good")
end

local function handleEvent(ev: ArenaEvent, now: number)
	local e = ev :: any
	if e.kind == "claim" then
		onClaim(e, now)
	elseif e.kind == "cut" then
		onCut(e, now)
	elseif e.kind == "king" then
		local st = playerById[e.id]
		if st ~= nil then
			BadgeService.award(st.player, "king")
		end
	elseif e.kind == "fullMap" then
		onFullMap(e)
	end
end

-- life cycle -----------------------------------------------------------------------------------

local function doRespawn(st: PState, now: number)
	local player = st.player
	st.pendingUntil = nil
	AnalyticsService.funnelOnce(player, 5, "respawn")
	sim:respawn(st.id, UpgradeService.startPatch(player), UpgradeService.shieldSeconds(player), now)
	st.walkSpeed = playerWalkSpeed(player)
	resetLife(st, now)
	local r = sim:runner(st.id)
	if r ~= nil then
		placeAtCell(st, r.x, r.y, now)
	end
end

-- Alive runners left with no turf and no trail can never claim again: give them a fresh patch.
-- The runner keeps its id and info (removeRunner then addRunner), so clients see despawn + spawn.
local function recycle(r: Runner, now: number)
	local id = r.id
	if orphans[id] then
		orphans[id] = nil
		sim:removeRunner(id, now)
		return
	end
	local st = playerById[id]
	local patch, shield = r.startPatch, Config.Arena.SpawnShield
	if st ~= nil then
		patch, shield = UpgradeService.startPatch(st.player), UpgradeService.shieldSeconds(st.player)
	end
	local info = r.info
	sim:removeRunner(id, now)
	info.id = id
	sim:addRunner(info, patch, shield, now)
	local nr = sim:runner(id)
	if st ~= nil and nr ~= nil then
		placeAtCell(st, nr.x, nr.y, now)
	end
end

local function housekeeping(now: number)
	local kingSt = playerById[sim:kingId()]
	EconomyService.setKing(if kingSt ~= nil then kingSt.player else nil)
	if kingSt ~= nil then
		kingSt.kingAccum += STEP
		if kingSt.kingAccum &gt;= 1 then
			kingSt.kingAccum -= 1
			RewardService.progress(kingSt.player, "kingSeconds", 1, "add")
			local rush = Formulas.isCrownRush(os.time())
			local won = false
			DataService.update(kingSt.player, function(p)
				p.stats.kingSeconds += 1
				if rush then
					local cr = Config.CrownRush
					if p.crownRush.event ~= cr.Start then
						p.crownRush.event = cr.Start
						p.crownRush.seconds = 0
					end
					p.crownRush.seconds += 1
					if p.crownRush.seconds &gt;= cr.PrizeSeconds and not p.owned[cr.Trail] then
						p.owned[cr.Trail] = true
						won = true
					end
				end
			end)
			if won then
				remote(Remotes.Toast):FireClient(kingSt.player, S.crownRushWon, "good")
			end
		end
	end

	for _, st in table.clone(playerById) do
		local r = sim:runner(st.id)
		if r ~= nil and not r.alive then
			local pendingUntil = st.pendingUntil
			if r.pending and pendingUntil ~= nil and now &gt;= pendingUntil then
				st.pendingUntil = nil
				sim:releaseVictim(st.id)
			elseif
				not r.pending
				and not st.respawning
				and now - st.deathTime &gt; (if st.autoRespawn then Config.Arena.RespawnDelay else IDLE_RESPAWN)
			then
				doRespawn(st, now)
			end
		end
	end

	for _, r in sim:runners() do
		if r.alive and #r.trail == 0 and sim:cellsOf(r.id) == 0 then
			local since = zeroSince[r.id]
			if since == nil then
				zeroSince[r.id] = now
			elseif now - since &gt; ZERO_TURF_RECYCLE then
				zeroSince[r.id] = nil
				recycle(r, now)
			end
		else
			zeroSince[r.id] = nil
		end
	end
end

local function tick(now: number)
	local pre = ArenaService.preStep
	if pre ~= nil then
		local ok, err = pcall(pre, now, STEP)
		if not ok then
			warn("[ArenaService] preStep failed:", err)
		end
	end

	local positions: { [number]: Cell } = {}
	for id, p in ArenaService.botPositions do
		local r = sim:runner(id)
		if r ~= nil and r.info.isBot then
			positions[id] = p
		end
	end
	local list: { PState } = {}
	for _, st in states do
		table.insert(list, st)
	end
	for _, st in list do
		if st.id ~= 0 then
			local r = sim:runner(st.id)
			if r ~= nil and r.alive then
				readPlayer(st, r, now, positions)
			end
		end
	end

	sim:step(now, positions)

	for _, ev in sim:drainEvents() do
		local e = ev :: any
		if e.kind == "spawn" then
			-- Clients cannot read os.clock; give them shieldUntil on the synchronized server clock.
			local copy = table.clone(e)
			copy.shieldUntil = workspace:GetServerTimeNow() + (e.shieldUntil - now)
			broadcast(Remotes.ArenaEvent, copy)
		else
			broadcast(Remotes.ArenaEvent, ev)
		end
		local ok, err = pcall(handleEvent, ev, now)
		if not ok then
			warn("[ArenaService] event handler failed:", (ev :: any).kind, err)
		end
		for _, fn in table.clone(eventListeners) do
			local ok2, err2 = pcall(fn, ev)
			if not ok2 then
				warn("[ArenaService] onEvent listener failed:", err2)
			end
		end
	end

	housekeeping(now)
end

-- public API -----------------------------------------------------------------------------------

-- Called once the player's profile is loaded; the runner is added when the character exists.
function ArenaService.join(player: Player)
	if states[player] ~= nil or player.Parent == nil then
		return
	end
	local now = os.clock()
	local profile = DataService.get(player)
	-- ponytail: playSeconds is banked every 60 s, so a rejoin can get up to 60 s of extra gentle time once.
	local played = if profile ~= nil then profile.stats.playSeconds else 0
	local st: PState = {
		player = player,
		joinClock = now,
		gentleUntil = now + math.max(0, Config.Bots.GentleSeconds - played),
		id = 0,
		character = nil,
		hrp = nil,
		humanoid = nil,
		connections = {},
		charConnections = {},
		walkSpeed = playerWalkSpeed(player),
		prevWalkSpeed = 0,
		speedGraceUntil = 0,
		lastPos = nil,
		lastTime = now,
		slack = Config.Security.SpeedSlack,
		overTicks = 0,
		strikes = {},
		exemptUntil = 0,
		settleTarget = nil,
		settleTries = 0,
		deathTime = -math.huge, -- no death yet: the first character gets its runner at once
		lifeStart = now,
		lifeCoins = 0,
		lifeKills = 0,
		pendingUntil = nil,
		secondChanceUsed = false,
		respawning = false,
		autoRespawn = false,
		kingAccum = 0,
		ready = false,
	}
	states[player] = st
	table.insert(
		st.connections,
		player.CharacterAdded:Connect(function(char: Model)
			onCharacter(st, char)
		end)
	)
	local char = player.Character
	if char ~= nil then
		task.spawn(onCharacter, st, char)
	end
end

-- The runner (and its turf) stays for LeaveNeutralDelay seconds, then is removed.
function ArenaService.leave(player: Player)
	local st = states[player]
	if st == nil then
		return
	end
	states[player] = nil
	for _, c in st.connections do
		c:Disconnect()
	end
	for _, c in st.charConnections do
		c:Disconnect()
	end
	local id = st.id
	if id == 0 then
		return
	end
	st.id = 0
	playerById[id] = nil
	local r = sim:runner(id)
	if r == nil then
		return
	end
	if r.pending then
		sim:releaseVictim(id)
	end
	orphans[id] = true
	local info = r.info
	task.delay(Config.Arena.LeaveNeutralDelay, function()
		if orphans[id] then
			orphans[id] = nil
			local cur = sim:runner(id)
			if cur ~= nil and cur.info == info then
				sim:removeRunner(id, os.clock())
			end
		end
	end)
end

-- Request handler. Waits out the rest of RespawnDelay if needed.
function ArenaService.respawn(player: Player): (boolean, any)
	local st = states[player]
	if st == nil or st.id == 0 then
		return false, "not_in_arena"
	end
	local id = st.id
	local r = sim:runner(id)
	if r == nil or r.alive then
		return false, "not_dead"
	end
	if st.respawning then
		return false, "busy"
	end
	if r.pending then
		st.pendingUntil = nil
		sim:releaseVictim(id)
	end
	local remaining = st.deathTime + Config.Arena.RespawnDelay - os.clock()
	if remaining &gt; 0 then
		st.respawning = true
		task.wait(remaining)
		st.respawning = false
		local again = sim:runner(id)
		if states[player] ~= st or st.id ~= id or again == nil or again.alive then
			return false, "not_dead"
		end
	end
	doRespawn(st, os.clock())
	return true, id
end

function ArenaService.declineSecondChance(player: Player): (boolean, any)
	local st = states[player]
	if st == nil or st.id == 0 then
		return false, "not_in_arena"
	end
	local r = sim:runner(st.id)
	if r == nil or not r.pending then
		return false, "not_pending"
	end
	st.pendingUntil = nil
	sim:releaseVictim(st.id)
	return true, nil
end

-- MonetizationService.onSecondChance: true only when the player was still a pending victim.
function ArenaService.secondChance(player: Player): boolean
	local st = states[player]
	if st == nil or st.id == 0 then
		return false
	end
	local r = sim:runner(st.id)
	if r == nil or not r.pending then
		return false
	end
	local now = os.clock()
	if not sim:revive(st.id, Config.Products.secondChance.Shield, now) then
		return false
	end
	st.pendingUntil = nil
	st.secondChanceUsed = true
	placeAtCell(st, r.x, r.y, now)
	return true
end

-- After a speed upgrade, a rebirth or a pass grant (2x Speed).
function ArenaService.refreshWalkSpeed(player: Player)
	local st = states[player]
	if st == nil then
		return
	end
	local speed = playerWalkSpeed(player)
	if speed &lt; st.walkSpeed then
		st.prevWalkSpeed = st.walkSpeed
		st.speedGraceUntil = os.clock() + SPEED_DROP_GRACE
	end
	st.walkSpeed = speed
	local humanoid = st.humanoid
	if humanoid ~= nil and st.id ~= 0 and sim:isAlive(st.id) then
		humanoid.WalkSpeed = speed
	end
end

function ArenaService.runnerIdOf(player: Player): number
	local st = states[player]
	return if st ~= nil then st.id else 0
end

function ArenaService.start()
	if started then
		return
	end
	started = true
	for _, name in
		{ Remotes.ArenaSnapshot, Remotes.ArenaDelta, Remotes.ArenaEvent, Remotes.Death, Remotes.Reward, Remotes.Toast, Remotes.RunnerInfo }
	do
		remote(name)
	end

	MonetizationService.onSecondChance = ArenaService.secondChance
	MonetizationService.onPassOwned = function(player: Player)
		ArenaService.refreshVip(player)
		ArenaService.refreshWalkSpeed(player) -- 2x Speed applies at once, no respawn needed
	end
	EconomyService.cellsProvider = function(player: Player): number
		local st = states[player]
		if st == nil or st.id == 0 or not sim:isAlive(st.id) then
			return 0
		end
		return sim:cellsOf(st.id)
	end

	ShopService.equippedChanged:Connect(function(player: Player, equipped: { skin: string, trail: string, effect: string })
		local st = states[player]
		if st == nil or st.id == 0 then
			return
		end
		local r = sim:runner(st.id)
		if r == nil then
			return
		end
		r.info.skin, r.info.trail, r.info.effect = equipped.skin, equipped.trail, equipped.effect
		r.info.vip = EconomyService.hasPass(player, "vip")
		broadcast(Remotes.RunnerInfo, liveInfos())
	end)

	Players.PlayerRemoving:Connect(ArenaService.leave)

	local acc, deltaAcc = 0, 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		local steps = 0
		while acc &gt;= STEP do
			steps += 1
			if steps &gt; MAX_CATCHUP_STEPS then
				acc = 0
				break
			end
			acc -= STEP
			local ok, err = pcall(tick, os.clock())
			if not ok then
				warn("[ArenaService] tick failed:", err)
			end
		end
		deltaAcc += dt
		if deltaAcc &gt;= DELTA_PERIOD then
			deltaAcc = math.min(deltaAcc - DELTA_PERIOD, DELTA_PERIOD)
			flushDeltas()
		end
	end)
end

return ArenaService
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000000000000000000000000000018">
					<Properties>
						<string name="Name">BadgeService</string>
						<ProtectedString name="Source">--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Players = game:GetService("Players")

local Badges = {}

local awarded: { [number]: { [string]: boolean } } = {}

function Badges.award(player: Player, key: string)
	local id = Config.Ids.Badges[key]
	if id == nil or id == 0 then
		return
	end
	local set = awarded[player.UserId]
	if set == nil then
		set = {}
		awarded[player.UserId] = set
	end
	if set[key] then
		return
	end
	set[key] = true
	local userId = player.UserId
	task.spawn(function()
		local ok = pcall(function()
			game:GetService("BadgeService"):AwardBadge(userId, id)
		end)
		if not ok and awarded[userId] ~= nil then
			awarded[userId][key] = nil
		end
	end)
end

Players.PlayerRemoving:Connect(function(player: Player)
	awarded[player.UserId] = nil
end)

return Badges
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000000000000000000000000000019">
					<Properties>
						<string name="Name">BotService</string>
						<ProtectedString name="Source">--!strict
-- Server bots (GDD G10): keeps the arena at Config.Arena.MinRunners with BotBrain-driven runners.
-- Rigs live in workspace.Bots, named tostring(runnerId). A bot starts as a simple anchored stand-in
-- rig; its R15 avatar (a joining player's friend, else a Config fallback) is built asynchronously
-- and swapped in. The arena sim stays authoritative: the avatar walks after it with Humanoid:MoveTo.
local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local BotBrain = require(Shared.BotBrain)
local Catalog = require(Shared.Catalog)
local Config = require(Shared.Config)
local Types = require(Shared.Types)
local ArenaService = require(script.Parent.ArenaService)
local DataService = require(script.Parent.DataService)

type RunnerInfo = Types.RunnerInfo
type Bot = {
	id: number,
	info: RunnerInfo,
	brain: BotBrain.State,
	px: number, -- continuous position in cell units; the sim floors it
	py: number,
	model: Model,
	body: Part?, -- stand-in rig parts; nil once the avatar is swapped in
	head: Part?,
	respawnAt: number?,
	avatarUserId: number?,
	hum: Humanoid?, -- set once the avatar is swapped in
	root: BasePart?,
	lift: number, -- avatar root height above the floor
	run: AnimationTrack?,
	idle: AnimationTrack?,
	moving: boolean?,
}
type PoolEntry = { userId: number, displayName: string, owner: Player }

local NAMES = {
	"PixelPanda", "TurboTaco", "SunnySprout", "ZippyZebra", "MangoMoose", "CosmoCub", "BubbleBolt", "NovaNugget",
	"JellyJet", "MapleMarble", "RocketRadish", "PeppyPenguin", "WaffleWizard", "BreezyBean", "LunaLlama", "CometCookie",
	"DizzyDolphin", "FizzyFox", "GummyGecko", "HappyHedgehog", "IcyIguana", "JollyJaguar", "KiwiKite", "LemonLynx",
	"MintyMole", "NoodleNewt", "OtterOrbit", "PuddlePuffin", "QuirkyQuail", "RaspberryRay", "SnappySquid", "TofuTiger",
	"UmbrellaUnicorn", "VelvetVole", "WobblyWalrus", "YoyoYak", "ZestyZinnia", "BlueberryBlitz", "CloudyCamel", "DoodleDuck",
}

local GENTLE_RADIUS = 20 -- cells
local TUTORIAL_NEAR_CELLS = 25 -- a new player should have a bot this close (GDD G7.4)
local TUTORIAL_RELEASE_CELLS = 15 -- a steered bot is released once this close
local BODY_HEIGHT = 4
local BODY_WIDTH = 3
local HEAD_SIZE = 2
local RESPAWN_JITTER_MIN, RESPAWN_JITTER_MAX = 1, 3
local MAINTAIN_PERIOD = 1
local FLOOR_Y = Config.Arena.FloorY
local CELLS_PER_SECOND = Config.Arena.BaseWalkSpeed / Config.Arena.CellSize

local BotService = {}

local bots: { [number]: Bot } = {}
local rng = Random.new()
local folder: Folder? = nil
local maintainAcc = 0
local warnedBrain = false
local started = false
-- One bot at a time is steered toward a tutorial player who has no bot nearby (GAP-07).
local steer: { botId: number, targetId: number }? = nil
local BOT_GROUP = "TurfBots" -- avatar rigs: collide with the floor (Default), not with players or each other
local PLAYER_GROUP = "TurfPlayers" -- player characters: same as Default except they pass through bots
local pool: { PoolEntry } = {} -- friends of players in the server, tagged with that player
local templates: { [number]: Model } = {} -- built avatars by userId, kept in ServerStorage
local templateOrder: { number } = {}
local building: { [number]: boolean } = {}
local failed: { [number]: boolean } = {} -- userIds whose avatar could not be built (not retried)
local store: Folder? = nil

local function pickName(): string
	local used: { [string]: boolean } = {}
	for _, b in bots do
		used[b.info.name] = true
	end
	local start = rng:NextInteger(1, #NAMES)
	for k = 0, #NAMES - 1 do
		local name = NAMES[(start + k - 1) % #NAMES + 1]
		if not used[name] then
			return name
		end
	end
	return NAMES[start]
end

-- A default or common cosmetic of the given type, so bots look varied but never premium.
local function pickCosmetic(itemType: string): string
	local list: { string } = {}
	local fallback = ""
	for _, item in Catalog.ofType(itemType) do
		if item.default == true then
			fallback = item.id
		end
		if item.default == true or item.rarity == "common" then
			table.insert(list, item.id)
		end
	end
	if #list == 0 then
		return fallback
	end
	return list[rng:NextInteger(1, #list)]
end

local function makeRig(info: RunnerInfo): (Model, Part, Part)
	local color = Color3.fromHex(Config.Colors.Players[info.colorIndex] or Config.Colors.Players[1])
	local model = Instance.new("Model")
	model.Name = tostring(info.id)

	local body = Instance.new("Part")
	body.Name = "Body"
	body.Shape = Enum.PartType.Cylinder -- cylinders run along X; placeRig turns it upright
	body.Size = Vector3.new(BODY_HEIGHT, BODY_WIDTH, BODY_WIDTH)
	body.Color = color
	body.Material = Enum.Material.SmoothPlastic
	body.Anchored = true
	body.CanCollide = false
	body.CanQuery = false
	body.CanTouch = false
	body.Parent = model

	local head = Instance.new("Part")
	head.Name = "Head"
	head.Shape = Enum.PartType.Ball
	head.Size = Vector3.new(HEAD_SIZE, HEAD_SIZE, HEAD_SIZE)
	head.Color = color
	head.Material = Enum.Material.SmoothPlastic
	head.Anchored = true
	head.CanCollide = false
	head.CanQuery = false
	head.CanTouch = false
	head.Parent = model

	local gui = Instance.new("BillboardGui")
	gui.Name = "NameTag"
	gui.Size = UDim2.fromOffset(160, 30)
	gui.StudsOffset = Vector3.new(0, HEAD_SIZE, 0)
	gui.MaxDistance = 150
	gui.Adornee = head
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = info.name
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = gui
	gui.Parent = head

	model.PrimaryPart = body
	return model, body, head
end

local function animate(b: Bot, moving: boolean, walkSpeed: number)
	local run, idle = b.run, b.idle
	if run == nil or idle == nil then
		return
	end
	if b.moving ~= moving then
		b.moving = moving
		if moving then
			idle:Stop(0.2)
			run:Play(0.2)
		else
			run:Stop(0.2)
			idle:Play(0.2)
		end
	end
	if moving then
		run:AdjustSpeed(walkSpeed / Config.Bots.RunAnimationSpeed)
	end
end

-- Stand-in: anchored parts placed on the simulated position. Avatar: walks with Humanoid:MoveTo
-- toward a point a little ahead of the simulated position along (dx, dy) at the simulated speed
-- (cells/s); PivotTo only when `snap` or when it drifted further than RigSnapDistance.
local function placeRig(b: Bot, snap: boolean, dx: number, dy: number, speed: number)
	local grid = ArenaService.sim.grid
	local wx, wz = grid:cellToWorld(b.px - 0.5, b.py - 0.5)
	local hum, root = b.hum, b.root
	if hum == nil or root == nil then
		local body, head = b.body, b.head
		if body ~= nil and head ~= nil then
			body.CFrame = CFrame.new(wx, FLOOR_Y + BODY_HEIGHT / 2, wz) * CFrame.Angles(0, 0, math.pi / 2)
			head.CFrame = CFrame.new(wx, FLOOR_Y + BODY_HEIGHT + HEAD_SIZE / 2, wz)
		end
		return
	end
	local ahead = Config.Bots.RigLookAheadCells
	local tx, tz = grid:cellToWorld(b.px - 0.5 + dx * ahead, b.py - 0.5 + dy * ahead)
	local rp = root.Position
	if
		snap
		or Vector3.new(rp.X - wx, 0, rp.Z - wz).Magnitude &gt; Config.Bots.RigSnapDistance
		or math.abs(rp.Y - (FLOOR_Y + b.lift)) &gt; Config.Bots.RigSnapHeight
	then
		local pos = Vector3.new(wx, FLOOR_Y + b.lift, wz)
		local look = if dx ~= 0 or dy ~= 0 then Vector3.new(tx - wx, 0, tz - wz) else root.CFrame.LookVector * Vector3.new(1, 0, 1)
		b.model:PivotTo(if look.Magnitude &gt; 1e-3 then CFrame.new(pos, pos + look) else CFrame.new(pos))
		root.AssemblyLinearVelocity = Vector3.zero
	end
	local walkSpeed = math.max(speed * Config.Arena.CellSize * Config.Bots.RigSpeedScale, 1)
	hum.WalkSpeed = walkSpeed
	hum:MoveTo(Vector3.new(tx, FLOOR_Y, tz))
	animate(b, dx ~= 0 or dy ~= 0, walkSpeed)
end

-- Parents the rig into workspace.Bots on the simulated position; avatar roots stay server-owned.
local function showRig(b: Bot)
	placeRig(b, true, 0, 0, 0)
	b.model.Parent = folder
	local root = b.root
	if root ~= nil then
		pcall(root.SetNetworkOwner, root, nil)
	end
end

-- Swaps the stand-in rig for a clone of a built avatar template (keeps the simulated state).
local function applyAvatar(b: Bot, template: Model)
	local m = template:Clone()
	local hum = m:FindFirstChildOfClass("Humanoid")
	local root = m.PrimaryPart or m:FindFirstChild("HumanoidRootPart")
	if hum == nil or root == nil or not root:IsA("BasePart") then
		m:Destroy()
		return
	end
	m.Name = tostring(b.id)
	m.PrimaryPart = root
	hum.DisplayName = b.info.name
	hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CollisionGroup = BOT_GROUP
		end
	end
	local animator = hum:FindFirstChildOfClass("Animator")
	if animator == nil then
		local a = Instance.new("Animator")
		a.Parent = hum
		animator = a
	end
	local function load(id: string): AnimationTrack?
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		local ok, track = pcall((animator :: Animator).LoadAnimation, animator :: Animator, anim)
		if ok and track ~= nil then
			track.Looped = true
			return track
		end
		return nil
	end
	local visible = b.model.Parent ~= nil
	b.model:Destroy()
	b.model, b.body, b.head = m, nil, nil
	b.hum, b.root = hum, root
	b.lift = hum.HipHeight + root.Size.Y / 2
	b.run, b.idle, b.moving = load(Config.Bots.RunAnimationId), load(Config.Bots.IdleAnimationId), nil
	if visible then
		showRig(b)
	end
end

-- Builds (once per userId, off the caller's thread) and caches the avatar, then applies it to every
-- bot still waiting for it. On failure the bot keeps its stand-in rig.
local function requestAvatar(userId: number)
	local cached = templates[userId]
	if cached ~= nil then
		for _, b in bots do
			if b.avatarUserId == userId and b.hum == nil then
				applyAvatar(b, cached)
			end
		end
		return
	end
	if building[userId] or failed[userId] then
		return
	end
	building[userId] = true
	task.spawn(function()
		-- Always R15, whatever the friend's own rig type (R6 sinks into the floor and does not animate).
		local ok, model = pcall(function()
			local desc = Players:GetHumanoidDescriptionFromUserId(userId)
			return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
		end)
		building[userId] = nil
		if not ok or typeof(model) ~= "Instance" or not (model :: Instance):IsA("Model") then
			failed[userId] = true
			return
		end
		local m = model :: Model
		for _, d in m:GetDescendants() do
			if d:IsA("LuaSourceContainer") then
				d:Destroy()
			end
		end
		m.Name = tostring(userId)
		m.Parent = store
		templates[userId] = m
		table.insert(templateOrder, userId)
		while #templateOrder &gt; Config.Bots.AvatarCacheMax do
			local old = table.remove(templateOrder, 1) :: number
			local t = templates[old]
			templates[old] = nil
			if t ~= nil then
				t:Destroy()
			end
		end
		requestAvatar(userId)
	end)
end

-- A friend from the pool not worn by another bot and not in the server, else a fallback avatar
-- with a generated name. Returns (avatar userId or nil, runner name).
local function pickAvatar(): (number?, string)
	local inUse: { [number]: boolean } = {}
	for _, b in bots do
		local uid = b.avatarUserId
		if uid ~= nil then
			inUse[uid] = true
		end
	end
	local function free(uid: number): boolean
		return not inUse[uid] and not failed[uid] and Players:GetPlayerByUserId(uid) == nil
	end
	if #pool &gt; 0 then
		local start = rng:NextInteger(1, #pool)
		for k = 0, #pool - 1 do
			local e = pool[(start + k - 1) % #pool + 1]
			if free(e.userId) then
				return e.userId, e.displayName
			end
		end
	end
	for _, uid in Config.Bots.FallbackUserIds do
		if free(uid) then
			return uid, pickName()
		end
	end
	return nil, pickName()
end

-- Adds up to FriendsPerPlayer of the player's friends to the pool (yields; run off the join path).
local function fetchFriends(player: Player)
	local ok, pages = pcall(Players.GetFriendsAsync, Players, player.UserId)
	if not ok then
		return
	end
	local got: { PoolEntry } = {}
	local cap = Config.Bots.FriendsPerPlayer
	while #got &lt; cap do
		local okPage, page = pcall(function()
			return (pages :: any):GetCurrentPage()
		end)
		if not okPage or type(page) ~= "table" then
			break
		end
		for _, f in page do
			if #got &gt;= cap then
				break
			end
			local id, name = f.Id, f.DisplayName or f.Username
			if type(id) == "number" and id &gt; 0 and type(name) == "string" then
				table.insert(got, { userId = id, displayName = name, owner = player })
			end
		end
		if (pages :: any).IsFinished then
			break
		end
		if not pcall(function()
			(pages :: any):AdvanceToNextPageAsync()
		end) then
			break
		end
	end
	if player.Parent ~= Players then
		return
	end
	local have: { [number]: boolean } = {}
	for _, e in pool do
		have[e.userId] = true
	end
	for _, e in got do
		if not have[e.userId] then
			have[e.userId] = true
			table.insert(pool, e)
		end
	end
end

local function dropFriends(player: Player)
	for i = #pool, 1, -1 do
		if pool[i].owner == player then
			table.remove(pool, i)
		end
	end
end

local function setPlayerGroup(char: Model)
	local function set(d: Instance)
		if d:IsA("BasePart") then
			d.CollisionGroup = PLAYER_GROUP
		end
	end
	for _, d in char:GetDescendants() do
		set(d)
	end
	char.DescendantAdded:Connect(set)
end

local function watchPlayer(player: Player)
	task.spawn(fetchFriends, player)
	if player.Character ~= nil then
		setPlayerGroup(player.Character)
	end
	player.CharacterAdded:Connect(setPlayerGroup)
end

local function hideBot(b: Bot)
	b.model.Parent = nil
	ArenaService.botPositions[b.id] = nil
end

-- Snap to the runner's current cell (after spawn, respawn or a server-side recycle).
local function resetBot(b: Bot)
	local r = ArenaService.sim:runner(b.id)
	if r == nil then
		return
	end
	b.px, b.py = r.x + 0.5, r.y + 0.5
	b.respawnAt = nil
	BotBrain.reset(b.brain)
	ArenaService.botPositions[b.id] = { x = b.px, y = b.py }
	b.model.Name = tostring(b.id)
	showRig(b)
end

local function spawnBot(now: number)
	local tiers = Config.Bots.Tiers
	local tier = tiers[rng:NextInteger(1, #tiers)]
	local avatarUserId, name = pickAvatar()
	local info: RunnerInfo = {
		id = 0,
		userId = 0, -- stays 0: bots are off the leaderboards and never matched to a Player
		name = name,
		colorIndex = ArenaService.freeColorIndex(),
		skin = pickCosmetic("skin"),
		trail = pickCosmetic("trail"),
		effect = pickCosmetic("effect"),
		isBot = true,
	}
	local id = ArenaService.sim:addRunner(info, Config.Arena.StartPatch, Config.Arena.SpawnShield, now)
	local model, body, head = makeRig(info)
	local b: Bot = {
		id = id,
		info = info,
		brain = BotBrain.new(tier, function(): number
			return rng:NextNumber()
		end),
		px = 0,
		py = 0,
		model = model,
		body = body,
		head = head,
		respawnAt = nil,
		avatarUserId = avatarUserId,
		lift = 0,
	}
	bots[id] = b
	resetBot(b)
	if avatarUserId ~= nil then
		requestAvatar(avatarUserId)
	end
end

local function removeBot(b: Bot, now: number)
	bots[b.id] = nil
	ArenaService.botPositions[b.id] = nil
	b.model:Destroy()
	local r = ArenaService.sim:runner(b.id)
	if r ~= nil and r.info == b.info then
		ArenaService.sim:removeRunner(b.id, now)
	end
end

-- Bot count follows the number of players in the server (not live player runners), so a player's
-- character respawn does not make bots churn.
local function maintain(now: number)
	local target = math.max(0, Config.Arena.MinRunners - #Players:GetPlayers())
	local count = 0
	for _ in bots do
		count += 1
	end
	if count &lt; target then
		for _ = 1, target - count do
			spawnBot(now)
		end
	elseif count &gt; target then
		-- A player joined: drop the bot with the fewest cells (one wearing a player now in the server
		-- goes first). removeRunner clears its trail and makes all its cells neutral (no killer share).
		local sim = ArenaService.sim
		local pick: Bot? = nil
		local best = math.huge
		for id, b in bots do
			local uid = b.avatarUserId
			local score = if uid ~= nil and Players:GetPlayerByUserId(uid) ~= nil then -1 else sim:cellsOf(id)
			if score &lt; best then
				pick, best = b, score
			end
		end
		if pick ~= nil then
			removeBot(pick, now)
		end
	end
end

local function cellDist2(a: any, b: any): number
	return (a.x - b.x) ^ 2 + (a.y - b.y) ^ 2
end

-- Runs once per maintain period: keeps or ends the current steer, or starts one.
local function updateSteer()
	local sim = ArenaService.sim
	local cur = steer
	if cur ~= nil then
		local br, tr = sim:runner(cur.botId), sim:runner(cur.targetId)
		if br == nil or tr == nil or not br.alive or not tr.alive or bots[cur.botId] == nil
			or cellDist2(br, tr) &lt;= TUTORIAL_RELEASE_CELLS ^ 2 then
			steer = nil
		end
		return
	end
	local now = ArenaService.now()
	local gentleSet: { [number]: boolean } = {}
	for _, id in ArenaService.gentleRunnerIds(now) do
		gentleSet[id] = true
	end
	for _, player in Players:GetPlayers() do
		local id = ArenaService.runnerIdOf(player)
		local profile = DataService.get(player)
		local t = sim:runner(id)
		if gentleSet[id] and profile ~= nil and not profile.tutorialDone and t ~= nil and t.alive then
			local nearest, farthest, farD = math.huge, nil :: any, -1
			for botId, b in bots do
				local r = sim:runner(botId)
				if r ~= nil and r.alive and r.info == b.info then
					local d = cellDist2(r, t)
					nearest = math.min(nearest, d)
					if d &gt; farD and #r.trail == 0 then
						farthest, farD = botId, d
					end
				end
			end
			if nearest &gt; TUTORIAL_NEAR_CELLS ^ 2 and farthest ~= nil then
				steer = { botId = farthest :: number, targetId = id }
				return
			end
		end
	end
end

local function approach(value: number, target: number, maxDelta: number): number
	if math.abs(target - value) &lt;= maxDelta then
		return target
	end
	return value + math.sign(target - value) * maxDelta
end

local function moveBot(b: Bot, r: any, now: number, dt: number, gentle: { number }, gentleSet: { [number]: boolean })
	local sim = ArenaService.sim
	local grid = sim.grid
	local size = grid.size
	if math.abs(math.floor(b.px) - r.x) &gt; 1 or math.abs(math.floor(b.py) - r.y) &gt; 1 then
		resetBot(b)
	end

	local dx, dy = 0, 0
	local ok, a, c = pcall(BotBrain.step, b.brain, sim, b.id, now)
	if ok then
		dx, dy = math.sign(a or 0), math.sign(c or 0)
	elseif not warnedBrain then
		warnedBrain = true
		warn("[BotService] BotBrain.step failed:", a)
	end
	if dx ~= 0 and dy ~= 0 then
		dy = 0
	end
	local sv = steer
	if sv ~= nil and sv.botId == b.id then
		local t = sim:runner(sv.targetId)
		if t ~= nil then
			local tx, ty = t.x - r.x, t.y - r.y
			if math.abs(tx) &gt;= math.abs(ty) then
				dx, dy = math.sign(tx), 0
			else
				dx, dy = 0, math.sign(ty)
			end
		end
	end

	-- Never cut a player in their gentle window: stop before entering their trail.
	if dx ~= 0 or dy ~= 0 then
		local nx, ny = math.floor(b.px) + dx, math.floor(b.py) + dy
		if grid:inBounds(nx, ny) then
			for _, owner in sim:trailOwnersAt(grid:index(nx, ny)) do
				if gentleSet[owner] then
					dx, dy = 0, 0
					break
				end
			end
		end
	end

	local speed = CELLS_PER_SECOND
	for _, id in gentle do
		local g = sim:runner(id)
		if g ~= nil and g.alive then
			local ddx, ddy = g.x - r.x, g.y - r.y
			if ddx * ddx + ddy * ddy &lt;= GENTLE_RADIUS * GENTLE_RADIUS then
				speed *= Config.Bots.GentleSpeedScale
				break
			end
		end
	end
	local step = speed * dt
	-- Moving along one axis re-centres the other so the bot stays in its row/column.
	if dx ~= 0 then
		b.px += dx * step
		b.py = approach(b.py, math.floor(b.py) + 0.5, step)
	elseif dy ~= 0 then
		b.py += dy * step
		b.px = approach(b.px, math.floor(b.px) + 0.5, step)
	end
	b.px = math.clamp(b.px, 0.5, size - 0.5)
	b.py = math.clamp(b.py, 0.5, size - 0.5)
	ArenaService.botPositions[b.id] = { x = b.px, y = b.py }
	placeRig(b, false, dx, dy, speed)
end

local function preStep(now: number, dt: number)
	maintainAcc += dt
	if maintainAcc &gt;= MAINTAIN_PERIOD then
		maintainAcc = 0
		maintain(now)
		updateSteer()
	end
	local sim = ArenaService.sim
	local gentle = ArenaService.gentleRunnerIds(now)
	local gentleSet: { [number]: boolean } = {}
	for _, id in gentle do
		gentleSet[id] = true
	end
	for id, b in table.clone(bots) do
		local r = sim:runner(id)
		if r == nil or r.info ~= b.info then
			removeBot(b, now)
		elseif not r.alive then
			local at = b.respawnAt
			if at == nil then
				sim:releaseVictim(id)
				b.respawnAt = now + Config.Arena.RespawnDelay + rng:NextNumber(RESPAWN_JITTER_MIN, RESPAWN_JITTER_MAX)
				hideBot(b)
			elseif now &gt;= at then
				sim:respawn(id, Config.Arena.StartPatch, Config.Arena.SpawnShield, now)
				resetBot(b)
			end
		else
			moveBot(b, r, now, dt, gentle, gentleSet)
		end
	end
end

local function onEvent(ev: Types.ArenaEvent)
	local e = ev :: any
	if e.kind == "cut" then
		local b = bots[e.victim]
		if b ~= nil then
			ArenaService.sim:releaseVictim(b.id)
			b.respawnAt = ArenaService.now()
				+ Config.Arena.RespawnDelay
				+ rng:NextNumber(RESPAWN_JITTER_MIN, RESPAWN_JITTER_MAX)
			hideBot(b)
		end
	elseif e.kind == "spawn" then
		local b = bots[e.runner.id]
		if b ~= nil and e.runner == b.info then
			resetBot(b)
		end
	elseif e.kind == "despawn" then
		local b = bots[e.id]
		if b ~= nil then
			hideBot(b)
		end
	end
end

function BotService.start()
	if started then
		return
	end
	started = true
	local existing = workspace:FindFirstChild("Bots")
	if existing ~= nil then
		existing:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = "Bots"
	f.Parent = workspace
	folder = f
	local s = Instance.new("Folder")
	s.Name = "BotAvatars"
	s.Parent = ServerStorage
	store = s
	pcall(function()
		for _, g in { BOT_GROUP, PLAYER_GROUP } do
			if not PhysicsService:IsCollisionGroupRegistered(g) then
				PhysicsService:RegisterCollisionGroup(g)
			end
		end
		PhysicsService:CollisionGroupSetCollidable(BOT_GROUP, BOT_GROUP, false)
		PhysicsService:CollisionGroupSetCollidable(BOT_GROUP, PLAYER_GROUP, false)
		-- Players never touch each other (no flinging); both groups still collide with Default (floor, walls).
		PhysicsService:CollisionGroupSetCollidable(PLAYER_GROUP, PLAYER_GROUP, false)
	end)
	for _, p in Players:GetPlayers() do
		watchPlayer(p)
	end
	Players.PlayerAdded:Connect(watchPlayer)
	Players.PlayerRemoving:Connect(dropFriends)
	ArenaService.preStep = preStep
	ArenaService.onEvent:Connect(onEvent)
end

return BotService
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000000000000000000000000001A">
					<Properties>
						<string name="Name">DataService</string>
						<ProtectedString name="Source">--!strict
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Types = require(Shared.Types)
local ProfileTemplate = require(Shared.ProfileTemplate)

type Profile = Types.Profile

type Store = {
	update: (key: string, transform: (any) -&gt; any) -&gt; any,
}

type Session = {
	player: Player,
	key: string,
	profile: Profile,
	dirty: boolean,
	released: boolean,
}

local LOCK_TIMEOUT = 120
local LOCK_RETRIES = 5
local LOCK_RETRY_WAIT = 6
local CALL_TRIES = 3
local CLOSE_CAP = 25

local DataService = {}

local listeners: { (Player, Profile) -&gt; () } = {}
DataService.changed = {
	Connect = function(_self: any, fn: (Player, Profile) -&gt; ())
		table.insert(listeners, fn)
		return {
			Disconnect = function()
				local i = table.find(listeners, fn)
				if i then
					table.remove(listeners, i)
				end
			end,
		}
	end,
}

local store: Store? = nil
local sessions: { [Player]: Session } = {}
local loading: { [Player]: boolean } = {}
local releasing = 0 -- release writes in flight
local releasingKeys: { [string]: boolean } = {} -- keys whose release write is in flight; a rejoin here waits for them
local started = false

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in value do
		out[k] = deepCopy(v)
	end
	return out
end

local function makeMockStore(): Store
	local data: { [string]: any } = {}
	return {
		update = function(key: string, transform: (any) -&gt; any): any
			local result = transform(deepCopy(data[key]))
			if result ~= nil then
				data[key] = deepCopy(result)
			end
			return result
		end,
	}
end

local function makeRealStore(ds: DataStore): Store
	return {
		update = function(key: string, transform: (any) -&gt; any): any
			return (ds:UpdateAsync(key, transform))
		end,
	}
end

local function initStore(): Store
	local ok, ds = pcall(function()
		return DataStoreService:GetDataStore(Config.Data.StoreName)
	end)
	if ok and ds and RunService:IsStudio() then
		-- Unpublished places / API access off only fail on the first real request.
		ok = pcall(function()
			local _ = (ds :: DataStore):GetAsync("__probe")
		end)
	end
	if ok and ds then
		return makeRealStore(ds :: DataStore)
	end
	if RunService:IsStudio() then
		warn("[DataService] DataStores unavailable in Studio; using an in-memory mock store. Progress will not persist.")
		return makeMockStore()
	end
	-- Live server without a store: every call fails, so players are kicked rather than given unsaved data.
	warn("[DataService] GetDataStore failed:", ds)
	return {
		update = function(_key: string, _transform: (any) -&gt; any): any
			error("DataStore unavailable")
		end,
	}
end

local function getStore(): Store
	if not store then
		store = initStore()
	end
	return store :: Store
end

local function withRetry(fn: () -&gt; any): (boolean, any)
	local lastErr: any = nil
	for attempt = 1, CALL_TRIES do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		if attempt &lt; CALL_TRIES then
			task.wait(2 ^ (attempt - 1))
		end
	end
	warn("[DataService] DataStore call failed after retries:", lastErr)
	return false, lastErr
end

local function keyFor(player: Player): string
	return "u_" .. tostring(player.UserId)
end

local function stripLock(data: any): Profile
	data._lock = nil
	return data :: Profile
end

-- Returns "ok" | "locked" | "error", plus the profile on "ok".
local function tryLoad(key: string): (string, Profile?)
	local blocked = false
	local loaded: any = nil
	local ok = withRetry(function()
		return getStore().update(key, function(old: any): any
			blocked = false
			loaded = nil
			local now = os.time()
			if type(old) == "table" and type(old._lock) == "table" then
				local lock = old._lock
				local t = if type(lock.t) == "number" then lock.t else 0
				if lock.jobId ~= game.JobId and now - t &lt; LOCK_TIMEOUT then
					blocked = true
					return nil
				end
			end
			local data: any = ProfileTemplate.reconcile(old, now)
			data.lastJoin = now
			data._lock = { jobId = game.JobId, t = now }
			loaded = data
			return data
		end)
	end)
	if not ok then
		return "error", nil
	end
	if blocked then
		return "locked", nil
	end
	if loaded == nil then
		return "error", nil
	end
	return "ok", stripLock(deepCopy(loaded))
end

-- Writes only while we still own the lock, so a lost lock can never clobber another server's data.
local writing: { [Session]: boolean } = {}
local function write(session: Session, releaseLock: boolean): boolean
	while writing[session] do task.wait() end
	if session.released and not releaseLock then return false end
	writing[session] = true
	local snapshot: any = deepCopy(session.profile)
	local lockLost = false
	local wrote = false
	local ok = withRetry(function()
		return getStore().update(session.key, function(old: any): any
			lockLost = false
			wrote = false
			if not releaseLock and session.released then
				-- An autosave still in flight when the session was released must not re-take the lock.
				return nil
			end
			if type(old) ~= "table" or type(old._lock) ~= "table" or old._lock.jobId ~= game.JobId then
				lockLost = true
				return nil
			end
			local out = deepCopy(snapshot)
			if not releaseLock then
				out._lock = { jobId = game.JobId, t = os.time() }
			end
			wrote = true
			return out
		end)
	end)
	writing[session] = nil
	if ok and lockLost then
		warn("[DataService] Session lock lost for " .. session.key .. "; save skipped.")
		if not releaseLock and session.player.Parent ~= nil then
			-- Playing on would only lose progress: every later save is skipped too.
			session.player:Kick("Your data was opened on another server. Please rejoin.")
		end
		return false
	end
	-- True only when this session's data was actually written (not cancelled by a release).
	if ok and wrote then
		session.dirty = false
		return true
	end
	return false
end

function DataService.load(player: Player): Profile?
	local existing = sessions[player]
	if existing and not existing.released then
		return existing.profile
	end
	while loading[player] do
		task.wait(0.1)
	end
	if sessions[player] then
		return DataService.get(player)
	end

	loading[player] = true
	local key = keyFor(player)
	local status, profile = "locked", nil -- stays "locked" if the release wait below times out
	-- Same-server rejoin: our own JobId's lock never blocks, so wait for the old session's final write.
	local deadline = os.clock() + Config.Data.ReleaseWaitSeconds
	while releasingKeys[key] and os.clock() &lt; deadline and player.Parent ~= nil do
		task.wait(0.1)
	end
	for attempt = 0, if releasingKeys[key] then -1 else LOCK_RETRIES do
		if attempt &gt; 0 then
			task.wait(LOCK_RETRY_WAIT)
		end
		if player.Parent == nil then
			loading[player] = nil
			return nil
		end
		status, profile = tryLoad(key)
		if status ~= "locked" then
			break
		end
	end
	loading[player] = nil

	if status ~= "ok" or profile == nil then
		if player.Parent ~= nil then
			if status == "locked" then
				player:Kick("Your data is still being saved by another server. Please rejoin in a minute.")
			else
				player:Kick("We couldn't load your data safely. Please rejoin in a moment.")
			end
		end
		return nil
	end

	local session: Session = { player = player, key = key, profile = profile, dirty = false, released = false }
	sessions[player] = session
	if player.Parent == nil then
		-- Left mid-load: drop the lock we just took.
		DataService.release(player)
		return nil
	end
	return profile
end

function DataService.get(player: Player): Profile?
	local session = sessions[player]
	if session and not session.released then
		return session.profile
	end
	return nil
end

function DataService.update(player: Player, fn: (Profile) -&gt; ())
	local session = sessions[player]
	if not session or session.released then
		return
	end
	fn(session.profile)
	session.dirty = true
	for _, cb in table.clone(listeners) do
		task.spawn(cb, player, session.profile)
	end
end

function DataService.save(player: Player): boolean
	local session = sessions[player]
	if not session or session.released then
		return false
	end
	return write(session, false)
end

function DataService.release(player: Player)
	local session = sessions[player]
	if not session or session.released then
		return
	end
	session.released = true
	releasing += 1
	releasingKeys[session.key] = true
	pcall(write, session, true) -- pcall so the counters below can never leak
	releasingKeys[session.key] = nil
	releasing -= 1
	if sessions[player] == session then
		sessions[player] = nil
	end
end

function DataService.hasReceipt(profile: Profile, purchaseId: string): boolean
	return table.find(profile.receipts, purchaseId) ~= nil
end

function DataService.addReceipt(profile: Profile, purchaseId: string)
	if DataService.hasReceipt(profile, purchaseId) then
		return
	end
	table.insert(profile.receipts, purchaseId)
end

local function autosaveLoop()
	while true do
		local period = Config.Data.AutosaveSeconds
		local list: { Player } = {}
		for player, session in sessions do
			if not session.released then
				table.insert(list, player)
			end
		end
		if #list == 0 then
			task.wait(period)
		else
			local gap = period / #list
			for _, player in list do
				task.wait(gap)
				-- Always written, even when clean, because the write also refreshes the session lock.
				if sessions[player] and not sessions[player].released then
					task.spawn(DataService.save, player)
				end
			end
		end
	end
end

local function onClose()
	for player, session in sessions do
		if not session.released then
			task.spawn(DataService.release, player)
		end
	end
	-- Also waits for releases PlayerRemoving started during shutdown: the server stops as soon as
	-- BindToClose returns, which would drop those in-flight saves.
	local deadline = os.clock() + CLOSE_CAP
	while releasing &gt; 0 and os.clock() &lt; deadline do
		task.wait(0.1)
	end
end

function DataService.start()
	if started then
		return
	end
	started = true
	getStore()
	Players.PlayerRemoving:Connect(function(player: Player)
		DataService.release(player)
	end)
	game:BindToClose(onClose)
	task.spawn(autosaveLoop)
end

return DataService
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000000000000000000000000001B">
					<Properties>
						<string name="Name">EconomyService</string>
						<ProtectedString name="Source">--!strict
-- The only module that changes coins or gems.
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Formulas = require(Shared.Formulas)
local Types = require(Shared.Types)
local DataService = require(script.Parent.DataService)

type Profile = Types.Profile

local EconomyService = {}

local listeners: { (Player, string, number, string) -&gt; () } = {}
EconomyService.granted = {
	Connect = function(_self: any, fn: (Player, string, number, string) -&gt; ())
		table.insert(listeners, fn)
		return {
			Disconnect = function()
				local i = table.find(listeners, fn)
				if i then
					table.remove(listeners, i)
				end
			end,
		}
	end,
}

EconomyService.cellsProvider = nil :: ((Player) -&gt; number)?

local passOwned: { [Player]: { [string]: boolean } } = {}
local inGroup: { [Player]: boolean } = {}
local kingPlayer: Player? = nil -- set by ArenaService every tick (Crown Rush multiplier)
local friendsHere: { [Player]: { [Player]: boolean } } = {} -- Roblox friends currently in this server
local started = false

local function fire(player: Player, currency: string, amount: number, reason: string)
	for _, cb in table.clone(listeners) do
		task.spawn(cb, player, currency, amount, reason)
	end
end

local function validAmount(amount: any): boolean
	return type(amount) == "number" and amount == amount and amount &gt; 0 and amount &lt; math.huge
end

function EconomyService.setPassOwned(player: Player, passKey: string, owned: boolean)
	local set = passOwned[player]
	if set == nil then
		set = {}
		passOwned[player] = set
	end
	(set :: { [string]: boolean })[passKey] = owned
end

function EconomyService.hasPass(player: Player, passKey: string): boolean
	local set = passOwned[player]
	return set ~= nil and set[passKey] == true
end

function EconomyService.setInGroup(player: Player, value: boolean)
	inGroup[player] = value
end

function EconomyService.isInGroup(player: Player): boolean
	return inGroup[player] == true
end

function EconomyService.hasFriendHere(player: Player): boolean
	local set = friendsHere[player]
	return set ~= nil and next(set) ~= nil
end

local function setFriendLink(player: Player, other: Player, linked: boolean)
	local had = EconomyService.hasFriendHere(player)
	local set = friendsHere[player]
	if set == nil then
		if not linked then
			return
		end
		set = {}
		friendsHere[player] = set
	end
	(set :: { [Player]: boolean })[other] = if linked then true else nil
	if EconomyService.hasFriendHere(player) ~= had then
		-- ponytail: an empty update only marks the profile dirty, so Main pushes ProfileUpdate with the new multiplier
		DataService.update(player, function() end)
	end
end

-- Friendship is symmetric: the newcomer asks once per other player. Web call: off the join path, errors = not friends.
-- Bots are not Player instances, so Players:GetPlayers() never includes them.
local function checkFriends(player: Player)
	for _, other in Players:GetPlayers() do
		if other ~= player then
			task.spawn(function()
				local ok, friends = pcall(function()
					return player:IsFriendsWith(other.UserId)
				end)
				if ok and friends == true and player.Parent ~= nil and other.Parent ~= nil then
					setFriendLink(player, other, true)
					setFriendLink(other, player, true)
				end
			end)
		end
	end
end

function EconomyService.multiplier(player: Player): number
	local profile = DataService.get(player)
	if profile == nil then
		return 1
	end
	local now = os.time()
	return Formulas.coinMultiplier({
		coinBoostLevel = profile.upgrades.coinBoost,
		crowns = profile.crowns,
		vip = EconomyService.hasPass(player, "vip"),
		doubleCoins = EconomyService.hasPass(player, "doubleCoins"),
		boostActive = profile.boostUntil &gt; now,
		inGroup = inGroup[player] == true,
		withFriend = EconomyService.hasFriendHere(player),
		weekend = Formulas.isWeekendUTC(now),
		crownRushKing = kingPlayer == player and Formulas.isCrownRush(now),
	})
end

-- ArenaService reports the current King (a real player, or nil) every tick.
function EconomyService.setKing(player: Player?)
	kingPlayer = player
end

-- Returns coins actually added (after multiplier, rounded). 0 when the profile is not loaded.
function EconomyService.addCoins(player: Player, baseAmount: number, reason: string, applyMultiplier: boolean): number
	if not validAmount(baseAmount) then
		return 0
	end
	local amount = baseAmount
	if applyMultiplier then
		amount = baseAmount * EconomyService.multiplier(player)
	end
	amount = math.floor(amount + 0.5)
	if amount &lt;= 0 then
		return 0
	end
	local applied = false
	DataService.update(player, function(profile)
		profile.coins += amount
		profile.lifetimeCoinsSinceRebirth += amount
		applied = true
	end)
	if not applied then
		return 0
	end
	fire(player, "coins", amount, reason)
	return amount
end

function EconomyService.addGems(player: Player, amount: number, reason: string)
	if not validAmount(amount) then
		return
	end
	amount = math.floor(amount)
	local applied = false
	DataService.update(player, function(profile)
		profile.gems += amount
		applied = true
	end)
	if applied then
		fire(player, "gems", amount, reason)
	end
end

-- For use INSIDE a DataService.update callback (e.g. a receipt grant that must be atomic).
-- Adds a flat amount with no multiplier and does not count toward rebirth progress.
function EconomyService.creditInProfile(player: Player, profile: Profile, currency: string, amount: number, reason: string)
	if not validAmount(amount) then
		return
	end
	amount = math.floor(amount)
	if currency == "coins" then
		profile.coins += amount
	elseif currency == "gems" then
		profile.gems += amount
	else
		return
	end
	fire(player, currency, amount, reason)
end

-- Atomic check-and-deduct.
function EconomyService.spend(player: Player, currency: string, amount: number): boolean
	if (currency ~= "coins" and currency ~= "gems") or not validAmount(amount) then
		return false
	end
	local ok = false
	DataService.update(player, function(profile)
		if currency == "coins" then
			if profile.coins &gt;= amount then
				profile.coins -= amount
				ok = true
			end
		elseif profile.gems &gt;= amount then
			profile.gems -= amount
			ok = true
		end
	end)
	return ok
end

-- Rebirth reset: coins and rebirth progress back to zero.
function EconomyService.resetCoins(player: Player)
	DataService.update(player, function(profile)
		profile.coins = 0
		profile.lifetimeCoinsSinceRebirth = 0
	end)
end

function EconomyService.onCapture(player: Player, neutral: number, stolen: number): number
	if type(neutral) ~= "number" or type(stolen) ~= "number" then
		return 0
	end
	return EconomyService.addCoins(player, Formulas.captureCoins(neutral, stolen), "capture", true)
end

function EconomyService.onKill(player: Player, victimCells: number, victimWasKing: boolean): number
	return EconomyService.addCoins(player, Formulas.killCoins(victimCells, victimWasKing), "kill", true)
end

function EconomyService.onFullMap(player: Player)
	EconomyService.addCoins(player, Config.Arena.FullMapBonus, "fullMap", true)
end

-- For use INSIDE a DataService.update callback.
function EconomyService.extendBoostInProfile(profile: Profile, seconds: number)
	profile.boostUntil = math.max(os.time(), profile.boostUntil) + seconds
end

function EconomyService.activateBoost(player: Player, seconds: number)
	if not validAmount(seconds) then
		return
	end
	DataService.update(player, function(profile)
		EconomyService.extendBoostInProfile(profile, seconds)
	end)
end

local function passiveLoop()
	while true do
		task.wait(Config.Income.PassiveInterval)
		local provider = EconomyService.cellsProvider
		if provider ~= nil then
			for _, player in Players:GetPlayers() do
				local ok, cells = pcall(provider, player)
				if ok and type(cells) == "number" then
					local coins = Formulas.passiveCoins(cells)
					if coins &gt; 0 then
						EconomyService.addCoins(player, coins, "passive", true)
					end
				end
			end
		end
	end
end

function EconomyService.start()
	if started then
		return
	end
	started = true
	Players.PlayerRemoving:Connect(function(player)
		passOwned[player] = nil
		inGroup[player] = nil
		friendsHere[player] = nil
		for other, set in friendsHere do
			if set[player] then
				setFriendLink(other, player, false)
			end
		end
	end)
	Players.PlayerAdded:Connect(checkFriends)
	for _, player in Players:GetPlayers() do
		checkFriends(player)
	end
	task.spawn(passiveLoop)
end

return EconomyService
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000000000000000000000000001C">
					<Properties>
						<string name="Name">LeaderboardService</string>
						<ProtectedString name="Source">--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

type Entry = { userId: number, value: number }

local LeaderboardService = {}

local boardSet: { [string]: boolean } = {}
for _, board in ipairs(Config.Leaderboards.Boards) do
	boardSet[board] = true
end

local stores: { [string]: any } = {}
local cache: { [string]: { Entry } } = {}
local pending: { [string]: { [number]: number } } = {}
local listeners: { (string, { Entry }) -&gt; () } = {}
local available = true
local warned = false
local started = false

for _, board in ipairs(Config.Leaderboards.Boards) do
	cache[board] = {}
	pending[board] = {}
end

local function warnOnce(err: any)
	if warned then
		return
	end
	warned = true
	warn("LeaderboardService: DataStore error, leaderboards degraded: " .. tostring(err))
end

local function getStore(board: string): any?
	if not available then
		return nil
	end
	local existing = stores[board]
	if existing ~= nil then
		return existing
	end
	local ok, result = pcall(DataStoreService.GetOrderedDataStore, DataStoreService, "LB_" .. board .. "_v1")
	if not ok then
		available = false
		warnOnce(result)
		return nil
	end
	stores[board] = result
	return result
end

local function fire(board: string, entries: { Entry })
	for _, fn in ipairs(listeners) do
		task.spawn(fn, board, entries)
	end
end

local function refresh()
	for _, player in ipairs(Players:GetPlayers()) do
		for _, board in ipairs(Config.Leaderboards.Boards) do
			local byUser = pending[board]
			local store = getStore(board)
			if byUser ~= nil and store ~= nil then
				local value = byUser[player.UserId]
				if value ~= nil then
					byUser[player.UserId] = nil
					local ok, err = pcall(store.SetAsync, store, "u_" .. player.UserId, math.floor(value))
					if not ok then
						if byUser[player.UserId] == nil then
							byUser[player.UserId] = value
						end
						warnOnce(err)
					end
				end
			end
		end
	end

	for _, board in ipairs(Config.Leaderboards.Boards) do
		local store = getStore(board)
		if store ~= nil then
			local ok, result = pcall(function()
				local pages = store:GetSortedAsync(false, Config.Leaderboards.Size)
				return pages:GetCurrentPage()
			end)
			if ok then
				local entries: { Entry } = {}
				for _, row in ipairs(result) do
					local userId = tonumber(string.sub(row.key, 3))
					if userId ~= nil then
						table.insert(entries, { userId = userId, value = row.value })
					end
				end
				cache[board] = entries
				fire(board, entries)
			else
				warnOnce(result)
			end
		end
	end
end

local function onRemoving(player: Player)
	for _, board in ipairs(Config.Leaderboards.Boards) do
		local byUser = pending[board]
		if byUser ~= nil then
			local value = byUser[player.UserId]
			if value ~= nil then
				local store = getStore(board)
				if store ~= nil then
					local ok, err = pcall(store.SetAsync, store, "u_" .. player.UserId, math.floor(value))
					if not ok then
						warnOnce(err)
					end
				end
				byUser[player.UserId] = nil
			end
		end
	end
end

function LeaderboardService.start()
	if started then
		return
	end
	started = true
	Players.PlayerRemoving:Connect(onRemoving)
	task.spawn(function()
		while true do
			refresh()
			task.wait(Config.Leaderboards.RefreshSeconds)
		end
	end)
end

function LeaderboardService.submit(player: Player, board: string, value: number)
	if not boardSet[board] then
		return
	end
	pending[board][player.UserId] = value
end

function LeaderboardService.top(board: string): { Entry }
	return cache[board] or {}
end

LeaderboardService.changed = {
	Connect = function(_self: any, fn: (string, { Entry }) -&gt; ())
		table.insert(listeners, fn)
	end,
}

return LeaderboardService
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000000000000000000000000001D">
					<Properties>
						<string name="Name">MonetizationService</string>
						<ProtectedString name="Source">--!strict
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local EconomyRules = require(Shared.EconomyRules)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local ShopService = require(script.Parent.ShopService)

local MonetizationService = {}

-- Pluggable: return true when the respawn was applied.
MonetizationService.onSecondChance = nil :: ((Player) -&gt; boolean)?
-- Pluggable: called after a game pass is marked owned (ArenaService refreshes the VIP tag).
MonetizationService.onPassOwned = nil :: ((Player) -&gt; ())?
-- Pluggable: called after a receipt is granted (productKey, Robux price or 0); Main logs analytics.
MonetizationService.onProductBought = nil :: ((Player, string, number) -&gt; ())?

local SECOND_CHANCE_REFUND_GEMS = 20

local joinClock: { [Player]: number } = {}
local passKeyById: { [number]: string } = {}
local productKeyById: { [number]: string } = {}
local started = false

for key, id in Config.Ids.Passes do
	if id ~= 0 then
		passKeyById[id] = key
	end
end
for key, id in Config.Ids.Products do
	if id ~= 0 then
		productKeyById[id] = key
	end
end

local function markPassOwned(player: Player, passKey: string)
	EconomyService.setPassOwned(player, passKey, true)
	if DataService.get(player) ~= nil then
		ShopService.reconcile(player)
	end
	local hook = MonetizationService.onPassOwned
	if hook ~= nil then
		pcall(hook, player)
	end
end

-- Studio-only: same path as a finished pass purchase, for testing with placeholder ids. No-op in live servers.
function MonetizationService.debugGrantPass(player: Player, passKey: string): boolean
	if not RunService:IsStudio() or (Config.Ids.Passes :: any)[passKey] == nil then
		return false
	end
	markPassOwned(player, passKey)
	return true
end

-- Grants a pass only when Roblox confirms ownership. Errors always retry; a clean false retries only
-- after a purchase prompt (retryFalse), where the API can return a cached false. Run off the caller's thread.
local verifying: { [Player]: { [string]: boolean } } = {} -- purchase checks in flight, so a spammed signal starts one loop
local function verifyPass(player: Player, key: string, id: number, retryFalse: boolean)
	if EconomyService.hasPass(player, key) then
		return
	end
	if retryFalse then
		local set: { [string]: boolean } = verifying[player] or {}
		if set[key] or player.Parent == nil then
			return
		end
		set[key] = true
		verifying[player] = set
	end
	local cfg = Config.PassCheck
	for attempt = 1, cfg.Attempts do
		if player.Parent == nil then
			break
		end
		local ok, owns = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
		end)
		if ok and owns == true then
			if player.Parent ~= nil then
				markPassOwned(player, key)
			end
			break
		end
		if (ok and not retryFalse) or attempt == cfg.Attempts then
			break
		end
		task.wait(if retryFalse then cfg.RetrySeconds else cfg.RetrySeconds * 2 ^ (attempt - 1))
	end
	local set = verifying[player]
	if retryFalse and set ~= nil then
		set[key] = nil
	end
end

local function checkPasses(player: Player)
	for key, id in Config.Ids.Passes do
		if id ~= 0 then
			task.spawn(verifyPass, player, key, id, false)
		end
	end
end

local function checkGroup(player: Player)
	if Config.Ids.GroupId == 0 then
		return
	end
	local ok, member = pcall(function()
		return player:IsInGroup(Config.Ids.GroupId)
	end)
	if ok and member == true then
		EconomyService.setInGroup(player, true)
		if DataService.get(player) ~= nil then
			ShopService.reconcile(player)
		end
	end
end

local function onPlayerAdded(player: Player)
	joinClock[player] = os.clock()
	DataService.load(player)
	if player.Parent == nil then
		return
	end
	task.spawn(checkPasses, player)
	task.spawn(checkGroup, player)
end

function MonetizationService.shouldOfferStarter(player: Player): boolean
	local profile = DataService.get(player)
	local joined = joinClock[player]
	if profile == nil or joined == nil then
		return false
	end
	return EconomyRules.shouldOfferStarter(profile.starterPackBought, os.clock() - joined, profile.starterOfferSeenAt, os.time())
end

function MonetizationService.markStarterOfferSeen(player: Player)
	DataService.update(player, function(profile)
		if profile.starterOfferSeenAt == 0 then
			profile.starterOfferSeenAt = os.time()
		end
	end)
end

local function processReceipt(info: { [string]: any }): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if player == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local profile = DataService.get(player)
	if profile == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local productKey = productKeyById[info.ProductId]
	if productKey == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(info.PurchaseId)
	if DataService.hasReceipt(profile, purchaseId) then
		-- This may be an in-memory receipt from a failed save, not a durable one.
		-- Retry persistence without granting the reward again.
		local ok, saved = pcall(DataService.save, player)
		return if ok and saved == true then Enum.ProductPurchaseDecision.PurchaseGranted else Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local cfg = (Config.Products :: any)[productKey]
	local secondChanceApplied = true
	if productKey == "secondChance" then
		local handler = MonetizationService.onSecondChance
		secondChanceApplied = false
		if handler ~= nil then
			local ok, result = pcall(handler, player)
			secondChanceApplied = ok and result == true
		end
	end

	local ran = false
	DataService.update(player, function(p)
		if DataService.hasReceipt(p, purchaseId) then
			ran = true
			return
		end
		DataService.addReceipt(p, purchaseId)
		if productKey == "wheelSpin" then
			p.wheelPaid += 1
		elseif productKey == "boost15" then
			EconomyService.extendBoostInProfile(p, cfg.Seconds)
		elseif productKey == "starterPack" then
			-- Once per account (owner decision 4): the client never offers it again. A repeat can only come
			-- from a stale or forced prompt; the player has paid, so they still get the gems.
			EconomyService.creditInProfile(player, p, "gems", cfg.Gems, productKey)
			if not p.starterPackBought then
				p.starterPackBought = true
				EconomyService.creditInProfile(player, p, "coins", cfg.Coins, productKey)
				p.owned[cfg.Skin] = true
			end
		elseif productKey == "secondChance" then
			if not secondChanceApplied then
				EconomyService.creditInProfile(player, p, "gems", SECOND_CHANCE_REFUND_GEMS, "secondChanceRefund")
			end
		elseif cfg.Gems ~= nil then
			EconomyService.creditInProfile(player, p, "gems", cfg.Gems, productKey)
		end
		ran = true
	end)
	if not ran then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- Persist the receipt before telling Roblox the purchase is granted.
	local saveOk, saved = pcall(DataService.save, player)
	if not saveOk or saved ~= true then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local bought = MonetizationService.onProductBought
	if bought ~= nil then
		pcall(bought, player, productKey, tonumber(info.CurrencySpent) or 0)
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.start()
	if started then
		return
	end
	started = true
	MarketplaceService.ProcessReceipt = processReceipt :: any
	-- The client can fire this signal itself, so it only triggers a server-side ownership check.
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Instance, gamePassId: number, wasPurchased: boolean)
		local key = if type(gamePassId) == "number" then passKeyById[gamePassId] else nil
		if wasPurchased == true and key ~= nil and typeof(player) == "Instance" and player:IsA("Player") then
			task.spawn(verifyPass, player :: Player, key, gamePassId, true)
		end
	end)
	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayerAdded, player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		joinClock[player] = nil
		verifying[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
end

return MonetizationService
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000000000000000000000000001E">
					<Properties>
						<string name="Name">RewardService</string>
						<ProtectedString name="Source">--!strict
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Catalog = require(Shared.Catalog)
local Config = require(Shared.Config)
local EconomyRules = require(Shared.EconomyRules)
local Formulas = require(Shared.Formulas)
local Types = require(Shared.Types)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local ShopService = require(script.Parent.ShopService)

type Profile = Types.Profile

local RewardService = {}

local PLAY_TICK = 60
local MINUTES_PER_TICK = PLAY_TICK / 60

local bankClock: { [Player]: number } = {} -- os.clock() of the last time play was banked into profile.playtime
local started = false

local questDefs: { [string]: EconomyRules.QuestDef } = {}
for _, quest in Catalog.quests do
	questDefs[quest.id] = { kind = quest.kind, target = quest.target }
end
local questRewards: { [string]: Catalog.Reward } = {}
for _, quest in Catalog.quests do
	questRewards[quest.id] = quest.reward
end

local function today(): number
	return Formulas.dayNumber(os.time())
end

-- Call inside an update: rolls profile.playtime over to today and banks the seconds since the last bank.
-- ponytail: seconds since the last 60 s bank are lost on leave; add a bank on release if that matters.
local function bankPlaytime(p: Profile, player: Player)
	local now = os.clock()
	local since = now - (bankClock[player] or now)
	bankClock[player] = now
	local day = today()
	if p.playtime.day ~= day then
		p.playtime.day = day
		p.playtime.seconds = 0
		p.playtime.claimed = 0
	end
	p.playtime.seconds += since
end

-- Call inside an update.
local function regenerateQuests(profile: Profile, userId: number)
	local day = today()
	if profile.quests.day == day then
		return
	end
	local list = {}
	for i, quest in Catalog.questsForDay(day, userId) do
		list[i] = { id = quest.id, progress = 0, claimed = false }
	end
	profile.quests = { day = day, list = list }
end

local function grant(player: Player, reward: Catalog.Reward, reason: string)
	if reward.currency == "gems" then
		EconomyService.addGems(player, reward.amount, reason)
	else
		EconomyService.addCoins(player, reward.amount, reason, false)
	end
end

local function isIndex(value: any, max: number): boolean
	return type(value) == "number" and value == math.floor(value) and value &gt;= 1 and value &lt;= max
end

function RewardService.claimDaily(player: Player): (boolean, any)
	local profile = DataService.get(player)
	if profile == nil then
		return false, "no_profile"
	end
	local state = Formulas.dailyClaimState(profile.daily.lastClaimDay, profile.daily.streak, today())
	if not state.canClaim then
		return false, "already_claimed"
	end
	local reward = Catalog.daily[state.nextStreak]
	local vip = EconomyService.hasPass(player, "vip")
	local function dailyAmount(currency: string, base: number): number
		return if currency == "gems" and vip then base * Config.Vip.DailyGemMultiplier else base
	end
	local amount = dailyAmount(reward.currency, reward.amount)
	local firstLoop = profile.daily.loops == 0
	local run = Formulas.dailyNextRun(profile.daily.lastClaimDay, profile.daily.run, today())
	local m = Catalog.nextDailyMilestone(run, profile.daily.milestones)
	local hit = if m ~= nil and m.day == run then m else nil
	DataService.update(player, function(p)
		p.daily.streak = state.nextStreak
		p.daily.lastClaimDay = today()
		p.daily.run = run
		if state.nextStreak == #Catalog.daily then
			p.daily.loops += 1
		end
		if hit ~= nil then
			p.daily.milestones[tostring(hit.day)] = true
		end
	end)
	grant(player, { currency = reward.currency, amount = amount }, "daily")
	local skin: string? = nil
	if reward.skin ~= nil and firstLoop and ShopService.grantItem(player, reward.skin) then
		skin = reward.skin
	end
	local milestone = nil
	if hit ~= nil then
		local bonus = dailyAmount(hit.currency, hit.amount)
		grant(player, { currency = hit.currency, amount = bonus }, "daily_milestone")
		local mSkin: string? = nil
		if hit.skin ~= nil and ShopService.grantItem(player, hit.skin) then
			mSkin = hit.skin
		end
		milestone = { day = hit.day, currency = hit.currency, amount = bonus, skin = mSkin }
	end
	return true,
		{ streak = state.nextStreak, currency = reward.currency, amount = amount, skin = skin, run = run, milestone = milestone }
end

function RewardService.claimPlaytime(player: Player, index: any): (boolean, any)
	if not isIndex(index, #Catalog.playtime) then
		return false, "bad_args"
	end
	if bankClock[player] == nil or DataService.get(player) == nil then
		return false, "no_profile"
	end
	local reward = Catalog.playtime[index]
	local bit = 2 ^ (index - 1)
	local err: string? = nil
	DataService.update(player, function(p)
		bankPlaytime(p, player)
		if bit32.btest(p.playtime.claimed, bit) then
			err = "already_claimed"
		elseif p.playtime.seconds &lt; reward.seconds then
			err = "too_early"
		else
			p.playtime.claimed = bit32.bor(p.playtime.claimed, bit)
		end
	end)
	if err ~= nil then
		return false, err
	end
	grant(player, reward, "playtime")
	return true, { currency = reward.currency, amount = reward.amount }
end

function RewardService.claimQuest(player: Player, index: any): (boolean, any)
	local profile = DataService.get(player)
	if profile == nil then
		return false, "no_profile"
	end
	if profile.quests.day ~= today() then
		DataService.update(player, function(p)
			regenerateQuests(p, player.UserId)
		end)
		return false, "quests_refreshed"
	end
	if not isIndex(index, #profile.quests.list) then
		return false, "bad_args"
	end
	local entry = profile.quests.list[index]
	local def = questDefs[entry.id]
	local reward = questRewards[entry.id]
	if def == nil or reward == nil then
		return false, "unknown_quest"
	end
	if entry.claimed then
		return false, "already_claimed"
	end
	if entry.progress &lt; def.target then
		return false, "not_complete"
	end
	DataService.update(player, function(p)
		p.quests.list[index].claimed = true
	end)
	grant(player, reward, "quest")
	return true, { id = entry.id, currency = reward.currency, amount = reward.amount }
end

function RewardService.redeemCode(player: Player, code: any): (boolean, any)
	if type(code) ~= "string" or #code == 0 or #code &gt; Config.Security.MaxCodeLength then
		return false, "bad_args"
	end
	local key = string.upper(code)
	local reward = (Catalog.codes :: { [string]: Catalog.Reward })[key]
	if reward == nil or not Catalog.isReleaseOpen(Catalog.codeRelease[key], os.time()) then
		return false, "invalid_code"
	end
	local profile = DataService.get(player)
	if profile == nil then
		return false, "no_profile"
	end
	if profile.codes[key] then
		return false, "already_used"
	end
	DataService.update(player, function(p)
		p.codes[key] = true
	end)
	grant(player, reward, "code")
	return true, { currency = reward.currency, amount = reward.amount }
end

-- Playtime rewards claimed today as a dense array (sparse tables do not survive remotes).
function RewardService.playtimeClaimed(player: Player): { boolean }
	local out = table.create(#Catalog.playtime, false)
	local p = DataService.get(player)
	if p ~= nil and p.playtime.day == today() then
		for i in out do
			out[i] = bit32.btest(p.playtime.claimed, 2 ^ (i - 1))
		end
	end
	return out
end

-- Unix time at which today's play would have started if it were one session; the client counts
-- playtime rewards from here, so it keeps working unchanged.
function RewardService.playtimeStart(player: Player): number
	local p = DataService.get(player)
	local played = if p ~= nil and p.playtime.day == today() then p.playtime.seconds else 0
	local clock = bankClock[player]
	if clock ~= nil then
		played += os.clock() - clock
	end
	return os.time() - math.floor(played)
end

-- One DataService update per call, however many quests match.
function RewardService.progress(player: Player, kind: string, amount: number, mode: string)
	if type(kind) ~= "string" or type(amount) ~= "number" then
		return
	end
	DataService.update(player, function(p)
		regenerateQuests(p, player.UserId)
		EconomyRules.applyQuestProgress(p.quests.list, questDefs, kind, amount, if mode == "max" then "max" else "add")
	end)
end

local function playLoop()
	while true do
		task.wait(PLAY_TICK)
		for _, player in Players:GetPlayers() do
			DataService.update(player, function(p)
				p.stats.playSeconds += PLAY_TICK
				bankPlaytime(p, player)
				regenerateQuests(p, player.UserId)
				EconomyRules.applyQuestProgress(p.quests.list, questDefs, "playMinutes", MINUTES_PER_TICK, "add")
			end)
		end
	end
end

function RewardService.start()
	if started then
		return
	end
	started = true
	local function onPlayer(player: Player)
		if DataService.load(player) ~= nil then
			bankClock[player] = os.clock()
			DataService.update(player, function(p)
				bankPlaytime(p, player) -- rolls the day over; banks nothing on join
				regenerateQuests(p, player.UserId)
			end)
		end
	end
	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayer, player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		bankClock[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayer, player)
	end
	task.spawn(playLoop)
end

return RewardService
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000000000000000000000000001F">
					<Properties>
						<string name="Name">ShopService</string>
						<ProtectedString name="Source">--!strict
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Catalog = require(Shared.Catalog)
local Config = require(Shared.Config)
local Formulas = require(Shared.Formulas)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)

local ShopService = {}

local listeners: { (Player, { skin: string, trail: string, effect: string }) -&gt; () } = {}
ShopService.equippedChanged = {
	Connect = function(_self: any, fn: (Player, { skin: string, trail: string, effect: string }) -&gt; ())
		table.insert(listeners, fn)
		return {
			Disconnect = function()
				local i = table.find(listeners, fn)
				if i then
					table.remove(listeners, i)
				end
			end,
		}
	end,
}

local started = false

function ShopService.owns(player: Player, itemId: string): boolean
	local profile = DataService.get(player)
	return profile ~= nil and profile.owned[itemId] == true
end

-- True only when the item was newly added.
function ShopService.grantItem(player: Player, itemId: string): boolean
	if type(itemId) ~= "string" or Catalog.byId(itemId) == nil then
		return false
	end
	local added = false
	DataService.update(player, function(profile)
		if profile.owned[itemId] ~= true then
			profile.owned[itemId] = true
			added = true
		end
	end)
	return added
end

-- Idempotent: defaults, crown-tier skins by crowns, and items tied to passes, group or the starter pack.
function ShopService.reconcile(player: Player)
	DataService.update(player, function(profile)
		for _, item in Catalog.items do
			local entitled = item.default == true
			if item.crownsRequired ~= nil and profile.crowns &gt;= item.crownsRequired then
				entitled = true
			end
			local source = item.source
			if source ~= nil then
				if (Config.Ids.Passes :: any)[source] ~= nil then
					entitled = entitled or EconomyService.hasPass(player, source)
				elseif source == "group" then
					entitled = entitled or EconomyService.isInGroup(player)
				elseif source == "starterPack" then
					entitled = entitled or profile.starterPackBought
				end
			end
			if entitled and profile.owned[item.id] ~= true then
				profile.owned[item.id] = true
			end
		end
	end)
end

function ShopService.buyItem(player: Player, itemId: any): (boolean, any)
	if type(itemId) ~= "string" then
		return false, "bad_args"
	end
	local item = Catalog.byId(itemId)
	local profile = DataService.get(player)
	if item == nil then
		return false, "unknown_item"
	end
	if profile == nil then
		return false, "no_profile"
	end
	if profile.owned[itemId] == true then
		return false, "already_owned"
	end
	if item.crownsRequired ~= nil and profile.crowns &lt; item.crownsRequired then
		return false, "crowns_required"
	end
	if not Catalog.isPurchasable(item) then
		return false, "not_for_sale"
	end
	local featured = table.find(Catalog.featured(Formulas.dayNumber(os.time())), itemId) ~= nil
	local price = Formulas.itemPrice(item.rarity, featured)
	if price == nil then
		return false, "not_for_sale"
	end
	if not EconomyService.spend(player, price.currency, price.amount) then
		return false, "insufficient_funds"
	end
	ShopService.grantItem(player, itemId)
	return true, { id = itemId, currency = price.currency, amount = price.amount }
end

function ShopService.equip(player: Player, itemId: any): (boolean, any)
	if type(itemId) ~= "string" then
		return false, "bad_args"
	end
	local item = Catalog.byId(itemId)
	if item == nil then
		return false, "unknown_item"
	end
	local equipped: { skin: string, trail: string, effect: string }? = nil
	local err = "not_owned"
	local unchanged = false
	DataService.update(player, function(profile)
		if profile.owned[itemId] ~= true then
			return
		end
		local slot = profile.equipped :: any
		if slot[item.type] == itemId then
			unchanged = true -- already equipped: nothing to broadcast
			return
		end
		if item.type == "skin" then
			profile.equipped.skin = itemId
		elseif item.type == "trail" then
			profile.equipped.trail = itemId
		elseif item.type == "effect" then
			profile.equipped.effect = itemId
		else
			err = "unknown_item"
			return
		end
		equipped = profile.equipped
	end)
	if unchanged then
		return true, itemId
	end
	if equipped == nil then
		return false, err
	end
	for _, cb in table.clone(listeners) do
		task.spawn(cb, player, equipped)
	end
	return true, itemId
end

function ShopService.start()
	if started then
		return
	end
	started = true
	local function onPlayer(player: Player)
		if DataService.load(player) ~= nil then
			ShopService.reconcile(player)
		end
	end
	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayer, player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayer, player)
	end
end

return ShopService
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000000000000000000000000000020">
					<Properties>
						<string name="Name">SkyChestService</string>
						<ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Def = require(Shared.SkyChest)
local Data = require(script.Parent.DataService)
local Economy = require(script.Parent.EconomyService)
local Arena = require(script.Parent.ArenaService)
local Service = {}
local remote: RemoteEvent
local active: Model? = nil
local busy: {[Player]: boolean} = {}
local rng = Random.new()
local started = false
local policies: {[Player]: any} = {}

local function paidAllowed(player: Player): boolean
	local cached=policies[player]
	if cached and os.clock()-cached.at&lt;60 then return cached.allowed end
	local ok, policy = pcall(function() return PolicyService:GetPolicyInfoForPlayerAsync(player) end)
	local allowed=ok and policy.ArePaidRandomItemsRestricted == false
	policies[player]={at=os.clock(),allowed=allowed}
	return allowed
end

local function done(ok: boolean, result: any): (boolean, any)
	return ok, result
end

local function handle(player: Player, action: any): (boolean, any)
	local p = Data.get(player)
	if not p then return done(false, "Profile not ready.") end
	if action == "status" then
		return done(true, {free = p.wheelFree, paid = p.wheelPaid, allowed = paidAllowed(player), productId = Def.ProductId})
	elseif action == "purchase" then
		if Def.ProductId == 0 or not paidAllowed(player) then return done(false, "Paid spins are unavailable for this account.") end
		return done(true, Def.ProductId)
	elseif action ~= "spin" then return done(false, "Invalid action.") end
	if p.wheelFree &lt;= 0 and (p.wheelPaid &lt;= 0 or not paidAllowed(player)) then return done(false, "No eligible spins available.") end
	local draw = rng:NextInteger(1, 100)
	local index = 1
	for i, prize in Def.Prizes do draw -= prize.weight; if draw &lt;= 0 then index = i; break end end
	local prize = Def.Prizes[index]
	local duplicate = false
	Data.update(player, function(profile)
		if profile.wheelFree &gt; 0 then profile.wheelFree -= 1 else profile.wheelPaid -= 1 end
		if prize.kind == "coins" or prize.kind == "gems" then Economy.creditInProfile(player, profile, prize.kind, prize.amount, "skyChest")
		elseif prize.kind == "skin" then
			duplicate = profile.owned[prize.skin] == true
			if duplicate then Economy.creditInProfile(player, profile, "gems", 100, "skyChestDuplicate") else profile.owned[prize.skin] = true end
		elseif prize.kind == "speed" then profile.speedBoostUntil = math.max(os.time(), profile.speedBoostUntil) + Def.SpeedSeconds end
	end)
	Arena.refreshWalkSpeed(player)
	Data.save(player)
	return done(true, {index = index, duplicate = duplicate, free = p.wheelFree, paid = p.wheelPaid})
end

-- busy is always cleared, even when the handler throws.
function Service.request(player: Player, action: any): (boolean, any)
	if busy[player] then return false, "Please wait for your spin." end
	busy[player] = true
	local ok, good, result = pcall(handle, player, action)
	busy[player] = nil
	if not ok then
		warn("[SkyChestService] request failed:", good)
		return false, "Spin failed, please try again."
	end
	return good, result
end

local function chest(position: Vector3): Model
	local model = Instance.new("Model"); model.Name = "SkyChest"
	local root = Instance.new("Part"); root.Name = "Body"; root.Size = Vector3.new(7,4,5); root.Color = Color3.fromHex("9C7DFF"); root.Anchored = true; root.CanCollide = false; root.Material = Enum.Material.SmoothPlastic; root.CFrame = CFrame.new(position); root.Parent = model
	model.PrimaryPart = root
	local function part(name: string, size: Vector3, offset: Vector3, color: string)
		local p = Instance.new("Part"); p.Name = name; p.Size = size; p.Color = Color3.fromHex(color); p.Material = Enum.Material.SmoothPlastic; p.CanCollide = false; p.Massless = true; p.CFrame = root.CFrame + offset; p.Parent = model
		local weld = Instance.new("WeldConstraint"); weld.Part0 = root; weld.Part1 = p; weld.Parent = p
	end
	part("Lid",Vector3.new(7.4,1.5,5.4),Vector3.new(0,2.6,0),"C9B7FF")
	for _,x in {-2.4,2.4} do part("GoldBand",Vector3.new(0.6,5.2,5.6),Vector3.new(x,0.65,0),"FFC94A") end
	part("BaseTrim",Vector3.new(7.5,0.5,5.5),Vector3.new(0,-2,0),"202840")
	part("Latch",Vector3.new(1.1,1.6,0.6),Vector3.new(0,1,-2.9),"FFC94A")
	local light = Instance.new("PointLight"); light.Color = Color3.fromHex("FFC94A"); light.Brightness = 3; light.Range = 25; light.Parent = root
	local gui=Instance.new("BillboardGui"); gui.Size=UDim2.fromOffset(230,65);gui.StudsOffset=Vector3.new(0,6,0);gui.AlwaysOnTop=true;gui.Parent=root
	local label=Instance.new("TextLabel");label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=1;label.Text="SKY CHEST\nRun into it for a free spin!";label.Font=Enum.Font.GothamBold;label.TextScaled=true;label.TextColor3=Color3.fromHex("FFC94A");label.TextStrokeTransparency=0;label.Parent=gui
	return model
end

function Service.drop(at: Vector3?)
	local TweenService = game:GetService("TweenService")
	if active then return end
	local half = Config.Arena.GridSize * Config.Arena.CellSize * 0.36
	local landing = at or Vector3.new(rng:NextNumber(-half,half), Config.Arena.FloorY+3, rng:NextNumber(-half,half))
	local model=chest(landing+Vector3.new(0,110,0));active=model;model.Parent=workspace
	remote:FireAllClients({kind="fall",position=landing})
	local root=model.PrimaryPart :: BasePart
	local fall=TweenService:Create(root,TweenInfo.new(Def.FallSeconds,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{CFrame=CFrame.new(landing)});fall:Play();fall.Completed:Wait()
	remote:FireAllClients({kind="land",position=landing})
	local expires=os.clock()+Def.Lifetime
	while active==model and os.clock()&lt;expires do
		-- Pickup uses the arena's accepted runner cell (speed-checked), never the raw root position.
		local lx,ly=Arena.sim.grid:worldToCell(landing.X,landing.Z)
		local reach=Config.Arena.SkyChestPickupCells
		for _,player in Players:GetPlayers() do
			local r=Arena.sim:runner(Arena.runnerIdOf(player))
			if r and r.alive and (r.x-lx)^2+(r.y-ly)^2&lt;=reach*reach and Data.get(player) then
				active=nil;model:Destroy()
				Data.update(player,function(p) p.wheelFree+=1 end);Data.save(player)
				remote:FireClient(player,{kind="claimed"});return
			end
		end
		task.wait(0.15)
	end
	if active==model then active=nil end;model:Destroy()
end

function Service.start()
	if started then return end;started=true
	remote=Instance.new("RemoteEvent");remote.Name="SkyChestEvent";remote.Parent=ReplicatedStorage:WaitForChild("Remotes")
	Players.PlayerRemoving:Connect(function(player) busy[player]=nil;policies[player]=nil end)
	task.spawn(function() task.wait(Def.Interval);while true do task.spawn(Service.drop);task.wait(Def.Interval) end end)
	if game:GetService("RunService"):IsStudio() then
		local debugDrop=Instance.new("BindableEvent");debugDrop.Name="DebugDrop";debugDrop.Parent=script
		debugDrop.Event:Connect(function(position: Vector3?) task.spawn(Service.drop,position) end)
	end
	-- One refresh per second expires temporary speed without multiplying the permanent pass.
	task.spawn(function() while true do task.wait(1);for _,player in Players:GetPlayers() do if Data.get(player) then Arena.refreshWalkSpeed(player) end end end end)
end
return Service
