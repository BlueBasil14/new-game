                <string name="Source">-- Migrations/Content - generated by node tools/v3/b-release/run.mjs fingerprints SoundSystem (plan B0)
-- from tools/v3/b-release/packs/SoundSystem.json and fingerprints computed in Studio.
-- Do not edit it: change the descriptor and run that command again.
--   each entry: a subtree of buyer content, and "&lt;PackId&gt;@&lt;version&gt; &lt;element&gt;"
--   of every published 2.x copy with its fingerprint (Migrate.contentFingerprint).
return {
	{
		path = "SoundService/SoundSystem/SFX",
		published = {
			["SoundSystem@2.0.0 SoundService/SoundSystem/SFX"] = "f2:e4023159:?cfcb0ed7",
			["SoundSystem@2.1.0 SoundService/SoundSystem/SFX"] = "f2:e4023159:?ad847a85",
			["SoundSystem@2.1.1 SoundService/SoundSystem/SFX"] = "f2:e4023159:?ad847a85",
			["SoundSystem@3.0.0 SoundService/SoundSystem/SFX"] = "f2:e4023159:?f6b7b0bc",
			["SoundSystem@3.2.0 SoundService/SoundSystem/SFX"] = "f2:e4023159:?f6b7b0bc",
			["SoundSystem@3.2.1 SoundService/SoundSystem/SFX"] = "f2:e4023159:?f6b7b0bc",
		},
	},
	{
		path = "SoundService/SoundSystem/Music",
		published = {
			["SoundSystem@2.0.0 SoundService/SoundSystem/Music"] = "f2:e4023159:?9ca6f9e7",
			["SoundSystem@2.1.0 SoundService/SoundSystem/Music"] = "f2:e4023159:?9ca6f9e7",
			["SoundSystem@2.1.1 SoundService/SoundSystem/Music"] = "f2:e4023159:?9ca6f9e7",
			["SoundSystem@3.0.0 SoundService/SoundSystem/Music"] = "f2:e4023159:?9ca6f9e7",
			["SoundSystem@3.2.0 SoundService/SoundSystem/Music"] = "f2:e4023159:?9ca6f9e7",
			["SoundSystem@3.2.1 SoundService/SoundSystem/Music"] = "f2:e4023159:?9ca6f9e7",
		},
	},
	{
		path = "Workspace/SoundSystem/Demo",
		published = {
			["SoundSystem@2.0.0 Workspace/SoundSystem/Demo"] = "f2:e4023159:?860e2f99",
			["SoundSystem@2.1.0 Workspace/SoundSystem/Demo"] = "f2:e4023159:?860e2f99",
			["SoundSystem@2.1.1 Workspace/SoundSystem/Demo"] = "f2:e4023159:?860e2f99",
			["SoundSystem@3.0.0 Workspace/SoundSystem/Demo"] = "f2:e4023159:?a1cdcb26",
			["SoundSystem@3.2.0 Workspace/SoundSystem/Demo"] = "f2:e4023159:?a1cdcb26",
			["SoundSystem@3.2.1 Workspace/SoundSystem/Demo"] = "f2:e4023159:?a1cdcb26",
		},
