            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source">-- Notification facade. Packs call Notify:Toast(...) freely; it is a no-op
-- until a backend registers (Notifications System v2 calls setBackend from
-- its server and client inits).
--
-- WHY THIS IS A FACADE AND NOT A REQUIRE: every pack in the ecosystem wants
-- to announce something, and Notifications System is optional. Without this,
-- five packs would each carry the same twenty lines of FindFirstChild +
-- pcall + degrade - and a pack that declared it in manifest.deps would make
-- an optional companion mandatory, since the plugin refuses to install a
-- pack whose declared deps are missing. Same reasoning, same shape, as
-- SFX.lua, which solved this once already for sound.
--
-- Server methods take a `player`; the client backend's do not (a client only
-- ever notifies its own player), which is why a missing method has to be a
-- no-op rather than an error.
local Notify = {}
local backend = nil

-- A missing method behaves exactly like a missing backend: the client
-- backend has no ChatTo/ToastAll/BannerAll, and a pack must not have to know
-- which side it is on. pcall because a notification is fire-and-forget - a
-- bug in the renderer must never surface as an error inside the pack that
-- called it.
local function forward(method, ...)
	if not backend then
		return
	end
	local fn = backend[method]
	if type(fn) ~= "function" then
		return
	end
	local ok, err = pcall(fn, backend, ...)
	if not ok then
		warn("[RBLXE Notify] backend:" .. method .. " failed: " .. tostring(err))
	end
end

function Notify:Toast(...)
	forward("Toast", ...)
end

function Notify:ToastAll(...)
	forward("ToastAll", ...)
end

function Notify:Chat(...)
	forward("Chat", ...)
end

function Notify:ChatTo(...)
	forward("ChatTo", ...)
end

function Notify:Banner(...)
	forward("Banner", ...)
end

function Notify:BannerAll(...)
	forward("BannerAll", ...)
end

function Notify.setBackend(b)
	backend = b
end

return Notify
