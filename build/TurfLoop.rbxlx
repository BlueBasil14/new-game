			<Item class="ModuleScript" referent="RBX00000000000000000000000000000006">
				<Properties>
					<string name="Name">EconomyRules</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Pure decision logic shared by the economy services so it can be unit tested.
local Config = require(script.Parent.Config)

local EconomyRules = {}

export type QuestDef = { kind: string, target: number }
export type QuestEntry = { id: string, progress: number, claimed: boolean }

local SECONDS_PER_HOUR = 3600

-- GDD G4.2: shown once the session is old enough, then only inside the offer window.
function EconomyRules.shouldOfferStarter(bought: boolean, sessionSeconds: number, seenAt: number, now: number): boolean
	local cfg = Config.Products.starterPack
	if bought or sessionSeconds < cfg.OfferAfterSeconds then
		return false
	end
	if seenAt == 0 then
		return true
	end
	return now - seenAt <= cfg.OfferWindowHours * SECONDS_PER_HOUR
end

-- Returns true when any entry changed. Claimed quests are frozen; progress is capped at target.
function EconomyRules.applyQuestProgress(
	list: { QuestEntry },
	defs: { [string]: QuestDef },
	kind: string,
	amount: number,
	mode: string
): boolean
	if amount ~= amount or amount <= 0 or amount == math.huge then
		return false
	end
	local changed = false
	for _, entry in list do
		local def = defs[entry.id]
		if def ~= nil and def.kind == kind and not entry.claimed then
			local nextValue = if mode == "add" then entry.progress + amount else math.max(entry.progress, amount)
			nextValue = math.min(nextValue, def.target)
			if nextValue ~= entry.progress then
				entry.progress = nextValue
				changed = true
			end
		end
	end
	return changed
end

return EconomyRules
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000000000000000000000000000007">
				<Properties>
					<string name="Name">FloodFill</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Territory claim: trail becomes turf, then everything the owner encloses becomes turf.
local Grid = require(script.Parent.Grid)

local FloodFill = {}

export type ClaimResult = {
	changed: { number }, -- indices whose owner changed, trail cells first
	neutral: number,
	stolen: number,
	cx: number, -- centroid of changed cells (cell coords); trail end cell if nothing changed
	cy: number,
}

type Scratch = { mark: buffer, queue: buffer, gen: number }
local scratchBySize: { [number]: Scratch } = {}
local scratchLost: { number } = table.create(256, 0) -- cells lost per previous owner + 1

local function scratchFor(size: number): Scratch
	local s = scratchBySize[size]
	if not s then
		-- mark holds a u32 generation stamp per cell so it never needs clearing.
		s = { mark = buffer.create(size * size * 4), queue = buffer.create(size * size * 2), gen = 0 }
		scratchBySize[size] = s
	end
	s.gen += 1
	if s.gen >= 4294967295 then
		buffer.fill(s.mark, 0, 0)
		s.gen = 1
	end
	return s
end

function FloodFill.claim(grid: Grid.Grid, owner: number, trailCells: { number }): ClaimResult
	local size = grid.size
	local cells = grid.cells
	local changed = {}
	local neutral, stolen = 0, 0
	local sumX, sumY = 0, 0

	local function take(i: number)
		local prev = grid:setIndex(i, owner)
		if prev ~= owner then
			table.insert(changed, i)
			if prev == 0 then
				neutral += 1
			else
				stolen += 1
			end
			sumX += i % size
			sumY += i // size
		end
	end

	for _, i in trailCells do
		take(i)
	end

	local bx0, by0, bx1, by1 = grid:bounds(owner)
	if bx0 and by0 and bx1 and by1 then
		-- Cells outside the owner's box reach the border trivially, so flood only inside box+1.
		local x0, y0 = math.max(bx0 - 1, 0), math.max(by0 - 1, 0)
		local x1, y1 = math.min(bx1 + 1, size - 1), math.min(by1 + 1, size - 1)
		local s = scratchFor(size)
		local mark, queue, gen = s.mark, s.queue, s.gen
		local head, tail = 0, 0

		local function seed(i: number)
			if buffer.readu8(cells, i) ~= owner and buffer.readu32(mark, i * 4) ~= gen then
				buffer.writeu32(mark, i * 4, gen)
				buffer.writeu16(queue, tail * 2, i)
				tail += 1
			end
		end
		for x = x0, x1 do
			seed(y0 * size + x)
			seed(y1 * size + x)
		end
		for y = y0 + 1, y1 - 1 do
			seed(y * size + x0)
			seed(y * size + x1)
		end

		while head < tail do
			local i = buffer.readu16(queue, head * 2)
			head += 1
			local x, y = i % size, i // size
			if x > x0 then
				local j = i - 1
				if buffer.readu32(mark, j * 4) ~= gen and buffer.readu8(cells, j) ~= owner then
					buffer.writeu32(mark, j * 4, gen)
					buffer.writeu16(queue, tail * 2, j)
					tail += 1
				end
			end
			if x < x1 then
				local j = i + 1
				if buffer.readu32(mark, j * 4) ~= gen and buffer.readu8(cells, j) ~= owner then
					buffer.writeu32(mark, j * 4, gen)
					buffer.writeu16(queue, tail * 2, j)
					tail += 1
				end
			end
			if y > y0 then
				local j = i - size
				if buffer.readu32(mark, j * 4) ~= gen and buffer.readu8(cells, j) ~= owner then
					buffer.writeu32(mark, j * 4, gen)
					buffer.writeu16(queue, tail * 2, j)
					tail += 1
				end
			end
			if y < y1 then
				local j = i + size
				if buffer.readu32(mark, j * 4) ~= gen and buffer.readu8(cells, j) ~= owner then
					buffer.writeu32(mark, j * 4, gen)
					buffer.writeu16(queue, tail * 2, j)
					tail += 1
				end
			end
		end

		-- Hot loop writes the buffer directly; every filled cell lies inside the owner's box, so
		-- only counts (and emptied owners' boxes) need fixing up.
		local counts = grid.counts
		local lost = scratchLost
		local filled = 0
		for y = y0 + 1, y1 - 1 do
			local row = y * size
			for x = x0 + 1, x1 - 1 do
				local i = row + x
				if buffer.readu32(mark, i * 4) ~= gen then
					local prev = buffer.readu8(cells, i)
					if prev ~= owner then
						buffer.writeu8(cells, i, owner)
						lost[prev + 1] += 1
						filled += 1
						table.insert(changed, i)
						sumX += x
						sumY += y
					end
				end
			end
		end
		if filled > 0 then
			counts[owner + 1] += filled
			for k = 1, 256 do
				local c = lost[k]
				if c > 0 then
					counts[k] -= c
					lost[k] = 0
					if k == 1 then
						neutral += c
					else
						stolen += c
						grid:refreshBounds(k - 1)
					end
				end
			end
		end
	end

	local n = #changed
	local cx, cy
	if n > 0 then
		cx, cy = sumX / n, sumY / n
	else
		local last = trailCells[#trailCells] or 0
		cx, cy = last % size, last // size
	end
	return { changed = changed, neutral = neutral, stolen = stolen, cx = cx, cy = cy }
end

return FloodFill
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000000000000000000000000000008">
				<Properties>
					<string name="Name">Formulas</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Pure economy and calendar formulas. Every number comes from Config.
local Config = require(script.Parent.Config)

local Formulas = {}

type UpgradeDef = { Max: number, Base: number, Growth: number, PerLevel: number }
local Upgrades = Config.Upgrades :: { [string]: UpgradeDef }

export type CoinContext = {
	coinBoostLevel: number,
	crowns: number,
	vip: boolean,
	doubleCoins: boolean,
	boostActive: boolean,
	inGroup: boolean,
	weekend: boolean,
}

local SECONDS_PER_DAY = 86400
local DAYS_PER_WEEK = 7
local EPOCH_WEEKDAY = 4 -- 1970-01-01 was a Thursday (0 = Sunday)
local SATURDAY, SUNDAY = 6, 0

local function round(x: number): number
	return math.floor(x + 0.5)
end

local function roundTo5(x: number): number
	return round(x / 5) * 5
end

-- nil at max level (or unknown upgrade)
function Formulas.upgradeCost(upgradeId: string, currentLevel: number): number?
	local def = Upgrades[upgradeId]
	if def == nil or currentLevel >= def.Max then
		return nil
	end
	return roundTo5(def.Base * def.Growth ^ currentLevel)
end

function Formulas.upgradeValue(upgradeId: string, level: number): number
	local def = Upgrades[upgradeId]
	if upgradeId == "startSize" then
		return Config.Arena.StartPatch + def.PerLevel * level
	elseif upgradeId == "shield" then
		return Config.Arena.SpawnShield + def.PerLevel * level
	end
	return 1 + def.PerLevel * level -- speed, coinBoost
end

function Formulas.coinMultiplier(ctx: CoinContext): number
	local inc = Config.Income
	local m = Formulas.upgradeValue("coinBoost", ctx.coinBoostLevel)
	m *= 1 + inc.RebirthBonusPerCrown * ctx.crowns
	if ctx.vip then
		m *= inc.VipMultiplier
	end
	if ctx.doubleCoins then
		m *= inc.DoubleCoinsMultiplier
	end
	if ctx.boostActive then
		m *= inc.BoostMultiplier
	end
	if ctx.inGroup then
		m *= 1 + inc.GroupBonus
	end
	if ctx.weekend then
		m *= inc.WeekendMultiplier
	end
	return m
end

-- Base coins for one capture; size bonus tier is chosen by the capture's total cell count.
function Formulas.captureCoins(neutralCells: number, stolenCells: number): number
	local inc = Config.Income
	local base = neutralCells * inc.CellNeutral + stolenCells * inc.CellStolen
	local total = neutralCells + stolenCells
	local bonus = 0
	for _, tier in inc.CaptureBonus do
		if total >= tier.MinCells then
			bonus = tier.Bonus
		end
	end
	return round(base * (1 + bonus))
end

function Formulas.killCoins(victimCells: number, victimWasKing: boolean): number
	local inc = Config.Income
	local coins = inc.KillBase + math.floor(victimCells * inc.KillVictimShare + 1e-9)
	if victimWasKing then
		coins *= inc.KingKillMultiplier
	end
	return coins
end

function Formulas.passiveCoins(ownCells: number): number
	return math.floor(ownCells / Config.Income.PassiveCellsPerCoin)
end

function Formulas.rebirthRequirement(crowns: number): number
	return Config.Rebirth.Base * 2 ^ crowns
end

function Formulas.dayNumber(unixSeconds: number): number
	return math.floor(unixSeconds / SECONDS_PER_DAY)
end

function Formulas.isWeekendUTC(unixSeconds: number): boolean
	local weekday = (Formulas.dayNumber(unixSeconds) + EPOCH_WEEKDAY) % DAYS_PER_WEEK
	return weekday == SATURDAY or weekday == SUNDAY
end

function Formulas.dailyClaimState(lastClaimDay: number, streak: number, today: number): { canClaim: boolean, nextStreak: number }
	local gap = today - lastClaimDay
	if gap <= 0 then
		return { canClaim = false, nextStreak = streak }
	elseif gap == 1 then
		return { canClaim = true, nextStreak = streak % DAYS_PER_WEEK + 1 }
	end
	return { canClaim = true, nextStreak = 1 }
end

-- nil when the rarity is not for sale (crown, exclusive, unknown)
function Formulas.itemPrice(rarity: string, featured: boolean): { currency: string, amount: number }?
	local def = (Config.Prices :: any)[rarity]
	if type(def) ~= "table" then
		return nil
	end
	local amount: number = def.Amount
	if featured then
		amount = round(amount * (1 - Config.Prices.FeaturedDiscount))
	end
	return { currency = def.Currency, amount = amount }
end

return Formulas
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000000000000000000000000000009">
				<Properties>
					<string name="Name">GreedyMesh</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Covers an owner's cells with few rectangles: each row is split into runs, and a run extends the
-- rectangle directly above it when that rectangle has the same x, width and owner.
local Grid = require(script.Parent.Grid)

local GreedyMesh = {}

export type Rect = { x: number, y: number, w: number, h: number }

-- Active rectangles keyed by run start x + 1, swapped between rows.
local activeA: { [number]: Rect } = {}
local activeB: { [number]: Rect } = {}
local ownerA: { [number]: number } = {}
local ownerB: { [number]: number } = {}

-- Rectangles covering exactly owner's cells inside the inclusive region (x0,y0)-(x1,y1).
function GreedyMesh.build(grid: Grid.Grid, owner: number, x0: number, y0: number, x1: number, y1: number): { Rect }
	local size, cells = grid.size, grid.cells
	x0, y0 = math.max(x0, 0), math.max(y0, 0)
	x1, y1 = math.min(x1, size - 1), math.min(y1, size - 1)
	local out: { Rect } = {}
	local prev, cur = activeA, activeB
	table.clear(prev)
	for y = y0, y1 do
		table.clear(cur)
		local row = y * size
		local x = x0
		while x <= x1 do
			if buffer.readu8(cells, row + x) == owner then
				local s = x
				x += 1
				while x <= x1 and buffer.readu8(cells, row + x) == owner do
					x += 1
				end
				local w = x - s
				local r = prev[s + 1]
				if r and r.w == w then
					r.h += 1
				else
					r = { x = s, y = y, w = w, h = 1 }
					table.insert(out, r)
				end
				cur[s + 1] = r
			else
				x += 1
			end
		end
		prev, cur = cur, prev
	end
	table.clear(activeA)
	table.clear(activeB)
	return out
end

-- One pass over the whole grid; returns rectangles for every non-neutral owner.
function GreedyMesh.buildAll(grid: Grid.Grid): { [number]: { Rect } }
	local size, cells = grid.size, grid.cells
	local out: { [number]: { Rect } } = {}
	local prev, cur, prevO, curO = activeA, activeB, ownerA, ownerB
	table.clear(prev)
	table.clear(prevO)
	for y = 0, size - 1 do
		table.clear(cur)
		table.clear(curO)
		local row = y * size
		local x = 0
		while x < size do
			local o = buffer.readu8(cells, row + x)
			local s = x
			x += 1
			while x < size and buffer.readu8(cells, row + x) == o do
				x += 1
			end
			if o ~= 0 then
				local w = x - s
				local r = prev[s + 1]
				if r and r.w == w and prevO[s + 1] == o then
					r.h += 1
				else
					r = { x = s, y = y, w = w, h = 1 }
					local list = out[o]
					if not list then
						list = {}
						out[o] = list
					end
					table.insert(list, r)
				end
				cur[s + 1] = r
				curO[s + 1] = o
			end
		end
		prev, cur, prevO, curO = cur, prev, curO, prevO
	end
	table.clear(activeA)
	table.clear(activeB)
	table.clear(ownerA)
	table.clear(ownerB)
	return out
end

return GreedyMesh
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000000000000000000000000000A">
				<Properties>
					<string name="Name">Grid</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Buffer-backed owner grid: one u8 per cell (0 = neutral, 1..255 = runner id).
-- Cell index = y * size + x, 0-based (see Types). World X maps to grid x, world Z to grid y.
local Config = require(script.Parent.Config)

local Grid = {}
Grid.__index = Grid

export type Grid = typeof(setmetatable(
	{} :: {
		size: number,
		total: number,
		cells: buffer,
		counts: { number }, -- counts[owner + 1]
		-- Conservative per-owner bounding boxes: they grow on every set and reset only when the
		-- owner's count reaches 0, so they always contain the owner's cells (possibly loosely).
		minX: { number },
		minY: { number },
		maxX: { number },
		maxY: { number },
	},
	Grid
))

export type CellDelta = { index: number, owner: number }

function Grid.new(size: number?): Grid
	local n = size or Config.Arena.GridSize
	-- Indices must fit the u16 used by the delta encoding.
	assert(n >= 1 and n <= 255, "grid size must be 1..255")
	local self = setmetatable({
		size = n,
		total = n * n,
		cells = buffer.create(n * n),
		counts = table.create(256, 0),
		minX = table.create(256, math.huge),
		minY = table.create(256, math.huge),
		maxX = table.create(256, -1),
		maxY = table.create(256, -1),
	}, Grid)
	self.counts[1] = n * n
	return self
end

function Grid.inBounds(self: Grid, x: number, y: number): boolean
	return x >= 0 and y >= 0 and x < self.size and y < self.size
end

function Grid.index(self: Grid, x: number, y: number): number
	return y * self.size + x
end

function Grid.fromIndex(self: Grid, i: number): (number, number)
	return i % self.size, i // self.size
end

function Grid.getIndex(self: Grid, i: number): number
	return buffer.readu8(self.cells, i)
end

-- Returns the previous owner.
function Grid.setIndex(self: Grid, i: number, owner: number): number
	local cells = self.cells
	local prev = buffer.readu8(cells, i)
	if prev == owner then
		return prev
	end
	buffer.writeu8(cells, i, owner)
	local counts = self.counts
	local pc = counts[prev + 1] - 1
	counts[prev + 1] = pc
	if pc == 0 and prev ~= 0 then
		self.minX[prev + 1] = math.huge
		self.minY[prev + 1] = math.huge
		self.maxX[prev + 1] = -1
		self.maxY[prev + 1] = -1
	end
	counts[owner + 1] += 1
	if owner ~= 0 then
		local k = owner + 1
		local size = self.size
		local x, y = i % size, i // size
		if x < self.minX[k] then
			self.minX[k] = x
		end
		if x > self.maxX[k] then
			self.maxX[k] = x
		end
		if y < self.minY[k] then
			self.minY[k] = y
		end
		if y > self.maxY[k] then
			self.maxY[k] = y
		end
	end
	return prev
end

-- For bulk writers (FloodFill) that adjust counts themselves: resets owner's box if it is empty.
function Grid.refreshBounds(self: Grid, owner: number)
	local k = owner + 1
	if owner ~= 0 and self.counts[k] == 0 then
		self.minX[k] = math.huge
		self.minY[k] = math.huge
		self.maxX[k] = -1
		self.maxY[k] = -1
	end
end

function Grid.get(self: Grid, x: number, y: number): number
	return buffer.readu8(self.cells, y * self.size + x)
end

function Grid.set(self: Grid, x: number, y: number, owner: number): number
	return self:setIndex(y * self.size + x, owner)
end

function Grid.count(self: Grid, owner: number): number
	return self.counts[owner + 1]
end

-- Conservative bounding box (inclusive) containing every cell of owner, or nil if it has none.
function Grid.bounds(self: Grid, owner: number): (number?, number?, number?, number?)
	if owner == 0 then
		return 0, 0, self.size - 1, self.size - 1
	end
	local k = owner + 1
	if self.counts[k] == 0 then
		return nil, nil, nil, nil
	end
	return self.minX[k], self.minY[k], self.maxX[k], self.maxY[k]
end

-- Recounts from scratch (tests / invariant checks).
function Grid.recount(self: Grid): { number }
	local out = table.create(256, 0)
	for i = 0, self.total - 1 do
		local o = buffer.readu8(self.cells, i) + 1
		out[o] += 1
	end
	return out
end

-- Arena is centred on the world origin.
function Grid.worldToCell(self: Grid, wx: number, wz: number): (number, number)
	local cs = Config.Arena.CellSize
	local half = self.size * cs / 2
	local x = math.clamp(math.floor((wx + half) / cs), 0, self.size - 1)
	local y = math.clamp(math.floor((wz + half) / cs), 0, self.size - 1)
	return x, y
end

function Grid.cellToWorld(self: Grid, x: number, y: number): (number, number)
	local cs = Config.Arena.CellSize
	local half = self.size * cs / 2
	return (x + 0.5) * cs - half, (y + 0.5) * cs - half
end

-- Every cell crossed going from (x0,y0) to (x1,y1), excluding the start, 4-connected so a
-- trail drawn from consecutive results has no diagonal gaps. Returns a flat list of indices.
function Grid.line(self: Grid, x0: number, y0: number, x1: number, y1: number): { number }
	local dx, dy = math.abs(x1 - x0), math.abs(y1 - y0)
	local sx = if x1 > x0 then 1 else -1
	local sy = if y1 > y0 then 1 else -1
	local out = table.create(dx + dy)
	local size = self.size
	local x, y, ix, iy = x0, y0, 0, 0
	while ix < dx or iy < dy do
		-- Step along whichever axis the ideal line crosses a cell boundary on first.
		if (1 + 2 * ix) * dy < (1 + 2 * iy) * dx then
			x += sx
			ix += 1
		else
			y += sy
			iy += 1
		end
		table.insert(out, y * size + x)
	end
	return out
end

-- RLE snapshot: u8 size, then runs of [u8 owner, u16 length].
function Grid.encodeRLE(self: Grid): buffer
	local cells, total = self.cells, self.total
	local runs = 0
	local i = 0
	while i < total do
		local o = buffer.readu8(cells, i)
		local j = i + 1
		while j < total and j - i < 65535 and buffer.readu8(cells, j) == o do
			j += 1
		end
		runs += 1
		i = j
	end
	local out = buffer.create(1 + runs * 3)
	buffer.writeu8(out, 0, self.size)
	local p = 1
	i = 0
	while i < total do
		local o = buffer.readu8(cells, i)
		local j = i + 1
		while j < total and j - i < 65535 and buffer.readu8(cells, j) == o do
			j += 1
		end
		buffer.writeu8(out, p, o)
		buffer.writeu16(out, p + 1, j - i)
		p += 3
		i = j
	end
	return out
end

function Grid.decodeRLE(data: buffer): Grid
	local g = Grid.new(buffer.readu8(data, 0))
	local len = buffer.len(data)
	local p, i = 1, 0
	while p < len do
		local o = buffer.readu8(data, p)
		local n = buffer.readu16(data, p + 1)
		for k = i, i + n - 1 do
			g:setIndex(k, o)
		end
		i += n
		p += 3
	end
	return g
end

-- Cell delta: u16 count, then per entry [u16 index, u8 owner].
function Grid.encodeDelta(deltas: { CellDelta }): buffer
	local n = #deltas
	local out = buffer.create(2 + n * 3)
	buffer.writeu16(out, 0, n)
	for k = 1, n do
		local d = deltas[k]
		buffer.writeu16(out, 2 + (k - 1) * 3, d.index)
		buffer.writeu8(out, 4 + (k - 1) * 3, d.owner)
	end
	return out
end

-- Same format, owners read from the grid; avoids building CellDelta tables on the server.
function Grid.encodeIndices(self: Grid, indices: { number }): buffer
	local n = #indices
	local out = buffer.create(2 + n * 3)
	buffer.writeu16(out, 0, n)
	for k = 1, n do
		local i = indices[k]
		buffer.writeu16(out, 2 + (k - 1) * 3, i)
		buffer.writeu8(out, 4 + (k - 1) * 3, buffer.readu8(self.cells, i))
	end
	return out
end

function Grid.decodeDelta(data: buffer): { CellDelta }
	local n = buffer.readu16(data, 0)
	local out = table.create(n)
	for k = 1, n do
		out[k] = { index = buffer.readu16(data, 2 + (k - 1) * 3), owner = buffer.readu8(data, 4 + (k - 1) * 3) }
	end
	return out
end

-- Applies an encoded delta in place; returns the changed indices.
function Grid.applyDelta(self: Grid, data: buffer): { number }
	local n = buffer.readu16(data, 0)
	local out = table.create(n)
	for k = 1, n do
		local i = buffer.readu16(data, 2 + (k - 1) * 3)
		self:setIndex(i, buffer.readu8(data, 4 + (k - 1) * 3))
		out[k] = i
	end
	return out
end

return Grid
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000000000000000000000000000B">
				<Properties>
					<string name="Name">ProfileTemplate</string>
					<ProtectedString name="Source"><![CDATA[--!strict
local Config = require(script.Parent.Config)
local Types = require(script.Parent.Types)

type Profile = Types.Profile

local ProfileTemplate = {}

function ProfileTemplate.default(now: number): Profile
	return {
		v = Config.Data.Version,
		coins = 0,
		gems = 0,
		crowns = 0,
		lifetimeCoinsSinceRebirth = 0,
		upgrades = { speed = 0, startSize = 0, coinBoost = 0, shield = 0 },
		owned = { default = true, default_trail = true, sparkle = true },
		equipped = { skin = "default", trail = "default_trail", effect = "sparkle" },
		stats = {
			cells = 0,
			kills = 0,
			deaths = 0,
			bestPct = 0,
			captures = 0,
			playSeconds = 0,
			kingSeconds = 0,
		},
		daily = { streak = 0, lastClaimDay = 0, loops = 0 },
		quests = { day = 0, list = {} },
		codes = {},
		starterPackBought = false,
		starterOfferSeenAt = 0,
		tutorialDone = false,
		receipts = {},
		boostUntil = 0,
		settings = { music = true, sfx = true, shake = true, lowDetail = false },
		firstJoin = now,
		lastJoin = now,
	}
end

local function isFiniteNumber(x: any): boolean
	return type(x) == "number" and x == x and x ~= math.huge and x ~= -math.huge
end

-- Map fields hold arbitrary string keys; only `true` entries are meaningful.
local MAP_FIELDS = { owned = true, codes = true }

local function reconcileValue(value: any, template: any): any
	local tt = type(template)
	if tt == "number" then
		if isFiniteNumber(value) then
			return math.max(0, value)
		end
		return template
	elseif tt == "table" then
		local out = {}
		local src = if type(value) == "table" then value else {}
		for k, tv in template do
			out[k] = reconcileValue(src[k], tv)
		end
		return out
	elseif type(value) == tt then
		return value
	end
	return template
end

local function reconcileMap(value: any, template: { [string]: boolean }): { [string]: boolean }
	local out: { [string]: boolean } = {}
	if type(value) == "table" then
		for k, v in value do
			if type(k) == "string" and v == true then
				out[k] = true
			end
		end
	end
	for k, v in template do
		if out[k] == nil then
			out[k] = v
		end
	end
	return out
end

local function reconcileQuestList(value: any): { { id: string, progress: number, claimed: boolean } }
	local out = {}
	if type(value) ~= "table" then
		return out
	end
	for _, q in ipairs(value) do
		if type(q) == "table" and type(q.id) == "string" then
			table.insert(out, {
				id = q.id,
				progress = if isFiniteNumber(q.progress) then math.max(0, q.progress) else 0,
				claimed = q.claimed == true,
			})
		end
	end
	return out
end

local function reconcileReceipts(value: any): { string }
	local all: { string } = {}
	if type(value) == "table" then
		for _, r in ipairs(value) do
			if type(r) == "string" then
				table.insert(all, r)
			end
		end
	end
	local limit = Config.Data.ReceiptHistory
	if #all <= limit then
		return all
	end
	local out: { string } = {}
	for i = #all - limit + 1, #all do
		table.insert(out, all[i])
	end
	return out
end

function ProfileTemplate.reconcile(data: any, now: number): Profile
	local template: any = ProfileTemplate.default(now)
	local src: { [any]: any } = if type(data) == "table" then data else {}
	local out: { [any]: any } = {}

	-- Unknown top-level keys are preserved so newer-schema fields survive an older server.
	for k, v in src do
		if template[k] == nil then
			out[k] = v
		end
	end

	for k, tv in template do
		if MAP_FIELDS[k] then
			out[k] = reconcileMap(src[k], tv)
		elseif k == "receipts" then
			out[k] = reconcileReceipts(src[k])
		elseif k == "quests" then
			local q = if type(src.quests) == "table" then src.quests else {}
			out[k] = {
				day = if isFiniteNumber(q.day) then math.max(0, q.day) else 0,
				list = reconcileQuestList(q.list),
			}
		else
			out[k] = reconcileValue(src[k], tv)
		end
	end

	out.v = Config.Data.Version
	return (out :: any) :: Profile
end

return ProfileTemplate
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000000000000000000000000000C">
				<Properties>
					<string name="Name">Remotes</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Names of every remote and every client request (GDD G11.4). Instances are created by the
-- server in ReplicatedStorage.Remotes; clients WaitForChild them.
local Remotes = {}

Remotes.Folder = "Remotes"

-- server -> client RemoteEvents
Remotes.ArenaSnapshot = "ArenaSnapshot" -- (rle: buffer, runners: {RunnerInfo}, yourRunnerId: number?)
Remotes.ArenaDelta = "ArenaDelta" -- (cells: buffer, trails: {TrailDelta})   see Types
Remotes.ArenaEvent = "ArenaEvent" -- (event: ArenaEvent)
-- (payload: { coins: number, cells: number, lifeSeconds: number, kills: number, canSecondChance: boolean, killerName: string? })
Remotes.Death = "Death" -- sent to the eliminated player only
Remotes.Reward = "Reward" -- (payload: { coins: number?, gems: number?, reason: string, cx: number?, cy: number? }) popup feedback
-- (payload: { profile: Profile (receipts stripped), session: SessionInfo })
-- SessionInfo = { multiplier: number, passes: { [string]: boolean }, featured: { string },
--   joinedAt: number (os.time), playtimeClaimed: { [number]: boolean }, starterOffer: boolean, serverTime: number }
-- Sent in full on load and after every profile change (throttled to 4 Hz per player).
Remotes.ProfileUpdate = "ProfileUpdate"
Remotes.Toast = "Toast" -- (text: string, kind: "info" | "good" | "bad")
-- (runners: {RunnerInfo}) every alive or pending runner, re-sent when someone's equipped cosmetics change
Remotes.RunnerInfo = "RunnerInfo"

-- client -> server RemoteFunction; server returns (ok: boolean, resultOrErrorKey: any)
Remotes.Request = "Request"

Remotes.Requests = {
	BuyUpgrade = "BuyUpgrade", -- (upgradeId: string)
	BuyItem = "BuyItem", -- (itemId: string)
	Equip = "Equip", -- (itemId: string)
	ClaimDaily = "ClaimDaily", -- ()
	ClaimPlaytime = "ClaimPlaytime", -- (index: number)
	ClaimQuest = "ClaimQuest", -- (index: number)
	RedeemCode = "RedeemCode", -- (code: string)
	Rebirth = "Rebirth", -- ()
	Respawn = "Respawn", -- ()
	SetSetting = "SetSetting", -- (key: string, value: boolean)
	TutorialDone = "TutorialDone", -- ()
	StarterOfferSeen = "StarterOfferSeen", -- ()
	DeclineSecondChance = "DeclineSecondChance", -- ()
	Ready = "Ready", -- () client startup ping; the server (re)sends the arena snapshot
}

return Remotes
]]></ProtectedString>
				</Properties>
