				<Item class="ModuleScript" referent="RBX00000000000000000000000000000018">
					<Properties>
						<string name="Name">DataService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Types = require(Shared.Types)
local ProfileTemplate = require(Shared.ProfileTemplate)

type Profile = Types.Profile

type Store = {
	update: (key: string, transform: (any) -> any) -> any,
}

type Session = {
	key: string,
	profile: Profile,
	dirty: boolean,
	released: boolean,
}

local LOCK_TIMEOUT = 120
local LOCK_RETRIES = 5
local LOCK_RETRY_WAIT = 6
local CALL_TRIES = 3
local CLOSE_CAP = 25

local DataService = {}

local listeners: { (Player, Profile) -> () } = {}
DataService.changed = {
	Connect = function(_self: any, fn: (Player, Profile) -> ())
		table.insert(listeners, fn)
		return {
			Disconnect = function()
				local i = table.find(listeners, fn)
				if i then
					table.remove(listeners, i)
				end
			end,
		}
	end,
}

local store: Store? = nil
local sessions: { [Player]: Session } = {}
local loading: { [Player]: boolean } = {}
local releasing = 0 -- release writes in flight
local started = false

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in value do
		out[k] = deepCopy(v)
	end
	return out
end

local function makeMockStore(): Store
	local data: { [string]: any } = {}
	return {
		update = function(key: string, transform: (any) -> any): any
			local result = transform(deepCopy(data[key]))
			if result ~= nil then
				data[key] = deepCopy(result)
			end
			return result
		end,
	}
end

local function makeRealStore(ds: DataStore): Store
	return {
		update = function(key: string, transform: (any) -> any): any
			return (ds:UpdateAsync(key, transform))
		end,
	}
end

local function initStore(): Store
	local ok, ds = pcall(function()
		return DataStoreService:GetDataStore(Config.Data.StoreName)
	end)
	if ok and ds and RunService:IsStudio() then
		-- Unpublished places / API access off only fail on the first real request.
		ok = pcall(function()
			local _ = (ds :: DataStore):GetAsync("__probe")
		end)
	end
	if ok and ds then
		return makeRealStore(ds :: DataStore)
	end
	if RunService:IsStudio() then
		warn("[DataService] DataStores unavailable in Studio; using an in-memory mock store. Progress will not persist.")
		return makeMockStore()
	end
	-- Live server without a store: every call fails, so players are kicked rather than given unsaved data.
	warn("[DataService] GetDataStore failed:", ds)
	return {
		update = function(_key: string, _transform: (any) -> any): any
			error("DataStore unavailable")
		end,
	}
end

local function getStore(): Store
	if not store then
		store = initStore()
	end
	return store :: Store
end

local function withRetry(fn: () -> any): (boolean, any)
	local lastErr: any = nil
	for attempt = 1, CALL_TRIES do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		if attempt < CALL_TRIES then
			task.wait(2 ^ (attempt - 1))
		end
	end
	warn("[DataService] DataStore call failed after retries:", lastErr)
	return false, lastErr
end

local function keyFor(player: Player): string
	return "u_" .. tostring(player.UserId)
end

local function stripLock(data: any): Profile
	data._lock = nil
	return data :: Profile
end

-- Returns "ok" | "locked" | "error", plus the profile on "ok".
local function tryLoad(key: string): (string, Profile?)
	local blocked = false
	local loaded: any = nil
	local ok = withRetry(function()
		return getStore().update(key, function(old: any): any
			blocked = false
			loaded = nil
			local now = os.time()
			if type(old) == "table" and type(old._lock) == "table" then
				local lock = old._lock
				local t = if type(lock.t) == "number" then lock.t else 0
				if lock.jobId ~= game.JobId and now - t < LOCK_TIMEOUT then
					blocked = true
					return nil
				end
			end
			local data: any = ProfileTemplate.reconcile(old, now)
			data.lastJoin = now
			data._lock = { jobId = game.JobId, t = now }
			loaded = data
			return data
		end)
	end)
	if not ok then
		return "error", nil
	end
	if blocked then
		return "locked", nil
	end
	if loaded == nil then
		return "error", nil
	end
	return "ok", stripLock(deepCopy(loaded))
end

-- Writes only while we still own the lock, so a lost lock can never clobber another server's data.
local function write(session: Session, releaseLock: boolean): boolean
	local snapshot: any = deepCopy(session.profile)
	local lockLost = false
	local ok = withRetry(function()
		return getStore().update(session.key, function(old: any): any
			lockLost = false
			if not releaseLock and session.released then
				-- An autosave still in flight when the session was released must not re-take the lock.
				return nil
			end
			if type(old) ~= "table" or type(old._lock) ~= "table" or old._lock.jobId ~= game.JobId then
				lockLost = true
				return nil
			end
			local out = deepCopy(snapshot)
			if not releaseLock then
				out._lock = { jobId = game.JobId, t = os.time() }
			end
			return out
		end)
	end)
	if ok and lockLost then
		warn("[DataService] Session lock lost for " .. session.key .. "; save skipped.")
		return false
	end
	if ok then
		session.dirty = false
	end
	return ok
end

function DataService.load(player: Player): Profile?
	local existing = sessions[player]
	if existing and not existing.released then
		return existing.profile
	end
	while loading[player] do
		task.wait(0.1)
	end
	if sessions[player] then
		return DataService.get(player)
	end

	loading[player] = true
	local key = keyFor(player)
	local status, profile = "error", nil
	for attempt = 0, LOCK_RETRIES do
		if attempt > 0 then
			task.wait(LOCK_RETRY_WAIT)
		end
		if player.Parent == nil then
			loading[player] = nil
			return nil
		end
		status, profile = tryLoad(key)
		if status ~= "locked" then
			break
		end
	end
	loading[player] = nil

	if status ~= "ok" or profile == nil then
		if player.Parent ~= nil then
			if status == "locked" then
				player:Kick("Your data is still being saved by another server. Please rejoin in a minute.")
			else
				player:Kick("We couldn't load your data safely. Please rejoin in a moment.")
			end
		end
		return nil
	end

	local session: Session = { key = key, profile = profile, dirty = false, released = false }
	sessions[player] = session
	if player.Parent == nil then
		-- Left mid-load: drop the lock we just took.
		DataService.release(player)
		return nil
	end
	return profile
end

function DataService.get(player: Player): Profile?
	local session = sessions[player]
	if session and not session.released then
		return session.profile
	end
	return nil
end

function DataService.update(player: Player, fn: (Profile) -> ())
	local session = sessions[player]
	if not session or session.released then
		return
	end
	fn(session.profile)
	session.dirty = true
	for _, cb in table.clone(listeners) do
		task.spawn(cb, player, session.profile)
	end
end

function DataService.save(player: Player): boolean
	local session = sessions[player]
	if not session or session.released then
		return false
	end
	return write(session, false)
end

function DataService.release(player: Player)
	local session = sessions[player]
	if not session or session.released then
		return
	end
	session.released = true
	releasing += 1
	write(session, true)
	releasing -= 1
	if sessions[player] == session then
		sessions[player] = nil
	end
end

function DataService.hasReceipt(profile: Profile, purchaseId: string): boolean
	return table.find(profile.receipts, purchaseId) ~= nil
end

function DataService.addReceipt(profile: Profile, purchaseId: string)
	if DataService.hasReceipt(profile, purchaseId) then
		return
	end
	table.insert(profile.receipts, purchaseId)
	while #profile.receipts > Config.Data.ReceiptHistory do
		table.remove(profile.receipts, 1)
	end
end

local function autosaveLoop()
	while true do
		local period = Config.Data.AutosaveSeconds
		local list: { Player } = {}
		for player, session in sessions do
			if not session.released then
				table.insert(list, player)
			end
		end
		if #list == 0 then
			task.wait(period)
		else
			local gap = period / #list
			for _, player in list do
				task.wait(gap)
				-- Always written, even when clean, because the write also refreshes the session lock.
				if sessions[player] and not sessions[player].released then
					task.spawn(DataService.save, player)
				end
			end
		end
	end
end

local function onClose()
	for player, session in sessions do
		if not session.released then
			task.spawn(DataService.release, player)
		end
	end
	-- Also waits for releases PlayerRemoving started during shutdown: the server stops as soon as
	-- BindToClose returns, which would drop those in-flight saves.
	local deadline = os.clock() + CLOSE_CAP
	while releasing > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
end

function DataService.start()
	if started then
		return
	end
	started = true
	getStore()
	Players.PlayerRemoving:Connect(function(player: Player)
		DataService.release(player)
	end)
	game:BindToClose(onClose)
	task.spawn(autosaveLoop)
end

return DataService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000000000000000000000000000019">
					<Properties>
						<string name="Name">EconomyService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- The only module that changes coins or gems.
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Formulas = require(Shared.Formulas)
local Types = require(Shared.Types)
local DataService = require(script.Parent.DataService)

type Profile = Types.Profile

local EconomyService = {}

local listeners: { (Player, string, number, string) -> () } = {}
EconomyService.granted = {
	Connect = function(_self: any, fn: (Player, string, number, string) -> ())
		table.insert(listeners, fn)
		return {
			Disconnect = function()
				local i = table.find(listeners, fn)
				if i then
					table.remove(listeners, i)
				end
			end,
		}
	end,
}

EconomyService.cellsProvider = nil :: ((Player) -> number)?

local passOwned: { [Player]: { [string]: boolean } } = {}
local inGroup: { [Player]: boolean } = {}
local started = false

local function fire(player: Player, currency: string, amount: number, reason: string)
	for _, cb in table.clone(listeners) do
		task.spawn(cb, player, currency, amount, reason)
	end
end

local function validAmount(amount: any): boolean
	return type(amount) == "number" and amount == amount and amount > 0 and amount < math.huge
end

function EconomyService.setPassOwned(player: Player, passKey: string, owned: boolean)
	local set = passOwned[player]
	if set == nil then
		set = {}
		passOwned[player] = set
	end
	(set :: { [string]: boolean })[passKey] = owned
end

function EconomyService.hasPass(player: Player, passKey: string): boolean
	local set = passOwned[player]
	return set ~= nil and set[passKey] == true
end

function EconomyService.setInGroup(player: Player, value: boolean)
	inGroup[player] = value
end

function EconomyService.isInGroup(player: Player): boolean
	return inGroup[player] == true
end

function EconomyService.multiplier(player: Player): number
	local profile = DataService.get(player)
	if profile == nil then
		return 1
	end
	local now = os.time()
	return Formulas.coinMultiplier({
		coinBoostLevel = profile.upgrades.coinBoost,
		crowns = profile.crowns,
		vip = EconomyService.hasPass(player, "vip"),
		doubleCoins = EconomyService.hasPass(player, "doubleCoins"),
		boostActive = profile.boostUntil > now,
		inGroup = inGroup[player] == true,
		weekend = Formulas.isWeekendUTC(now),
	})
end

-- Returns coins actually added (after multiplier, rounded). 0 when the profile is not loaded.
function EconomyService.addCoins(player: Player, baseAmount: number, reason: string, applyMultiplier: boolean): number
	if not validAmount(baseAmount) then
		return 0
	end
	local amount = baseAmount
	if applyMultiplier then
		amount = baseAmount * EconomyService.multiplier(player)
	end
	amount = math.floor(amount + 0.5)
	if amount <= 0 then
		return 0
	end
	local applied = false
	DataService.update(player, function(profile)
		profile.coins += amount
		profile.lifetimeCoinsSinceRebirth += amount
		applied = true
	end)
	if not applied then
		return 0
	end
	fire(player, "coins", amount, reason)
	return amount
end

function EconomyService.addGems(player: Player, amount: number, reason: string)
	if not validAmount(amount) then
		return
	end
	amount = math.floor(amount)
	local applied = false
	DataService.update(player, function(profile)
		profile.gems += amount
		applied = true
	end)
	if applied then
		fire(player, "gems", amount, reason)
	end
end

-- For use INSIDE a DataService.update callback (e.g. a receipt grant that must be atomic).
-- Adds a flat amount with no multiplier and does not count toward rebirth progress.
function EconomyService.creditInProfile(player: Player, profile: Profile, currency: string, amount: number, reason: string)
	if not validAmount(amount) then
		return
	end
	amount = math.floor(amount)
	if currency == "coins" then
		profile.coins += amount
	elseif currency == "gems" then
		profile.gems += amount
	else
		return
	end
	fire(player, currency, amount, reason)
end

-- Atomic check-and-deduct.
function EconomyService.spend(player: Player, currency: string, amount: number): boolean
	if (currency ~= "coins" and currency ~= "gems") or not validAmount(amount) then
		return false
	end
	local ok = false
	DataService.update(player, function(profile)
		if currency == "coins" then
			if profile.coins >= amount then
				profile.coins -= amount
				ok = true
			end
		elseif profile.gems >= amount then
			profile.gems -= amount
			ok = true
		end
	end)
	return ok
end

-- Rebirth reset: coins and rebirth progress back to zero.
function EconomyService.resetCoins(player: Player)
	DataService.update(player, function(profile)
		profile.coins = 0
		profile.lifetimeCoinsSinceRebirth = 0
	end)
end

function EconomyService.onCapture(player: Player, neutral: number, stolen: number): number
	if type(neutral) ~= "number" or type(stolen) ~= "number" then
		return 0
	end
	return EconomyService.addCoins(player, Formulas.captureCoins(neutral, stolen), "capture", true)
end

function EconomyService.onKill(player: Player, victimCells: number, victimWasKing: boolean): number
	return EconomyService.addCoins(player, Formulas.killCoins(victimCells, victimWasKing), "kill", true)
end

function EconomyService.onFullMap(player: Player)
	EconomyService.addCoins(player, Config.Arena.FullMapBonus, "fullMap", true)
end

-- For use INSIDE a DataService.update callback.
function EconomyService.extendBoostInProfile(profile: Profile, seconds: number)
	profile.boostUntil = math.max(os.time(), profile.boostUntil) + seconds
end

function EconomyService.activateBoost(player: Player, seconds: number)
	if not validAmount(seconds) then
		return
	end
	DataService.update(player, function(profile)
		EconomyService.extendBoostInProfile(profile, seconds)
	end)
end

local function passiveLoop()
	while true do
		task.wait(Config.Income.PassiveInterval)
		local provider = EconomyService.cellsProvider
		if provider ~= nil then
			for _, player in Players:GetPlayers() do
				local ok, cells = pcall(provider, player)
				if ok and type(cells) == "number" then
					local coins = Formulas.passiveCoins(cells)
					if coins > 0 then
						EconomyService.addCoins(player, coins, "passive", true)
					end
				end
			end
		end
	end
end

function EconomyService.start()
	if started then
		return
	end
	started = true
	Players.PlayerRemoving:Connect(function(player)
		passOwned[player] = nil
		inGroup[player] = nil
	end)
	task.spawn(passiveLoop)
end

return EconomyService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000000000000000000000000001A">
					<Properties>
						<string name="Name">LeaderboardService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

type Entry = { userId: number, value: number }

local LeaderboardService = {}

local boardSet: { [string]: boolean } = {}
for _, board in ipairs(Config.Leaderboards.Boards) do
	boardSet[board] = true
end

local stores: { [string]: any } = {}
local cache: { [string]: { Entry } } = {}
local pending: { [string]: { [number]: number } } = {}
local listeners: { (string, { Entry }) -> () } = {}
local available = true
local warned = false
local started = false

for _, board in ipairs(Config.Leaderboards.Boards) do
	cache[board] = {}
	pending[board] = {}
end

local function warnOnce(err: any)
	if warned then
		return
	end
	warned = true
	warn("LeaderboardService: DataStore error, leaderboards degraded: " .. tostring(err))
end

local function getStore(board: string): any?
	if not available then
		return nil
	end
	local existing = stores[board]
	if existing ~= nil then
		return existing
	end
	local ok, result = pcall(DataStoreService.GetOrderedDataStore, DataStoreService, "LB_" .. board .. "_v1")
	if not ok then
		available = false
		warnOnce(result)
		return nil
	end
	stores[board] = result
	return result
end

local function fire(board: string, entries: { Entry })
	for _, fn in ipairs(listeners) do
		task.spawn(fn, board, entries)
	end
end

local function refresh()
	for _, player in ipairs(Players:GetPlayers()) do
		for _, board in ipairs(Config.Leaderboards.Boards) do
			local byUser = pending[board]
			local store = getStore(board)
			if byUser ~= nil and store ~= nil then
				local value = byUser[player.UserId]
				if value ~= nil then
					byUser[player.UserId] = nil
					local ok, err = pcall(store.SetAsync, store, "u_" .. player.UserId, math.floor(value))
					if not ok then
						if byUser[player.UserId] == nil then
							byUser[player.UserId] = value
						end
						warnOnce(err)
					end
				end
			end
		end
	end

	for _, board in ipairs(Config.Leaderboards.Boards) do
		local store = getStore(board)
		if store ~= nil then
			local ok, result = pcall(function()
				local pages = store:GetSortedAsync(false, Config.Leaderboards.Size)
				return pages:GetCurrentPage()
			end)
			if ok then
				local entries: { Entry } = {}
				for _, row in ipairs(result) do
					local userId = tonumber(string.sub(row.key, 3))
					if userId ~= nil then
						table.insert(entries, { userId = userId, value = row.value })
					end
				end
				cache[board] = entries
				fire(board, entries)
			else
				warnOnce(result)
			end
		end
	end
end

local function onRemoving(player: Player)
	for _, board in ipairs(Config.Leaderboards.Boards) do
		local byUser = pending[board]
		if byUser ~= nil then
			local value = byUser[player.UserId]
			if value ~= nil then
				local store = getStore(board)
				if store ~= nil then
					local ok, err = pcall(store.SetAsync, store, "u_" .. player.UserId, math.floor(value))
					if not ok then
						warnOnce(err)
					end
				end
				byUser[player.UserId] = nil
			end
		end
	end
end

function LeaderboardService.start()
	if started then
		return
	end
	started = true
	Players.PlayerRemoving:Connect(onRemoving)
	task.spawn(function()
		while true do
			refresh()
			task.wait(Config.Leaderboards.RefreshSeconds)
		end
	end)
end

function LeaderboardService.submit(player: Player, board: string, value: number)
	if not boardSet[board] then
		return
	end
	pending[board][player.UserId] = value
end

function LeaderboardService.top(board: string): { Entry }
	return cache[board] or {}
end

LeaderboardService.changed = {
	Connect = function(_self: any, fn: (string, { Entry }) -> ())
		table.insert(listeners, fn)
	end,
}

return LeaderboardService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000000000000000000000000001B">
					<Properties>
						<string name="Name">MonetizationService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local EconomyRules = require(Shared.EconomyRules)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local ShopService = require(script.Parent.ShopService)

local MonetizationService = {}

-- Pluggable: return true when the respawn was applied.
MonetizationService.onSecondChance = nil :: ((Player) -> boolean)?
-- Pluggable: called after a game pass is marked owned (ArenaService refreshes the VIP tag).
MonetizationService.onPassOwned = nil :: ((Player) -> ())?
-- Pluggable: called after a receipt is granted (productKey, Robux price or 0); Main logs analytics.
MonetizationService.onProductBought = nil :: ((Player, string, number) -> ())?

local SECOND_CHANCE_REFUND_GEMS = 20

local joinClock: { [Player]: number } = {}
local passKeyById: { [number]: string } = {}
local productKeyById: { [number]: string } = {}
local started = false

for key, id in Config.Ids.Passes do
	if id ~= 0 then
		passKeyById[id] = key
	end
end
for key, id in Config.Ids.Products do
	if id ~= 0 then
		productKeyById[id] = key
	end
end

local function markPassOwned(player: Player, passKey: string)
	EconomyService.setPassOwned(player, passKey, true)
	if DataService.get(player) ~= nil then
		ShopService.reconcile(player)
	end
	local hook = MonetizationService.onPassOwned
	if hook ~= nil then
		pcall(hook, player)
	end
end

local function checkPasses(player: Player)
	for key, id in Config.Ids.Passes do
		if id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
			end)
			if ok and owns == true then
				markPassOwned(player, key)
			end
		end
	end
end

local function checkGroup(player: Player)
	if Config.Ids.GroupId == 0 then
		return
	end
	local ok, member = pcall(function()
		return player:IsInGroup(Config.Ids.GroupId)
	end)
	if ok and member == true then
		EconomyService.setInGroup(player, true)
		if DataService.get(player) ~= nil then
			ShopService.reconcile(player)
		end
	end
end

local function onPlayerAdded(player: Player)
	joinClock[player] = os.clock()
	DataService.load(player)
	if player.Parent == nil then
		return
	end
	task.spawn(checkPasses, player)
	task.spawn(checkGroup, player)
end

function MonetizationService.shouldOfferStarter(player: Player): boolean
	local profile = DataService.get(player)
	local joined = joinClock[player]
	if profile == nil or joined == nil then
		return false
	end
	return EconomyRules.shouldOfferStarter(profile.starterPackBought, os.clock() - joined, profile.starterOfferSeenAt, os.time())
end

function MonetizationService.markStarterOfferSeen(player: Player)
	DataService.update(player, function(profile)
		if profile.starterOfferSeenAt == 0 then
			profile.starterOfferSeenAt = os.time()
		end
	end)
end

local function processReceipt(info: { [string]: any }): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if player == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local profile = DataService.get(player)
	if profile == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local productKey = productKeyById[info.ProductId]
	if productKey == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(info.PurchaseId)
	if DataService.hasReceipt(profile, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local cfg = (Config.Products :: any)[productKey]
	local secondChanceApplied = true
	if productKey == "secondChance" then
		local handler = MonetizationService.onSecondChance
		secondChanceApplied = false
		if handler ~= nil then
			local ok, result = pcall(handler, player)
			secondChanceApplied = ok and result == true
		end
	end

	local ran = false
	DataService.update(player, function(p)
		if DataService.hasReceipt(p, purchaseId) then
			ran = true
			return
		end
		DataService.addReceipt(p, purchaseId)
		if productKey == "boost15" then
			EconomyService.extendBoostInProfile(p, cfg.Seconds)
		elseif productKey == "starterPack" then
			EconomyService.creditInProfile(player, p, "gems", cfg.Gems, productKey)
			if not p.starterPackBought then
				p.starterPackBought = true
				EconomyService.creditInProfile(player, p, "coins", cfg.Coins, productKey)
				p.owned[cfg.Skin] = true
			end
		elseif productKey == "secondChance" then
			if not secondChanceApplied then
				EconomyService.creditInProfile(player, p, "gems", SECOND_CHANCE_REFUND_GEMS, "secondChanceRefund")
			end
		elseif cfg.Gems ~= nil then
			EconomyService.creditInProfile(player, p, "gems", cfg.Gems, productKey)
		end
		ran = true
	end)
	if not ran then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- Persist the receipt before telling Roblox the purchase is granted.
	pcall(DataService.save, player)
	local bought = MonetizationService.onProductBought
	if bought ~= nil then
		pcall(bought, player, productKey, tonumber(info.CurrencySpent) or 0)
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.start()
	if started then
		return
	end
	started = true
	MarketplaceService.ProcessReceipt = processReceipt :: any
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Instance, gamePassId: number, wasPurchased: boolean)
		local key = passKeyById[gamePassId]
		if wasPurchased and key ~= nil and player:IsA("Player") then
			markPassOwned(player :: Player, key)
		end
	end)
	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayerAdded, player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		joinClock[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
end

return MonetizationService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000000000000000000000000001C">
					<Properties>
						<string name="Name">RewardService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Catalog = require(Shared.Catalog)
local Config = require(Shared.Config)
local EconomyRules = require(Shared.EconomyRules)
local Formulas = require(Shared.Formulas)
local Types = require(Shared.Types)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local ShopService = require(script.Parent.ShopService)

type Profile = Types.Profile

local RewardService = {}

local PLAY_TICK = 60
local MINUTES_PER_TICK = PLAY_TICK / 60

local joinClock: { [Player]: number } = {}
local claimedPlaytime: { [Player]: { [number]: boolean } } = {}
local started = false

local questDefs: { [string]: EconomyRules.QuestDef } = {}
for _, quest in Catalog.quests do
	questDefs[quest.id] = { kind = quest.kind, target = quest.target }
end
local questRewards: { [string]: Catalog.Reward } = {}
for _, quest in Catalog.quests do
	questRewards[quest.id] = quest.reward
end

local function today(): number
	return Formulas.dayNumber(os.time())
end

-- Call inside an update.
local function regenerateQuests(profile: Profile, userId: number)
	local day = today()
	if profile.quests.day == day then
		return
	end
	local list = {}
	for i, quest in Catalog.questsForDay(day, userId) do
		list[i] = { id = quest.id, progress = 0, claimed = false }
	end
	profile.quests = { day = day, list = list }
end

local function grant(player: Player, reward: Catalog.Reward, reason: string)
	if reward.currency == "gems" then
		EconomyService.addGems(player, reward.amount, reason)
	else
		EconomyService.addCoins(player, reward.amount, reason, false)
	end
end

local function isIndex(value: any, max: number): boolean
	return type(value) == "number" and value == math.floor(value) and value >= 1 and value <= max
end

function RewardService.claimDaily(player: Player): (boolean, any)
	local profile = DataService.get(player)
	if profile == nil then
		return false, "no_profile"
	end
	local state = Formulas.dailyClaimState(profile.daily.lastClaimDay, profile.daily.streak, today())
	if not state.canClaim then
		return false, "already_claimed"
	end
	local reward = Catalog.daily[state.nextStreak]
	local amount = reward.amount
	if reward.currency == "gems" and EconomyService.hasPass(player, "vip") then
		amount *= Config.Vip.DailyGemMultiplier
	end
	local firstLoop = profile.daily.loops == 0
	DataService.update(player, function(p)
		p.daily.streak = state.nextStreak
		p.daily.lastClaimDay = today()
		if state.nextStreak == #Catalog.daily then
			p.daily.loops += 1
		end
	end)
	grant(player, { currency = reward.currency, amount = amount }, "daily")
	local skin: string? = nil
	if reward.skin ~= nil and firstLoop and ShopService.grantItem(player, reward.skin) then
		skin = reward.skin
	end
	return true, { streak = state.nextStreak, currency = reward.currency, amount = amount, skin = skin }
end

function RewardService.claimPlaytime(player: Player, index: any): (boolean, any)
	if not isIndex(index, #Catalog.playtime) then
		return false, "bad_args"
	end
	local joined = joinClock[player]
	if joined == nil or DataService.get(player) == nil then
		return false, "no_profile"
	end
	local reward = Catalog.playtime[index]
	local claimed = claimedPlaytime[player]
	if claimed == nil then
		claimed = {}
		claimedPlaytime[player] = claimed
	end
	if (claimed :: { [number]: boolean })[index] then
		return false, "already_claimed"
	end
	if os.clock() - joined < reward.seconds then
		return false, "too_early"
	end
	(claimed :: { [number]: boolean })[index] = true
	grant(player, reward, "playtime")
	return true, { currency = reward.currency, amount = reward.amount }
end

function RewardService.claimQuest(player: Player, index: any): (boolean, any)
	local profile = DataService.get(player)
	if profile == nil then
		return false, "no_profile"
	end
	if profile.quests.day ~= today() then
		DataService.update(player, function(p)
			regenerateQuests(p, player.UserId)
		end)
		return false, "quests_refreshed"
	end
	if not isIndex(index, #profile.quests.list) then
		return false, "bad_args"
	end
	local entry = profile.quests.list[index]
	local def = questDefs[entry.id]
	local reward = questRewards[entry.id]
	if def == nil or reward == nil then
		return false, "unknown_quest"
	end
	if entry.claimed then
		return false, "already_claimed"
	end
	if entry.progress < def.target then
		return false, "not_complete"
	end
	DataService.update(player, function(p)
		p.quests.list[index].claimed = true
	end)
	grant(player, reward, "quest")
	return true, { id = entry.id, currency = reward.currency, amount = reward.amount }
end

function RewardService.redeemCode(player: Player, code: any): (boolean, any)
	if type(code) ~= "string" or #code == 0 or #code > Config.Security.MaxCodeLength then
		return false, "bad_args"
	end
	local key = string.upper(code)
	local reward = (Catalog.codes :: { [string]: Catalog.Reward })[key]
	if reward == nil then
		return false, "invalid_code"
	end
	local profile = DataService.get(player)
	if profile == nil then
		return false, "no_profile"
	end
	if profile.codes[key] then
		return false, "already_used"
	end
	DataService.update(player, function(p)
		p.codes[key] = true
	end)
	grant(player, reward, "code")
	return true, { currency = reward.currency, amount = reward.amount }
end

-- Playtime rewards claimed this session as a dense array (sparse tables do not survive remotes).
function RewardService.playtimeClaimed(player: Player): { boolean }
	local out = table.create(#Catalog.playtime, false)
	local claimed = claimedPlaytime[player]
	if claimed ~= nil then
		for i in claimed do
			if out[i] ~= nil then
				out[i] = true
			end
		end
	end
	return out
end

-- One DataService update per call, however many quests match.
function RewardService.progress(player: Player, kind: string, amount: number, mode: string)
	if type(kind) ~= "string" or type(amount) ~= "number" then
		return
	end
	DataService.update(player, function(p)
		regenerateQuests(p, player.UserId)
		EconomyRules.applyQuestProgress(p.quests.list, questDefs, kind, amount, if mode == "max" then "max" else "add")
	end)
end

local function playLoop()
	while true do
		task.wait(PLAY_TICK)
		for _, player in Players:GetPlayers() do
			DataService.update(player, function(p)
				p.stats.playSeconds += PLAY_TICK
				regenerateQuests(p, player.UserId)
				EconomyRules.applyQuestProgress(p.quests.list, questDefs, "playMinutes", MINUTES_PER_TICK, "add")
			end)
		end
	end
end

function RewardService.start()
	if started then
		return
	end
	started = true
	local function onPlayer(player: Player)
		joinClock[player] = os.clock()
		if DataService.load(player) ~= nil then
			DataService.update(player, function(p)
				regenerateQuests(p, player.UserId)
			end)
		end
	end
	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayer, player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		joinClock[player] = nil
		claimedPlaytime[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayer, player)
	end
	task.spawn(playLoop)
end

return RewardService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000000000000000000000000001D">
					<Properties>
						<string name="Name">ShopService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Catalog = require(Shared.Catalog)
local Config = require(Shared.Config)
local Formulas = require(Shared.Formulas)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)

local ShopService = {}

local listeners: { (Player, { skin: string, trail: string, effect: string }) -> () } = {}
ShopService.equippedChanged = {
	Connect = function(_self: any, fn: (Player, { skin: string, trail: string, effect: string }) -> ())
		table.insert(listeners, fn)
		return {
			Disconnect = function()
				local i = table.find(listeners, fn)
				if i then
					table.remove(listeners, i)
				end
			end,
		}
	end,
}

local started = false

function ShopService.owns(player: Player, itemId: string): boolean
	local profile = DataService.get(player)
	return profile ~= nil and profile.owned[itemId] == true
end

-- True only when the item was newly added.
function ShopService.grantItem(player: Player, itemId: string): boolean
	if type(itemId) ~= "string" or Catalog.byId(itemId) == nil then
		return false
	end
	local added = false
	DataService.update(player, function(profile)
		if profile.owned[itemId] ~= true then
			profile.owned[itemId] = true
			added = true
		end
	end)
	return added
end

-- Idempotent: defaults, crown-tier skins by crowns, and items tied to passes, group or the starter pack.
function ShopService.reconcile(player: Player)
	DataService.update(player, function(profile)
		for _, item in Catalog.items do
			local entitled = item.default == true
			if item.crownsRequired ~= nil and profile.crowns >= item.crownsRequired then
				entitled = true
			end
			local source = item.source
			if source ~= nil then
				if (Config.Ids.Passes :: any)[source] ~= nil then
					entitled = entitled or EconomyService.hasPass(player, source)
				elseif source == "group" then
					entitled = entitled or EconomyService.isInGroup(player)
				elseif source == "starterPack" then
					entitled = entitled or profile.starterPackBought
				end
			end
			if entitled and profile.owned[item.id] ~= true then
				profile.owned[item.id] = true
			end
		end
	end)
end

function ShopService.buyItem(player: Player, itemId: any): (boolean, any)
	if type(itemId) ~= "string" then
		return false, "bad_args"
	end
	local item = Catalog.byId(itemId)
	local profile = DataService.get(player)
	if item == nil then
		return false, "unknown_item"
	end
	if profile == nil then
		return false, "no_profile"
	end
	if profile.owned[itemId] == true then
		return false, "already_owned"
	end
	if item.crownsRequired ~= nil and profile.crowns < item.crownsRequired then
		return false, "crowns_required"
	end
	if not Catalog.isPurchasable(item) then
		return false, "not_for_sale"
	end
	local featured = table.find(Catalog.featured(Formulas.dayNumber(os.time())), itemId) ~= nil
	local price = Formulas.itemPrice(item.rarity, featured)
	if price == nil then
		return false, "not_for_sale"
	end
	if not EconomyService.spend(player, price.currency, price.amount) then
		return false, "insufficient_funds"
	end
	ShopService.grantItem(player, itemId)
	return true, { id = itemId, currency = price.currency, amount = price.amount }
end

function ShopService.equip(player: Player, itemId: any): (boolean, any)
	if type(itemId) ~= "string" then
		return false, "bad_args"
	end
	local item = Catalog.byId(itemId)
	if item == nil then
		return false, "unknown_item"
	end
	local equipped: { skin: string, trail: string, effect: string }? = nil
	local err = "not_owned"
	DataService.update(player, function(profile)
		if profile.owned[itemId] ~= true then
			return
		end
		if item.type == "skin" then
			profile.equipped.skin = itemId
		elseif item.type == "trail" then
			profile.equipped.trail = itemId
		elseif item.type == "effect" then
			profile.equipped.effect = itemId
		else
			err = "unknown_item"
			return
		end
		equipped = profile.equipped
	end)
	if equipped == nil then
		return false, err
	end
	for _, cb in table.clone(listeners) do
		task.spawn(cb, player, equipped)
	end
	return true, itemId
end

function ShopService.start()
	if started then
		return
	end
	started = true
	local function onPlayer(player: Player)
		if DataService.load(player) ~= nil then
			ShopService.reconcile(player)
		end
	end
	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayer, player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayer, player)
	end
end

return ShopService
]]></ProtectedString>
					</Properties>
