		published = {
			["SoundSystem@2.0.0 ReplicatedStorage/Packs/SoundSystem/Assets/Templates"] = "f2:e4023159:?1e6d402f",
			["SoundSystem@2.1.0 ReplicatedStorage/Packs/SoundSystem/Assets/Templates"] = "f2:e4023159:0cedd141",
			["SoundSystem@2.1.1 ReplicatedStorage/Packs/SoundSystem/Assets/Templates"] = "f2:e4023159:0cedd141",
			["SoundSystem@3.0.0 ReplicatedStorage/Packs/SoundSystem/Assets/Templates"] = "f2:e4023159:0cedd141",
			["SoundSystem@3.2.0 ReplicatedStorage/Packs/SoundSystem/Assets/Templates"] = "f2:e4023159:0cedd141",
