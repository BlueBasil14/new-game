						<Properties>
							<string name="Name">PanelController</string>
							<ProtectedString name="Source"><![CDATA[--!strict
-- All modal panels (G9.3). Each panel is built lazily and refreshed on profile changes while open.
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Types = require(Shared.Types)
local Catalog = require(Shared.Catalog)
local Formulas = require(Shared.Formulas)
local Remotes = require(Shared.Remotes)
local UiKit = require(script.Parent.Parent.ui.UiKit)
local ClientState = require(script.Parent.Parent.ClientState)

local S = {
	upgradesTitle = "Upgrades",
	shopTitle = "Shop",
	dailyTitle = "Daily Reward",
	questsTitle = "Daily Quests",
	rebirthTitle = "Rebirth",
	codesTitle = "Codes",
	settingsTitle = "Settings",
	deathTitle = "Eliminated",
	starterTitle = "Starter Pack",

	genericError = "Something went wrong",
	comingSoon = "Coming soon",
	notEnoughCoins = "Not enough coins",
	notEnoughGems = "Not enough gems",
	upgraded = "%s upgraded",
	upgradeMax = "MAX",
	upgradeLevel = "Lv %d / %d",
	upgradeArrow = "%s  >  %s",
	upgradeCoins = "%s coins",
	speedValue = "+%d%%",
	cellsValue = "%d cells",
	secondsValue = "%.1f s",
	passFooter = "Get the 2x Coins pass",
	passFooterOwned = "2x Coins pass active",
	upgradeNames = {
		coinBoost = "Coin Boost",
		speed = "Speed",
		shield = "Spawn Shield",
		startSize = "Start Size",
	},

	tabs = {
		featured = "Featured",
		skins = "Skins",
		trails = "Trails",
		effects = "Effects",
		gems = "Gems",
		passes = "Passes",
	},
	ownedToggle = "Owned",
	emptyTab = "Nothing here yet",
	owned = "Owned",
	equip = "Equip",
	equipped = "Equipped",
	equippedToast = "%s equipped",
	boughtToast = "Bought %s",
	claimItem = "Claim",
	needsCrowns = "Needs %d Crowns",
	notForSale = "Not for sale",
	unlockVia = "Unlock via: %s",
	discount = "-%d%%",
	priceCoins = "%s coins",
	priceGems = "%s gems",
	priceRobux = "R$ %d",
	sources = {
		vip = "VIP pass",
		neonPack = "Neon Pack",
		starterPack = "Starter Pack",
		group = "Group reward",
		daily7 = "7-day streak",
	},
	rarity = {
		common = "Common",
		rare = "Rare",
		epic = "Epic",
		legendary = "Legendary",
		crown = "Crown",
		exclusive = "Exclusive",
	},
	gemsName = "%s Gems",
	boostName = "2x Coins",
	boostSub = "%d min",
	starterName = "Starter Pack",
	starterSub = "%s gems + skin",
	passNames = { vip = "VIP", doubleCoins = "2x Coins", neonPack = "Neon Pack" },
