				<string name="Name">Server</string>
			</Properties>
			<Item class="Script" referent="RBX00000000000000000000000000000011">
				<Properties>
					<string name="Name">Main</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Server entry point (GDD G11): builds the world, creates the remotes, starts services in
-- dependency order, loads players and routes client requests.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared.Catalog)
local Config = require(Shared.Config)
local Formulas = require(Shared.Formulas)
local Remotes = require(Shared.Remotes)

local Server = script.Parent
local Services = Server:WaitForChild("services")
local WorldBuilder = require(Server:WaitForChild("WorldBuilder") :: any)
local AnalyticsService = require(Services:WaitForChild("AnalyticsService") :: any)
local ArenaService = require(Services:WaitForChild("ArenaService") :: any)
local BadgeService = require(Services:WaitForChild("BadgeService") :: any)
local BotService = require(Services:WaitForChild("BotService") :: any)
local DataService = require(Services:WaitForChild("DataService") :: any)
local EconomyService = require(Services:WaitForChild("EconomyService") :: any)
local LeaderboardService = require(Services:WaitForChild("LeaderboardService") :: any)
local MonetizationService = require(Services:WaitForChild("MonetizationService") :: any)
local RewardService = require(Services:WaitForChild("RewardService") :: any)
local ShopService = require(Services:WaitForChild("ShopService") :: any)
local UpgradeService = require(Services:WaitForChild("UpgradeService") :: any)

local PROFILE_PERIOD = 0.25 -- 4 Hz ProfileUpdate throttle
local MAX_ARGS = 4
local MAX_STRING = 64
local RESPAWN_TIME = 0.5
local FUNNEL_MINUTE_10 = 600 -- seconds, GDD G12 funnel
local SETTINGS = { music = true, sfx = true, shake = true, lowDetail = true }

-- 1. world and remotes ---------------------------------------------------------------------------

WorldBuilder.build()

local remoteFolder = Instance.new("Folder")
remoteFolder.Name = Remotes.Folder
for key, value in Remotes :: any do
	if type(value) == "string" and key ~= "Folder" and key ~= "Request" then
		local ev = Instance.new("RemoteEvent")
		ev.Name = value
		ev.Parent = remoteFolder
	end
end
local requestFn = Instance.new("RemoteFunction")
requestFn.Name = Remotes.Request
requestFn.Parent = remoteFolder
remoteFolder.Parent = ReplicatedStorage

local profileRemote = remoteFolder:FindFirstChild(Remotes.ProfileUpdate) :: RemoteEvent

Players.RespawnTime = RESPAWN_TIME

-- 2. services --------------------------------------------------------------------------------------

DataService.start()
EconomyService.start()
ShopService.start()
MonetizationService.start()
RewardService.start()
LeaderboardService.start()
ArenaService.start()
BotService.start()

-- 3. profile replication ---------------------------------------------------------------------------

local joinedAt: { [Player]: number } = {}
local coinsEarned: { [Player]: number } = {}
local dirty: { [Player]: boolean } = {}

local function sessionInfo(player: Player): { [string]: any }
	local passes: { [string]: boolean } = {}
	for key in Config.Ids.Passes do
		passes[key] = EconomyService.hasPass(player, key)
	end
	return {
		multiplier = EconomyService.multiplier(player),
		passes = passes,
		featured = Catalog.featured(Formulas.dayNumber(os.time())),
		joinedAt = joinedAt[player] or os.time(),
		playtimeClaimed = RewardService.playtimeClaimed(player),
		starterOffer = MonetizationService.shouldOfferStarter(player),
		serverTime = os.time(),
	}
end

local function sendProfile(player: Player)
	local profile = DataService.get(player)
	if profile == nil or player.Parent == nil then
		return
	end
	local copy = table.clone(profile) :: any
	copy.receipts = nil
	profileRemote:FireClient(player, { profile = copy, session = sessionInfo(player) })
end

DataService.changed:Connect(function(player: Player)
	dirty[player] = true
end)

task.spawn(function()
	while true do
		task.wait(PROFILE_PERIOD)
		local list: { Player } = {}
		for player in dirty do
			table.insert(list, player)
		end
		table.clear(dirty)
		for _, player in list do
			local ok, err = pcall(sendProfile, player)
			if not ok then
				warn("[Main] ProfileUpdate failed:", err)
			end
		end
	end
end)

EconomyService.granted:Connect(function(player: Player, currency: string, amount: number)
	if currency == "coins" then
		coinsEarned[player] = (coinsEarned[player] or 0) + amount
	end
end)

-- Leaderboard stand (WorldBuilder's LeaderboardStand): title + top 10 of the "cells" board. Rows are built
-- once; names resolve asynchronously, cached per userId ("Player" until known).
local STAND_BOARD = "cells"
local STAND_ROWS = 10
local standRows: { { rank: TextLabel, name: TextLabel, value: TextLabel } }? = nil
local nameCache: { [number]: string } = {}
local nameResolving: { [number]: boolean } = {}

local function standLabel(parent: Instance, pos: UDim2, size: UDim2, align: Enum.TextXAlignment, color: Color3): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Position, l.Size = pos, size
	l.Font = Enum.Font.GothamBold
	l.TextScaled = true
	l.TextXAlignment = align
	l.TextColor3 = color
	l.Text = ""
	l.Parent = parent
	return l
end

local function buildStand(): { { rank: TextLabel, name: TextLabel, value: TextLabel } }?
	local node: Instance? = workspace
	for _, name in { "World", "Decor", "Props", "LeaderboardStand", "BoardPanel", "BoardGui", "Board" } do
		node = if node ~= nil then node:FindFirstChild(name) else nil
	end
	local board = node
	if board == nil or not board:IsA("Frame") then
		return nil
	end
	local white, yellow = Color3.fromHex(Config.Colors.UiLight), Color3.fromHex(Config.Colors.Yellow)
	local title = standLabel(board, UDim2.fromScale(0.05, 0.02), UDim2.fromScale(0.9, 0.1), Enum.TextXAlignment.Center, yellow)
	title.Text = "TOP PLAYERS - CELLS CAPTURED"
	local rows = {}
	local rowH = 0.8 / STAND_ROWS
	for i = 1, STAND_ROWS do
		local y = 0.15 + (i - 1) * rowH
		rows[i] = {
			rank = standLabel(board, UDim2.fromScale(0.05, y), UDim2.fromScale(0.1, rowH * 0.85), Enum.TextXAlignment.Left, yellow),
			name = standLabel(board, UDim2.fromScale(0.17, y), UDim2.fromScale(0.5, rowH * 0.85), Enum.TextXAlignment.Left, white),
			value = standLabel(board, UDim2.fromScale(0.68, y), UDim2.fromScale(0.27, rowH * 0.85), Enum.TextXAlignment.Right, white),
		}
	end
	return rows
end

local function renderStand()
	if standRows == nil then
		standRows = buildStand()
	end
	local rows = standRows
	if rows == nil then
		return
	end
	local entries = LeaderboardService.top(STAND_BOARD)
	for i, row in rows do
		local e = entries[i]
		if e == nil then
			row.rank.Text, row.name.Text, row.value.Text = "", "", ""
		else
			row.rank.Text = "#" .. i
			row.name.Text = nameCache[e.userId] or "Player"
			row.value.Text = tostring(e.value)
			if nameCache[e.userId] == nil and not nameResolving[e.userId] then
				nameResolving[e.userId] = true
				task.spawn(function()
					local ok, name = pcall(function()
						return Players:GetNameFromUserIdAsync(e.userId)
					end)
					nameResolving[e.userId] = nil
					if ok and type(name) == "string" then
						nameCache[e.userId] = name
						renderStand()
					end
				end)
			end
		end
	end
end

local function updateLeaderboardStand(board: string, _entries: { any })
	if board == STAND_BOARD then
		renderStand()
	end
end
LeaderboardService.changed:Connect(updateLeaderboardStand)
renderStand()

MonetizationService.onProductBought = function(player: Player, productKey: string, robux: number)
	AnalyticsService.log(player, "product_bought", { id = productKey, robux = robux })
	if productKey == "starterPack" then
		AnalyticsService.log(player, "offer_bought", { id = productKey })
	end
end

-- 4. request router ---------------------------------------------------------------------------------

type Handler = (Player, ...any) -> (boolean, any)

local handlers: { [string]: Handler } = {
	BuyUpgrade = function(player: Player, upgradeId: any): (boolean, any)
		local ok, result = UpgradeService.buy(player, upgradeId)
		if ok then
			ArenaService.refreshWalkSpeed(player)
			AnalyticsService.log(player, "upgrade_buy", { id = upgradeId, level = result.level })
			AnalyticsService.funnelOnce(player, 3, "first_upgrade")
		end
		return ok, result
	end,
	BuyItem = function(player: Player, itemId: any): (boolean, any)
		local ok, result = ShopService.buyItem(player, itemId)
		if ok then
			AnalyticsService.log(player, "item_buy", { id = itemId, currency = result.currency })
		end
		return ok, result
	end,
	Equip = function(player: Player, itemId: any): (boolean, any)
		return ShopService.equip(player, itemId)
	end,
	ClaimDaily = function(player: Player): (boolean, any)
		local ok, result = RewardService.claimDaily(player)
		if ok then
			AnalyticsService.log(player, "daily_claim", { day = result.streak })
			if result.streak >= #Catalog.daily then
				BadgeService.award(player, "streak7")
			end
		end
		return ok, result
	end,
	ClaimPlaytime = function(player: Player, index: any): (boolean, any)
		return RewardService.claimPlaytime(player, index)
	end,
	ClaimQuest = function(player: Player, index: any): (boolean, any)
		local ok, result = RewardService.claimQuest(player, index)
		if ok then
			AnalyticsService.log(player, "quest_claim", { id = result.id })
		end
		return ok, result
	end,
	RedeemCode = function(player: Player, code: any): (boolean, any)
		local ok, result = RewardService.redeemCode(player, code)
		if ok then
			AnalyticsService.log(player, "code_redeem", { code = code })
		end
		return ok, result
	end,
	Rebirth = function(player: Player): (boolean, any)
		local ok, result = UpgradeService.rebirth(player)
		if ok then
			ArenaService.refreshWalkSpeed(player)
			LeaderboardService.submit(player, "crowns", result.crowns)
			BadgeService.award(player, "firstRebirth")
			AnalyticsService.log(player, "rebirth", { count = result.crowns })
		end
		return ok, result
	end,
	Respawn = function(player: Player): (boolean, any)
		return ArenaService.respawn(player)
	end,
	DeclineSecondChance = function(player: Player): (boolean, any)
		return ArenaService.declineSecondChance(player)
	end,
	SetSetting = function(player: Player, key: any, value: any): (boolean, any)
		if type(key) ~= "string" or SETTINGS[key] == nil or type(value) ~= "boolean" then
			return false, "bad_args"
		end
		if DataService.get(player) == nil then
			return false, "no_profile"
		end
		DataService.update(player, function(p)
			(p.settings :: any)[key] = value
		end)
		return true, value
	end,
	TutorialDone = function(player: Player): (boolean, any)
		if DataService.get(player) == nil then
			return false, "no_profile"
		end
		DataService.update(player, function(p)
			p.tutorialDone = true
		end)
		AnalyticsService.log(player, "tutorial_step", { n = "done" })
		return true, nil
	end,
	-- Client startup ping: the router below already re-sends the snapshot on a player's first Request.
	Ready = function(_player: Player): (boolean, any)
		return true, nil
	end,
	StarterOfferSeen = function(player: Player): (boolean, any)
		MonetizationService.markStarterOfferSeen(player)
		AnalyticsService.log(player, "offer_shown", { id = "starterPack" })
		return true, nil
	end,
}

local buckets: { [Player]: { tokens: number, last: number } } = {}
local readySent: { [Player]: boolean } = {}

local function allowRequest(player: Player): boolean
	local now = os.clock()
	local rate = Config.Security.RequestsPerSecond
	local b = buckets[player]
	if b == nil then
		b = { tokens = rate, last = now }
		buckets[player] = b
	end
	local bucket = b :: { tokens: number, last: number }
	bucket.tokens = math.min(rate, bucket.tokens + (now - bucket.last) * rate)
	bucket.last = now
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

local function validArg(a: any): boolean
	local t = type(a)
	if t == "string" then
		return #a <= MAX_STRING
	end
	return t == "nil" or t == "boolean" or t == "number"
end

requestFn.OnServerInvoke = function(player: Player, name: any, ...: any): (boolean, any)
	if type(name) ~= "string" or (Remotes.Requests :: any)[name] ~= name or handlers[name] == nil then
		return false, "bad_request"
	end
	if not allowRequest(player) then
		return false, "rate_limited"
	end
	local n = select("#", ...)
	if n > MAX_ARGS then
		return false, "bad_args"
	end
	local args = { ... }
	for i = 1, n do
		if not validArg(args[i]) then
			return false, "bad_args"
		end
	end
	-- The first Request proves the client's listeners are connected: (re)send the arena snapshot.
	if not readySent[player] then
		readySent[player] = true
		ArenaService.clientReady(player)
	end
	local ok, result, extra = pcall(handlers[name], player, table.unpack(args, 1, n))
	if not ok then
		warn("[Main] request " .. name .. " failed:", result)
		return false, "server_error"
	end
	return result, extra
end

-- 5. players ---------------------------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	joinedAt[player] = os.time()
	coinsEarned[player] = 0
	local profile = DataService.load(player)
	if profile == nil or player.Parent == nil then
		return
	end
	ShopService.reconcile(player)
	sendProfile(player)
	ArenaService.join(player)
	AnalyticsService.log(player, "session_start")
	AnalyticsService.funnelOnce(player, 1, "join")
	task.delay(FUNNEL_MINUTE_10, function()
		if player.Parent ~= nil then
			AnalyticsService.funnelOnce(player, 6, "minute_10")
		end
	end)
end

Players.PlayerAdded:Connect(function(player: Player)
	task.spawn(onPlayerAdded, player)
end)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player: Player)
	ArenaService.leave(player)
	local joined = joinedAt[player]
	if joined ~= nil then
		AnalyticsService.log(player, "session_end", { seconds = os.time() - joined, coinsEarned = coinsEarned[player] or 0 })
	end
	joinedAt[player] = nil
	coinsEarned[player] = nil
	dirty[player] = nil
	buckets[player] = nil
	readySent[player] = nil
	DataService.release(player)
end)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000000000000000000000000000012">
				<Properties>
					<string name="Name">WorldBuilder</string>
					<ProtectedString name="Source"><![CDATA[--!strict
local Lighting = game:GetService("Lighting")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local WorldBuilder = {}

local HALF = Config.Arena.GridSize * Config.Arena.CellSize / 2
local FLOOR_Y = Config.Arena.FloorY
local WALL_H, WALL_T = 12, 4

function WorldBuilder.hex(str: string): Color3
	return Color3.fromHex(str)
end

local function makePart(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, props: { [string]: any }?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for k, v in props do
			(p :: any)[k] = v
		end
	end
	p.Parent = parent
	return p
end

local function ball(parent: Instance, name: string, diameter: number, pos: Vector3, color: Color3, props: { [string]: any }?): Part
	local p = makePart(parent, name, Vector3.new(diameter, diameter, diameter), CFrame.new(pos), color, props)
	p.Shape = Enum.PartType.Ball
	return p
end

-- Cylinders extend along X, so rotate to stand them upright.
local function pillar(parent: Instance, name: string, height: number, diameter: number, pos: Vector3, color: Color3): Part
	local p = makePart(parent, name, Vector3.new(height, diameter, diameter), CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2), color)
	p.Shape = Enum.PartType.Cylinder
	return p
end

local function folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function buildFloor(root: Folder)
	local f = folder(root, "Arena")
	local size = Config.Arena.GridSize * Config.Arena.CellSize
	local floor = makePart(f, "Floor", Vector3.new(size, 2, size), CFrame.new(0, FLOOR_Y - 1, 0), WorldBuilder.hex(Config.Colors.Ground))
	floor.TopSurface = Enum.SurfaceType.Smooth
	local lineColor = WorldBuilder.hex(Config.Colors.GridLine)
	local step = 8 * Config.Arena.CellSize
	local lines = folder(f, "GridLines")
	for i = 0, Config.Arena.GridSize / 8 do
		local offset = -HALF + i * step
		local common = { CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false }
		makePart(lines, "LineX", Vector3.new(size, 0.05, 0.4), CFrame.new(0, FLOOR_Y + 0.025, offset), lineColor, common)
		makePart(lines, "LineZ", Vector3.new(0.4, 0.05, size), CFrame.new(offset, FLOOR_Y + 0.025, 0), lineColor, common)
	end
end

local function buildWalls(root: Folder)
	local f = folder(root, "Walls")
	local color = WorldBuilder.hex(Config.Colors.Wall)
	local len = HALF * 2 + WALL_T * 2
	local c = HALF + WALL_T / 2
	local specs = {
		{ "North", Vector3.new(len, WALL_H, WALL_T), Vector3.new(0, 0, -c) },
		{ "South", Vector3.new(len, WALL_H, WALL_T), Vector3.new(0, 0, c) },
		{ "East", Vector3.new(WALL_T, WALL_H, len), Vector3.new(c, 0, 0) },
		{ "West", Vector3.new(WALL_T, WALL_H, len), Vector3.new(-c, 0, 0) },
	}
	for _, s in specs do
		local size = s[2] :: Vector3
		local pos = s[3] :: Vector3
		makePart(f, (s[1] :: string) .. "Wall", size, CFrame.new(pos + Vector3.new(0, FLOOR_Y + WALL_H / 2, 0)), color)
		local cs = Vector3.new(size.X, 60, size.Z)
		makePart(f, (s[1] :: string) .. "Collider", cs, CFrame.new(pos + Vector3.new(0, FLOOR_Y + WALL_H + 30, 0)), color, {
			Transparency = 1,
			CanQuery = false,
			CastShadow = false,
		})
	end

	local towers = folder(f, "Towers")
	local accent = WorldBuilder.hex(Config.Colors.Yellow)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local model = Instance.new("Model")
			model.Name = "CornerTower"
			model:SetAttribute("Placeholder", "M2")
			local bx, bz = sx * (HALF + WALL_T), sz * (HALF + WALL_T)
			makePart(model, "Base", Vector3.new(14, 6, 14), CFrame.new(bx, FLOOR_Y + 3, bz), color)
			pillar(model, "Shaft", 14, 9, Vector3.new(bx, FLOOR_Y + 13, bz), color)
			makePart(model, "Cap", Vector3.new(12, 3, 12), CFrame.new(bx, FLOOR_Y + 21.5, bz), color)
			ball(model, "Beacon", 5, Vector3.new(bx, FLOOR_Y + 25.5, bz), accent)
			model.Parent = towers
		end
	end
end

local function ringPos(rng: Random, minR: number, maxR: number): Vector3
	-- Sample outside the walls (square ring) by rejection.
	local limit = HALF + WALL_T + 14
	for _ = 1, 50 do
		local x = rng:NextNumber(-maxR, maxR)
		local z = rng:NextNumber(-maxR, maxR)
		if math.max(math.abs(x), math.abs(z)) > limit and math.max(math.abs(x), math.abs(z)) > minR then
			return Vector3.new(x, FLOOR_Y, z)
		end
	end
	return Vector3.new(maxR, FLOOR_Y, maxR)
end

local function buildDecor(root: Folder)
	local rng = Random.new(20240601)
	local greens = { Color3.fromHex("#4ADE80"), Color3.fromHex("#2DB86A"), Color3.fromHex("#B6E33B") }
	local rockColors = { Color3.fromHex("#9AA3B5"), Color3.fromHex("#6B7A99"), Color3.fromHex("#B8C0D0") }

	local trees = folder(root, "Trees")
	for _ = 1, 40 do
		local pos = ringPos(rng, 0, 560)
		local h = rng:NextNumber(10, 18)
		local model = Instance.new("Model")
		model.Name = "Tree"
		model:SetAttribute("Placeholder", "M4")
		pillar(model, "Trunk", h, 3, pos + Vector3.new(0, h / 2, 0), Color3.fromHex("#A0704A"))
		local g = greens[rng:NextInteger(1, #greens)]
		local d = h * 0.9
		ball(model, "LeavesLow", d, pos + Vector3.new(0, h + d * 0.2, 0), g)
		ball(model, "LeavesHigh", d * 0.65, pos + Vector3.new(0, h + d * 0.75, 0), g)
		model.Parent = trees
	end

	local rocks = folder(root, "Rocks")
	for _ = 1, 25 do
		local pos = ringPos(rng, 0, 560)
		local s = rng:NextNumber(3, 8)
		local r = makePart(rocks, "Rock", Vector3.new(s, s * 0.7, s * rng:NextNumber(0.8, 1.3)),
			CFrame.new(pos + Vector3.new(0, s * 0.25, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0),
			rockColors[rng:NextInteger(1, #rockColors)], { Material = Enum.Material.Slate })
		r:SetAttribute("Placeholder", "M5")
	end

	local clouds = folder(root, "Clouds")
	local white = Color3.new(1, 1, 1)
	for _ = 1, 12 do
		local model = Instance.new("Model")
		model.Name = "Cloud"
		model:SetAttribute("Placeholder", "M6")
		local c = Vector3.new(rng:NextNumber(-600, 600), rng:NextNumber(90, 140), rng:NextNumber(-600, 600))
		for _ = 1, rng:NextInteger(4, 5) do
			ball(model, "Puff", rng:NextNumber(18, 34), c + Vector3.new(rng:NextNumber(-22, 22), rng:NextNumber(-3, 3), rng:NextNumber(-10, 10)), white, {
				CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
			})
		end
		model.Parent = clouds
	end
end

local function buildProps(root: Folder)
	local f = folder(root, "Props")
	local dark = WorldBuilder.hex(Config.Colors.UiDark)
	local yellow = WorldBuilder.hex(Config.Colors.Yellow)
	local pink = WorldBuilder.hex(Config.Colors.Pink)
	local out = HALF + 50

	local kiosk = Instance.new("Model")
	kiosk.Name = "ShopKiosk"
	kiosk:SetAttribute("Placeholder", "M7")
	makePart(kiosk, "Counter", Vector3.new(12, 6, 8), CFrame.new(-30, FLOOR_Y + 3, out), pink)
	makePart(kiosk, "Roof", Vector3.new(15, 1.5, 11), CFrame.new(-30, FLOOR_Y + 12, out), yellow)
	for _, dx in { -6, 6 } do
		makePart(kiosk, "Post", Vector3.new(1, 6, 1), CFrame.new(-30 + dx, FLOOR_Y + 9, out + 4), dark)
	end
	kiosk.Parent = f

	local stand = Instance.new("Model")
	stand.Name = "LeaderboardStand"
	stand:SetAttribute("Placeholder", "M8")
	-- Just outside the north wall, raised above it, facing the arena centre (+Z): the Back face is visible from inside.
	local boardW, boardH, boardLift = 48, 24, 2
	local northZ = -(HALF + WALL_T + 6)
	local boardY = FLOOR_Y + WALL_H + boardLift + boardH / 2
	makePart(stand, "Post", Vector3.new(2, boardY - FLOOR_Y, 2), CFrame.new(0, FLOOR_Y + (boardY - FLOOR_Y) / 2, northZ - 1.5), dark)
	local panel = makePart(stand, "BoardPanel", Vector3.new(boardW, boardH, 1), CFrame.new(0, boardY, northZ), dark)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "BoardGui"
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 50
	gui.Parent = panel
	local board = Instance.new("Frame")
	board.Name = "Board"
	board.Size = UDim2.fromScale(1, 1)
	board.BackgroundColor3 = dark
	board.BorderSizePixel = 0
	board.Parent = gui
	stand.Parent = f

	local chest = Instance.new("Model")
	chest.Name = "RewardChest"
	chest:SetAttribute("Placeholder", "M11")
	makePart(chest, "Box", Vector3.new(6, 4, 4), CFrame.new(0, FLOOR_Y + 2, out), yellow)
	makePart(chest, "Lid", Vector3.new(6.4, 1.5, 4.4), CFrame.new(0, FLOOR_Y + 4.75, out), pink)
	makePart(chest, "Lock", Vector3.new(1, 1.5, 0.5), CFrame.new(0, FLOOR_Y + 3.5, out - 2.2), dark)
	chest.Parent = f
end

local function buildLighting()
	-- Lighting.Technology (Future) is not scriptable; set it in Studio.
	Lighting.ClockTime = 14
	Lighting.Brightness = 2.5
	Lighting.Ambient = Color3.fromHex("#8A93A8")
	Lighting.OutdoorAmbient = Color3.fromHex("#B8C0D0")
	Lighting.GlobalShadows = true

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "TurfColorCorrection"
	cc.Saturation = 0.15
	cc.Contrast = 0.05
	cc.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Name = "TurfBloom"
	bloom.Intensity = 0.4
	bloom.Threshold = 1.2
	bloom.Size = 24
	bloom.Parent = Lighting

	local atmo = Instance.new("Atmosphere")
	atmo.Name = "TurfAtmosphere"
	atmo.Density = 0.25
	atmo.Color = Color3.fromHex("#CFE3FF")
	atmo.Decay = Color3.fromHex("#B8D0F0")
	atmo.Glare = 0
	atmo.Haze = 1
	atmo.Parent = Lighting
end

function WorldBuilder.build()
	local old = workspace:FindFirstChild("World")
	if old then
		old:Destroy()
	end
	local root = Instance.new("Folder")
	root.Name = "World"
	buildFloor(root)
	buildWalls(root)
	local decor = folder(root, "Decor")
	buildDecor(decor)
	buildProps(decor)
	root.Parent = workspace
	buildLighting()
end

return WorldBuilder
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Folder" referent="RBX00000000000000000000000000000013">
				<Properties>
					<string name="Name">services</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX00000000000000000000000000000014">
					<Properties>
						<string name="Name">AnalyticsService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Analytics = {}

local CUSTOM_KEYS = { "CustomField01", "CustomField02", "CustomField03" }

function Analytics.log(player: Player?, event: string, fields: { [string]: any }?)
	if player == nil then
		return
	end
	local target: Player = player
	local payload: { [string]: string }? = nil
	if fields ~= nil then
		-- Roblox only accepts Enum.AnalyticsCustomFieldKeys names (CustomField01..03) as keys;
		-- field names are sorted so each event maps them to the same slot every time.
		local names: { string } = {}
		for key in pairs(fields) do
			table.insert(names, key)
		end
		table.sort(names)
		local out: { [string]: string } = {}
		for i = 1, math.min(#names, #CUSTOM_KEYS) do
			out[CUSTOM_KEYS[i]] = tostring(fields[names[i]])
		end
		payload = out
	end
	local ok = pcall(function()
		game:GetService("AnalyticsService"):LogCustomEvent(target, event, 1, payload)
	end)
	if not ok and payload ~= nil then
		pcall(function()
			game:GetService("AnalyticsService"):LogCustomEvent(target, event, 1)
		end)
	end
end

function Analytics.funnel(player: Player, step: number, name: string)
	pcall(function()
		game:GetService("AnalyticsService"):LogOnboardingFunnelStepEvent(player, step, name)
	end)
end

-- Funnel step logged at most once per player per session (GDD G12: join, first capture, first upgrade,
-- first death, respawn, minute 10).
local funnelSeen: { [Player]: { [number]: boolean } } = {}

function Analytics.funnelOnce(player: Player, step: number, name: string)
	local seen = funnelSeen[player]
	if seen == nil then
		seen = {}
		funnelSeen[player] = seen
	end
	local set = seen :: { [number]: boolean }
	if set[step] then
		return
	end
	set[step] = true
	Analytics.funnel(player, step, name)
end

game:GetService("Players").PlayerRemoving:Connect(function(player: Player)
	funnelSeen[player] = nil
end)

return Analytics
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000000000000000000000000000015">
					<Properties>
						<string name="Name">ArenaService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Authoritative arena (GDD G2, G11.6): owns the ArenaSim, reads character positions on a fixed
-- tick, applies movement checks, pays out sim events and replicates state. See docs/API_arena.md.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ArenaSim = require(Shared.ArenaSim)
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Types = require(Shared.Types)

local AnalyticsService = require(script.Parent.AnalyticsService)
local BadgeService = require(script.Parent.BadgeService)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local LeaderboardService = require(script.Parent.LeaderboardService)
local MonetizationService = require(script.Parent.MonetizationService)
local RewardService = require(script.Parent.RewardService)
local ShopService = require(script.Parent.ShopService)
local UpgradeService = require(script.Parent.UpgradeService)

type RunnerInfo = Types.RunnerInfo
type ArenaEvent = Types.ArenaEvent
type Runner = ArenaSim.Runner
type Cell = { x: number, y: number }

type PState = {
	player: Player,
	joinClock: number,
	id: number, -- 0 = no runner
	character: Model?,
	hrp: BasePart?,
	humanoid: Humanoid?,
	connections: { RBXScriptConnection },
	charConnections: { RBXScriptConnection },
	walkSpeed: number,
	prevWalkSpeed: number,
	speedGraceUntil: number,
	lastPos: Vector3?,
	lastTime: number,
	overTicks: number,
	strikes: { number },
	exemptUntil: number,
	settleTarget: Vector3?,
	settleTries: number,
	deathTime: number,
	lifeStart: number,
	lifeCoins: number,
	lifeKills: number,
	pendingUntil: number?,
	secondChanceUsed: boolean,
	respawning: boolean,
	autoRespawn: boolean, -- cut without a Second Chance offer: respawn after RespawnDelay without a request
	kingAccum: number,
	ready: boolean,
}

local STEP = 1 / Config.Arena.TickRate
local DELTA_PERIOD = 1 / Config.Arena.DeltaRate
local CELL = Config.Arena.CellSize
local HALF = Config.Arena.GridSize * CELL / 2
local FLOOR_Y = Config.Arena.FloorY

local MAX_CATCHUP_STEPS = 5
-- After a server teleport the client keeps reporting its old position for a few frames.
local TELEPORT_EXEMPT = 0.5
local SETTLE_RADIUS = 2 * CELL
local SETTLE_RETRIES = 5
local SPEED_SLACK = 1 -- studs per check, absorbs replication jitter
local SPEED_DROP_GRACE = 1 -- seconds the old speed stays allowed after WalkSpeed drops (client lag)
local MAX_SPEED_WINDOW = 1 -- caps the allowance after a long stand-still
local BELOW_FLOOR = 6
local ABOVE_FLOOR = 20
-- Cut players wait anchored under the floor; the chase camera then still sits above the arena.
local HIDE_DEPTH = 20
-- Seconds the victim's turf is held after the prompt. A purchase in flight cannot be detected (the client
-- opens the dialog), so this stays generous.
local SECOND_CHANCE_GRACE = 12
local ZERO_TURF_RECYCLE = 2
local IDLE_RESPAWN = 30 -- server respawns a released player who never sent Respawn
local CHARACTER_WAIT = 10
local MAP_BADGES = { { pct = 10, key = "map10" }, { pct = 50, key = "map50" } }

local ArenaService = {}

local rng = Random.new()
local sim = ArenaSim.new({
	rng = function(): number
		return rng:NextNumber()
	end,
})

ArenaService.sim = sim
-- Bot target positions in cell units (floored by the sim), written by BotService in preStep.
ArenaService.botPositions = {} :: { [number]: Cell }
-- Single hook run at the start of every sim tick, before positions are read (BotService).
ArenaService.preStep = nil :: ((now: number, dt: number) -> ())?

local eventListeners: { (ArenaEvent) -> () } = {}
-- Callbacks run synchronously, in order, for every drained sim event (after ArenaService handled it).
ArenaService.onEvent = {
	Connect = function(_self: any, fn: (ArenaEvent) -> ())
		table.insert(eventListeners, fn)
		return {
			Disconnect = function()
				local i = table.find(eventListeners, fn)
				if i then
					table.remove(eventListeners, i)
				end
			end,
		}
	end,
}

local states: { [Player]: PState } = {}
local playerById: { [number]: PState } = {}
local orphans: { [number]: boolean } = {} -- runners of players who left, removed after LeaveNeutralDelay
local zeroSince: { [number]: number } = {}
local remotes: { [string]: RemoteEvent } = {}
local started = false

function ArenaService.now(): number
	return os.clock()
end

local function remote(name: string): RemoteEvent
	local r = remotes[name]
	if r == nil then
		local folder = ReplicatedStorage:WaitForChild(Remotes.Folder)
		r = folder:WaitForChild(name) :: RemoteEvent
		remotes[name] = r
	end
	return r :: RemoteEvent
end

-- Only clients that have received a snapshot get incremental updates.
local function broadcast(name: string, ...: any)
	local r = remote(name)
	for player, st in states do
		if st.ready and player.Parent ~= nil then
			r:FireClient(player, ...)
		end
	end
end

local function liveInfos(): { RunnerInfo }
	local out = {}
	for _, r in sim:runners() do
		if r.alive or r.pending then
			table.insert(out, r.info)
		end
	end
	return out
end

function ArenaService.freeColorIndex(): number
	local used: { [number]: boolean } = {}
	local runners = sim:runners()
	for _, r in runners do
		used[r.info.colorIndex] = true
	end
	local n = #Config.Colors.Players
	for i = 1, n do
		if not used[i] then
			return i
		end
	end
	return 1 + #runners % n
end

-- Player runner ids whose session is still inside the bots' gentle window (GDD G7.6).
function ArenaService.gentleRunnerIds(now: number): { number }
	local out = {}
	for id, st in playerById do
		if now - st.joinClock < Config.Bots.GentleSeconds then
			table.insert(out, id)
		end
	end
	return out
end

-- replication --------------------------------------------------------------------------------

local function flushDeltas()
	local changes = sim:drainCellChanges()
	local trails = sim:drainTrailDeltas()
	if #changes > 0 or #trails > 0 then
		broadcast(Remotes.ArenaDelta, sim.grid:encodeIndices(changes), trails)
	end
end

local function sendSnapshot(player: Player)
	local st = states[player]
	if st == nil then
		return
	end
	-- Flush first so deltas already queued are not re-applied on top of the snapshot's trails.
	flushDeltas()
	remote(Remotes.ArenaSnapshot):FireClient(player, sim.grid:encodeRLE(), liveInfos(), if st.id ~= 0 then st.id else nil)
	local trails = {}
	for _, r in sim:runners() do
		if r.alive or r.pending then
			table.insert(trails, { id = r.id, clear = true, append = table.clone(r.trail) })
		end
	end
	remote(Remotes.ArenaDelta):FireClient(player, sim.grid:encodeIndices({}), trails)
	st.ready = true
end

-- Called by the request router on a client's first Request (its UI is listening by then).
function ArenaService.clientReady(player: Player)
	if states[player] ~= nil then
		sendSnapshot(player)
	end
end

-- characters ---------------------------------------------------------------------------------

local function cellCFrame(st: PState, cx: number, cy: number): CFrame
	local wx, wz = sim.grid:cellToWorld(cx, cy)
	local lift = 3
	local hrp, humanoid = st.hrp, st.humanoid
	if hrp ~= nil and humanoid ~= nil then
		lift = math.max(humanoid.HipHeight, 2) + hrp.Size.Y / 2 + 0.5
	end
	return CFrame.new(wx, FLOOR_Y + lift, wz)
end

local function teleport(st: PState, target: CFrame, now: number)
	local char, hrp = st.character, st.hrp
	if char == nil or hrp == nil then
		return
	end
	char:PivotTo(target)
	hrp.AssemblyLinearVelocity = Vector3.zero
	st.exemptUntil = now + TELEPORT_EXEMPT
	st.settleTarget = target.Position
	st.lastPos = nil
	st.overTicks = 0
end

local function placeAtCell(st: PState, cx: number, cy: number, now: number)
	local hrp, humanoid = st.hrp, st.humanoid
	if hrp == nil or humanoid == nil then
		return
	end
	hrp.Anchored = false
	humanoid.WalkSpeed = st.walkSpeed
	st.settleTries = 0
	teleport(st, cellCFrame(st, cx, cy), now)
	-- Anchoring (hideCharacter) drops network ownership; hand control back to the player.
	pcall(function()
		hrp:SetNetworkOwner(st.player)
	end)
end

local function hideCharacter(st: PState)
	local char, hrp, humanoid = st.character, st.hrp, st.humanoid
	if char == nil or hrp == nil or humanoid == nil then
		return
	end
	humanoid.WalkSpeed = 0
	hrp.Anchored = true
	local p = hrp.Position
	char:PivotTo(CFrame.new(p.X, FLOOR_Y - HIDE_DEPTH, p.Z))
	st.settleTarget = nil
	st.lastPos = nil
end

local function resetLife(st: PState, now: number)
	st.lifeStart = now
	st.lifeCoins = 0
	st.lifeKills = 0
	st.secondChanceUsed = false
	st.pendingUntil = nil
	st.respawning = false
	st.autoRespawn = false
	st.kingAccum = 0
	st.overTicks = 0
end

local function removePlayerRunner(st: PState, now: number)
	local id = st.id
	if id == 0 then
		return
	end
	st.id = 0
	st.pendingUntil = nil
	playerById[id] = nil
	zeroSince[id] = nil
	sim:removeRunner(id, now)
end

-- Gold DisplayName tag above the head for VIP players; removed when absent.
local function applyVipTag(st: PState)
	local head = if st.character ~= nil then st.character:FindFirstChild("Head") else nil
	if head == nil then
		return
	end
	local old = head:FindFirstChild("VipTag")
	if old ~= nil then
		old:Destroy()
	end
	if not EconomyService.hasPass(st.player, "vip") then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "VipTag"
	gui.Size = UDim2.fromOffset(200, 40)
	gui.StudsOffset = Vector3.new(0, 2.5, 0)
	gui.AlwaysOnTop = true
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = Color3.fromHex(Config.Colors.Yellow)
	label.TextStrokeTransparency = 0.4
	label.Text = st.player.DisplayName
	label.Parent = gui
	gui.Parent = head
end

-- Re-reads the VIP pass into RunnerInfo, refreshes the world tag and re-broadcasts (pass bought or loaded).
function ArenaService.refreshVip(player: Player)
	local st = states[player]
	if st == nil then
		return
	end
	applyVipTag(st)
	local r = if st.id ~= 0 then sim:runner(st.id) else nil
	if r ~= nil then
		r.info.vip = EconomyService.hasPass(player, "vip")
		broadcast(Remotes.RunnerInfo, liveInfos())
	end
end

local function addPlayerRunner(st: PState, now: number)
	local player = st.player
	local profile = DataService.get(player)
	if profile == nil or st.character == nil or st.id ~= 0 then
		return
	end
	local info: RunnerInfo = {
		id = 0,
		userId = player.UserId,
		name = player.DisplayName,
		colorIndex = ArenaService.freeColorIndex(),
		skin = profile.equipped.skin,
		trail = profile.equipped.trail,
		effect = profile.equipped.effect,
		isBot = false,
		vip = EconomyService.hasPass(player, "vip"),
	}
	local id = sim:addRunner(info, UpgradeService.startPatch(player), UpgradeService.shieldSeconds(player), now)
	st.id = id
	playerById[id] = st
	applyVipTag(st)
	st.walkSpeed = UpgradeService.walkSpeed(player)
	resetLife(st, now)
	local r = sim:runner(id)
	if r ~= nil then
		placeAtCell(st, r.x, r.y, now)
	end
	sendSnapshot(player)
end

local function onDied(st: PState)
	removePlayerRunner(st, os.clock())
	st.character, st.hrp, st.humanoid = nil, nil, nil
end

local function onCharacter(st: PState, char: Model)
	for _, c in st.charConnections do
		c:Disconnect()
	end
	table.clear(st.charConnections)
	st.character, st.hrp, st.humanoid = nil, nil, nil
	local player = st.player
	local humanoid = char:WaitForChild("Humanoid", CHARACTER_WAIT)
	local hrp = char:WaitForChild("HumanoidRootPart", CHARACTER_WAIT)
	if humanoid == nil or hrp == nil or not humanoid:IsA("Humanoid") or not hrp:IsA("BasePart") then
		return
	end
	local deadline = os.clock() + CHARACTER_WAIT
	while char.Parent == nil and os.clock() < deadline do
		task.wait()
		if player.Character ~= char or states[player] ~= st then
			return
		end
	end
	-- One frame so the engine's own spawn placement does not override our teleport.
	task.wait()
	if player.Character ~= char or states[player] ~= st or char.Parent == nil then
		return
	end
	local hum = humanoid :: Humanoid
	hum.JumpPower = 0
	hum.JumpHeight = 0
	st.character, st.hrp, st.humanoid = char, hrp :: BasePart, hum
	table.insert(
		st.charConnections,
		hum.Died:Connect(function()
			if st.character == char then
				onDied(st)
			end
		end)
	)
	local now = os.clock()
	removePlayerRunner(st, now) -- stale runner from a previous character, if any
	addPlayerRunner(st, now)
end

-- anti-exploit (G11.6) --------------------------------------------------------------------------

local function addStrike(st: PState, now: number)
	local strikes = st.strikes
	local i = 1
	while i <= #strikes do
		if now - strikes[i] > Config.Security.StrikeWindow then
			table.remove(strikes, i)
		else
			i += 1
		end
	end
	table.insert(strikes, now)
	if #strikes >= Config.Security.KickStrikes then
		st.player:Kick("Movement check failed. Please rejoin.")
	end
end

local function snapBack(st: PState, r: Runner, now: number)
	st.settleTries = 0
	teleport(st, cellCFrame(st, r.x, r.y), now)
end

-- G11.6: out of bounds sends the runner to the cell of its own turf nearest its last accepted cell
-- (its last cell when it owns nothing) and drops its trail.
local function outOfBounds(st: PState, r: Runner, now: number)
	local bx, by, bd = r.x, r.y, math.huge
	local x0, y0, x1, y1 = sim.grid:bounds(r.id)
	if x0 and y0 and x1 and y1 then
		local size = sim.size
		for y = y0, y1 do
			for x = x0, x1 do
				if sim.grid:getIndex(y * size + x) == r.id then
					local d = (x - r.x) ^ 2 + (y - r.y) ^ 2
					if d < bd then
						bx, by, bd = x, y, d
					end
				end
			end
		end
	end
	-- Move the sim position too, so the next step does not walk a line from the old cell.
	r.x, r.y = bx, by
	sim:clearTrail(r.id)
	snapBack(st, r, now)
end

local function speedAllowance(st: PState, now: number): number
	if now < st.speedGraceUntil then
		return math.max(st.walkSpeed, st.prevWalkSpeed)
	end
	return st.walkSpeed
end

-- Writes the runner's target cell into positions only when the movement is accepted.
local function readPlayer(st: PState, r: Runner, now: number, positions: { [number]: Cell })
	local hrp = st.hrp
	if hrp == nil or hrp.Parent == nil or hrp.Anchored then
		return
	end
	local pos = hrp.Position
	if now < st.exemptUntil then
		-- Once the client has been seen at the target the teleport has landed; the player may
		-- then walk away from it during the window without being pulled back.
		local t = st.settleTarget
		if t ~= nil then
			local tdx, tdz = pos.X - t.X, pos.Z - t.Z
			if tdx * tdx + tdz * tdz <= SETTLE_RADIUS * SETTLE_RADIUS then
				st.settleTarget = nil
			end
		end
		st.lastPos, st.lastTime = pos, now
		return
	end
	local target = st.settleTarget
	if target ~= nil then
		local dx, dz = pos.X - target.X, pos.Z - target.Z
		if dx * dx + dz * dz > SETTLE_RADIUS * SETTLE_RADIUS and st.settleTries < SETTLE_RETRIES then
			st.settleTries += 1
			teleport(st, CFrame.new(target), now)
			return
		end
		st.settleTarget = nil
		st.lastPos, st.lastTime = pos, now
	end
	if
		math.abs(pos.X) > HALF + CELL
		or math.abs(pos.Z) > HALF + CELL
		or pos.Y < FLOOR_Y - BELOW_FLOOR
		or pos.Y > FLOOR_Y + ABOVE_FLOOR
	then
		outOfBounds(st, r, now)
		return
	end
	local last = st.lastPos
	if last == nil then
		st.lastPos, st.lastTime = pos, now
		return
	end
	-- Compared against the last ACCEPTED position, so held ticks widen the allowance (lag-safe).
	local dx, dz = pos.X - last.X, pos.Z - last.Z
	local distSq = dx * dx + dz * dz
	if distSq < 1e-4 then
		-- No new replicated position (or standing still): keep lastTime so a replication stall
		-- followed by a catch-up burst is measured over the real elapsed time.
		st.overTicks = 0
		local cx, cy = sim.grid:worldToCell(pos.X, pos.Z)
		positions[r.id] = { x = cx, y = cy }
		return
	end
	local elapsed = math.min(now - st.lastTime, MAX_SPEED_WINDOW)
	local allowed = Config.Security.SpeedTolerance * speedAllowance(st, now) * elapsed + SPEED_SLACK
	if distSq > allowed * allowed then
		st.overTicks += 1
		if st.overTicks >= Config.Security.SpeedStrikeTicks then
			snapBack(st, r, now)
			addStrike(st, now)
		end
		return
	end
	st.overTicks = 0
	st.lastPos, st.lastTime = pos, now
	local cx, cy = sim.grid:worldToCell(pos.X, pos.Z)
	positions[r.id] = { x = cx, y = cy }
end

-- event handling -------------------------------------------------------------------------------

local function onClaim(e: any, now: number)
	local st = playerById[e.id]
	if st == nil then
		return
	end
	local player = st.player
	local coins = EconomyService.onCapture(player, e.neutral, e.stolen)
	st.lifeCoins += coins
	local pct = sim:share(e.id) * 100
	RewardService.progress(player, "cells", e.cells, "add")
	RewardService.progress(player, "bigCapture", e.cells, "max")
	RewardService.progress(player, "mapPct", pct, "max")
	local applied, firstCapture, totalCells, best = false, false, 0, 0
	DataService.update(player, function(p)
		applied = true
		firstCapture = p.stats.captures == 0
		p.stats.cells += e.cells
		p.stats.captures += 1
		if pct > p.stats.bestPct then
			p.stats.bestPct = pct
		end
		totalCells, best = p.stats.cells, p.stats.bestPct
	end)
	if applied then
		LeaderboardService.submit(player, "cells", totalCells)
		LeaderboardService.submit(player, "bestPct", best)
	end
	BadgeService.award(player, "firstLoop")
	for _, b in MAP_BADGES do
		if pct >= b.pct then
			BadgeService.award(player, b.key)
		end
	end
	remote(Remotes.Reward):FireClient(player, { coins = coins, reason = "capture", cx = e.cx, cy = e.cy })
	AnalyticsService.log(player, "capture", { cells = e.cells, stolen = e.stolen })
	AnalyticsService.funnelOnce(player, 2, "first_capture")
	if firstCapture then
		AnalyticsService.log(player, "first_capture", { seconds = math.floor(now - st.joinClock) })
	end
end

local function onCut(e: any, now: number)
	local victimRunner = sim:runner(e.victim)
	local killerRunner = sim:runner(e.killer)
	local victimWasBot = victimRunner ~= nil and victimRunner.info.isBot
	local killerWasBot = killerRunner ~= nil and killerRunner.info.isBot

	local ks = playerById[e.killer]
	if ks ~= nil then
		local player = ks.player
		local coins = EconomyService.onKill(player, e.victimCells, e.victimWasKing)
		ks.lifeCoins += coins
		ks.lifeKills += 1
		RewardService.progress(player, "kills", 1, "add")
		local kills: number? = nil
		DataService.update(player, function(p)
			p.stats.kills += 1
			kills = p.stats.kills
		end)
		if kills ~= nil then
			LeaderboardService.submit(player, "kills", kills)
		end
		BadgeService.award(player, "firstCut")
		remote(Remotes.Reward):FireClient(player, { coins = coins, reason = "kill" })
		AnalyticsService.log(player, "cut", { victimWasBot = victimWasBot })
	end

	local vs = playerById[e.victim]
	if vs == nil then
		-- Bots and runners of players who left: split their turf now (BotService also does this for bots).
		sim:releaseVictim(e.victim)
		return
	end
	local player = vs.player
	vs.deathTime = now
	DataService.update(player, function(p)
		p.stats.deaths += 1
	end)
	hideCharacter(vs)
	local canSecondChance = Config.Ids.Products.secondChance ~= 0
		and sim:share(e.victim) >= Config.Products.secondChance.MinMapShare
		and not vs.secondChanceUsed
	local lifeSeconds = math.floor(now - vs.lifeStart)
	remote(Remotes.Death):FireClient(player, {
		coins = vs.lifeCoins,
		cells = e.victimCells,
		lifeSeconds = lifeSeconds,
		kills = vs.lifeKills,
		canSecondChance = canSecondChance,
		killerName = if killerRunner ~= nil then killerRunner.info.name else nil,
	})
	AnalyticsService.log(player, "death", { cells = e.victimCells, lifeSeconds = lifeSeconds, killerWasBot = killerWasBot })
	AnalyticsService.funnelOnce(player, 4, "first_death")
	if canSecondChance then
		vs.pendingUntil = now + Config.Products.secondChance.PromptSeconds + SECOND_CHANCE_GRACE
	else
		vs.autoRespawn = true
		sim:releaseVictim(e.victim)
	end
end

local function onFullMap(e: any)
	local r = sim:runner(e.id)
	local st = playerById[e.id]
	if st ~= nil then
		EconomyService.onFullMap(st.player)
		BadgeService.award(st.player, "map100")
	end
	local name = if r ~= nil then r.info.name else "Someone"
	remote(Remotes.Toast):FireAllClients(name .. " captured the WHOLE map!", "good")
end

local function handleEvent(ev: ArenaEvent, now: number)
	local e = ev :: any
	if e.kind == "claim" then
		onClaim(e, now)
	elseif e.kind == "cut" then
		onCut(e, now)
	elseif e.kind == "king" then
		local st = playerById[e.id]
		if st ~= nil then
			BadgeService.award(st.player, "king")
		end
	elseif e.kind == "fullMap" then
		onFullMap(e)
	end
end

-- life cycle -----------------------------------------------------------------------------------

local function doRespawn(st: PState, now: number)
	local player = st.player
	st.pendingUntil = nil
	AnalyticsService.funnelOnce(player, 5, "respawn")
	sim:respawn(st.id, UpgradeService.startPatch(player), UpgradeService.shieldSeconds(player), now)
	st.walkSpeed = UpgradeService.walkSpeed(player)
	resetLife(st, now)
	local r = sim:runner(st.id)
	if r ~= nil then
		placeAtCell(st, r.x, r.y, now)
	end
end

-- Alive runners left with no turf and no trail can never claim again: give them a fresh patch.
-- The runner keeps its id and info (removeRunner then addRunner), so clients see despawn + spawn.
local function recycle(r: Runner, now: number)
	local id = r.id
	if orphans[id] then
		orphans[id] = nil
		sim:removeRunner(id, now)
		return
	end
	local st = playerById[id]
	local patch, shield = r.startPatch, Config.Arena.SpawnShield
	if st ~= nil then
		patch, shield = UpgradeService.startPatch(st.player), UpgradeService.shieldSeconds(st.player)
	end
	local info = r.info
	sim:removeRunner(id, now)
	info.id = id
	sim:addRunner(info, patch, shield, now)
	local nr = sim:runner(id)
	if st ~= nil and nr ~= nil then
		placeAtCell(st, nr.x, nr.y, now)
	end
end

local function housekeeping(now: number)
	local kingSt = playerById[sim:kingId()]
	if kingSt ~= nil then
		kingSt.kingAccum += STEP
		if kingSt.kingAccum >= 1 then
			kingSt.kingAccum -= 1
			RewardService.progress(kingSt.player, "kingSeconds", 1, "add")
			DataService.update(kingSt.player, function(p)
				p.stats.kingSeconds += 1
			end)
		end
	end

	for _, st in table.clone(playerById) do
		local r = sim:runner(st.id)
		if r ~= nil and not r.alive then
			local pendingUntil = st.pendingUntil
			if r.pending and pendingUntil ~= nil and now >= pendingUntil then
				st.pendingUntil = nil
				sim:releaseVictim(st.id)
			elseif
				not r.pending
				and not st.respawning
				and now - st.deathTime > (if st.autoRespawn then Config.Arena.RespawnDelay else IDLE_RESPAWN)
			then
				doRespawn(st, now)
			end
		end
	end

	for _, r in sim:runners() do
		if r.alive and #r.trail == 0 and sim:cellsOf(r.id) == 0 then
			local since = zeroSince[r.id]
			if since == nil then
				zeroSince[r.id] = now
			elseif now - since > ZERO_TURF_RECYCLE then
				zeroSince[r.id] = nil
				recycle(r, now)
			end
		else
			zeroSince[r.id] = nil
		end
	end
end

local function tick(now: number)
	local pre = ArenaService.preStep
	if pre ~= nil then
		local ok, err = pcall(pre, now, STEP)
		if not ok then
			warn("[ArenaService] preStep failed:", err)
		end
	end

	local positions: { [number]: Cell } = {}
	for id, p in ArenaService.botPositions do
		local r = sim:runner(id)
		if r ~= nil and r.info.isBot then
			positions[id] = p
		end
	end
	local list: { PState } = {}
	for _, st in states do
		table.insert(list, st)
	end
	for _, st in list do
		if st.id ~= 0 then
			local r = sim:runner(st.id)
			if r ~= nil and r.alive then
				readPlayer(st, r, now, positions)
			end
		end
	end

	sim:step(now, positions)

	for _, ev in sim:drainEvents() do
		local e = ev :: any
		if e.kind == "spawn" then
			-- Clients cannot read os.clock; give them shieldUntil on the synchronized server clock.
			local copy = table.clone(e)
			copy.shieldUntil = workspace:GetServerTimeNow() + (e.shieldUntil - now)
			broadcast(Remotes.ArenaEvent, copy)
		else
			broadcast(Remotes.ArenaEvent, ev)
		end
		local ok, err = pcall(handleEvent, ev, now)
		if not ok then
			warn("[ArenaService] event handler failed:", (ev :: any).kind, err)
		end
		for _, fn in table.clone(eventListeners) do
			local ok2, err2 = pcall(fn, ev)
			if not ok2 then
				warn("[ArenaService] onEvent listener failed:", err2)
			end
		end
	end

	housekeeping(now)
end

-- public API -----------------------------------------------------------------------------------

-- Called once the player's profile is loaded; the runner is added when the character exists.
function ArenaService.join(player: Player)
	if states[player] ~= nil or player.Parent == nil then
		return
	end
	local now = os.clock()
	local st: PState = {
		player = player,
		joinClock = now,
		id = 0,
		character = nil,
		hrp = nil,
		humanoid = nil,
		connections = {},
		charConnections = {},
		walkSpeed = UpgradeService.walkSpeed(player),
		prevWalkSpeed = 0,
		speedGraceUntil = 0,
		lastPos = nil,
		lastTime = now,
		overTicks = 0,
		strikes = {},
		exemptUntil = 0,
		settleTarget = nil,
		settleTries = 0,
		deathTime = now,
		lifeStart = now,
		lifeCoins = 0,
		lifeKills = 0,
		pendingUntil = nil,
		secondChanceUsed = false,
		respawning = false,
		autoRespawn = false,
		kingAccum = 0,
		ready = false,
	}
	states[player] = st
	table.insert(
		st.connections,
		player.CharacterAdded:Connect(function(char: Model)
			onCharacter(st, char)
		end)
	)
	local char = player.Character
	if char ~= nil then
		task.spawn(onCharacter, st, char)
	end
end

-- The runner (and its turf) stays for LeaveNeutralDelay seconds, then is removed.
function ArenaService.leave(player: Player)
	local st = states[player]
	if st == nil then
		return
	end
	states[player] = nil
	for _, c in st.connections do
		c:Disconnect()
	end
	for _, c in st.charConnections do
		c:Disconnect()
	end
	local id = st.id
	if id == 0 then
		return
	end
	st.id = 0
	playerById[id] = nil
	local r = sim:runner(id)
	if r == nil then
		return
	end
	if r.pending then
		sim:releaseVictim(id)
	end
	orphans[id] = true
	local info = r.info
	task.delay(Config.Arena.LeaveNeutralDelay, function()
		if orphans[id] then
			orphans[id] = nil
			local cur = sim:runner(id)
			if cur ~= nil and cur.info == info then
				sim:removeRunner(id, os.clock())
			end
		end
	end)
end

-- Request handler. Waits out the rest of RespawnDelay if needed.
function ArenaService.respawn(player: Player): (boolean, any)
	local st = states[player]
	if st == nil or st.id == 0 then
		return false, "not_in_arena"
	end
	local id = st.id
	local r = sim:runner(id)
	if r == nil or r.alive then
		return false, "not_dead"
	end
	if st.respawning then
		return false, "busy"
	end
	if r.pending then
		st.pendingUntil = nil
		sim:releaseVictim(id)
	end
	local remaining = st.deathTime + Config.Arena.RespawnDelay - os.clock()
	if remaining > 0 then
		st.respawning = true
		task.wait(remaining)
		st.respawning = false
		local again = sim:runner(id)
		if states[player] ~= st or st.id ~= id or again == nil or again.alive then
			return false, "not_dead"
		end
	end
	doRespawn(st, os.clock())
	return true, id
end

function ArenaService.declineSecondChance(player: Player): (boolean, any)
	local st = states[player]
	if st == nil or st.id == 0 then
		return false, "not_in_arena"
	end
	local r = sim:runner(st.id)
	if r == nil or not r.pending then
		return false, "not_pending"
	end
	st.pendingUntil = nil
	sim:releaseVictim(st.id)
	return true, nil
end

-- MonetizationService.onSecondChance: true only when the player was still a pending victim.
function ArenaService.secondChance(player: Player): boolean
	local st = states[player]
	if st == nil or st.id == 0 then
		return false
	end
	local r = sim:runner(st.id)
	if r == nil or not r.pending then
		return false
	end
	local now = os.clock()
	if not sim:revive(st.id, Config.Products.secondChance.Shield, now) then
		return false
	end
	st.pendingUntil = nil
	st.secondChanceUsed = true
	placeAtCell(st, r.x, r.y, now)
	return true
end

-- After a speed upgrade or a rebirth.
function ArenaService.refreshWalkSpeed(player: Player)
	local st = states[player]
	if st == nil then
		return
	end
	local speed = UpgradeService.walkSpeed(player)
	if speed < st.walkSpeed then
		st.prevWalkSpeed = st.walkSpeed
		st.speedGraceUntil = os.clock() + SPEED_DROP_GRACE
	end
	st.walkSpeed = speed
	local humanoid = st.humanoid
	if humanoid ~= nil and st.id ~= 0 and sim:isAlive(st.id) then
		humanoid.WalkSpeed = speed
	end
end

function ArenaService.runnerIdOf(player: Player): number
	local st = states[player]
	return if st ~= nil then st.id else 0
end

function ArenaService.start()
	if started then
		return
	end
	started = true
	for _, name in
		{ Remotes.ArenaSnapshot, Remotes.ArenaDelta, Remotes.ArenaEvent, Remotes.Death, Remotes.Reward, Remotes.Toast, Remotes.RunnerInfo }
	do
		remote(name)
	end

	MonetizationService.onSecondChance = ArenaService.secondChance
	MonetizationService.onPassOwned = ArenaService.refreshVip
	EconomyService.cellsProvider = function(player: Player): number
		local st = states[player]
		if st == nil or st.id == 0 or not sim:isAlive(st.id) then
			return 0
		end
		return sim:cellsOf(st.id)
	end

	ShopService.equippedChanged:Connect(function(player: Player, equipped: { skin: string, trail: string, effect: string })
		local st = states[player]
		if st == nil or st.id == 0 then
			return
		end
		local r = sim:runner(st.id)
		if r == nil then
			return
		end
		r.info.skin, r.info.trail, r.info.effect = equipped.skin, equipped.trail, equipped.effect
		r.info.vip = EconomyService.hasPass(player, "vip")
		broadcast(Remotes.RunnerInfo, liveInfos())
	end)

	Players.PlayerRemoving:Connect(ArenaService.leave)

	local acc, deltaAcc = 0, 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		local steps = 0
		while acc >= STEP do
			steps += 1
			if steps > MAX_CATCHUP_STEPS then
				acc = 0
				break
			end
			acc -= STEP
			local ok, err = pcall(tick, os.clock())
			if not ok then
				warn("[ArenaService] tick failed:", err)
			end
		end
		deltaAcc += dt
		if deltaAcc >= DELTA_PERIOD then
			deltaAcc = math.min(deltaAcc - DELTA_PERIOD, DELTA_PERIOD)
			flushDeltas()
		end
	end)
end

return ArenaService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000000000000000000000000000016">
					<Properties>
						<string name="Name">BadgeService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Players = game:GetService("Players")

local Badges = {}

local awarded: { [number]: { [string]: boolean } } = {}

function Badges.award(player: Player, key: string)
	local id = Config.Ids.Badges[key]
	if id == nil or id == 0 then
		return
	end
	local set = awarded[player.UserId]
	if set == nil then
		set = {}
		awarded[player.UserId] = set
	end
	if set[key] then
		return
	end
	set[key] = true
	local userId = player.UserId
	task.spawn(function()
		local ok = pcall(function()
			game:GetService("BadgeService"):AwardBadge(userId, id)
		end)
		if not ok and awarded[userId] ~= nil then
			awarded[userId][key] = nil
		end
	end)
end

Players.PlayerRemoving:Connect(function(player: Player)
	awarded[player.UserId] = nil
end)

return Badges
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000000000000000000000000000017">
					<Properties>
						<string name="Name">BotService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Server bots (GDD G10): keeps the arena at Config.Arena.MinRunners with BotBrain-driven runners
-- shown as simple anchored rigs. Rigs live in workspace.Bots, named tostring(runnerId).
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local BotBrain = require(Shared.BotBrain)
local Catalog = require(Shared.Catalog)
local Config = require(Shared.Config)
local Types = require(Shared.Types)
local ArenaService = require(script.Parent.ArenaService)
local DataService = require(script.Parent.DataService)

type RunnerInfo = Types.RunnerInfo
type Bot = {
	id: number,
	info: RunnerInfo,
	brain: BotBrain.State,
	px: number, -- continuous position in cell units; the sim floors it
	py: number,
	model: Model,
	body: Part,
	head: Part,
	respawnAt: number?,
}

local NAMES = {
	"PixelPanda", "TurboTaco", "SunnySprout", "ZippyZebra", "MangoMoose", "CosmoCub", "BubbleBolt", "NovaNugget",
	"JellyJet", "MapleMarble", "RocketRadish", "PeppyPenguin", "WaffleWizard", "BreezyBean", "LunaLlama", "CometCookie",
	"DizzyDolphin", "FizzyFox", "GummyGecko", "HappyHedgehog", "IcyIguana", "JollyJaguar", "KiwiKite", "LemonLynx",
	"MintyMole", "NoodleNewt", "OtterOrbit", "PuddlePuffin", "QuirkyQuail", "RaspberryRay", "SnappySquid", "TofuTiger",
	"UmbrellaUnicorn", "VelvetVole", "WobblyWalrus", "YoyoYak", "ZestyZinnia", "BlueberryBlitz", "CloudyCamel", "DoodleDuck",
}

local GENTLE_RADIUS = 20 -- cells
local TUTORIAL_NEAR_CELLS = 25 -- a new player should have a bot this close (GDD G7.4)
local TUTORIAL_RELEASE_CELLS = 15 -- a steered bot is released once this close
local BODY_HEIGHT = 4
local BODY_WIDTH = 3
local HEAD_SIZE = 2
local RESPAWN_JITTER_MIN, RESPAWN_JITTER_MAX = 1, 3
local MAINTAIN_PERIOD = 1
local FLOOR_Y = Config.Arena.FloorY
local CELLS_PER_SECOND = Config.Arena.BaseWalkSpeed / Config.Arena.CellSize

local BotService = {}

local bots: { [number]: Bot } = {}
local rng = Random.new()
local folder: Folder? = nil
local maintainAcc = 0
local warnedBrain = false
local started = false
-- One bot at a time is steered toward a tutorial player who has no bot nearby (GAP-07).
local steer: { botId: number, targetId: number }? = nil

local function pickName(): string
	local used: { [string]: boolean } = {}
	for _, b in bots do
		used[b.info.name] = true
	end
	local start = rng:NextInteger(1, #NAMES)
	for k = 0, #NAMES - 1 do
		local name = NAMES[(start + k - 1) % #NAMES + 1]
		if not used[name] then
			return name
		end
	end
	return NAMES[start]
end

-- A default or common cosmetic of the given type, so bots look varied but never premium.
local function pickCosmetic(itemType: string): string
	local list: { string } = {}
	local fallback = ""
	for _, item in Catalog.ofType(itemType) do
		if item.default == true then
			fallback = item.id
		end
		if item.default == true or item.rarity == "common" then
			table.insert(list, item.id)
		end
	end
	if #list == 0 then
		return fallback
	end
	return list[rng:NextInteger(1, #list)]
end

local function makeRig(info: RunnerInfo): (Model, Part, Part)
	local color = Color3.fromHex(Config.Colors.Players[info.colorIndex] or Config.Colors.Players[1])
	local model = Instance.new("Model")
	model.Name = tostring(info.id)

	local body = Instance.new("Part")
	body.Name = "Body"
	body.Shape = Enum.PartType.Cylinder -- cylinders run along X; placeRig turns it upright
	body.Size = Vector3.new(BODY_HEIGHT, BODY_WIDTH, BODY_WIDTH)
	body.Color = color
	body.Material = Enum.Material.SmoothPlastic
	body.Anchored = true
	body.CanCollide = false
	body.CanQuery = false
	body.CanTouch = false
	body.Parent = model

	local head = Instance.new("Part")
	head.Name = "Head"
	head.Shape = Enum.PartType.Ball
	head.Size = Vector3.new(HEAD_SIZE, HEAD_SIZE, HEAD_SIZE)
	head.Color = color
	head.Material = Enum.Material.SmoothPlastic
	head.Anchored = true
	head.CanCollide = false
	head.CanQuery = false
	head.CanTouch = false
	head.Parent = model

	local gui = Instance.new("BillboardGui")
	gui.Name = "NameTag"
	gui.Size = UDim2.fromOffset(160, 30)
	gui.StudsOffset = Vector3.new(0, HEAD_SIZE, 0)
	gui.MaxDistance = 150
	gui.Adornee = head
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = info.name
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = gui
	gui.Parent = head

	model.PrimaryPart = body
	return model, body, head
end

local function placeRig(b: Bot)
	local wx, wz = ArenaService.sim.grid:cellToWorld(b.px - 0.5, b.py - 0.5)
	b.body.CFrame = CFrame.new(wx, FLOOR_Y + BODY_HEIGHT / 2, wz) * CFrame.Angles(0, 0, math.pi / 2)
	b.head.CFrame = CFrame.new(wx, FLOOR_Y + BODY_HEIGHT + HEAD_SIZE / 2, wz)
end

local function hideBot(b: Bot)
	b.model.Parent = nil
	ArenaService.botPositions[b.id] = nil
end

-- Snap to the runner's current cell (after spawn, respawn or a server-side recycle).
local function resetBot(b: Bot)
	local r = ArenaService.sim:runner(b.id)
	if r == nil then
		return
	end
	b.px, b.py = r.x + 0.5, r.y + 0.5
	b.respawnAt = nil
	BotBrain.reset(b.brain)
	ArenaService.botPositions[b.id] = { x = b.px, y = b.py }
	b.model.Name = tostring(b.id)
	placeRig(b)
	b.model.Parent = folder
end

local function spawnBot(now: number)
	local tiers = Config.Bots.Tiers
	local tier = tiers[rng:NextInteger(1, #tiers)]
	local info: RunnerInfo = {
		id = 0,
		userId = 0,
		name = pickName(),
		colorIndex = ArenaService.freeColorIndex(),
		skin = pickCosmetic("skin"),
		trail = pickCosmetic("trail"),
		effect = pickCosmetic("effect"),
		isBot = true,
	}
	local id = ArenaService.sim:addRunner(info, Config.Arena.StartPatch, Config.Arena.SpawnShield, now)
	local model, body, head = makeRig(info)
	local b: Bot = {
		id = id,
		info = info,
		brain = BotBrain.new(tier, function(): number
			return rng:NextNumber()
		end),
		px = 0,
		py = 0,
		model = model,
		body = body,
		head = head,
		respawnAt = nil,
	}
	bots[id] = b
	resetBot(b)
end

local function removeBot(b: Bot, now: number)
	bots[b.id] = nil
	ArenaService.botPositions[b.id] = nil
	b.model:Destroy()
	local r = ArenaService.sim:runner(b.id)
	if r ~= nil and r.info == b.info then
		ArenaService.sim:removeRunner(b.id, now)
	end
end

-- Bot count follows the number of players in the server (not live player runners), so a player's
-- character respawn does not make bots churn.
local function maintain(now: number)
	local target = math.max(0, Config.Arena.MinRunners - #Players:GetPlayers())
	local count = 0
	for _ in bots do
		count += 1
	end
	if count < target then
		for _ = 1, target - count do
			spawnBot(now)
		end
	elseif count > target then
		local sim = ArenaService.sim
		local pick: Bot? = nil
		local best = math.huge
		for id, b in bots do
			local score = if sim:isAlive(id) then sim:cellsOf(id) else -1
			if score < best then
				pick, best = b, score
			end
		end
		if pick ~= nil then
			removeBot(pick, now)
		end
	end
end

local function cellDist2(a: any, b: any): number
	return (a.x - b.x) ^ 2 + (a.y - b.y) ^ 2
end

-- Runs once per maintain period: keeps or ends the current steer, or starts one.
local function updateSteer()
	local sim = ArenaService.sim
	local cur = steer
	if cur ~= nil then
		local br, tr = sim:runner(cur.botId), sim:runner(cur.targetId)
		if br == nil or tr == nil or not br.alive or not tr.alive or bots[cur.botId] == nil
			or cellDist2(br, tr) <= TUTORIAL_RELEASE_CELLS ^ 2 then
			steer = nil
		end
		return
	end
	local now = ArenaService.now()
	local gentleSet: { [number]: boolean } = {}
	for _, id in ArenaService.gentleRunnerIds(now) do
		gentleSet[id] = true
	end
	for _, player in Players:GetPlayers() do
		local id = ArenaService.runnerIdOf(player)
		local profile = DataService.get(player)
		local t = sim:runner(id)
		if gentleSet[id] and profile ~= nil and not profile.tutorialDone and t ~= nil and t.alive then
			local nearest, farthest, farD = math.huge, nil :: any, -1
			for botId, b in bots do
				local r = sim:runner(botId)
				if r ~= nil and r.alive and r.info == b.info then
					local d = cellDist2(r, t)
					nearest = math.min(nearest, d)
					if d > farD and #r.trail == 0 then
						farthest, farD = botId, d
					end
				end
			end
			if nearest > TUTORIAL_NEAR_CELLS ^ 2 and farthest ~= nil then
				steer = { botId = farthest :: number, targetId = id }
				return
			end
		end
	end
end

local function approach(value: number, target: number, maxDelta: number): number
	if math.abs(target - value) <= maxDelta then
		return target
	end
	return value + math.sign(target - value) * maxDelta
end

local function moveBot(b: Bot, r: any, now: number, dt: number, gentle: { number }, gentleSet: { [number]: boolean })
	local sim = ArenaService.sim
	local grid = sim.grid
	local size = grid.size
	if math.abs(math.floor(b.px) - r.x) > 1 or math.abs(math.floor(b.py) - r.y) > 1 then
		resetBot(b)
	end

	local dx, dy = 0, 0
	local ok, a, c = pcall(BotBrain.step, b.brain, sim, b.id, now)
	if ok then
		dx, dy = math.sign(a or 0), math.sign(c or 0)
	elseif not warnedBrain then
		warnedBrain = true
		warn("[BotService] BotBrain.step failed:", a)
	end
	if dx ~= 0 and dy ~= 0 then
		dy = 0
	end
	local sv = steer
	if sv ~= nil and sv.botId == b.id then
		local t = sim:runner(sv.targetId)
		if t ~= nil then
			local tx, ty = t.x - r.x, t.y - r.y
			if math.abs(tx) >= math.abs(ty) then
				dx, dy = math.sign(tx), 0
			else
				dx, dy = 0, math.sign(ty)
			end
		end
	end

	-- Never cut a player in their gentle window: stop before entering their trail.
	if dx ~= 0 or dy ~= 0 then
		local nx, ny = math.floor(b.px) + dx, math.floor(b.py) + dy
		if grid:inBounds(nx, ny) then
			for _, owner in sim:trailOwnersAt(grid:index(nx, ny)) do
				if gentleSet[owner] then
					dx, dy = 0, 0
					break
				end
			end
		end
	end

	local speed = CELLS_PER_SECOND
	for _, id in gentle do
		local g = sim:runner(id)
		if g ~= nil and g.alive then
			local ddx, ddy = g.x - r.x, g.y - r.y
			if ddx * ddx + ddy * ddy <= GENTLE_RADIUS * GENTLE_RADIUS then
				speed *= Config.Bots.GentleSpeedScale
				break
			end
		end
	end
	local step = speed * dt
	-- Moving along one axis re-centres the other so the bot stays in its row/column.
	if dx ~= 0 then
		b.px += dx * step
		b.py = approach(b.py, math.floor(b.py) + 0.5, step)
	elseif dy ~= 0 then
		b.py += dy * step
		b.px = approach(b.px, math.floor(b.px) + 0.5, step)
	end
	b.px = math.clamp(b.px, 0.5, size - 0.5)
	b.py = math.clamp(b.py, 0.5, size - 0.5)
	ArenaService.botPositions[b.id] = { x = b.px, y = b.py }
	placeRig(b)
end

local function preStep(now: number, dt: number)
	maintainAcc += dt
	if maintainAcc >= MAINTAIN_PERIOD then
		maintainAcc = 0
		maintain(now)
		updateSteer()
	end
	local sim = ArenaService.sim
	local gentle = ArenaService.gentleRunnerIds(now)
	local gentleSet: { [number]: boolean } = {}
	for _, id in gentle do
		gentleSet[id] = true
	end
	for id, b in table.clone(bots) do
		local r = sim:runner(id)
		if r == nil or r.info ~= b.info then
			removeBot(b, now)
		elseif not r.alive then
			local at = b.respawnAt
			if at == nil then
				sim:releaseVictim(id)
				b.respawnAt = now + Config.Arena.RespawnDelay + rng:NextNumber(RESPAWN_JITTER_MIN, RESPAWN_JITTER_MAX)
				hideBot(b)
			elseif now >= at then
				sim:respawn(id, Config.Arena.StartPatch, Config.Arena.SpawnShield, now)
				resetBot(b)
			end
		else
			moveBot(b, r, now, dt, gentle, gentleSet)
		end
	end
end

local function onEvent(ev: Types.ArenaEvent)
	local e = ev :: any
	if e.kind == "cut" then
		local b = bots[e.victim]
		if b ~= nil then
			ArenaService.sim:releaseVictim(b.id)
			b.respawnAt = ArenaService.now()
				+ Config.Arena.RespawnDelay
				+ rng:NextNumber(RESPAWN_JITTER_MIN, RESPAWN_JITTER_MAX)
			hideBot(b)
		end
	elseif e.kind == "spawn" then
		local b = bots[e.runner.id]
		if b ~= nil and e.runner == b.info then
			resetBot(b)
		end
	elseif e.kind == "despawn" then
		local b = bots[e.id]
		if b ~= nil then
			hideBot(b)
		end
	end
end

function BotService.start()
	if started then
		return
	end
	started = true
	local existing = workspace:FindFirstChild("Bots")
	if existing ~= nil then
		existing:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = "Bots"
	f.Parent = workspace
	folder = f
	ArenaService.preStep = preStep
	ArenaService.onEvent:Connect(onEvent)
end

return BotService
]]></ProtectedString>
					</Properties>
