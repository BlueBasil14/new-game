          <Item class="ModuleScript" referent="19">
            <Properties>
              <string name="Name">RootPersistence</string>
              <BinaryString name="AttributesSerialize" />
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source">-- RootPersistence.lua - keeps StarterGui.RBLXEssentials alive across
-- character respawns (Kernel 2.1.1).
--
-- WHY: Roblox resets PlayerGui on every character spawn. Each StarterGui
-- child is destroyed and cloned again unless it is a top-level
-- LayerCollector with ResetOnSpawn = false. The installer creates
-- StarterGui.RBLXEssentials as a Folder, which has no ResetOnSpawn, so the
-- whole tree was destroyed on the server and cloned again on every respawn
-- (the ResetOnSpawn = false of each pack ScreenGui nested inside is
-- ignored: only top-level LayerCollectors count). That server-side Destroy
-- replicates to every instance the client had moved out of the tree,
-- including every panel and HUD button MenuSystem adopted into
-- RBLXEssentialsGUI, so after the first death the menus and the HUD buttons
-- were gone. Diagnosed natively on 2026-09-23.
--
-- The server calls persist once at boot, before packs load, to turn a
-- non-ScreenGui root into a ScreenGui with ResetOnSpawn = false. The root
-- instance itself is replaced (the old Folder is destroyed), but the new one
-- keeps its name, attributes, tags and children, so every
-- PlayerGui.RBLXEssentials.&lt;PackId&gt;.&lt;Gui&gt; path stays the same: look the root
-- up by name after boot. The holder is neutral (no insets, no safe-area
-- clipping), so it adds no layout of its own, and the pack ScreenGuis nested
-- inside keep rendering as independent layers.
--
-- Pure: no `game` access. `create` is Instance.new and `enums` is Enum,
-- both injected so Lune specs can pass @lune/roblox's versions.
local RootPersistence = {}

RootPersistence.ROOT = "RBLXEssentials"

-- The nearest ancestor of `inst` (not `inst` itself) that is a GuiObject or
-- a LayerCollector, or nil when there is none.
local function nearestGuiAncestor(inst)
	local node = inst.Parent
	while node ~= nil do
		if node:IsA("GuiObject") or node:IsA("LayerCollector") then
			return node
		end
		node = node.Parent
	end
	return nil
end

-- Reports every instance under the root whose behavior changes now that the
-- root persists instead of resetting on spawn:
--   * client code (a LocalScript, or a Script with RunContext Client) now
--     runs once per session instead of on every respawn;
--   * a nested LayerCollector that asked to reset on spawn no longer does;
--   * only when the old root was not a LayerCollector (a Folder, which
--     renders nothing): a GuiObject with no GuiObject or LayerCollector
--     between it and the root now renders. Only the top of each such subtree
--     is reported, so a Frame &gt; Folder &gt; Frame chain gives one warning. When
--     the old root was already a ScreenGui, those objects were already
--     rendering, so they are not reported.
local function audit(root, enums, warnings, rootWasLayerCollector)
	for _, inst in ipairs(root:GetDescendants()) do
		if inst:IsA("LocalScript") or (inst:IsA("Script") and inst.RunContext == enums.RunContext.Client) then
			table.insert(warnings, ("%s: now runs once per session instead of on every respawn"):format(inst:GetFullName()))
		elseif inst:IsA("LayerCollector") then
			if inst.ResetOnSpawn == true then
				table.insert(warnings, ("%s: no longer resets on spawn"):format(inst:GetFullName()))
			end
		elseif inst:IsA("GuiObject") then
			if not rootWasLayerCollector and nearestGuiAncestor(inst) == root then
				table.insert(warnings, ("%s: now renders (it has no ScreenGui of its own)"):format(inst:GetFullName()))
			end
		end
	end
end

-- Makes StarterGui.RBLXEssentials survive respawn. Returns (root, warnings);
-- root is nil only when StarterGui has no RBLXEssentials child.
function RootPersistence.persist(starterGui, create, enums)
	local warnings = {}
	local root = starterGui:FindFirstChild(RootPersistence.ROOT)

	local matches = 0
	for _, child in ipairs(starterGui:GetChildren()) do
		if child.Name == RootPersistence.ROOT then
			matches += 1
		end
	end
	if matches &gt; 1 and root ~= nil then
		table.insert(warnings, ("more than one StarterGui child is named %s; only %s was made persistent")
			:format(RootPersistence.ROOT, root:GetFullName()))
	end

	if root == nil then
		return nil, warnings
	end

	if root:IsA("ScreenGui") then
		-- Already converted, or the root may already be a ScreenGui if the
		-- game replaced it by hand: only make sure it survives respawn, and
		-- audit only when that is a change. Its GuiObjects already rendered.
		if root.ResetOnSpawn then
			root.ResetOnSpawn = false
			audit(root, enums, warnings, true)
		end
		table.sort(warnings)
		return root, warnings
	end

	local holder = create("ScreenGui")
	holder.Name = RootPersistence.ROOT
	holder.ResetOnSpawn = false
	holder.ScreenInsets = enums.ScreenInsets.None
	holder.ClipToDeviceSafeArea = false
	holder.SafeAreaCompatibility = enums.SafeAreaCompatibility.None
	for key, value in pairs(root:GetAttributes()) do
		holder:SetAttribute(key, value)
	end
	for _, tag in ipairs(root:GetTags()) do
		holder:AddTag(tag)
	end

	local moved = {}
	local moveOk, moveErr = pcall(function()
		for _, child in ipairs(root:GetChildren()) do
			child.Parent = holder
			table.insert(moved, child)
		end
	end)
	if not moveOk then
		-- Put back whatever already moved, so nothing is left orphaned.
		local stranded = {}
		for _, child in ipairs(moved) do
			local backOk = pcall(function()
				child.Parent = root
			end)
			if not backOk then
				table.insert(stranded, child)
			end
		end
		if #stranded == 0 then
			holder:Destroy()
		else
			-- Destroying the holder would destroy these children with it.
			for _, child in ipairs(stranded) do
				table.insert(warnings, ("%s could not be returned to %s"):format(child.Name, RootPersistence.ROOT))
			end
		end
		table.insert(warnings, ("%s: root not made persistent; menus, HUD buttons and pack interfaces may stop working after a respawn (%s)")
			:format(RootPersistence.ROOT, tostring(moveErr)))
		table.sort(warnings)
		return root, warnings
	end

	-- Parented before the Folder is destroyed, with no yield in between, so
	-- the moved children always have a root.
	holder.Parent = starterGui
	root:Destroy()

	audit(holder, enums, warnings, false)
	table.sort(warnings)
	return holder, warnings
end

return RootPersistence
