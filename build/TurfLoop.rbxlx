-- Roblox audio asset ids for every GDD G9.2 sound. 0 = not uploaded yet (FeedbackController skips it).
local SoundIds: { [string]: number } = {
	trailStart = 0,
	trailLoop = 0,
	heartbeat = 0,
	claimPop = 0,
	bigClaim = 0,
	stealCrunch = 0,
	snip = 0,
	deathPop = 0,
	respawnWhoosh = 0,
	crownFanfare = 0,
	coinTick = 0,
	purchase = 0,
	uiHover = 0,
	uiClick = 0,
	uiError = 0,
	rewardClaim = 0,
	questComplete = 0,
	rebirthSwell = 0,
	lobbyMusic = 0,
	arenaMusic = 0,
}

return SoundIds
