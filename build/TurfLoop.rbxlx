                <BinaryString name="SerializedOverrides">
                </BinaryString>
                <string name="Source">-- Migrations/Keep - what T.migrate must look at in the 2.x pack's own code
-- (plan B1). Everything below "return {" is generated from the published
-- 2.x releases by tools/v3/keep-gen.luau (plan B0, ruling 11): run it again
-- after a 2.x release, and with --check to compare.
--
-- folders: none. Sound System 2.x had no folder for the game's own modules
--   (no trigger modules, no custom rewards), so 3.0 reads no Extensions.
-- shipped: every script a 2.x release shipped under the pack's own roots
--   (ReplicatedStorage/Packs/SoundSystem, ServerScriptService/Packs/
--   SoundSystem; its StarterGui, SoundService and Workspace folders ship no
--   script), keyed "&lt;service key&gt;/&lt;path under that service's
--   RBLXEssentials&gt;", with the SourceHash (plugins/Official/src/Shared/
--   SourceHash.lua) of every published version of it. A game that edited
--   one (the volume ladder in VolumeHandlers, the voice limits in OneShots
--   or Loops, the icons in MusicSystem, the demo wiring or the positional
--   API in the server module, Apply Template) makes T.migrate refuse
--   without force (migrate-custom-modified) and name the lines it changed;
--   with force the 3.0 version replaces it (or, for Apply Template,
--   Client/Template and Client/AwaitGui, which 3.0 dropped, nothing does)
--   and the edited copy stays in the protected migration backup.
-- lines: for each published SourceHash, SourceHash.fnv1a32 of each line of
--   that source, trimmed, blank lines left out, in order. T.migrate names
--   the lines a game changed with them.
return {
	folders = {},
	shipped = {
		-- 2.0.0, 2.1.0, 2.1.1
		["ReplicatedStorage/Packs/SoundSystem/Actions/Apply Template"] = { "89443e6d" },
		-- 2.0.0; 2.1.0, 2.1.1
		["ReplicatedStorage/Packs/SoundSystem/Client"] = { "aeb8d347", "af263c9f" },
		-- 2.1.0, 2.1.1
		["ReplicatedStorage/Packs/SoundSystem/Client/AwaitGui"] = { "e2838c36" },
		-- 2.0.0, 2.1.0, 2.1.1
		["ReplicatedStorage/Packs/SoundSystem/Client/Backend"] = { "cbe87f20" },
		-- 2.0.0, 2.1.0, 2.1.1
		["ReplicatedStorage/Packs/SoundSystem/Client/Fingerprint"] = { "adf6f40a" },
		-- 2.1.0, 2.1.1
		["ReplicatedStorage/Packs/SoundSystem/Client/Loops"] = { "09c3c1b7" },
		-- 2.1.0, 2.1.1
		["ReplicatedStorage/Packs/SoundSystem/Client/MusicPlayerHUD"] = { "ebfd67c0" },
		-- 2.0.0; 2.1.0, 2.1.1
		["ReplicatedStorage/Packs/SoundSystem/Client/MusicSystem"] = { "06fc0cb9", "69c2d578" },
		-- 2.1.0, 2.1.1
		["ReplicatedStorage/Packs/SoundSystem/Client/OneShots"] = { "c799d15e" },
		-- 2.0.0; 2.1.0, 2.1.1
		["ReplicatedStorage/Packs/SoundSystem/Client/Template"] = { "4913ffa8", "a044be2b" },
		-- 2.0.0, 2.1.0, 2.1.1
		["ReplicatedStorage/Packs/SoundSystem/Client/VolumeHandlers"] = { "c7b30135" },
		-- 2.0.0; 2.1.0; 2.1.1
		["ReplicatedStorage/Packs/SoundSystem/manifest"] = { "094c2e04", "db91263d", "b1e905c0" },
		-- 2.0.0, 2.1.0, 2.1.1
		["ServerScriptService/Packs/SoundSystem"] = { "3755ce51" },
	},
	lines = {
