					<string name="Name">ArenaSim</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Engine-free arena rules (GDD G2). The server feeds it target cells each tick and forwards the
-- drained events, cell changes and trail deltas to clients. See docs/API_arena.md.
local Config = require(script.Parent.Config)
local Types = require(script.Parent.Types)
local Grid = require(script.Parent.Grid)
local FloodFill = require(script.Parent.FloodFill)

type RunnerInfo = Types.RunnerInfo
type ArenaEvent = Types.ArenaEvent
type TrailDelta = Types.TrailDelta

export type Runner = {
	id: number,
	info: RunnerInfo,
	alive: boolean,
	-- Dead and waiting for releaseVictim/revive; turf still belongs to the runner meanwhile.
	pending: boolean,
	killer: number, -- killer of a pending victim, 0 if none
	x: number,
	y: number,
	trail: { number }, -- cell indices in walk order, never contains own turf
	shieldUntil: number,
	startPatch: number,
}

export type Options = { size: number?, rng: (() -> number)? }

local ArenaSim = {}
ArenaSim.__index = ArenaSim

export type ArenaSim = typeof(setmetatable(
	{} :: {
		grid: Grid.Grid,
		size: number,
		total: number,
		rng: () -> number,
		runnersById: { [number]: Runner },
		order: { number }, -- runner ids ascending
		-- Trail overlay: primary trail owner per cell; rare second owners (only possible when a
		-- shield stopped a cut) live in `extra`.
		trailOwner: buffer,
		extra: { [number]: { number } },
		king: number,
		events: { ArenaEvent },
		dirty: buffer,
		dirtyList: { number },
		deltas: { [number]: TrailDelta },
		cutBy: { [number]: number }, -- victim -> killer, during one step
		cutOrder: { number },
	},
	ArenaSim
))

function ArenaSim.new(opts: Options?): ArenaSim
	local o = opts or {}
	local grid = Grid.new(o.size)
	local n = grid.size
	return setmetatable({
		grid = grid,
		size = n,
		total = n * n,
		rng = o.rng or math.random,
		runnersById = {},
		order = {},
		trailOwner = buffer.create(n * n),
		extra = {},
		king = 0,
		events = {},
		dirty = buffer.create(n * n),
		dirtyList = {},
		deltas = {},
		cutBy = {},
		cutOrder = {},
	}, ArenaSim)
end

-- cell / trail primitives ------------------------------------------------------------------

local function setCell(self: ArenaSim, i: number, owner: number)
	if self.grid:setIndex(i, owner) ~= owner and buffer.readu8(self.dirty, i) == 0 then
		buffer.writeu8(self.dirty, i, 1)
		table.insert(self.dirtyList, i)
	end
end

local function markDirty(self: ArenaSim, i: number)
	if buffer.readu8(self.dirty, i) == 0 then
		buffer.writeu8(self.dirty, i, 1)
		table.insert(self.dirtyList, i)
	end
end

local function deltaFor(self: ArenaSim, id: number): TrailDelta
	local d = self.deltas[id]
	if not d then
		d = { id = id, clear = false, append = {} }
		self.deltas[id] = d
	end
	return d
end

local function trailHas(self: ArenaSim, i: number, id: number): boolean
	if buffer.readu8(self.trailOwner, i) == id then
		return true
	end
	local ex = self.extra[i]
	return ex ~= nil and table.find(ex, id) ~= nil
end

local function appendTrail(self: ArenaSim, r: Runner, i: number)
	table.insert(r.trail, i)
	if buffer.readu8(self.trailOwner, i) == 0 then
		buffer.writeu8(self.trailOwner, i, r.id)
	else
		local ex = self.extra[i]
		if ex then
			table.insert(ex, r.id)
		else
			self.extra[i] = { r.id }
		end
	end
	table.insert(deltaFor(self, r.id).append, i)
end

local function clearTrail(self: ArenaSim, r: Runner)
	local id = r.id
	for _, i in r.trail do
		local ex = self.extra[i]
		if buffer.readu8(self.trailOwner, i) == id then
			if ex then
				buffer.writeu8(self.trailOwner, i, table.remove(ex, 1) :: number)
				if #ex == 0 then
					self.extra[i] = nil
				end
			else
				buffer.writeu8(self.trailOwner, i, 0)
			end
		elseif ex then
			local k = table.find(ex, id)
			if k then
				table.remove(ex, k)
				if #ex == 0 then
					self.extra[i] = nil
				end
			end
		end
	end
	if #r.trail > 0 then
		table.clear(r.trail)
		local d = deltaFor(self, id)
		d.clear = true
		table.clear(d.append)
	end
end

-- Indices of every cell owned by id (scans the owner's conservative bounding box).
local function cellsOwned(self: ArenaSim, id: number): { number }
	local out = {}
	local x0, y0, x1, y1 = self.grid:bounds(id)
	if not (x0 and y0 and x1 and y1) then
		return out
	end
	local cells, size = self.grid.cells, self.size
	for y = y0, y1 do
		for i = y * size + x0, y * size + x1 do
			if buffer.readu8(cells, i) == id then
				table.insert(out, i)
			end
		end
	end
	return out
end

local function releaseCells(self: ArenaSim, id: number)
	for _, i in cellsOwned(self, id) do
		setCell(self, i, 0)
	end
end

local function updateKing(self: ArenaSim)
	local best, bestN = 0, 0
	for _, id in self.order do
		local r = self.runnersById[id]
		if r.alive then
			local n = self.grid:count(id)
			-- order is ascending, so ties go to the lowest id unless the current king is tied
			if n > bestN or (n == bestN and n > 0 and id == self.king) then
				best, bestN = id, n
			end
		end
	end
	if bestN < Config.Arena.KingMinShare * self.total then
		best = 0
	end
	if best ~= self.king then
		self.king = best
		table.insert(self.events, { kind = "king", id = best } :: ArenaEvent)
	end
end

-- spawning ---------------------------------------------------------------------------------

local function patchOrigin(self: ArenaSim, cx: number, cy: number, p: number): (number, number)
	local half = (p - 1) // 2
	return cx - half, cy - half
end

local function stampPatch(self: ArenaSim, id: number, cx: number, cy: number, p: number)
	local ox, oy = patchOrigin(self, cx, cy, p)
	local size = self.size
	for y = math.max(oy, 0), math.min(oy + p - 1, size - 1) do
		for x = math.max(ox, 0), math.min(ox + p - 1, size - 1) do
			setCell(self, y * size + x, id)
		end
	end
end

-- Centre cell of the free patch farthest from every other present runner. Candidates are
-- sampled every 4 cells; a patch is free if all its cells are neutral and trail-free. Falls back
-- to occupied candidates when nothing is free. rng breaks ties only.
local function chooseSpawn(self: ArenaSim, selfId: number, p: number): (number, number)
	local size = self.size
	local half = (p - 1) // 2
	local lo = math.min(half, size - 1)
	local hi = math.max(size - 1 - (p - 1 - half), lo)
	local others = {}
	for _, id in self.order do
		local r = self.runnersById[id]
		if id ~= selfId and (r.alive or r.pending) then
			table.insert(others, r)
		end
	end
	local cells, trail = self.grid.cells, self.trailOwner
	local bestX, bestY, bestScore = (lo + hi) // 2, (lo + hi) // 2, -math.huge
	local step = 4
	local y = lo
	while true do
		local x = lo
		while true do
			local free = true
			for py = math.max(y - half, 0), math.min(y - half + p - 1, size - 1) do
				for px = math.max(x - half, 0), math.min(x - half + p - 1, size - 1) do
					local i = py * size + px
					if buffer.readu8(cells, i) ~= 0 or buffer.readu8(trail, i) ~= 0 then
						free = false
						break
					end
				end
				if not free then
					break
				end
			end
			local d = if #others == 0 then 0 else math.huge
			for _, r in others do
				local dx, dy = r.x - x, r.y - y
				local dd = dx * dx + dy * dy
				if dd < d then
					d = dd
				end
			end
			local score = (if free then 1e9 else 0) + d + self.rng()
			if score > bestScore then
				bestX, bestY, bestScore = x, y, score
			end
			if x >= hi then
				break
			end
			x = math.min(x + step, hi)
		end
		if y >= hi then
			break
		end
		y = math.min(y + step, hi)
	end
	return bestX, bestY
end

local function spawnRunner(self: ArenaSim, r: Runner, startPatch: number, shieldSeconds: number, now: number)
	local cx, cy = chooseSpawn(self, r.id, startPatch)
	stampPatch(self, r.id, cx, cy, startPatch)
	r.x, r.y = cx, cy
	r.alive, r.pending, r.killer = true, false, 0
	r.shieldUntil = now + shieldSeconds
	r.startPatch = startPatch
	table.insert(
		self.events,
		{ kind = "spawn", runner = r.info, x = cx, y = cy, shieldUntil = r.shieldUntil } :: ArenaEvent
	)
end

-- public API -------------------------------------------------------------------------------

function ArenaSim.allocateId(self: ArenaSim): number
	for id = 1, 255 do
		if self.runnersById[id] == nil then
			return id
		end
	end
	error("ArenaSim: no free runner id")
end

-- info.id == 0 allocates the lowest free id and writes it back into info. Returns the id.
function ArenaSim.addRunner(self: ArenaSim, info: RunnerInfo, startPatch: number, shieldSeconds: number, now: number): number
	if info.id == 0 then
		info.id = self:allocateId()
	end
	local id = info.id
	assert(id >= 1 and id <= 255 and self.runnersById[id] == nil, "runner id in use or invalid")
	local r: Runner = {
		id = id,
		info = info,
		alive = false,
		pending = false,
		killer = 0,
		x = 0,
		y = 0,
		trail = {},
		shieldUntil = 0,
		startPatch = startPatch,
	}
	self.runnersById[id] = r
	table.insert(self.order, id)
	table.sort(self.order)
	spawnRunner(self, r, startPatch, shieldSeconds, now)
	updateKing(self)
	return id
end

function ArenaSim.removeRunner(self: ArenaSim, id: number, _now: number)
	local r = self.runnersById[id]
	if not r then
		return
	end
	clearTrail(self, r)
	releaseCells(self, id)
	self.runnersById[id] = nil
	table.remove(self.order, table.find(self.order, id) :: number)
	table.insert(self.events, { kind = "despawn", id = id } :: ArenaEvent)
	updateKing(self)
end

-- Splits a pending victim's turf: the KillerShare of cells nearest the killer's current cell go
-- to the killer (if still alive; never cells under the killer's own trail), the rest neutral.
-- Returns (cells given to killer, cells made neutral).
function ArenaSim.releaseVictim(self: ArenaSim, id: number): (number, number)
	local r = self.runnersById[id]
	if not r or not r.pending then
		return 0, 0
	end
	r.pending = false
	local owned = cellsOwned(self, id)
	local n = #owned
	local given = 0
	local killer = self.runnersById[r.killer]
	r.killer = 0
	local k = math.floor(n * Config.Arena.KillerShare)
	if killer and killer.alive and k > 0 then
		local size, kx, ky = self.size, killer.x, killer.y
		local cand, dist = table.create(n), table.create(n)
		for _, i in owned do
			if not trailHas(self, i, killer.id) then
				local dx, dy = i % size - kx, i // size - ky
				table.insert(cand, i)
				table.insert(dist, dx * dx + dy * dy)
			end
		end
		k = math.min(k, #cand)
		-- Quickselect: afterwards cand[1..k] are the k nearest cells (unordered).
		local lo, hi = 1, #cand
		while lo < hi do
			local p = dist[(lo + hi) // 2]
			local a, b = lo, hi
			while a <= b do
				while dist[a] < p do
					a += 1
				end
				while dist[b] > p do
					b -= 1
				end
				if a <= b then
					dist[a], dist[b] = dist[b], dist[a]
					cand[a], cand[b] = cand[b], cand[a]
					a += 1
					b -= 1
				end
			end
			if k <= b then
				hi = b
			elseif k >= a then
				lo = a
			else
				break
			end
		end
		for j = 1, k do
			setCell(self, cand[j], killer.id)
		end
		given = k
	end
	for _, i in owned do
		if self.grid:getIndex(i) == id then
			setCell(self, i, 0)
		end
	end
	updateKing(self)
	return given, n - given
end

-- Second Chance: cancels a pending release; the runner keeps its turf and stays where it died.
function ArenaSim.revive(self: ArenaSim, id: number, shieldSeconds: number, now: number): boolean
	local r = self.runnersById[id]
	if not r or not r.pending then
		return false
	end
	r.pending, r.killer, r.alive = false, 0, true
	r.shieldUntil = now + shieldSeconds
	table.insert(self.events, { kind = "spawn", runner = r.info, x = r.x, y = r.y, shieldUntil = r.shieldUntil } :: ArenaEvent)
	updateKing(self)
	return true
end

-- New patch at a fresh spot. A still-pending victim is released first.
function ArenaSim.respawn(self: ArenaSim, id: number, startPatch: number, shieldSeconds: number, now: number)
	local r = self.runnersById[id]
	assert(r and not r.alive, "respawn needs a dead runner")
	if r.pending then
		self:releaseVictim(id)
	end
	spawnRunner(self, r, startPatch, shieldSeconds, now)
	updateKing(self)
end

-- step -------------------------------------------------------------------------------------

local function tryCut(self: ArenaSim, killer: Runner, victimId: number, now: number)
	local v = self.runnersById[victimId]
	if v and v.alive and self.cutBy[victimId] == nil and now >= killer.shieldUntil and now >= v.shieldUntil then
		self.cutBy[victimId] = killer.id
		table.insert(self.cutOrder, victimId)
	end
end

local function claim(self: ArenaSim, r: Runner)
	local res = FloodFill.claim(self.grid, r.id, r.trail)
	for _, i in res.changed do
		markDirty(self, i)
	end
	clearTrail(self, r)
	table.insert(self.events, {
		kind = "claim",
		id = r.id,
		cells = #res.changed,
		neutral = res.neutral,
		stolen = res.stolen,
		cx = res.cx,
		cy = res.cy,
	} :: ArenaEvent)
	if self.grid:count(r.id) >= self.total then
		table.insert(self.events, { kind = "fullMap", id = r.id } :: ArenaEvent)
		releaseCells(self, r.id)
		stampPatch(self, r.id, r.x, r.y, r.startPatch)
	end
end

local function enter(self: ArenaSim, r: Runner, i: number, now: number)
	local id = r.id
	local p = buffer.readu8(self.trailOwner, i)
	if p ~= 0 then
		if p ~= id then
			tryCut(self, r, p, now)
		end
		local ex = self.extra[i]
		if ex then
			for _, o in ex do
				if o ~= id then
					tryCut(self, r, o, now)
				end
			end
		end
	end
	-- A runner cut earlier this tick still moves (so head-on cuts resolve) but cannot claim.
	if self.cutBy[id] ~= nil then
		return
	end
	if self.grid:getIndex(i) == id then
		if #r.trail > 0 then
			claim(self, r)
		end
	elseif not trailHas(self, i, id) then
		appendTrail(self, r, i)
	end
end

-- positions: target cell per runner id for this tick. Absent or dead runners do not move.
function ArenaSim.step(self: ArenaSim, now: number, positions: { [number]: { x: number, y: number } })
	local size = self.size
	for _, id in self.order do
		local r = self.runnersById[id]
		local pos = positions[id]
		if r and r.alive and pos then
			local tx = math.clamp(math.floor(pos.x), 0, size - 1)
			local ty = math.clamp(math.floor(pos.y), 0, size - 1)
			if tx ~= r.x or ty ~= r.y then
				for _, i in self.grid:line(r.x, r.y, tx, ty) do
					r.x, r.y = i % size, i // size
					enter(self, r, i, now)
				end
			end
		end
	end
	if #self.cutOrder > 0 then
		table.sort(self.cutOrder)
		local wasKing = self.king
		for _, vid in self.cutOrder do
			local v = self.runnersById[vid]
			v.alive, v.pending, v.killer = false, true, self.cutBy[vid]
			clearTrail(self, v)
			table.insert(self.events, {
				kind = "cut",
				killer = v.killer,
				victim = vid,
				victimCells = self.grid:count(vid),
				victimWasKing = vid == wasKing,
			} :: ArenaEvent)
		end
		table.clear(self.cutOrder)
		table.clear(self.cutBy)
	end
	updateKing(self)
end

-- draining ---------------------------------------------------------------------------------

function ArenaSim.drainEvents(self: ArenaSim): { ArenaEvent }
	local e = self.events
	self.events = {}
	return e
end

function ArenaSim.drainCellChanges(self: ArenaSim): { number }
	local list = self.dirtyList
	for _, i in list do
		buffer.writeu8(self.dirty, i, 0)
	end
	self.dirtyList = {}
	return list
end

function ArenaSim.drainTrailDeltas(self: ArenaSim): { TrailDelta }
	local out = {}
	for _, d in self.deltas do
		table.insert(out, d)
	end
	table.sort(out, function(a, b)
		return a.id < b.id
	end)
	self.deltas = {}
	return out
end

-- getters ----------------------------------------------------------------------------------

function ArenaSim.cellsOf(self: ArenaSim, id: number): number
	return self.grid:count(id)
end

function ArenaSim.share(self: ArenaSim, id: number): number
	return self.grid:count(id) / self.total
end

function ArenaSim.kingId(self: ArenaSim): number
	return self.king
end

function ArenaSim.runner(self: ArenaSim, id: number): Runner?
	return self.runnersById[id]
end

function ArenaSim.runners(self: ArenaSim): { Runner }
	local out = table.create(#self.order)
	for k, id in self.order do
		out[k] = self.runnersById[id]
	end
	return out
end

-- Drops a runner's trail (e.g. out-of-bounds teleport); emits the usual clearing trail delta.
function ArenaSim.clearTrail(self: ArenaSim, id: number)
	local r = self.runnersById[id]
	if r then
		clearTrail(self, r)
	end
end

function ArenaSim.isAlive(self: ArenaSim, id: number): boolean
	local r = self.runnersById[id]
	return r ~= nil and r.alive
end

-- Primary trail owner of a cell (0 = none).
function ArenaSim.trailOwnerAt(self: ArenaSim, x: number, y: number): number
	return buffer.readu8(self.trailOwner, y * self.size + x)
end

-- Every trail owner of a cell (normally 0 or 1 entries).
function ArenaSim.trailOwnersAt(self: ArenaSim, i: number): { number }
	local out = {}
	local p = buffer.readu8(self.trailOwner, i)
	if p ~= 0 then
		table.insert(out, p)
	end
	local ex = self.extra[i]
	if ex then
		for _, o in ex do
			table.insert(out, o)
		end
	end
	return out
end

return ArenaSim
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000000000000000000000000000003">
				<Properties>
					<string name="Name">BotBrain</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Engine-free bot decision module (GDD G10). One brain state per bot; `step` is called every
-- simulation tick and returns a 4-direction unit step. Decisions are planned per cell, so repeated
-- calls while the bot's cell is unchanged return the same step (unless a threat flips the mode).
local Config = require(script.Parent.Config)
local Grid = require(script.Parent.Grid)
local ArenaSim = require(script.Parent.ArenaSim)

local BotBrain = {}

export type TierConfig = { LoopMin: number, LoopMax: number, Reaction: number }

type Cell = { x: number, y: number }

export type State = {
	tier: TierConfig,
	rng: () -> number,
	plan: { Cell }?,
	planIdx: number,
	threatSince: number?,
	returning: boolean,
	-- decision cache, keyed by cell + trail length + mode
	cx: number,
	cy: number,
	ctrail: number,
	cmode: string,
	cdx: number,
	cdy: number,
}

local SHORT_TRAIL = 6 -- GDD G10: hunting allowed with a trail this short
local TRAIL_LIMIT_FACTOR = 4 -- trail longer than this many LoopMax forces Return
local EDGE_SEARCH_RADIUS = 10 -- cells searched around the bot for a turf edge
local MAX_EDGE_CANDIDATES = 6

local DIRS: { Cell } = { { x = 1, y = 0 }, { x = -1, y = 0 }, { x = 0, y = 1 }, { x = 0, y = -1 } }

function BotBrain.new(tierConfig: TierConfig, rng: () -> number): State
	return {
		tier = tierConfig,
		rng = rng,
		plan = nil,
		planIdx = 1,
		threatSince = nil,
		returning = false,
		cx = -1,
		cy = -1,
		ctrail = -1,
		cmode = "",
		cdx = 0,
		cdy = 0,
	}
end

function BotBrain.reset(state: State)
	state.plan = nil
	state.planIdx = 1
	state.threatSince = nil
	state.returning = false
	state.cx = -1
	state.cy = -1
	state.ctrail = -1
	state.cmode = ""
	state.cdx = 0
	state.cdy = 0
end

local function stepToward(x: number, y: number, tx: number, ty: number): (number, number)
	local ddx, ddy = tx - x, ty - y
	if ddx ~= 0 and math.abs(ddx) >= math.abs(ddy) then
		return (ddx > 0 and 1 or -1), 0
	end
	if ddy ~= 0 then
		return 0, (ddy > 0 and 1 or -1)
	end
	return 0, 0
end

local function consider(
	grid: Grid.Grid,
	id: number,
	x: number,
	y: number,
	cx: number,
	cy: number,
	bestD: number,
	bx: number,
	by: number
): (number, number, number)
	if cx >= 0 and cy >= 0 and cx < grid.size and cy < grid.size and grid:get(cx, cy) == id then
		local d = math.abs(cx - x) + math.abs(cy - y)
		if d < bestD then
			return d, cx, cy
		end
	end
	return bestD, bx, by
end

-- Nearest own cell by bounded ring search around (x, y), limited by the owner's bounding box.
local function nearestOwn(grid: Grid.Grid, id: number, x: number, y: number): (number?, number?)
	if grid:get(x, y) == id then
		return x, y
	end
	local x0, y0, x1, y1 = grid:bounds(id)
	if x0 == nil or y0 == nil or x1 == nil or y1 == nil then
		return nil, nil
	end
	local dmin = math.max(0, x0 - x, x - x1, y0 - y, y - y1)
	local rMax = math.min(grid.size, dmin + math.max(x1 - x0, y1 - y0) + 1)
	for r = math.max(1, dmin), rMax do
		local bestD, bx, by = math.huge, -1, -1
		for ox = -r, r do
			bestD, bx, by = consider(grid, id, x, y, x + ox, y - r, bestD, bx, by)
			bestD, bx, by = consider(grid, id, x, y, x + ox, y + r, bestD, bx, by)
		end
		for oy = -r + 1, r - 1 do
			bestD, bx, by = consider(grid, id, x, y, x - r, y + oy, bestD, bx, by)
			bestD, bx, by = consider(grid, id, x, y, x + r, y + oy, bestD, bx, by)
		end
		if bx >= 0 then
			return bx, by
		end
	end
	return nil, nil
end

local function isEdge(grid: Grid.Grid, id: number, x: number, y: number): boolean
	if grid:get(x, y) ~= id then
		return false
	end
	for _, d in DIRS do
		local nx, ny = x + d.x, y + d.y
		if grid:inBounds(nx, ny) and grid:get(nx, ny) ~= id then
			return true
		end
	end
	return false
end

-- Cells from (ex, ey) to the grid border going in direction (dx, dy).
local function room(size: number, ex: number, ey: number, dx: number, dy: number): number
	if dx == 1 then
		return size - 1 - ex
	elseif dx == -1 then
		return ex
	elseif dy == 1 then
		return size - 1 - ey
	end
	return ey
end

-- Rectangular loop: edge cell, out `a`, sideways `b`, back `a`. Never leaves the grid.
local function makePlan(state: State, grid: Grid.Grid, id: number, x: number, y: number): { Cell }?
	local tier, rng, size = state.tier, state.rng, grid.size
	local span = tier.LoopMax - tier.LoopMin + 1
	local a0 = math.min(tier.LoopMax, tier.LoopMin + math.floor(rng() * span))
	local b0 = math.min(tier.LoopMax, tier.LoopMin + math.floor(rng() * span))

	local cands: { { x: number, y: number, d: number } } = {}
	for ey = math.max(0, y - EDGE_SEARCH_RADIUS), math.min(size - 1, y + EDGE_SEARCH_RADIUS) do
		for ex = math.max(0, x - EDGE_SEARCH_RADIUS), math.min(size - 1, x + EDGE_SEARCH_RADIUS) do
			if isEdge(grid, id, ex, ey) then
				table.insert(cands, { x = ex, y = ey, d = math.abs(ex - x) + math.abs(ey - y) })
			end
		end
	end
	table.sort(cands, function(p, q)
		return p.d < q.d
	end)

	local best: { Cell }? = nil
	local bestScore = -math.huge
	for ci = 1, math.min(#cands, MAX_EDGE_CANDIDATES) do
		local c = cands[ci]
		for _, d in DIRS do
			local nx, ny = c.x + d.x, c.y + d.y
			if grid:inBounds(nx, ny) and grid:get(nx, ny) ~= id then
				local a = math.min(a0, room(size, c.x, c.y, d.x, d.y))
				if a >= 2 then
					-- pick the sideways direction: prefer ending back on own turf, then more room
					local bestSide: Cell? = nil
					local bestB = 0
					local bestSideScore = -math.huge
					for sgn = -1, 1, 2 do
						local sx, sy = d.y * sgn, d.x * sgn
						local rb = room(size, c.x, c.y, sx, sy)
						local b = math.min(b0, rb)
						if b >= 1 then
							local own = grid:get(c.x + sx * b, c.y + sy * b) == id
							local s = (own and 1000 or 0) + rb + rng() * 0.5
							if s > bestSideScore then
								bestSideScore = s
								bestSide = { x = sx, y = sy }
								bestB = b
							end
						end
					end
					if bestSide ~= nil then
						local sx, sy = bestSide.x, bestSide.y
						local free = 0
						for i = 1, a do
							for j = 0, bestB do
								if grid:get(c.x + d.x * i + sx * j, c.y + d.y * i + sy * j) ~= id then
									free += 1
								end
							end
						end
						local score = free + rng() * 1.5
						if score > bestScore then
							bestScore = score
							local w1x, w1y = c.x + d.x * a, c.y + d.y * a
							local w2x, w2y = w1x + sx * bestB, w1y + sy * bestB
							best = {
								{ x = c.x, y = c.y },
								{ x = w1x, y = w1y },
								{ x = w2x, y = w2y },
								{ x = c.x + sx * bestB, y = c.y + sy * bestB },
							}
						end
					end
				end
			end
		end
	end
	return best
end

-- Is another alive runner within `radius` (Chebyshev) of the bot or any cell of its trail?
local function threatened(sim: ArenaSim.ArenaSim, id: number, x: number, y: number, trail: { number }, radius: number): boolean
	local size = sim.grid.size
	local minX, maxX, minY, maxY = x, x, y, y
	for _, i in trail do
		local cx, cy = i % size, i // size
		minX, maxX = math.min(minX, cx), math.max(maxX, cx)
		minY, maxY = math.min(minY, cy), math.max(maxY, cy)
	end
	for _, o in sim:runners() do
		if o.id ~= id and o.alive then
			local ox, oy = o.x, o.y
			if ox >= minX - radius and ox <= maxX + radius and oy >= minY - radius and oy <= maxY + radius then
				if math.max(math.abs(ox - x), math.abs(oy - y)) <= radius then
					return true
				end
				for _, i in trail do
					if math.max(math.abs(ox - i % size), math.abs(oy - i // size)) <= radius then
						return true
					end
				end
			end
		end
	end
	return false
end

-- Nearest cut-able enemy trail cell within HuntRadius that beats the bot's own way home.
local function findHunt(sim: ArenaSim.ArenaSim, id: number, x: number, y: number, tlen: number, now: number): (number?, number?)
	local grid = sim.grid
	local size = grid.size
	local radius = Config.Bots.HuntRadius
	local homeDist = math.huge
	if tlen > 0 then
		local hx, hy = nearestOwn(grid, id, x, y)
		if hx ~= nil and hy ~= nil then
			homeDist = math.abs(hx - x) + math.abs(hy - y)
		end
	end
	local best, bx, by = math.huge, nil, nil
	for _, o in sim:runners() do
		if o.id ~= id and o.alive and now >= o.shieldUntil then
			for _, i in o.trail do
				local cx, cy = i % size, i // size
				if math.max(math.abs(cx - x), math.abs(cy - y)) <= radius then
					local d = math.abs(cx - x) + math.abs(cy - y)
					if d > 0 and d < best then
						best, bx, by = d, cx, cy
					end
				end
			end
		end
	end
	if bx ~= nil and (tlen == 0 or best < homeDist) then
		return bx, by
	end
	return nil, nil
end

local function wander(state: State, size: number, x: number, y: number): (number, number)
	local c = size // 2
	if x ~= c or y ~= c then
		return stepToward(x, y, c, c)
	end
	local d = DIRS[1 + math.floor(state.rng() * #DIRS) % #DIRS]
	return d.x, d.y
end

local function goHome(state: State, grid: Grid.Grid, id: number, x: number, y: number): (number, number)
	local tx, ty = nearestOwn(grid, id, x, y)
	if tx == nil or ty == nil then
		return wander(state, grid.size, x, y)
	end
	return stepToward(x, y, tx, ty)
end

function BotBrain.step(state: State, sim: ArenaSim.ArenaSim, id: number, now: number): (number, number)
	local r = sim:runner(id)
	if r == nil or not r.alive or r.pending then
		BotBrain.reset(state)
		return 0, 0
	end
	local grid = sim.grid
	local size = grid.size
	local x = math.clamp(math.floor(r.x), 0, size - 1)
	local y = math.clamp(math.floor(r.y), 0, size - 1)
	local tlen = #r.trail
	local tier = state.tier

	-- threat tracking (only meaningful while carrying a trail)
	if tlen == 0 then
		state.returning = false
		state.threatSince = nil
	elseif threatened(sim, id, x, y, r.trail, Config.Bots.ThreatRadius) then
		local since = state.threatSince
		if since == nil then
			since = now
			state.threatSince = now
		end
		if now - since >= tier.Reaction then
			state.returning = true
		end
	else
		state.threatSince = nil
	end

	local mode = "free"
	if grid:count(id) == 0 then
		mode = "wander"
	elseif state.returning or tlen > tier.LoopMax * TRAIL_LIMIT_FACTOR then
		mode = "return"
	end

	if state.cx == x and state.cy == y and state.ctrail == tlen and state.cmode == mode then
		return state.cdx, state.cdy
	end

	local dx, dy = 0, 0
	if mode == "wander" then
		state.plan = nil
		dx, dy = wander(state, size, x, y)
	elseif mode == "return" then
		state.plan = nil
		dx, dy = goHome(state, grid, id, x, y)
	else
		local hx, hy = nil, nil
		if tlen <= SHORT_TRAIL then
			hx, hy = findHunt(sim, id, x, y, tlen, now)
		end
		if hx ~= nil and hy ~= nil then
			state.plan = nil
			dx, dy = stepToward(x, y, hx, hy)
		else
			-- advance along the loop waypoints
			local plan = state.plan
			if plan ~= nil then
				local idx = state.planIdx
				while idx <= #plan and plan[idx].x == x and plan[idx].y == y do
					idx += 1
				end
				state.planIdx = idx
				if idx > #plan then
					state.plan = nil
					plan = nil
				else
					dx, dy = stepToward(x, y, plan[idx].x, plan[idx].y)
				end
			end
			if plan == nil then
				if tlen > 0 or grid:get(x, y) ~= id then
					dx, dy = goHome(state, grid, id, x, y)
				else
					local newPlan = makePlan(state, grid, id, x, y)
					if newPlan ~= nil then
						state.plan = newPlan
						state.planIdx = 1
						local idx = 1
						while idx <= #newPlan and newPlan[idx].x == x and newPlan[idx].y == y do
							idx += 1
						end
						state.planIdx = idx
						dx, dy = stepToward(x, y, newPlan[idx].x, newPlan[idx].y)
					else
						dx, dy = wander(state, size, x, y)
					end
				end
			end
		end
	end

	-- safety: never leave the grid
	if not grid:inBounds(x + dx, y + dy) then
		state.plan = nil
		dx, dy = wander(state, size, x, y)
		if not grid:inBounds(x + dx, y + dy) then
			dx, dy = 0, 0
			for _, d in DIRS do
				if grid:inBounds(x + d.x, y + d.y) then
					dx, dy = d.x, d.y
					break
				end
			end
		end
	end

	state.cx, state.cy, state.ctrail, state.cmode = x, y, tlen, mode
	state.cdx, state.cdy = dx, dy
	return dx, dy
end

return BotBrain
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000000000000000000000000000004">
				<Properties>
					<string name="Name">Catalog</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Static cosmetics, quests and reward tables, plus deterministic lookup helpers.
local Config = require(script.Parent.Config)

export type Item = {
	id: string,
	name: string,
	type: string, -- "skin" | "trail" | "effect"
	rarity: string, -- "common" | "rare" | "epic" | "legendary" | "crown" | "exclusive"
	colorA: string,
	colorB: string?,
	pattern: string, -- "solid" | "stripes" | "dots" | "checker" | "waves" | "stars" | "hex"
	crownsRequired: number?,
	source: string?, -- "vip" | "neonPack" | "starterPack" | "group" | "daily7"
	default: boolean?,
}

export type Reward = { currency: string, amount: number }
export type Quest = { id: string, kind: string, target: number, reward: Reward }

local Catalog = {}

local items: { Item } = {}
local itemsById: { [string]: Item } = {}

local function add(
	itemType: string,
	rarity: string,
	id: string,
	name: string,
	colorA: string,
	colorB: string?,
	pattern: string?,
	extra: { crownsRequired: number?, source: string?, default: boolean? }?
)
	assert(itemsById[id] == nil, "duplicate item id " .. id)
	local item: Item = {
		id = id,
		name = name,
		type = itemType,
		rarity = rarity,
		colorA = colorA,
		colorB = colorB,
		pattern = pattern or "solid",
	}
	if extra then
		item.crownsRequired = extra.crownsRequired
		item.source = extra.source
		item.default = extra.default
	end
	table.insert(items, item)
	itemsById[id] = item
end

-- Defaults owned by everyone
add("skin", "common", "default", "Runner Colour", "#FFFFFF", nil, "solid", { default = true })
add("trail", "common", "default_trail", "Plain Trail", "#FFFFFF", nil, "solid", { default = true })
add("effect", "common", "sparkle", "Sparkle", "#FFE88A", "#FFFFFF", "stars", { default = true })

-- Turf skins: common
local commonSkins = {
	{ "sky_blue", "Sky Blue", "#7CC4FF", nil, "solid" },
	{ "mint_fresh", "Mint Fresh", "#8FF0C8", nil, "solid" },
	{ "lemon_pop", "Lemon Pop", "#FFF07A", nil, "solid" },
	{ "peach_fuzz", "Peach Fuzz", "#FFB59A", nil, "solid" },
	{ "grape_soda", "Grape Soda", "#B58CFF", nil, "solid" },
	{ "bubblegum", "Bubblegum", "#FF9ACB", nil, "solid" },
	{ "lime_zest", "Lime Zest", "#B6E33B", nil, "solid" },
	{ "coral_reef", "Coral Reef", "#FF7A6B", nil, "solid" },
	{ "sandy_beach", "Sandy Beach", "#F2D9A0", "#E8C37A", "stripes" },
	{ "teal_tide", "Teal Tide", "#2DD4BF", "#7CE8DA", "waves" },
	{ "cherry_dots", "Cherry Dots", "#FF4D4D", "#FFFFFF", "dots" },
	{ "slate_check", "Slate Check", "#6B7A99", "#9AA7C2", "checker" },
}
for _, r in commonSkins do
	add("skin", "common", r[1], r[2], r[3], r[4], r[5])
end

local rareSkins = {
	{ "candy_stripe", "Candy Stripe", "#FF4F8B", "#FFFFFF", "stripes" },
	{ "ocean_waves", "Ocean Waves", "#3D8BFF", "#9DD3FF", "waves" },
	{ "forest_hex", "Forest Hex", "#2E9E5B", "#8FE3A8", "hex" },
	{ "sunny_dots", "Sunny Dots", "#FFC83D", "#FF8A3D", "dots" },
	{ "berry_checker", "Berry Checker", "#7C5CFF", "#C9B8FF", "checker" },
	{ "starry_night", "Starry Night", "#2B3A8C", "#FFE88A", "stars" },
	{ "tangerine_wave", "Tangerine Wave", "#FF8A3D", "#FFD2A8", "waves" },
	{ "frosty_hex", "Frosty Hex", "#BDEBFF", "#FFFFFF", "hex" },
}
for _, r in rareSkins do
	add("skin", "rare", r[1], r[2], r[3], r[4], r[5])
end

local epicSkins = {
	{ "aurora", "Aurora", "#4ADE80", "#7C5CFF", "waves" },
	{ "lava_lamp", "Lava Lamp", "#FF4D4D", "#FFC83D", "waves" },
	{ "galaxy_swirl", "Galaxy Swirl", "#2B1F6B", "#C45CFF", "stars" },
	{ "disco_floor", "Disco Floor", "#FF5CD6", "#3DDCFF", "checker" },
	{ "jungle_gems", "Jungle Gems", "#1F8A4C", "#B6E33B", "hex" },
	{ "cotton_clouds", "Cotton Clouds", "#FFB8E0", "#B8E6FF", "dots" },
}
for _, r in epicSkins do
	add("skin", "epic", r[1], r[2], r[3], r[4], r[5])
end

local legendarySkins = {
	{ "rainbow_road", "Rainbow Road", "#FF4D4D", "#4F8BFF", "stripes" },
	{ "cosmic_crystal", "Cosmic Crystal", "#3DDCFF", "#C45CFF", "hex" },
	{ "golden_sunrise", "Golden Sunrise", "#FFC83D", "#FF4F8B", "stars" },
}
for _, r in legendarySkins do
	add("skin", "legendary", r[1], r[2], r[3], r[4], r[5])
end

local crownSkins = {
	{ "crown_bronze", "Bronze Crown", "#C98A4B", "#F0C08A", "stars", 1 },
	{ "crown_silver", "Silver Crown", "#C8D0DC", "#FFFFFF", "stars", 3 },
	{ "crown_gold", "Gold Crown", "#FFC83D", "#FFF1B0", "stars", 5 },
	{ "crown_diamond", "Diamond Crown", "#3DDCFF", "#FFFFFF", "hex", 10 },
}
for _, r in crownSkins do
	add("skin", "crown", r[1], r[2], r[3], r[4], r[5], { crownsRequired = r[6] })
end

-- Trails
add("trail", "common", "trail_pebble", "Pebble Path", "#B8C2D6", nil, "dots")
add("trail", "common", "trail_ribbon", "Ribbon", "#FF9ACB", nil, "stripes")
add("trail", "rare", "trail_bubble", "Bubble Trail", "#7CC4FF", "#FFFFFF", "dots")
add("trail", "rare", "trail_leaf", "Leaf Trail", "#4ADE80", "#B6E33B", "waves")
add("trail", "rare", "trail_ember", "Ember Trail", "#FF8A3D", "#FFC83D", "dots")
add("trail", "epic", "trail_stardust", "Stardust", "#FFE88A", "#C45CFF", "stars")
add("trail", "epic", "trail_ice", "Ice Streak", "#BDEBFF", "#3DDCFF", "hex")
add("trail", "legendary", "trail_rainbow", "Rainbow Streak", "#FF4D4D", "#4F8BFF", "stripes")

-- Capture effects
add("effect", "rare", "fireworks", "Fireworks", "#FF4F8B", "#FFC83D", "stars")
add("effect", "rare", "bubbles", "Bubbles", "#7CC4FF", "#FFFFFF", "dots")
add("effect", "epic", "lightning", "Lightning", "#FFE88A", "#4F8BFF", "stripes")
add("effect", "legendary", "hearts", "Hearts", "#FF4F8B", "#FFB8E0", "dots")

-- Exclusives (not for sale)
add("skin", "exclusive", "starter_spark", "Starter Spark", "#FFC83D", "#FF8A3D", "stars", { source = "starterPack" })
add("skin", "exclusive", "vip_gold", "VIP Gold", "#FFC83D", "#FFF1B0", "hex", { source = "vip" })
add("trail", "exclusive", "vip_gold_trail", "VIP Gold Trail", "#FFC83D", "#FFF1B0", "stars", { source = "vip" })
add("skin", "exclusive", "neon_pink", "Neon Pink", "#FF2E9A", "#FFB3E0", "stripes", { source = "neonPack" })
add("skin", "exclusive", "neon_cyan", "Neon Cyan", "#00F0FF", "#B3FBFF", "waves", { source = "neonPack" })
add("skin", "exclusive", "neon_lime", "Neon Lime", "#B6FF00", "#E6FF99", "checker", { source = "neonPack" })
add("skin", "exclusive", "neon_purple", "Neon Purple", "#B026FF", "#E0B3FF", "hex", { source = "neonPack" })
add("skin", "exclusive", "neon_orange", "Neon Orange", "#FF7A00", "#FFD1A3", "dots", { source = "neonPack" })
add("trail", "exclusive", "neon_trail", "Neon Trail", "#00F0FF", "#FF2E9A", "stripes", { source = "neonPack" })
add("skin", "exclusive", "team", "Team Colours", "#4F8BFF", "#FFFFFF", "stripes", { source = "group" })
add("skin", "exclusive", "streak_week", "Week Streak", "#FF5CD6", "#FFE88A", "stars", { source = "daily7" })

Catalog.items = items

function Catalog.byId(id: string): Item?
	return itemsById[id]
end

function Catalog.ofType(itemType: string): { Item }
	local out = {}
	for _, item in items do
		if item.type == itemType then
			table.insert(out, item)
		end
	end
	return out
end

local function isPurchasable(item: Item): boolean
	return item.default ~= true and item.source == nil and item.crownsRequired == nil and Config.Prices[item.rarity :: any] ~= nil
end
Catalog.isPurchasable = isPurchasable

-- Seeded deterministic PRNG (Park-Miller); no global random state.
local function makeRng(seed: number)
	local state = seed % 2147483646 + 1
	return function(n: number): number -- uniform integer in [1, n]
		state = state * 48271 % 2147483647
		return state % n + 1
	end
end

local function shuffle<T>(list: { T }, rng: (number) -> number): { T }
	local out = table.clone(list)
	for i = #out, 2, -1 do
		local j = rng(i)
		out[i], out[j] = out[j], out[i]
	end
	return out
end

function Catalog.featured(dayNumber: number): { string }
	local ids = {}
	for _, item in items do
		if isPurchasable(item) then
			table.insert(ids, item.id)
		end
	end
	local rng = makeRng(dayNumber * 7919 + 13)
	local shuffled = shuffle(ids, rng)
	local out = {}
	for i = 1, Config.Prices.FeaturedCount do
		out[i] = shuffled[i]
	end
	return out
end

-- Daily quest pool (G5)
local function q(id: string, kind: string, target: number, currency: string, amount: number): Quest
	return { id = id, kind = kind, target = target, reward = { currency = currency, amount = amount } }
end
Catalog.quests = {
	q("cells_500", "cells", 500, "coins", 300),
	q("cells_1500", "cells", 1500, "coins", 700),
	q("cells_4000", "cells", 4000, "coins", 1500),
	q("kills_3", "kills", 3, "coins", 500),
	q("kills_8", "kills", 8, "gems", 20),
	q("bigcap_100", "bigCapture", 100, "coins", 400),
	q("bigcap_300", "bigCapture", 300, "gems", 15),
	q("map_5", "mapPct", 5, "coins", 600),
	q("map_10", "mapPct", 10, "gems", 25),
	q("king_30", "kingSeconds", 30, "coins", 500),
	q("king_120", "kingSeconds", 120, "gems", 20),
	q("play_10", "playMinutes", 10, "coins", 300),
	q("play_20", "playMinutes", 20, "gems", 10),
}

Catalog.questKinds = { "cells", "kills", "bigCapture", "mapPct", "kingSeconds", "playMinutes" }

function Catalog.questsForDay(dayNumber: number, userId: number): { Quest }
	local rng = makeRng(dayNumber * 104729 + userId * 31 + 7)
	local kinds = shuffle(Catalog.questKinds, rng)
	local out = {}
	for i = 1, 3 do
		local pool = {}
		for _, quest in Catalog.quests do
			if quest.kind == kinds[i] then
				table.insert(pool, quest)
			end
		end
		out[i] = pool[rng(#pool)]
	end
	return out
end

-- Daily streak rewards, day 1..7. Day 7 also grants a rare skin on the first loop only.
Catalog.daily = {
	{ currency = "coins", amount = 250 },
	{ currency = "coins", amount = 500 },
	{ currency = "gems", amount = 20 },
	{ currency = "coins", amount = 1000 },
	{ currency = "gems", amount = 40 },
	{ currency = "coins", amount = 2500 },
	{ currency = "gems", amount = 100, skin = "streak_week" },
}

-- Per-session playtime rewards
Catalog.playtime = {
	{ seconds = 120, currency = "coins", amount = 100 },
	{ seconds = 300, currency = "coins", amount = 250 },
	{ seconds = 600, currency = "gems", amount = 10 },
	{ seconds = 1200, currency = "coins", amount = 1000 },
	{ seconds = 1800, currency = "gems", amount = 30 },
}

-- Keys are upper-case; compare against string.upper(input)
Catalog.codes = {
	RELEASE = { currency = "coins", amount = 1000 },
	TURF = { currency = "gems", amount = 25 },
}

Catalog.badges = {
	{ key = "firstLoop", name = "First Loop" },
	{ key = "firstCut", name = "First Cut" },
	{ key = "king", name = "King" },
	{ key = "map10", name = "10% Map" },
	{ key = "map50", name = "50% Map" },
	{ key = "map100", name = "100% Map" },
	{ key = "firstRebirth", name = "First Rebirth" },
	{ key = "streak7", name = "7-Day Streak" },
}

return Catalog
]]></ProtectedString>
