}

-- Display-only Robux prices; they must match the Roblox dashboard.
local ROBUX = {
	products = { gemsS = 49, gemsM = 199, gemsL = 449, gemsXL = 999, boost15 = 29, starterPack = 79, secondChance = 15 },
	passes = { vip = 399, doubleCoins = 249, neonPack = 199 },
}

local RARITY_HEX: { [string]: string } = {
	common = "#B8C2D6",
	rare = "#4F8BFF",
	epic = "#C45CFF",
	legendary = "#FFC83D",
	crown = "#3DDCFF",
	exclusive = "#FF4F8B",
}

local GEM_PRODUCTS = { "gemsS", "gemsM", "gemsL", "gemsXL" }
local PASS_ORDER = { "vip", "doubleCoins", "neonPack" }
local TAB_ORDER = { "featured", "skins", "trails", "effects", "gems", "passes" }
local TAB_TYPES: { [string]: string } = { skins = "skin", trails = "trail", effects = "effect" }
local SETTING_ORDER = { "music", "sfx", "shake", "lowDetail" }

local CARD_WIDTH = 0.32
local CARD_HEIGHT_PER_WIDTH = 1.15
local CARDS_PER_ROW = 3
local PULSE_SECONDS = 1.5
local REBIRTH_CONFIRM_SECONDS = 3
local DEATH_GUARD_SECONDS = 0.5
local STARTER_DELAY = 0.6
local COUNTDOWN_STEP = 0.1
local COIN_COUNT = 6
local COIN_PX = 16
local COIN_TIME = 0.45
local COIN_STAGGER = 0.05
local AWAY_DELAY = 1.2

local theme = UiKit.theme
local PANEL_BG = Color3.fromHex(Config.Colors.UiDark)
local CARD_BG = PANEL_BG:Lerp(theme.UiLight, 0.1)
local DIM = Color3.fromRGB(95, 104, 128)
local TRACK = PANEL_BG:Lerp(Color3.new(0, 0, 0), 0.4)

local PanelController = {}
PanelController.onSound = nil :: ((name: string) -> ())?

function PanelController.sound(name: string)
	local hook = PanelController.onSound
	if hook then
		hook(name)
	end
end
local sound = PanelController.sound

function PanelController.errorText(key: any): string
	if type(key) == "string" then
		local text = ERRORS[key]
		if text then
			return text
		end
	end
	return S.genericError
end
local errorText = PanelController.errorText

local function currencyWord(currency: string): string
	return if currency == "gems" then S.currencyGems else S.currencyCoins
end

function PanelController.rewardText(result: any, fallback: string): string
	if type(result) == "table" and type(result.amount) == "number" and type(result.currency) == "string" then
		return string.format(S.rewardText, UiKit.formatNumber(result.amount), currencyWord(result.currency))
	end
	return fallback
end

-- Helpers -----------------------------------------------------------------------------------

local function toastGood(text: string)
	UiKit.toast(text, theme.Success)
end

local function toastBad(text: string)
	UiKit.toast(text, theme.Danger)
end

local function round(x: number): number
	return math.floor(x + 0.5)
end

local function formatClock(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

local function squash(btn: GuiObject)
	local s = btn:FindFirstChild("ButtonScale")
	if s and s:IsA("UIScale") then
		s.Scale = 0.82
		TweenService:Create(s, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
end

local function pulseFor(inst: GuiObject, seconds: number)
	UiKit.pulse(inst)
	task.delay(seconds, function()
		UiKit.stopPulse(inst)
	end)
end

-- Coin shower: a few pooled Frames fly from the HUD wallet to the pressed button.
local coinFrames: { Frame } = {}

local function coinShower(target: GuiObject, currency: string?)
	local playerGui = Players.LocalPlayer:FindFirstChild("PlayerGui")
	local hud = playerGui and playerGui:FindFirstChild("Hud")
	local wallet = hud and hud:FindFirstChild("Wallet")
	if wallet == nil or not wallet:IsA("GuiObject") then
		return
	end
	local walletGui = wallet :: GuiObject
	if #coinFrames == 0 then
		local gui = UiKit.screenGui("CoinShower", 90)
		for i = 1, COIN_COUNT do
			local f = UiKit.frame({
				Name = "Coin" .. i,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(COIN_PX, COIN_PX),
				Visible = false,
				parent = gui,
			})
			UiKit.corner(f, 100)
			UiKit.stroke(f, theme.UiDark, 2)
			coinFrames[i] = f
		end
	end
	local from = walletGui.AbsolutePosition + walletGui.AbsoluteSize * Vector2.new(0.1, 0.17)
	local to = target.AbsolutePosition + target.AbsoluteSize * 0.5
	local color = if currency == "gems" then theme.Gem else theme.Yellow
	for i, f in coinFrames do
		local delay = (i - 1) * COIN_STAGGER
		task.delay(delay, function()
			f.BackgroundColor3 = color
			f.Position = UDim2.fromOffset(from.X, from.Y)
			f.Visible = true
			TweenService:Create(f, TweenInfo.new(COIN_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
				Position = UDim2.fromOffset(to.X, to.Y),
			}):Play()
		end)
		task.delay(delay + COIN_TIME, function()
			f.Visible = false
		end)
	end
end

local function button(props: {
	text: string?,
	color: Color3?,
	size: UDim2?,
	position: UDim2?,
	parent: Instance?,
	onClick: (() -> ())?,
}): TextButton
	local onClick = props.onClick
	props.onClick = function()
		sound("click")
		if onClick then
			onClick()
		end
	end
	return UiKit.button(props)
end

local function styleButton(btn: TextButton, text: string, color: Color3, dim: boolean)
	btn.Text = text
	btn.BackgroundColor3 = if dim then DIM else color
	btn.TextColor3 = if dim then theme.UiLight else theme.UiDark
end

local function currencyColor(currency: string): Color3
	return if currency == "gems" then theme.Gem else theme.Yellow
end

local function plainLabel(parent: Instance, text: string, pos: UDim2, size: UDim2, align: Enum.TextXAlignment?): TextLabel
	return UiKit.label({
		Text = text,
		Position = pos,
		Size = size,
		TextXAlignment = align or Enum.TextXAlignment.Left,
		parent = parent,
	})
end

local function bar(parent: Instance, pos: UDim2, size: UDim2): (Frame, Frame, TextLabel)
	local track = UiKit.frame({ Name = "Track", Position = pos, Size = size, BackgroundColor3 = TRACK, parent = parent })
	UiKit.corner(track, 100)
	local fill = UiKit.frame({ Name = "Fill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = theme.Success, parent = track })
	UiKit.corner(fill, 100)
	local text = UiKit.label({
		Name = "Text",
		Size = UDim2.fromScale(0.9, 0.8),
		Position = UDim2.fromScale(0.05, 0.1),
		ZIndex = 2,
		parent = track,
	})
	return track, fill, text
end

local function promptProduct(key: string)
	local id = (Config.Ids.Products :: any)[key]
	if type(id) ~= "number" or id == 0 then
		UiKit.toast(S.comingSoon)
		return
	end
	MarketplaceService:PromptProductPurchase(Players.LocalPlayer, id)
end

local function promptPass(key: string)
	local id = (Config.Ids.Passes :: any)[key]
	if type(id) ~= "number" or id == 0 then
		UiKit.toast(S.comingSoon)
		return
	end
	MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, id)
end

-- Registry ----------------------------------------------------------------------------------

type PanelEntry = { panel: UiKit.Panel, refresh: () -> () }

local built: { [string]: PanelEntry } = {}
local builders: { [string]: () -> PanelEntry } = {}
local started = false

local function ensure(name: string): PanelEntry?
	local entry = built[name]
	if entry then
		return entry
	end
	local builder = builders[name]
	if builder == nil then
		return nil
	end
	entry = builder()
	built[name] = entry
	return entry
end

local setShopTab: ((tab: string) -> ())? = nil

-- Upgrades ----------------------------------------------------------------------------------

local function upgradeLevel(p: Types.Profile, id: string): number
	return (p.upgrades :: any)[id] or 0
end

local function upgradeValueText(id: string, value: number): string
	if id == "startSize" then
		return string.format(S.cellsValue, value)
	elseif id == "shield" then
		return string.format(S.secondsValue, value)
	end
	return string.format(S.speedValue, round((value - 1) * 100))
end

local function buildUpgrades(): PanelEntry
	local panel = UiKit.panel({ title = S.upgradesTitle })
	local body = panel.body
	local list = UiKit.frame({
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.03, 0.03),
		Size = UDim2.fromScale(0.94, 0.75),
		parent = body,
	})
	UiKit.list(list, { Padding = UDim.new(0.02, 0) })

	local footWrap = UiKit.frame({
		Name = "FooterWrap",
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.03, 0.82),
		Size = UDim2.fromScale(0.94, 0.14),
		parent = body,
	})
	local footer = button({
		text = S.passFooter,
		color = theme.Pink,
		size = UDim2.fromScale(1, 1),
		parent = footWrap,
		onClick = function()
			promptPass("doubleCoins")
		end,
	})
	footer.TextColor3 = theme.UiLight

	type Row = { id: string, level: TextLabel, value: TextLabel, cost: TextButton }
	local rows: { Row } = {}
	local busy = false

	for i, id in Config.UpgradeOrder do
		local row = UiKit.frame({
			Name = id,
			Size = UDim2.fromScale(1, 0.235),
			BackgroundColor3 = CARD_BG,
			LayoutOrder = i,
			parent = list,
		})
		UiKit.corner(row, 12)
		plainLabel(row, S.upgradeNames[id], UDim2.fromScale(0.03, 0.08), UDim2.fromScale(0.33, 0.45))
		local level = plainLabel(row, "", UDim2.fromScale(0.03, 0.56), UDim2.fromScale(0.33, 0.32))
		level.TextTransparency = 0.25
		local value = plainLabel(row, "", UDim2.fromScale(0.38, 0.2), UDim2.fromScale(0.3, 0.6), Enum.TextXAlignment.Center)
		local cost: TextButton = nil :: any
		cost = button({
			text = "",
			size = UDim2.fromScale(0.27, 0.72),
			position = UDim2.fromScale(0.7, 0.14),
			parent = row,
			onClick = function()
				local p = ClientState.profile
				if busy or p == nil then
					return
				end
				local price = Formulas.upgradeCost(id, upgradeLevel(p, id))
				if price == nil then
					return
				end
				if p.coins < price then
					sound("error")
					toastBad(S.notEnoughCoins)
					pulseFor(footWrap, PULSE_SECONDS)
					return
				end
				busy = true
				local ok, result = ClientState.request(Remotes.Requests.BuyUpgrade, id)
				busy = false
				if ok then
					squash(cost)
					coinShower(cost, "coins")
					sound("buy")
					toastGood(string.format(S.upgraded, S.upgradeNames[id]))
				else
					sound("error")
					toastBad(errorText(result))
					if result == "insufficient_funds" then
						pulseFor(footWrap, PULSE_SECONDS)
					end
				end
			end,
		})
		rows[i] = { id = id, level = level, value = value, cost = cost }
	end

	local function refresh()
		local p = ClientState.profile
		if p == nil then
			return
		end
		for _, row in rows do
			local lvl = upgradeLevel(p, row.id)
			local max = (Config.Upgrades :: any)[row.id].Max
			row.level.Text = string.format(S.upgradeLevel, lvl, max)
			local current = upgradeValueText(row.id, Formulas.upgradeValue(row.id, lvl))
			local price = Formulas.upgradeCost(row.id, lvl)
			if price == nil then
				row.value.Text = current
				styleButton(row.cost, S.upgradeMax, theme.Success, true)
			else
				local nextText = upgradeValueText(row.id, Formulas.upgradeValue(row.id, lvl + 1))
				row.value.Text = string.format(S.upgradeArrow, current, nextText)
				styleButton(row.cost, string.format(S.upgradeCoins, UiKit.formatNumber(price)), theme.Yellow, p.coins < price)
			end
		end
		local owned = ClientState.session.passes.doubleCoins == true
		footer.Text = if owned then S.passFooterOwned else S.passFooter
		footer.BackgroundColor3 = if owned then DIM else theme.Pink
	end
	return { panel = panel, refresh = refresh }
end

-- Shop --------------------------------------------------------------------------------------

type CardSpec = {
	key: string,
	name: string,
	sub: string,
	subColor: Color3,
	colorA: Color3,
	colorB: Color3?,
	big: string?,
	badge: string?,
	borderColor: Color3,
	action: string,
	actionColor: Color3,
	dim: boolean,
	pulse: boolean?,
	onAction: (btn: TextButton) -> (),
}

local function makeCard(parent: Instance, spec: CardSpec, order: number)
	local card = UiKit.frame({
		Name = "Card" .. order,
		Size = UDim2.fromScale(CARD_WIDTH, 1),
		BackgroundColor3 = CARD_BG,
		LayoutOrder = order,
		parent = parent,
	})
	UiKit.corner(card, 12)
	UiKit.stroke(card, spec.borderColor, 2)
	local swatch = UiKit.frame({
		Name = "Swatch",
		Position = UDim2.fromScale(0.06, 0.04),
		Size = UDim2.fromScale(0.88, 0.42),
		BackgroundColor3 = spec.colorA,
		parent = card,
	})
	UiKit.corner(swatch, 8)
	if spec.colorB then
		local g = Instance.new("UIGradient")
		g.Color = ColorSequence.new(spec.colorA, spec.colorB)
		g.Rotation = 45
		g.Parent = swatch
	end
	if spec.big then
		UiKit.label({
			Text = spec.big,
			TextColor3 = theme.UiDark,
			Size = UDim2.fromScale(0.8, 0.5),
			Position = UDim2.fromScale(0.1, 0.25),
			parent = swatch,
		})
	end
	if spec.badge then
		local badge = UiKit.frame({
			Name = "Badge",
			Position = UDim2.fromScale(0.04, 0.06),
			Size = UDim2.fromScale(0.36, 0.26),
			BackgroundColor3 = theme.Pink,
			parent = swatch,
		})
		UiKit.corner(badge, 6)
		UiKit.label({
			Text = spec.badge,
			Size = UDim2.fromScale(0.9, 0.8),
			Position = UDim2.fromScale(0.05, 0.1),
			parent = badge,
		})
	end
	plainLabel(card, spec.name, UDim2.fromScale(0.06, 0.48), UDim2.fromScale(0.88, 0.14), Enum.TextXAlignment.Center)
	if spec.pulse then
		pulseFor(card, PULSE_SECONDS)
	end
	local sub = plainLabel(card, spec.sub, UDim2.fromScale(0.06, 0.62), UDim2.fromScale(0.88, 0.11), Enum.TextXAlignment.Center)
	sub.TextColor3 = spec.subColor
	local btn: TextButton = nil :: any
	btn = button({
		text = spec.action,
		color = spec.actionColor,
		size = UDim2.fromScale(0.88, 0.2),
		position = UDim2.fromScale(0.06, 0.76),
		parent = card,
		onClick = function()
			spec.onAction(btn)
		end,
	})
	styleButton(btn, spec.action, spec.actionColor, spec.dim)
end

local function specKey(parts: { string }): string
	return table.concat(parts, "|")
end

local function buildShop(): PanelEntry
	local panel = UiKit.panel({ title = S.shopTitle, size = UDim2.fromScale(0.66, 0.82) })
	local body = panel.body

	local tabBar = UiKit.frame({
		Name = "Tabs",
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.02, 0.015),
		Size = UDim2.fromScale(0.96, 0.095),
		parent = body,
	})
	UiKit.list(tabBar, { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0.008, 0) })

	local scroller = Instance.new("ScrollingFrame")
	scroller.Name = "Cards"
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel = 0
	scroller.Position = UDim2.fromScale(0.02, 0.125)
	scroller.Size = UDim2.fromScale(0.96, 0.86)
	scroller.CanvasSize = UDim2.new()
	scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroller.ScrollingDirection = Enum.ScrollingDirection.Y
	scroller.ScrollBarThickness = 6
	scroller.Parent = body
	-- Offset padding: a scale padding inside an AutomaticCanvasSize canvas feeds back into the canvas height.
	local rowsLayout = UiKit.list(scroller, { Padding = UDim.new(0, 8) })
	rowsLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	local tab = "featured"
	local ownedOnly = false
	local lastSig = ""
	local busy = false
	local passPulse = false
	local tabButtons: { [string]: TextButton } = {}
	local toggleButton: TextButton
	local refresh: () -> ()

	local function setTab(newTab: string)
		tab = newTab
		lastSig = ""
		refresh()
	end

	local tabWidth = (1 - 0.008 * #TAB_ORDER) / (#TAB_ORDER + 1)
	for i, id in TAB_ORDER do
		tabButtons[id] = button({
			text = S.tabs[id],
			size = UDim2.fromScale(tabWidth, 1),
			parent = tabBar,
			onClick = function()
				setTab(id)
			end,
		})
		tabButtons[id].LayoutOrder = i
	end
	toggleButton = button({
		text = S.ownedToggle,
		size = UDim2.fromScale(tabWidth, 1),
		parent = tabBar,
		onClick = function()
			ownedOnly = not ownedOnly
			if tab == "gems" or tab == "passes" then
				tab = "skins"
			end
			lastSig = ""
			refresh()
		end,
	})
	toggleButton.LayoutOrder = #TAB_ORDER + 1

	local function guarded(fn: () -> ())
		if busy then
			return
		end
		busy = true
		fn()
		busy = false
	end

	-- Insufficient coins: bring the 2x Coins pass forward (Passes tab, pulsing card) unless owned.
	local function offerCoinsPass()
		if ClientState.session.passes.doubleCoins == true then
			return
		end
		passPulse = true
		setTab("passes")
	end

	local function neonOffered(): boolean
		return Config.Ids.Passes.neonPack ~= 0 and ClientState.session.passes.neonPack ~= true
	end

	local function itemSpec(item: Catalog.Item, p: Types.Profile, featuredSet: { [string]: boolean }): CardSpec
		local owned = ClientState.owns(item.id)
		local featured = featuredSet[item.id] == true
		local rarityColor = Color3.fromHex(RARITY_HEX[item.rarity] or RARITY_HEX.common)
		local spec: CardSpec = {
			key = "",
			name = item.name,
			sub = S.rarity[item.rarity] or item.rarity,
			subColor = rarityColor,
			colorA = Color3.fromHex(item.colorA),
			colorB = if item.colorB then Color3.fromHex(item.colorB) else nil,
			big = nil,
			badge = nil,
			borderColor = rarityColor,
			action = "",
			actionColor = theme.Yellow,
			dim = true,
			onAction = function() end,
		}
		if owned then
			local isEquipped = (p.equipped :: any)[item.type] == item.id
			spec.action = if isEquipped then S.equipped else S.equip
			spec.actionColor = theme.Success
			spec.dim = isEquipped
			spec.onAction = function(btn: TextButton)
				if isEquipped then
					return
				end
				guarded(function()
					local ok, result = ClientState.request(Remotes.Requests.Equip, item.id)
					if ok then
						squash(btn)
						toastGood(string.format(S.equippedToast, item.name))
					else
						sound("error")
						toastBad(errorText(result))
					end
				end)
			end
		elseif item.crownsRequired then
			local need = item.crownsRequired
			local enough = p.crowns >= need
			spec.action = if enough then S.claimItem else string.format(S.needsCrowns, need)
			spec.actionColor = theme.Success
			spec.dim = not enough
			spec.onAction = function(btn: TextButton)
				if not enough then
					sound("error")
					toastBad(string.format(S.needsCrowns, need))
					return
				end
				guarded(function()
					local ok, result = ClientState.request(Remotes.Requests.BuyItem, item.id)
					if ok then
						squash(btn)
						sound("buy")
						toastGood(string.format(S.boughtToast, item.name))
					else
						sound("error")
						toastBad(errorText(result))
					end
				end)
			end
		elseif item.source then
			local source = item.source
			local label = S.sources[source] or source
			spec.action = label
			spec.dim = true
			spec.onAction = function()
				if source == "vip" or source == "neonPack" then
					promptPass(source)
				else
					UiKit.toast(string.format(S.unlockVia, label))
				end
			end
		else
			local price = Formulas.itemPrice(item.rarity, featured)
			if price == nil then
				spec.action = S.notForSale
			else
				local balance = if price.currency == "gems" then p.gems else p.coins
				local fmt = if price.currency == "gems" then S.priceGems else S.priceCoins
				spec.action = string.format(fmt, UiKit.formatNumber(price.amount))
				spec.actionColor = currencyColor(price.currency)
				spec.dim = balance < price.amount
				if featured then
					spec.badge = string.format(S.discount, round(Config.Prices.FeaturedDiscount * 100))
				end
				spec.onAction = function(btn: TextButton)
					local fresh = ClientState.profile
					if fresh == nil then
						return
					end
					local have = if price.currency == "gems" then fresh.gems else fresh.coins
					if have < price.amount then
						sound("error")
						toastBad(if price.currency == "gems" then S.notEnoughGems else S.notEnoughCoins)
						if price.currency == "gems" then
							setTab("gems")
						else
							offerCoinsPass()
						end
						return
					end
					guarded(function()
						local ok, result = ClientState.request(Remotes.Requests.BuyItem, item.id)
						if ok then
							squash(btn)
							coinShower(btn, price.currency)
							sound("buy")
							toastGood(string.format(S.boughtToast, item.name))
						else
							sound("error")
							toastBad(errorText(result))
							if result == "insufficient_funds" and price.currency == "coins" then
								offerCoinsPass()
							end
						end
					end)
				end
			end
		end
		spec.key = specKey({
			item.id,
			spec.action,
			if spec.dim then "d" else "a",
			spec.badge or "",
		})
		return spec
	end

	local function productSpec(key: string, name: string, sub: string, big: string, colorA: Color3, colorB: Color3?): CardSpec
		local robux = (ROBUX.products :: any)[key]
		local action = string.format(S.priceRobux, robux)
		return {
			key = specKey({ key, action }),
			name = name,
			sub = sub,
			subColor = theme.UiLight,
			colorA = colorA,
			colorB = colorB,
			big = big,
			badge = nil,
			borderColor = colorA,
			action = action,
			actionColor = theme.Yellow,
			dim = false,
			onAction = function()
				promptProduct(key)
			end,
		}
	end

	local function passSpec(key: string): CardSpec
		local owned = ClientState.session.passes[key] == true
		local robux = (ROBUX.passes :: any)[key]
		local colorA = if key == "vip" then theme.Yellow elseif key == "doubleCoins" then theme.Success else theme.Pink
		return {
			key = specKey({ key, if owned then "o" else "b" }),
			name = S.passNames[key],
			sub = S.passDescs[key],
			subColor = theme.UiLight,
			colorA = colorA,
			colorB = theme.UiLight,
			big = nil,
			badge = nil,
			borderColor = colorA,
			action = if owned then S.owned else string.format(S.priceRobux, robux),
			actionColor = theme.Yellow,
			dim = owned,
			pulse = key == "doubleCoins" and passPulse and not owned,
			onAction = function()
				if not owned then
					promptPass(key)
				end
			end,
		}
	end

	local function buildSpecs(p: Types.Profile): { CardSpec }
		local specs: { CardSpec } = {}
		if tab == "gems" then
			for _, key in GEM_PRODUCTS do
				local gems = (Config.Products :: any)[key].Gems
				local text = UiKit.formatNumber(gems)
				table.insert(specs, productSpec(key, string.format(S.gemsName, text), "", text, theme.Gem, theme.UiLight))
			end
			local minutes = round(Config.Products.boost15.Seconds / 60)
			table.insert(
				specs,
				productSpec("boost15", S.boostName, string.format(S.boostSub, minutes), Config.Income.BoostMultiplier .. "x", theme.Pink, theme.Yellow)
			)
			if not p.starterPackBought then
				local gems = UiKit.formatNumber(Config.Products.starterPack.Gems)
				table.insert(
					specs,
					productSpec("starterPack", S.starterName, string.format(S.starterSub, gems), gems, theme.Yellow, Color3.fromHex(Config.Colors.Players[2]))
				)
			end
		elseif tab == "passes" then
			for _, key in PASS_ORDER do
				table.insert(specs, passSpec(key))
			end
		else
			local featuredSet: { [string]: boolean } = {}
			for _, id in ClientState.session.featured do
				featuredSet[id] = true
			end
			local items: { Catalog.Item } = {}
			if tab == "featured" then
				for _, id in ClientState.session.featured do
					local item = Catalog.byId(id)
					if item then
						table.insert(items, item)
					end
				end
			else
				items = Catalog.ofType(TAB_TYPES[tab])
			end
			-- VIP is the top slot of Featured until owned.
			if tab == "featured" and not ownedOnly and ClientState.session.passes.vip ~= true then
				table.insert(specs, passSpec("vip"))
			end
			for _, item in items do
				if not ownedOnly or ClientState.owns(item.id) then
					table.insert(specs, itemSpec(item, p, featuredSet))
				end
			end
		end
		return specs
	end

	refresh = function()
		local p = ClientState.profile
		if p == nil then
			return
		end
		for id, btn in tabButtons do
			btn.BackgroundColor3 = if id == tab then theme.Yellow else DIM
			btn.TextColor3 = if id == tab then theme.UiDark else theme.UiLight
		end
		toggleButton.BackgroundColor3 = if ownedOnly then theme.Success else DIM
		toggleButton.TextColor3 = if ownedOnly then theme.UiDark else theme.UiLight

		local specs = buildSpecs(p)
		passPulse = false
		local keys = { tab, if ownedOnly then "own" else "all" }
		local showNeon = tab == "skins" and neonOffered()
		if showNeon then
			table.insert(keys, "neon")
		end
		for _, spec in specs do
			table.insert(keys, spec.key)
		end
		local sig = specKey(keys)
		if sig == lastSig then
			return
		end
		lastSig = sig
		local canvasPos = scroller.CanvasPosition
		for _, child in scroller:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		if showNeon then
			local banner = button({
				text = string.format(S.neonBanner, ROBUX.passes.neonPack),
				color = theme.Pink,
				size = UDim2.new(0.98, 0, 0, 44),
				parent = scroller,
				onClick = function()
					promptPass("neonPack")
				end,
			})
			banner.Name = "NeonBanner"
			banner.TextColor3 = theme.UiLight
			banner.LayoutOrder = 0
		end
		if #specs == 0 then
			local empty = UiKit.label({
				Name = "Empty",
				Text = S.emptyTab,
				Size = UDim2.fromScale(0.8, 0.12),
				TextTransparency = 0.3,
				parent = scroller,
			})
			empty.LayoutOrder = 1
			return
		end
		local rowCount = math.ceil(#specs / CARDS_PER_ROW)
		for r = 1, rowCount do
			local row = UiKit.frame({
				Name = "Row" .. r,
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 0),
				LayoutOrder = r,
				parent = scroller,
			})
			-- Default FitWithinMaxSize would clamp the zero-height row to 0x0; size from the canvas width instead.
			local rowAspect = UiKit.aspect(row, 1 / (CARD_WIDTH * CARD_HEIGHT_PER_WIDTH))
			rowAspect.AspectType = Enum.AspectType.ScaleWithParentSize
			rowAspect.DominantAxis = Enum.DominantAxis.Width
			UiKit.list(row, { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new((1 - CARD_WIDTH * CARDS_PER_ROW) / (CARDS_PER_ROW - 1), 0) })
			for c = 1, CARDS_PER_ROW do
				local spec = specs[(r - 1) * CARDS_PER_ROW + c]
				if spec then
					makeCard(row, spec, c)
				end
			end
		end
		task.defer(function()
			scroller.CanvasPosition = canvasPos
		end)
	end

	setShopTab = setTab
	return { panel = panel, refresh = refresh }
end

-- Daily -------------------------------------------------------------------------------------

local function buildDaily(): PanelEntry
	local panel = UiKit.panel({ title = S.dailyTitle, size = UDim2.fromScale(0.7, 0.68) })
	local body = panel.body
	local days = UiKit.frame({
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.02, 0.04),
		Size = UDim2.fromScale(0.96, 0.62),
		parent = body,
	})
	local count = #Catalog.daily
	local gap = 0.012
	UiKit.list(days, { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(gap, 0) })

	type Cell = { card: Frame, stroke: UIStroke, status: TextLabel }
	local cells: { Cell } = {}
	for i, reward in Catalog.daily do
		local card = UiKit.frame({
			Name = "Day" .. i,
			Size = UDim2.fromScale((1 - gap * (count - 1)) / count, 1),
			BackgroundColor3 = CARD_BG,
			LayoutOrder = i,
			parent = days,
		})
		UiKit.corner(card, 10)
		local stroke = UiKit.stroke(card, theme.UiLight, 3)
		stroke.Enabled = false
		plainLabel(card, string.format(S.dailyDay, i), UDim2.fromScale(0.05, 0.04), UDim2.fromScale(0.9, 0.12), Enum.TextXAlignment.Center)
		local coin = UiKit.frame({
			Name = "Icon",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0.22),
			Size = UDim2.fromScale(0.78, 0.2),
			BackgroundColor3 = currencyColor(reward.currency),
			parent = card,
		})
		UiKit.corner(coin, 100)
		UiKit.aspect(coin, 1)
		UiKit.label({
			Text = UiKit.formatNumber(reward.amount),
			TextColor3 = theme.UiDark,
			Size = UDim2.fromScale(0.8, 0.4),
			Position = UDim2.fromScale(0.1, 0.3),
			parent = coin,
		})
		local word = plainLabel(card, currencyWord(reward.currency), UDim2.fromScale(0.05, 0.62), UDim2.fromScale(0.9, 0.1), Enum.TextXAlignment.Center)
		word.TextTransparency = 0.25
		local status = plainLabel(card, "", UDim2.fromScale(0.05, 0.78), UDim2.fromScale(0.9, 0.12), Enum.TextXAlignment.Center)
		cells[i] = { card = card, stroke = stroke, status = status }
	end

	local busy = false
	local claimBtn: TextButton = nil :: any
	claimBtn = button({
		text = "",
		size = UDim2.fromScale(0.5, 0.18),
		position = UDim2.fromScale(0.25, 0.74),
		parent = body,
		onClick = function()
			local state = ClientState.dailyState()
			if busy or not state.canClaim then
				return
			end
			busy = true
			local ok, result = ClientState.request(Remotes.Requests.ClaimDaily)
			busy = false
			if ok then
				squash(claimBtn)
				sound("reward")
				local day = if type(result) == "table" and type(result.streak) == "number" then result.streak else state.nextStreak
				toastGood(string.format(S.dailyClaimed, day, PanelController.rewardText(result, "")))
			else
				sound("error")
				toastBad(errorText(result))
			end
		end,
	})

	local function refresh()
		local p = ClientState.profile
		if p == nil then
			return
		end
		local state = ClientState.dailyState()
		local claimedThrough = if state.canClaim then state.nextStreak - 1 else p.daily.streak
		local today = if state.canClaim then state.nextStreak else p.daily.streak
		for i, cell in cells do
			local done = i <= claimedThrough
			cell.stroke.Enabled = i == today
			cell.stroke.Color = if state.canClaim then theme.Yellow else theme.Success
			cell.card.BackgroundColor3 = if done then PANEL_BG:Lerp(theme.Success, 0.3) else CARD_BG
			local skinNote = Catalog.daily[i].skin ~= nil and p.daily.loops == 0
			if done then
				cell.status.Text = S.dailyDone
			elseif i == today and state.canClaim then
				cell.status.Text = S.dailyToday
			elseif skinNote then
				cell.status.Text = S.dailySkin
			else
				cell.status.Text = ""
			end
		end
		if state.canClaim then
			styleButton(claimBtn, string.format(S.dailyClaim, state.nextStreak), theme.Yellow, false)
			UiKit.pulse(claimBtn)
		else
			styleButton(claimBtn, S.dailyWait, theme.Yellow, true)
			UiKit.stopPulse(claimBtn)
		end
	end
	return { panel = panel, refresh = refresh }
end

-- Quests ------------------------------------------------------------------------------------

local function buildQuests(): PanelEntry
	local panel = UiKit.panel({ title = S.questsTitle, size = UDim2.fromScale(0.66, 0.7) })
	local body = panel.body
	local hasBoost = Config.Ids.Products.boost15 ~= 0
	local list = UiKit.frame({
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.03, 0.04),
		Size = UDim2.fromScale(0.94, if hasBoost then 0.82 else 0.92),
		parent = body,
	})
	UiKit.list(list, { Padding = UDim.new(0.03, 0) })
	if hasBoost then
		local boost = button({
			text = string.format(S.boostQuest, Config.Income.BoostMultiplier, round(Config.Products.boost15.Seconds / 60)),
			color = theme.Pink,
			size = UDim2.fromScale(0.4, 0.09),
			position = UDim2.fromScale(0.57, 0.89),
			parent = body,
			onClick = function()
				promptProduct("boost15")
			end,
		})
		boost.TextColor3 = theme.UiLight
	end

	type Row = { root: Frame, desc: TextLabel, fill: Frame, progress: TextLabel, reward: TextLabel, claim: TextButton }
	local rows: { Row } = {}
	local busy = false
	for i = 1, 3 do
		local root = UiKit.frame({
			Name = "Quest" .. i,
			Size = UDim2.fromScale(1, 0.3),
			BackgroundColor3 = CARD_BG,
			LayoutOrder = i,
			parent = list,
		})
		UiKit.corner(root, 12)
		local desc = plainLabel(root, "", UDim2.fromScale(0.03, 0.08), UDim2.fromScale(0.64, 0.28))
		local _, fill, progress = bar(root, UDim2.fromScale(0.03, 0.42), UDim2.fromScale(0.64, 0.22))
		local reward = plainLabel(root, "", UDim2.fromScale(0.03, 0.7), UDim2.fromScale(0.64, 0.22))
		local claim: TextButton = nil :: any
		claim = button({
			text = S.questClaim,
			size = UDim2.fromScale(0.27, 0.6),
			position = UDim2.fromScale(0.7, 0.2),
			parent = root,
			onClick = function()
				if busy then
					return
				end
				busy = true
				local ok, result = ClientState.request(Remotes.Requests.ClaimQuest, i)
				busy = false
				if ok then
					squash(claim)
					sound("reward")
					toastGood(PanelController.rewardText(result, S.questClaimed))
				else
					sound("error")
					toastBad(errorText(result))
				end
			end,
		})
		rows[i] = { root = root, desc = desc, fill = fill, progress = progress, reward = reward, claim = claim }
	end

	local function refresh()
		local p = ClientState.profile
		if p == nil then
			return
		end
		for i, row in rows do
			local entry = p.quests.list[i]
			local def = if entry then ClientState.quest(entry.id) else nil
			if entry == nil or def == nil then
				row.root.Visible = false
			else
				row.root.Visible = true
				local progress = math.min(entry.progress, def.target)
				local template = S.questKinds[def.kind] or "%s"
				row.desc.Text = string.format(template, UiKit.formatNumber(def.target))
				row.fill.Size = UDim2.fromScale(math.clamp(entry.progress / def.target, 0, 1), 1)
				row.progress.Text = string.format(S.questProgress, UiKit.formatNumber(math.floor(progress)), UiKit.formatNumber(def.target))
				row.reward.Text = string.format(S.rewardText, UiKit.formatNumber(def.reward.amount), currencyWord(def.reward.currency))
				row.reward.TextColor3 = currencyColor(def.reward.currency)
				local complete = entry.progress >= def.target
				if entry.claimed then
					styleButton(row.claim, S.questClaimed, theme.Success, true)
				else
					styleButton(row.claim, S.questClaim, theme.Yellow, not complete)
				end
			end
		end
	end
	return { panel = panel, refresh = refresh }
end

-- Rebirth -----------------------------------------------------------------------------------

local function buildRebirth(): PanelEntry
	local panel = UiKit.panel({ title = S.rebirthTitle, size = UDim2.fromScale(0.62, 0.72) })
	local body = panel.body
	local reqLabel = plainLabel(body, "", UDim2.fromScale(0.06, 0.04), UDim2.fromScale(0.88, 0.08), Enum.TextXAlignment.Center)
	local _, fill, progress = bar(body, UDim2.fromScale(0.06, 0.15), UDim2.fromScale(0.88, 0.1))

	local function column(x: number, title: string, text: string, color: Color3): TextLabel
		local box = UiKit.frame({
			Position = UDim2.fromScale(x, 0.32),
			Size = UDim2.fromScale(0.42, 0.34),
			BackgroundColor3 = CARD_BG,
			parent = body,
		})
		UiKit.corner(box, 12)
		local t = plainLabel(box, title, UDim2.fromScale(0.06, 0.06), UDim2.fromScale(0.88, 0.22), Enum.TextXAlignment.Center)
		t.TextColor3 = color
		return plainLabel(box, text, UDim2.fromScale(0.06, 0.32), UDim2.fromScale(0.88, 0.6), Enum.TextXAlignment.Center)
	end
	column(0.06, S.rebirthResetsTitle, S.rebirthResets, theme.Danger)
	local gainText = table.concat({
		S.rebirthGainCrown,
		string.format(S.rebirthGainBonus, round(Config.Income.RebirthBonusPerCrown * 100)),
		string.format(S.rebirthGainGems, Config.Rebirth.GemReward),
	}, "\n")
	column(0.52, S.rebirthGainTitle, gainText, theme.Success)

	local armed = false
	local armToken = 0
	local busy = false
	local confirm: TextButton = nil :: any

	local function eligible(): boolean
		local p = ClientState.profile
		return p ~= nil and p.lifetimeCoinsSinceRebirth >= Formulas.rebirthRequirement(p.crowns)
	end

	local function refresh()
		local p = ClientState.profile
		if p == nil then
			return
		end
		local need = Formulas.rebirthRequirement(p.crowns)
		reqLabel.Text = string.format(S.rebirthRequirement, UiKit.formatNumber(need))
		fill.Size = UDim2.fromScale(math.clamp(p.lifetimeCoinsSinceRebirth / need, 0, 1), 1)
		progress.Text = string.format(S.rebirthProgress, UiKit.formatNumber(math.floor(p.lifetimeCoinsSinceRebirth)), UiKit.formatNumber(need))
		if armed and eligible() then
			styleButton(confirm, S.rebirthConfirm, theme.Danger, false)
			confirm.TextColor3 = theme.UiLight
		else
			armed = false
			styleButton(confirm, S.rebirthButton, theme.Pink, not eligible())
		end
	end

	confirm = button({
		text = S.rebirthButton,
		size = UDim2.fromScale(0.6, 0.18),
		position = UDim2.fromScale(0.2, 0.74),
		parent = body,
		onClick = function()
			if busy then
				return
			end
			if not eligible() then
				sound("error")
				toastBad(errorText("not_enough_coins"))
				return
			end
			if not armed then
				armed = true
				armToken += 1
				local token = armToken
				refresh()
				task.delay(REBIRTH_CONFIRM_SECONDS, function()
					if armToken == token and armed then
						armed = false
						refresh()
					end
				end)
				return
			end
			armed = false
			armToken += 1
			busy = true
			local ok, result = ClientState.request(Remotes.Requests.Rebirth)
			busy = false
			if ok then
				squash(confirm)
				sound("reward")
				sound("rebirthSwell")
				local crowns = if type(result) == "table" and type(result.crowns) == "number" then result.crowns else ClientState.profile and ClientState.profile.crowns or 0
				toastGood(string.format(S.rebirthDone, crowns))
			else
				sound("error")
				toastBad(errorText(result))
			end
			refresh()
		end,
	})
	return { panel = panel, refresh = refresh }
end

-- Codes -------------------------------------------------------------------------------------

local function buildCodes(): PanelEntry
	local panel = UiKit.panel({ title = S.codesTitle, size = UDim2.fromScale(0.5, 0.5) })
	local body = panel.body
	local box = Instance.new("TextBox")
	box.Name = "CodeBox"
	box.BackgroundColor3 = TRACK
	box.BorderSizePixel = 0
	box.Font = Enum.Font.GothamBold
	box.TextScaled = true
	box.TextColor3 = theme.UiLight
	box.PlaceholderText = S.codePlaceholder
	box.PlaceholderColor3 = DIM
	box.Text = ""
	box.ClearTextOnFocus = false
	box.Position = UDim2.fromScale(0.1, 0.18)
	box.Size = UDim2.fromScale(0.8, 0.22)
	box.Parent = body
	UiKit.corner(box, 12)
	local limit = Instance.new("UITextSizeConstraint")
	limit.MaxTextSize = 32
	limit.MinTextSize = 8
	limit.Parent = box

	local busy = false
	local redeem: TextButton = nil :: any
	redeem = button({
		text = S.codeRedeem,
		size = UDim2.fromScale(0.5, 0.22),
		position = UDim2.fromScale(0.25, 0.55),
		parent = body,
		onClick = function()
			if busy then
				return
			end
			local code = string.match(box.Text, "^%s*(.-)%s*$") or ""
			code = string.sub(code, 1, Config.Security.MaxCodeLength)
			if code == "" then
				sound("error")
				toastBad(S.codeEmpty)
				return
			end
			busy = true
			local ok, result = ClientState.request(Remotes.Requests.RedeemCode, code)
			busy = false
			if ok then
				squash(redeem)
				sound("reward")
				box.Text = ""
				toastGood(PanelController.rewardText(result, S.codeOk))
			else
				sound("error")
				toastBad(errorText(result))
			end
		end,
	})
	return { panel = panel, refresh = function() end }
end

-- Settings ----------------------------------------------------------------------------------

local function buildSettings(): PanelEntry
	local panel = UiKit.panel({ title = S.settingsTitle, size = UDim2.fromScale(0.5, 0.62) })
	local body = panel.body
	local list = UiKit.frame({
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.05, 0.05),
		Size = UDim2.fromScale(0.9, 0.9),
		parent = body,
	})
	UiKit.list(list, { Padding = UDim.new(0.03, 0) })

	local toggles: { [string]: TextButton } = {}
	local busy = false
	local function paint(btn: TextButton, on: boolean)
		styleButton(btn, if on then S.on else S.off, theme.Success, not on)
	end

	for i, key in SETTING_ORDER do
		local row = UiKit.frame({ Name = key, Size = UDim2.fromScale(1, 0.2), BackgroundColor3 = CARD_BG, LayoutOrder = i, parent = list })
		UiKit.corner(row, 12)
		plainLabel(row, S.settingNames[key], UDim2.fromScale(0.04, 0.15), UDim2.fromScale(0.6, 0.7))
		local btn: TextButton = nil :: any
		btn = button({
			text = "",
			size = UDim2.fromScale(0.28, 0.6),
			position = UDim2.fromScale(0.68, 0.2),
			parent = row,
			onClick = function()
				local p = ClientState.profile
				if busy or p == nil then
					return
				end
				local new = not ((p.settings :: any)[key] == true)
				paint(btn, new)
				busy = true
				local ok, result = ClientState.request(Remotes.Requests.SetSetting, key, new)
				busy = false
				if not ok then
					sound("error")
					toastBad(errorText(result))
					paint(btn, not new)
				end
			end,
		})
		toggles[key] = btn
	end

	local function refresh()
		local p = ClientState.profile
		if p == nil then
			return
		end
		for key, btn in toggles do
			paint(btn, (p.settings :: any)[key] == true)
		end
	end
	return { panel = panel, refresh = refresh }
end

-- Death -------------------------------------------------------------------------------------

type DeathUi = {
	stats: { [string]: TextLabel },
	killer: TextLabel,
	respawn: TextButton,
	second: TextButton,
}

local death = {
	payload = nil :: any,
	ui = nil :: DeathUi?,
	busy = false,
	frozen = false,
	token = 0,
	shownAt = 0,
	justClosed = false,
}
local starterShown = false

local function finishDeath()
	local ui = death.ui
	if ui == nil or death.busy then
		return
	end
	death.busy = true
	death.token += 1
	ui.second.Visible = false
	local payload = death.payload
	if type(payload) == "table" and payload.canSecondChance then
		ClientState.request(Remotes.Requests.DeclineSecondChance)
	end
	local ok, result = ClientState.request(Remotes.Requests.Respawn)
	if not ok then
		sound("error")
		toastBad(errorText(result))
		death.busy = false
	end
end

local function buildDeath(): PanelEntry
	local panel = UiKit.panel({ title = S.deathTitle, size = UDim2.fromScale(0.5, 0.72) })
	panel.closeButton.Visible = false
	local body = panel.body

	local stats: { [string]: TextLabel } = {}
	local statDefs = {
		{ "cells", S.deathCells },
		{ "coins", S.deathCoins },
		{ "kills", S.deathKills },
		{ "time", S.deathTime },
	}
	for i, def in statDefs do
		local row = UiKit.frame({
			Name = def[1],
			Position = UDim2.fromScale(0.08, 0.03 + (i - 1) * 0.11),
			Size = UDim2.fromScale(0.84, 0.1),
			BackgroundColor3 = CARD_BG,
			parent = body,
		})
		UiKit.corner(row, 10)
		plainLabel(row, def[2], UDim2.fromScale(0.04, 0.15), UDim2.fromScale(0.55, 0.7))
		stats[def[1]] = plainLabel(row, "", UDim2.fromScale(0.6, 0.15), UDim2.fromScale(0.36, 0.7), Enum.TextXAlignment.Right)
	end
	local killer = plainLabel(body, "", UDim2.fromScale(0.08, 0.47), UDim2.fromScale(0.84, 0.07), Enum.TextXAlignment.Center)
	killer.TextTransparency = 0.2

	local respawn = button({
		text = S.respawn,
		color = theme.Success,
		size = UDim2.fromScale(0.8, 0.2),
		position = UDim2.fromScale(0.1, 0.57),
		parent = body,
		onClick = finishDeath,
	})
	local second = button({
		text = "",
		color = theme.Pink,
		size = UDim2.fromScale(0.8, 0.15),
		position = UDim2.fromScale(0.1, 0.8),
		parent = body,
		onClick = function()
			death.frozen = true
			second.Text = string.format(S.secondChanceWaiting, ROBUX.products.secondChance)
			promptProduct("secondChance")
		end,
	})
	second.TextColor3 = theme.UiLight
	death.ui = { stats = stats, killer = killer, respawn = respawn, second = second }
	return { panel = panel, refresh = function() end }
end

local function showDeath(payload: any)
	if type(payload) ~= "table" then
		return
	end
	local entry = ensure("Death")
	local ui = death.ui
	if entry == nil or ui == nil then
		return
	end
	death.payload = payload
	death.busy = false
	death.frozen = false
	death.token += 1
	death.shownAt = os.clock()
	local token = death.token

	ui.stats.cells.Text = UiKit.formatNumber(payload.cells or 0)
	ui.stats.coins.Text = UiKit.formatNumber(payload.coins or 0)
	ui.stats.kills.Text = UiKit.formatNumber(payload.kills or 0)
	ui.stats.time.Text = formatClock(payload.lifeSeconds or 0)
	ui.killer.Text = if payload.killerName then string.format(S.deathKiller, payload.killerName) else ""
	local eligible = payload.canSecondChance == true
	ui.second.Visible = eligible
	local remaining = Config.Products.secondChance.PromptSeconds
	ui.second.Text = string.format(S.secondChance, ROBUX.products.secondChance, math.ceil(remaining))
	entry.panel.show()

	if eligible then
		task.spawn(function()
			while death.token == token do
				task.wait(COUNTDOWN_STEP)
				if death.token ~= token then
					return
				end
				if not death.frozen then
					remaining -= COUNTDOWN_STEP
					if remaining <= 0 then
						finishDeath()
						return
					end
					ui.second.Text = string.format(S.secondChance, ROBUX.products.secondChance, math.ceil(remaining))
				end
			end
		end)
	end
end

-- Starter pack offer ------------------------------------------------------------------------

local function buildStarter(): PanelEntry
	local panel = UiKit.panel({ title = S.starterTitle, size = UDim2.fromScale(0.6, 0.66) })
	local body = panel.body
	local head = plainLabel(body, S.starterHeadline, UDim2.fromScale(0.1, 0.04), UDim2.fromScale(0.8, 0.1), Enum.TextXAlignment.Center)
	head.TextColor3 = theme.Yellow

	local starter = Config.Products.starterPack
	local offers = {
		{ string.format(S.starterGems, UiKit.formatNumber(starter.Gems)), theme.Gem },
		{ string.format(S.starterCoins, UiKit.formatNumber(starter.Coins)), theme.Yellow },
		{ S.starterSkin, theme.Pink },
	}
	local width = 0.29
	local gap = (1 - width * #offers) / (#offers + 1)
	for i, offer in offers do
		local card = UiKit.frame({
			Position = UDim2.fromScale(gap + (i - 1) * (width + gap), 0.18),
			Size = UDim2.fromScale(width, 0.34),
			BackgroundColor3 = offer[2],
			parent = body,
		})
		UiKit.corner(card, 12)
		UiKit.label({
			Text = offer[1],
			TextColor3 = theme.UiDark,
			TextWrapped = true,
			Size = UDim2.fromScale(0.86, 0.6),
			Position = UDim2.fromScale(0.07, 0.2),
			parent = card,
		})
	end

	local buy = button({
		text = string.format(S.priceRobux, ROBUX.products.starterPack),
		size = UDim2.fromScale(0.6, 0.18),
		position = UDim2.fromScale(0.2, 0.58),
		parent = body,
		onClick = function()
			promptProduct("starterPack")
		end,
	})
	UiKit.pulse(buy)
	button({
		text = S.starterNo,
		color = DIM,
		size = UDim2.fromScale(0.36, 0.12),
		position = UDim2.fromScale(0.32, 0.82),
		parent = body,
		onClick = function()
			panel.hide()
		end,
	}).TextColor3 = theme.UiLight

	local function refresh()
		local p = ClientState.profile
		if p and p.starterPackBought and panel.isOpen() then
			panel.hide()
		end
	end
	return { panel = panel, refresh = refresh }
end

local function tryStarter()
	if not death.justClosed then
		return
	end
	death.justClosed = false
	local profile = ClientState.profile
	if starterShown or not ClientState.session.starterOffer or profile == nil or profile.starterOfferSeenAt ~= 0 then
		return
	end
	starterShown = true
	task.delay(STARTER_DELAY, function()
		if not ClientState.arena.alive then
			starterShown = false
			return
		end
		PanelController.open("Starter")
		ClientState.request(Remotes.Requests.StarterOfferSeen)
	end)
end

local function closeDeath()
	local entry = built.Death
	if entry == nil or not entry.panel.isOpen() then
		return
	end
	if os.clock() - death.shownAt < DEATH_GUARD_SECONDS then
		return
	end
	death.token += 1
	entry.panel.hide()
	death.justClosed = true
	tryStarter()
end

-- "While you were away" return panel ---------------------------------------------------------

local function claimableQuests(): number
	local p = ClientState.profile
	local n = 0
	if p then
		for _, entry in p.quests.list do
			local def = ClientState.quest(entry.id)
			if def and not entry.claimed and entry.progress >= def.target then
				n += 1
			end
		end
	end
	return n
end

local function buildAway(): PanelEntry
	local panel = UiKit.panel({ title = S.awayTitle, size = UDim2.fromScale(0.5, 0.5) })
	local body = panel.body
	local streak = plainLabel(body, "", UDim2.fromScale(0.08, 0.06), UDim2.fromScale(0.84, 0.16), Enum.TextXAlignment.Center)
	streak.TextColor3 = theme.Yellow

	local function row(y: number): (TextLabel, TextButton, Frame)
		local box = UiKit.frame({
			Position = UDim2.fromScale(0.08, y),
			Size = UDim2.fromScale(0.84, 0.24),
			BackgroundColor3 = CARD_BG,
			parent = body,
		})
		UiKit.corner(box, 12)
		local label = plainLabel(box, "", UDim2.fromScale(0.04, 0.15), UDim2.fromScale(0.56, 0.7))
		local btn = button({
			text = "",
			size = UDim2.fromScale(0.32, 0.6),
			position = UDim2.fromScale(0.64, 0.2),
			parent = box,
		})
		return label, btn, box
	end

	local dailyLabel, dailyBtn = row(0.28)
	local questLabel, questBtn = row(0.6)

	local busy = false
	dailyBtn.Activated:Connect(function()
		local state = ClientState.dailyState()
		if busy or not state.canClaim then
			return
		end
		busy = true
		local ok, result = ClientState.request(Remotes.Requests.ClaimDaily)
		busy = false
		if ok then
			squash(dailyBtn)
			coinShower(dailyBtn, "coins")
			sound("reward")
			local day = if type(result) == "table" and type(result.streak) == "number" then result.streak else state.nextStreak
			toastGood(string.format(S.dailyClaimed, day, PanelController.rewardText(result, "")))
		else
			sound("error")
			toastBad(errorText(result))
		end
	end)
	questBtn.Activated:Connect(function()
		panel.hide()
		PanelController.open("Quests")
	end)

	local function refresh()
		local p = ClientState.profile
		if p == nil then
			return
		end
		streak.Text = string.format(S.awayStreak, p.daily.streak)
		local state = ClientState.dailyState()
		dailyLabel.Text = if state.canClaim then S.awayDailyReady else S.awayDailyDone
		dailyBtn.Visible = state.canClaim
		styleButton(dailyBtn, string.format(S.dailyClaim, state.nextStreak), theme.Yellow, false)
		local n = claimableQuests()
		questLabel.Text = string.format(S.awayQuests, n)
		questBtn.Visible = n > 0
		styleButton(questBtn, S.awayView, theme.Success, false)
	end
	return { panel = panel, refresh = refresh }
end

builders.Away = buildAway
builders.Upgrades = buildUpgrades
builders.Shop = buildShop
builders.Daily = buildDaily
builders.Quests = buildQuests
builders.Rebirth = buildRebirth
builders.Codes = buildCodes
builders.Settings = buildSettings
builders.Death = buildDeath
builders.Starter = buildStarter

-- Public API --------------------------------------------------------------------------------

function PanelController.open(name: string)
	local deathEntry = built.Death
	if name ~= "Death" and deathEntry and deathEntry.panel.isOpen() then
		return
	end
	local entry = ensure(name)
	if entry == nil then
		return
	end
	entry.refresh()
	entry.panel.show()
end

function PanelController.close()
	for name, entry in built do
		if name ~= "Death" and entry.panel.isOpen() then
			entry.panel.hide()
		end
	end
end

function PanelController.start()
	if started then
		return
	end
	started = true
	ClientState.start()

	ClientState.profileChanged:Connect(function()
		for _, entry in built do
			if entry.panel.isOpen() then
				entry.refresh()
			end
		end
	end)
	-- First profile of the session: welcome returning players who have something to claim.
	local awayChecked = false
	ClientState.profileChanged:Connect(function(profile: Types.Profile?)
		if awayChecked or profile == nil then
			return
		end
		awayChecked = true
		if profile.firstJoin == profile.lastJoin or not profile.tutorialDone then
			return
		end
		if not (ClientState.dailyState().canClaim or ClientState.questClaimable()) then
			return
		end
		task.delay(AWAY_DELAY, function()
			PanelController.open("Away")
		end)
	end)
	ClientState.death:Connect(showDeath)
	ClientState.arenaChanged:Connect(function()
		if ClientState.arena.alive then
			closeDeath()
		end
	end)
	ClientState.reward:Connect(function()
		sound("reward")
	end)
end

return PanelController
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX00000000000000000000000000000029">
						<Properties>
							<string name="Name">TurfRenderer</string>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Client-only turf and trail drawing with pooled anchored Parts.
-- Turf: the grid is split into CHUNK x CHUNK cell chunks; changed cells mark chunks dirty and a
-- per-frame budget of dirty chunks is re-meshed (GreedyMesh per owner present in the chunk).
-- Trails: one Part per straight run of trail cells (TrailRuns). Unused Parts are parked with
-- Parent = nil and never destroyed.
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local Grid = require(Shared.Grid)
local GreedyMesh = require(Shared.GreedyMesh)
local TrailRuns = require(Shared.TrailRuns)
local Types = require(Shared.Types)
local ClientState = require(script.Parent.Parent.ClientState)

local TurfRenderer = {}

-- pattern name -> image asset id; empty until pattern textures exist.
TurfRenderer.patternImages = {} :: { [string]: number }

local CHUNK = 16
local BUDGET = 6
local BUDGET_LOW = 3
local TURF_H = 0.2
local TRAIL_H = 0.6
local TRAIL_WIDTH = 0.6 -- fraction of a cell
local TRAIL_BRIGHTEN = 0.35
local FLASH_TIME = 0.25
local FLASH_LIGHTEN = 0.6
local FLASH_MAX = 40
local STOLEN_TINT = 0.7 -- stolen-claim flash starts this far from the owner colour toward Danger
local FLASH_WINDOW = 0.6 -- seconds a claim event and its cell delta may arrive apart
local BLINK_HZ = 4
local TEXTURE_TILE_CELLS = 2

local CS = Config.Arena.CellSize
local FLOOR = Config.Arena.FloorY
local WHITE = Color3.new(1, 1, 1)
local FALLBACK = Color3.fromHex(Config.Colors.GridLine)
local STOLEN_COLOR = Color3.fromHex(Config.Colors.Danger)

type Style = {
	a: Color3,
	b: Color3?,
	pattern: string,
	trail: Color3,
	image: number?,
}

local started = false
local folder: Folder? = nil
local grid: Grid.Grid? = nil
local size = Config.Arena.GridSize
local half = size * CS / 2
local cps = TrailRuns.chunksPerSide(size, CHUNK)
local lowDetail = false

local chunkParts: { { BasePart } } = {}
local chunkOwners: { { number } } = {}
local dirty: { boolean } = {}
local dirtyList: { number } = {}
local dirtyHead = 1
local gainOwner: { number } = {} -- chunk -> last owner that gained cells there
local gainTime: { number } = {}

local turfPool: { BasePart } = {}
local trailPool: { BasePart } = {}
local partTexture: { [BasePart]: Texture } = {}

local styles: { [number]: Style } = {}
local trailParts: { [number]: { BasePart } } = {}
local trailRuns: { [number]: TrailRuns.Runs } = {}
local danger: { [number]: boolean } = {}
local blinkOn = false

local claimAt: { [number]: number } = {}
local flashLeft: { [number]: number } = {}
local claimStolen: { [number]: boolean } = {} -- owner -> latest claim took cells from others
local flashStart: { [BasePart]: number } = {}
local flashFrom: { [BasePart]: Color3 } = {}
local flashTo: { [BasePart]: Color3 } = {}

-- Owner-presence scratch for one chunk pass.
local seen: { number } = table.create(256, 0)
local stamp = 0
local owners: { number } = table.create(256, 0)

local function newPart(): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Locked = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	return p
end

local function acquireTurf(): BasePart
	local n = #turfPool
	local p = turfPool[n]
	if p then
		turfPool[n] = nil
	else
		p = newPart()
		p.Name = "Turf"
	end
	p.Parent = folder
	return p
end

local function acquireTrail(): BasePart
	local n = #trailPool
	local p = trailPool[n]
	if p then
		trailPool[n] = nil
	else
		p = newPart()
		p.Name = "Trail"
	end
	p.Material = if lowDetail then Enum.Material.SmoothPlastic else Enum.Material.Neon
	p.Parent = folder
	return p
end

local function stopFlash(p: BasePart)
	if flashStart[p] then
		flashStart[p] = nil
		flashFrom[p] = nil
		flashTo[p] = nil
	end
end

local function releaseTurf(p: BasePart)
	stopFlash(p)
	p.Parent = nil
	table.insert(turfPool, p)
end

local function releaseTrail(p: BasePart)
	p.Parent = nil
	table.insert(trailPool, p)
end

local function hex(s: string?): Color3?
	if not s then
		return nil
	end
	local ok, c = pcall(Color3.fromHex, s)
	return if ok then c else nil
end

local function styleOf(owner: number): Style
	local s = styles[owner]
	if s then
		return s
	end
	local a, b, pattern = FALLBACK, nil :: Color3?, "solid"
	local trailBase = FALLBACK
	local info: Types.RunnerInfo? = ClientState.arena.runners[owner]
	if info then
		local item = Catalog.byId(info.skin)
		if item and item.type == "skin" and not item.default then
			a = hex(item.colorA) or FALLBACK
			b = hex(item.colorB)
			pattern = item.pattern
		else
			a = hex(Config.Colors.Players[info.colorIndex]) or FALLBACK
		end
		trailBase = a
		local trailItem = Catalog.byId(info.trail)
		if trailItem and trailItem.type == "trail" and not trailItem.default then
			trailBase = hex(trailItem.colorA) or a
		end
	end
	s = {
		a = a,
		b = b,
		pattern = pattern,
		trail = trailBase:Lerp(WHITE, TRAIL_BRIGHTEN),
		image = TurfRenderer.patternImages[pattern],
	}
	styles[owner] = s
	return s
end

-- Cheap pattern stand-in until textures exist: alternate colorA/colorB per chunk.
local function chunkColor(s: Style, cx: number, cy: number): Color3
	local b = s.b
	if b and s.pattern ~= "solid" and not s.image then
		local parity = if s.pattern == "stripes" then cx % 2 else (cx + cy) % 2
		return if parity == 0 then s.a else b
	end
	return s.a
end

local function applyTexture(p: BasePart, s: Style)
	local tex = partTexture[p]
	local image = s.image
	if image then
		if not tex then
			local t = Instance.new("Texture")
			t.Face = Enum.NormalId.Top
			t.StudsPerTileU = CS * TEXTURE_TILE_CELLS
			t.StudsPerTileV = CS * TEXTURE_TILE_CELLS
			t.Parent = p
			partTexture[p] = t
			tex = t
		end
		local t = tex :: Texture
		t.Texture = "rbxassetid://" .. image
		t.Color3 = s.b or WHITE
		t.Transparency = 0
	elseif tex then
		tex.Transparency = 1
	end
end

local function startFlash(p: BasePart, owner: number, color: Color3, now: number)
	local left = flashLeft[owner] or 0
	if lowDetail or left <= 0 then
		return
	end
	flashLeft[owner] = left - 1
	local from = if claimStolen[owner] then color:Lerp(STOLEN_COLOR, STOLEN_TINT) else color:Lerp(WHITE, FLASH_LIGHTEN)
	p.Color = from
	flashStart[p] = now
	flashFrom[p] = from
	flashTo[p] = color
end

local function markDirty(c: number)
	if not dirty[c] then
		dirty[c] = true
		table.insert(dirtyList, c)
	end
end

local function rebuildChunk(c: number, now: number)
	local g = grid :: Grid.Grid
	local cells = g.cells
	local cx, cy = (c - 1) % cps, (c - 1) // cps
	local x0, y0 = cx * CHUNK, cy * CHUNK
	local x1, y1 = math.min(x0 + CHUNK - 1, size - 1), math.min(y0 + CHUNK - 1, size - 1)

	stamp += 1
	local n = 0
	for y = y0, y1 do
		local row = y * size
		for x = x0, x1 do
			local o = buffer.readu8(cells, row + x)
			if o ~= 0 and seen[o] ~= stamp then
				seen[o] = stamp
				n += 1
				owners[n] = o
			end
		end
	end

	local flashOwner = 0
	local go = gainOwner[c]
	if go ~= 0 then
		local t = claimAt[go]
		if t and now - t < FLASH_WINDOW then
			flashOwner = go
			gainOwner[c] = 0
		elseif now - gainTime[c] > FLASH_WINDOW then
			gainOwner[c] = 0
		end
	end

	local parts, pOwner = chunkParts[c], chunkOwners[c]
	local used = 0
	for k = 1, n do
		local o = owners[k]
		local s = styleOf(o)
		local color = chunkColor(s, cx, cy)
		local rects = GreedyMesh.build(g, o, x0, y0, x1, y1)
		for _, r in rects do
			used += 1
			local p = parts[used]
			if not p then
				p = acquireTurf()
				parts[used] = p
			end
			pOwner[used] = o
			stopFlash(p)
			p.Size = Vector3.new(r.w * CS, TURF_H, r.h * CS)
			p.CFrame = CFrame.new((r.x + r.w * 0.5) * CS - half, FLOOR + 0.1 - TURF_H * 0.5, (r.y + r.h * 0.5) * CS - half)
			p.Color = color
			applyTexture(p, s)
			if o == flashOwner then
				startFlash(p, o, color, now)
			end
		end
	end
	for k = #parts, used + 1, -1 do
		releaseTurf(parts[k])
		parts[k] = nil
		pOwner[k] = nil
	end
end

local function trailColor(id: number): Color3
	if danger[id] and blinkOn then
		return WHITE
	end
	return styleOf(id).trail
end

local function placeRun(p: BasePart, r: TrailRuns.Runs)
	local x0, x1 = math.min(r.sx, r.ex), math.max(r.sx, r.ex)
	local y0, y1 = math.min(r.sy, r.ey), math.max(r.sy, r.ey)
	local thin = CS * TRAIL_WIDTH
	p.Size = Vector3.new((x1 - x0) * CS + thin, TRAIL_H, (y1 - y0) * CS + thin)
	p.CFrame = CFrame.new((x0 + x1 + 1) * 0.5 * CS - half, FLOOR + TRAIL_H * 0.5, (y0 + y1 + 1) * 0.5 * CS - half)
end

local function clearTrail(id: number)
	local list = trailParts[id]
	if list then
		for k = #list, 1, -1 do
			releaseTrail(list[k])
			list[k] = nil
		end
	end
	local r = trailRuns[id]
	if r then
		TrailRuns.reset(r)
	end
end

local function recolorTrail(id: number)
	local list = trailParts[id]
	if not list then
		return
	end
	local c = trailColor(id)
	for _, p in list do
		p.Color = c
	end
end

local function resetAll()
	for c = 1, #chunkParts do
		local parts = chunkParts[c]
		for k = #parts, 1, -1 do
			releaseTurf(parts[k])
			parts[k] = nil
		end
	end
	for id in trailParts do
		clearTrail(id)
	end
	table.clear(chunkParts)
	table.clear(chunkOwners)
	table.clear(dirty)
	table.clear(dirtyList)
	table.clear(gainOwner)
	table.clear(gainTime)
	table.clear(styles)
	table.clear(claimAt)
	table.clear(flashLeft)
	table.clear(claimStolen)
	dirtyHead = 1
	half = size * CS / 2
	cps = TrailRuns.chunksPerSide(size, CHUNK)
	for c = 1, cps * cps do
		chunkParts[c] = {}
		chunkOwners[c] = {}
		dirty[c] = false
		gainOwner[c] = 0
		gainTime[c] = 0
	end
end

local function step()
	local now = os.clock()
	if grid then
		local budget = if lowDetail then BUDGET_LOW else BUDGET
		while budget > 0 and dirtyHead <= #dirtyList do
			local c = dirtyList[dirtyHead]
			dirtyHead += 1
			if dirty[c] then
				dirty[c] = false
				rebuildChunk(c, now)
				budget -= 1
			end
		end
		if dirtyHead > #dirtyList then
			table.clear(dirtyList)
			dirtyHead = 1
		end
	end

	if next(flashStart) ~= nil then
		for p, t0 in flashStart do
			local a = (now - t0) / FLASH_TIME
			if a >= 1 then
				p.Color = flashTo[p]
				flashStart[p] = nil
				flashFrom[p] = nil
				flashTo[p] = nil
			else
				p.Color = flashFrom[p]:Lerp(flashTo[p], a)
			end
		end
	end

	if next(danger) ~= nil then
		local on = math.floor(now * BLINK_HZ * 2) % 2 == 0
		if on ~= blinkOn then
			blinkOn = on
			for id in danger do
				recolorTrail(id)
			end
		end
	end
end

function TurfRenderer.start()
	if started then
		return
	end
	started = true
	local existing = workspace:FindFirstChild("Turf")
	if existing and existing:IsA("Folder") then
		folder = existing
	else
		local f = Instance.new("Folder")
		f.Name = "Turf"
		f.Parent = workspace
		folder = f
	end
	resetAll()

	local function readSettings()
		local profile = ClientState.profile
		if profile then
			TurfRenderer.setLowDetail(profile.settings.lowDetail)
		end
	end
	ClientState.profileChanged:Connect(readSettings)
	readSettings()

	RunService.Heartbeat:Connect(step)
end

-- Full (re)build from a freshly decoded grid. Trails are dropped; the server follows a snapshot
-- with a delta carrying every trail in full.
function TurfRenderer.applySnapshot(g: Grid.Grid)
	grid = g
	size = g.size
	resetAll()
	for c = 1, cps * cps do
		markDirty(c)
	end
end

function TurfRenderer.cellsChanged(indices: { number })
	local g = grid
	if not g then
		return
	end
	local now = os.clock()
	local cells = g.cells
	for _, i in indices do
		local c = (i // size // CHUNK) * cps + (i % size) // CHUNK + 1
		markDirty(c)
		local o = buffer.readu8(cells, i)
		if o ~= 0 then
			gainOwner[c] = o
			gainTime[c] = now
		end
	end
end

-- Claim wave trigger (GDD G6). Chunks whose delta already arrived and were rebuilt flash now;
-- the rest flash when rebuilt within FLASH_WINDOW.
function TurfRenderer.claimFlash(owner: number, stolen: boolean?)
	if lowDetail or owner == 0 then
		return
	end
	claimStolen[owner] = stolen == true
	local now = os.clock()
	local estimate = 0
	for c = 1, cps * cps do
		if gainOwner[c] == owner and now - gainTime[c] < FLASH_WINDOW then
			local pOwner = chunkOwners[c]
			local found = 0
			for k = 1, #pOwner do
				if pOwner[k] == owner then
					found += 1
				end
			end
			estimate += math.max(found, 1)
		end
	end
	if estimate > FLASH_MAX then
		flashLeft[owner] = 0
		claimAt[owner] = nil
		return
	end
	claimAt[owner] = now
	flashLeft[owner] = FLASH_MAX
	for c = 1, cps * cps do
		if gainOwner[c] == owner and not dirty[c] and now - gainTime[c] < FLASH_WINDOW then
			gainOwner[c] = 0
			local parts, pOwner = chunkParts[c], chunkOwners[c]
			for k = 1, #parts do
				if pOwner[k] == owner then
					local p = parts[k]
					startFlash(p, owner, flashTo[p] or p.Color, now)
				end
			end
		end
	end
end

function TurfRenderer.trailDelta(delta: Types.TrailDelta)
	local id = delta.id
	if delta.clear then
		clearTrail(id)
	end
	local append = delta.append
	if #append == 0 then
		return
	end
	local r = trailRuns[id]
	if not r then
		r = TrailRuns.new()
		trailRuns[id] = r
	end
	local list = trailParts[id]
	if not list then
		list = {}
		trailParts[id] = list
	end
	local runs = r :: TrailRuns.Runs
	local parts = list :: { BasePart }
	local color = trailColor(id)
	for _, i in append do
		local res = TrailRuns.push(runs, i % size, i // size)
		if res == TrailRuns.NEW then
			local p = acquireTrail()
			p.Color = color
			table.insert(parts, p)
			placeRun(p, runs)
		elseif res == TrailRuns.EXTEND then
			placeRun(parts[#parts], runs)
		end
	end
end

-- Despawned runner: drop its trail state entirely.
function TurfRenderer.removeRunner(id: number)
	clearTrail(id)
	trailParts[id] = nil
	trailRuns[id] = nil
	danger[id] = nil
end

-- Base turf colour of a runner (same lookup the renderer uses); neutral grey for unknown ids.
function TurfRenderer.colorOf(runnerId: number): Color3
	if runnerId == 0 then
		return FALLBACK
	end
	return styleOf(runnerId).a
end

function TurfRenderer.runnerChanged(id: number)
	styles[id] = nil
	local g = grid
	if g then
		local x0, y0, x1, y1 = g:bounds(id)
		if x0 and y0 and x1 and y1 then
			TrailRuns.markBox(x0, y0, x1, y1, CHUNK, cps, dirty, dirtyList)
		end
	end
	recolorTrail(id)
end

function TurfRenderer.setTrailDanger(id: number, on: boolean)
	if on then
		danger[id] = true
	elseif danger[id] then
		danger[id] = nil
		recolorTrail(id)
	end
end

function TurfRenderer.setLowDetail(on: boolean)
	if on == lowDetail then
		return
	end
	lowDetail = on
	local material = if on then Enum.Material.SmoothPlastic else Enum.Material.Neon
	for _, list in trailParts do
		for _, p in list do
			p.Material = material
		end
	end
	if on then
		for p in flashStart do
			p.Color = flashTo[p]
		end
		table.clear(flashStart)
		table.clear(flashFrom)
		table.clear(flashTo)
	end
end

return TurfRenderer
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX0000000000000000000000000000002A">
						<Properties>
							<string name="Name">TutorialController</string>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Wordless first-run tutorial: loop guide, cut hint, then the first upgrade pointer.
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local ClientState = require(script.Parent.Parent.ClientState)
local UiKit = require(script.Parent.Parent.ui.UiKit)
local ArenaClient = require(script.Parent.ArenaClient)
local HudController = require(script.Parent.HudController)
local PanelController = require(script.Parent.PanelController)

local TweenService = game:GetService("TweenService")

local TutorialController = {}

local DOT_COUNT = 12
local DOT_STEP = 0.15
local DOT_SIZE = 1.2
local DOT_SIZE_ACTIVE = 2
local REPLACE_EVERY = 4
local CUT_TIMEOUT = 60
local CUT_POLL = 0.25
local UPGRADE_TIMEOUT = 45
local POLL = 0.2
local HAND_GAP = 6 -- px between the rail button and the hand
local RING_THICKNESS = 6
-- Three legs in cells: +X 5, +Z 4, -X 5; four dots per leg.
local LEGS = { Vector2.new(5, 0), Vector2.new(0, 4), Vector2.new(-5, 0) }

local function getRoot(): BasePart?
	local character = Players.LocalPlayer.Character
	if character == nil then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function guidePath(origin: Vector3): { Vector3 }
	local cellSize = Config.Arena.CellSize
	local points: { Vector3 } = {}
	local cursor = Vector3.new(origin.X, 1, origin.Z)
	for _, leg in LEGS do
		local step = Vector3.new(leg.X * cellSize, 0, leg.Y * cellSize)
		for j = 0, 3 do
			table.insert(points, cursor + step * (j / 4))
		end
		cursor += step
	end
	return points
end

local function runGuide()
	local folder = Instance.new("Folder")
	folder.Name = "TutorialGuide"
	local dots: { BasePart } = {}
	for _ = 1, DOT_COUNT do
		local dot = Instance.new("Part")
		dot.Shape = Enum.PartType.Ball
		dot.Size = Vector3.new(DOT_SIZE, DOT_SIZE, DOT_SIZE)
		dot.Material = Enum.Material.Neon
		dot.Color = Color3.new(1, 1, 1)
		dot.Anchored = true
		dot.CanCollide = false
		dot.CanQuery = false
		dot.CanTouch = false
		dot.CastShadow = false
		dot.Parent = folder
		table.insert(dots, dot)
	end
	-- Parented on first placement so the dots do not sit stacked at the origin before a character exists.

	local claimed = false
	local claimConn = ClientState.arenaEvent:Connect(function(event: any)
		if event.kind == "claim" and event.id == ClientState.arena.myId then
			claimed = true
		end
	end)

	local current = 0
	local lastPlaced = -math.huge
	while not claimed do
		local root = getRoot()
		local myId = ClientState.arena.myId
		local trail = if myId then ArenaClient.trails[myId] else nil
		local hasTrail = trail ~= nil and #trail > 0
		if root ~= nil and not hasTrail and os.clock() - lastPlaced >= REPLACE_EVERY then
			lastPlaced = os.clock()
			local points = guidePath(root.Position)
			for i, dot in dots do
				dot.Position = points[i]
			end
			if folder.Parent == nil then
				folder.Parent = workspace
			end
		end

		local prev = current
		current = current % DOT_COUNT + 1
		if prev > 0 then
			dots[prev].Size = Vector3.new(DOT_SIZE, DOT_SIZE, DOT_SIZE)
		end
		dots[current].Size = Vector3.new(DOT_SIZE_ACTIVE, DOT_SIZE_ACTIVE, DOT_SIZE_ACTIVE)
		task.wait(DOT_STEP)
	end

	claimConn:Disconnect()
	folder:Destroy()
end

local function nearestEnemyCell(grid: any, origin: Vector3, myId: number?): Vector3?
	local best: Vector3? = nil
	local bestDist = math.huge
	for id, trail in ArenaClient.trails do
		if id ~= myId and #trail > 0 then
			local x, y = grid:fromIndex(trail[#trail])
			local wx, wz = grid:cellToWorld(x, y)
			local d = Vector3.new(wx - origin.X, 0, wz - origin.Z).Magnitude
			if d < bestDist then
				bestDist = d
				best = Vector3.new(wx, 1, wz)
			end
		end
	end
	return best
end

local function runCutHint()
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(1, 1, 1)
	part.Position = Vector3.new(0, 1, 0)

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(60, 60)
	billboard.AlwaysOnTop = true
	billboard.StudsOffset = Vector3.new(0, 4, 0)
	billboard.Enabled = false
	billboard.Parent = part
	UiKit.label({
		Text = "✂",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
		Parent = billboard,
	})
	part.Parent = workspace

	local cut = false
	local cutConn = ClientState.arenaEvent:Connect(function(event: any)
		if event.kind == "cut" and event.killer == ClientState.arena.myId then
			cut = true
		end
	end)

	local deadline = os.clock() + CUT_TIMEOUT
	while not cut and os.clock() < deadline do
		local root = getRoot()
		local grid = ArenaClient.getGrid()
		if root ~= nil and grid ~= nil then
			local target = nearestEnemyCell(grid, root.Position, ClientState.arena.myId)
			if target then
				part.Position = target
				billboard.Enabled = true
			else
				billboard.Enabled = false
			end
		end
		task.wait(CUT_POLL)
	end

	cutConn:Disconnect()
	part:Destroy()
end

local function canBuyCoinBoost(): boolean
	local profile = ClientState.profile
	if profile == nil then
		return false
	end
	return profile.coins >= Config.Upgrades.coinBoost.Base or profile.upgrades.coinBoost > 0
end

local function coinBoostLevel(): number
	local profile = ClientState.profile
	return if profile then profile.upgrades.coinBoost else 0
end

local function runUpgradeHint()
	while not canBuyCoinBoost() do
		task.wait(POLL)
	end

	local gui = UiKit.screenGui("Tutorial", 50)
	-- The hand is a button: tapping it opens the Upgrades panel.
	local arrow = Instance.new("TextButton")
	arrow.Name = "Hand"
	arrow.Text = "👆"
	arrow.Font = Enum.Font.GothamBold
	arrow.TextScaled = true
	arrow.BackgroundTransparency = 1
	arrow.AutoButtonColor = false
	arrow.Size = UDim2.fromScale(0.06, 0.1)
	arrow.Position = UDim2.fromScale(0.09, 0.3) -- fallback until the rail button exists
	arrow.Parent = gui
	UiKit.pulse(arrow)
	arrow.Activated:Connect(function()
		PanelController.open("Upgrades")
	end)

	-- Pulse the real rail button with a breathing outline (the button already owns a UIScale for hover).
	local ring: UIStroke? = nil
	local ringTween: Tween? = nil

	local deadline = os.clock() + UPGRADE_TIMEOUT
	while coinBoostLevel() <= 0 and os.clock() < deadline do
		local button = HudController.getRailButton("Upgrades")
		if button then
			if ring == nil then
				local stroke = UiKit.stroke(button, Color3.new(1, 1, 1), 2)
				stroke.Name = "TutorialRing"
				ring = stroke
				local tween = TweenService:Create(
					stroke,
					TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
					{ Thickness = RING_THICKNESS }
				)
				tween:Play()
				ringTween = tween
			end
			local pos, size = button.AbsolutePosition, button.AbsoluteSize
			arrow.Position = UDim2.fromOffset(pos.X + size.X + HAND_GAP, pos.Y + size.Y * 0.2)
			arrow.Size = UDim2.fromOffset(size.Y, size.Y)
		end
		task.wait(POLL)
	end

	if ringTween then
		ringTween:Cancel()
	end
	if ring then
		ring:Destroy()
	end
	UiKit.stopPulse(arrow)
	gui:Destroy()
end

function TutorialController.start()
	task.spawn(function()
		local profile = ClientState.profile
		while profile == nil do
			task.wait(POLL)
			profile = ClientState.profile
		end
		if profile.tutorialDone then
			return
		end

		runGuide()
		runCutHint()
		runUpgradeHint()

		task.spawn(function()
			ClientState.request("TutorialDone")
		end)
	end)
end

return TutorialController
]]></ProtectedString>
						</Properties>
					</Item>
				</Item>
				<Item class="Folder" referent="RBX0000000000000000000000000000002B">
					<Properties>
						<string name="Name">ui</string>
					</Properties>
					<Item class="ModuleScript" referent="RBX0000000000000000000000000000002C">
						<Properties>
							<string name="Name">UiKit</string>
							<ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local UiKit = {}

UiKit.onClickSound = nil :: (() -> ())?
UiKit.onHoverSound = nil :: (() -> ())?

function UiKit.color(hex: string): Color3
	return Color3.fromHex(hex)
end

local theme: { [string]: any } = {}
for k, v in Config.Colors do
	if type(v) == "string" then
		theme[k] = Color3.fromHex(v)
	end
end
UiKit.theme = theme

local FONT = Enum.Font.GothamBold

function UiKit.screenGui(name: string, displayOrder: number?): ScreenGui
	local pg = Players.LocalPlayer:WaitForChild("PlayerGui")
	local existing = pg:FindFirstChild(name)
	if existing and existing:IsA("ScreenGui") then
		return existing
	end
	local g = Instance.new("ScreenGui")
	g.Name = name
	g.ResetOnSpawn = false
	g.IgnoreGuiInset = true
	g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	g.DisplayOrder = displayOrder or 0
	g.Parent = pg
	return g
end

local function applyProps(inst: Instance, props: { [string]: any }?)
	if props then
		for k, v in props do
			if k ~= "parent" then
				(inst :: any)[k] = v
			end
		end
		if props.parent then
			inst.Parent = props.parent
		end
	end
end

function UiKit.frame(props: { [string]: any }?): Frame
	local f = Instance.new("Frame")
	f.BackgroundColor3 = theme.UiDark
	f.BorderSizePixel = 0
	applyProps(f, props)
	return f
end

function UiKit.label(props: { [string]: any }?): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = FONT
	l.TextColor3 = theme.UiLight
	l.TextScaled = true
	l.BorderSizePixel = 0
	applyProps(l, props)
	local c = Instance.new("UITextSizeConstraint")
	c.MaxTextSize = 48
	c.MinTextSize = 8
	c.Parent = l
	return l
end

function UiKit.corner(inst: Instance, radius: number?): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 12)
	c.Parent = inst
	return c
end

function UiKit.stroke(inst: Instance, color: Color3?, thickness: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color or theme.UiLight
	s.Thickness = thickness or 2
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = inst
	return s
end

function UiKit.padding(inst: Instance, scale: number?): UIPadding
	local p = Instance.new("UIPadding")
	local u = UDim.new(scale or 0.04, 0)
	p.PaddingTop, p.PaddingBottom, p.PaddingLeft, p.PaddingRight = u, u, u, u
	p.Parent = inst
	return p
end

function UiKit.list(inst: Instance, props: { [string]: any }?): UIListLayout
	local l = Instance.new("UIListLayout")
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = UDim.new(0.02, 0)
	applyProps(l, props)
	l.Parent = inst
	return l
end

function UiKit.grid(inst: Instance, props: { [string]: any }?): UIGridLayout
	local g = Instance.new("UIGridLayout")
	g.SortOrder = Enum.SortOrder.LayoutOrder
	applyProps(g, props)
	g.Parent = inst
	return g
end

function UiKit.aspect(inst: Instance, ratio: number): UIAspectRatioConstraint
	local a = Instance.new("UIAspectRatioConstraint")
	a.AspectRatio = ratio
	a.Parent = inst
	return a
end

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

function UiKit.button(props: {
	text: string?,
	color: Color3?,
	size: UDim2?,
	position: UDim2?,
	parent: Instance?,
	onClick: (() -> ())?,
}): TextButton
	local b = Instance.new("TextButton")
	b.Name = "Button"
	b.AutoButtonColor = false
	b.BackgroundColor3 = props.color or theme.Yellow
	b.BorderSizePixel = 0
	b.Font = FONT
	b.Text = props.text or ""
	b.TextColor3 = theme.UiDark
	b.TextScaled = true
	b.Size = props.size or UDim2.fromScale(0.3, 0.1)
	b.Position = props.position or UDim2.new()
	UiKit.corner(b, 12)
	local c = Instance.new("UITextSizeConstraint")
	c.MaxTextSize = 36
	c.MinTextSize = 8
	c.Parent = b
	local scale = Instance.new("UIScale")
	scale.Name = "ButtonScale"
	scale.Parent = b
	b.Parent = props.parent

	local hover, down = false, false
	local function refresh()
		local target = if down then 0.95 elseif hover then 1.05 else 1
		tween(scale, 0.1, { Scale = target })
	end
	b.MouseEnter:Connect(function()
		hover = true
		local hoverSnd = UiKit.onHoverSound
		if hoverSnd then
			hoverSnd()
		end
		refresh()
	end)
	b.MouseLeave:Connect(function()
		hover = false
		down = false
		refresh()
	end)
	b.MouseButton1Down:Connect(function()
		down = true
		refresh()
	end)
	b.MouseButton1Up:Connect(function()
		down = false
		refresh()
	end)
	b.Activated:Connect(function()
		local snd = UiKit.onClickSound
		if snd then
			snd()
		end
		if props.onClick then
			props.onClick()
		end
	end)
	return b
end

export type Panel = {
	root: Frame,
	body: Frame,
	closeButton: TextButton,
	dimmer: Frame,
	show: () -> (),
	hide: () -> (),
	isOpen: () -> boolean,
}

local panelGui: ScreenGui? = nil
local currentPanel: Panel? = nil

function UiKit.panel(props: { title: string?, size: UDim2?, parent: Instance? }): Panel
	if not panelGui then
		panelGui = UiKit.screenGui("Panels", 50)
	end
	local dimmer = UiKit.frame({
		Name = "Dimmer",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Active = true,
		Visible = false,
		parent = props.parent or panelGui,
	})
	local root = UiKit.frame({
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = props.size or UDim2.fromScale(0.6, 0.7),
		parent = dimmer,
	})
	UiKit.corner(root, 18)
	UiKit.stroke(root, theme.UiLight, 2)
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(720, 560)
	limit.Parent = root
	local scale = Instance.new("UIScale")
	scale.Parent = root

	local bar = UiKit.frame({
		Name = "TitleBar",
		Size = UDim2.fromScale(1, 0.12),
		BackgroundColor3 = theme.Pink,
		parent = root,
	})
	UiKit.corner(bar, 18)
	UiKit.label({
		Name = "Title",
		Text = props.title or "",
		Size = UDim2.fromScale(0.7, 0.7),
		Position = UDim2.fromScale(0.05, 0.15),
		TextXAlignment = Enum.TextXAlignment.Left,
		parent = bar,
	})
	local closeBtn = UiKit.button({
		text = "X",
		color = theme.Danger,
		size = UDim2.fromScale(0.09, 0.7),
		position = UDim2.fromScale(0.89, 0.15),
		parent = bar,
	})
	closeBtn.TextColor3 = theme.UiLight
	UiKit.aspect(closeBtn, 1)

	local body = UiKit.frame({
		Name = "Body",
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0, 0.12),
		Size = UDim2.fromScale(1, 0.88),
		parent = root,
	})

	local open = false
	local panel: Panel
	local function hide()
		if not open then
			return
		end
		open = false
		dimmer.Visible = false
		if currentPanel == panel then
			currentPanel = nil
		end
	end
	local function show()
		if currentPanel and currentPanel ~= panel then
			currentPanel.hide()
		end
		currentPanel = panel
		open = true
		scale.Scale = 0.8
		dimmer.Visible = true
		tween(scale, 0.18, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end
	panel = {
		root = root,
		body = body,
		closeButton = closeBtn,
		dimmer = dimmer,
		show = show,
		hide = hide,
		isOpen = function()
			return open
		end,
	}
	closeBtn.Activated:Connect(hide)
	return panel
end

function UiKit.showPanel(panel: Panel)
	panel.show()
end

function UiKit.formatNumber(n: number): string
	local sign = if n < 0 then "-" else ""
	local a = math.abs(n)
	local function short(v: number, suffix: string): string
		local s = string.format("%.1f", v)
		s = string.gsub(s, "%.0$", "")
		return sign .. s .. suffix
	end
	if a >= 1e9 then
		return short(a / 1e9, "B")
	elseif a >= 1e6 then
		return short(a / 1e6, "M")
	elseif a >= 1e4 then
		return short(a / 1e3, "K")
	end
	local s = tostring(math.floor(a + 0.5))
	while true do
		local r, count = string.gsub(s, "^(%d+)(%d%d%d)", "%1,%2")
		s = r
		if count == 0 then
			break
		end
	end
	return sign .. s
end

local rollTokens: { [Instance]: number } = setmetatable({}, { __mode = "k" }) :: any

function UiKit.rollNumber(label: TextLabel, fromValue: number, toValue: number, seconds: number, formatFn: ((number) -> string)?)
	local fmt = formatFn or UiKit.formatNumber
	local token = (rollTokens[label] or 0) + 1
	rollTokens[label] = token
	if seconds <= 0 then
		label.Text = fmt(toValue)
		return
	end
	task.spawn(function()
		local t0 = os.clock()
		while rollTokens[label] == token and label.Parent do
			local a = math.min((os.clock() - t0) / seconds, 1)
			local eased = 1 - (1 - a) ^ 3
			label.Text = fmt(math.floor(fromValue + (toValue - fromValue) * eased + 0.5))
			if a >= 1 then
				break
			end
			RunService.RenderStepped:Wait()
		end
		if rollTokens[label] == token then
			label.Text = fmt(toValue)
		end
	end)
end

local pulses: { [Instance]: Tween } = {}

function UiKit.pulse(inst: GuiObject)
	if pulses[inst] then
		return
	end
	local found = inst:FindFirstChild("PulseScale") :: UIScale?
	local scale: UIScale
	if found then
		scale = found
	else
		scale = Instance.new("UIScale")
		scale.Name = "PulseScale"
		scale.Parent = inst
	end
	local t = TweenService:Create(scale, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.08 })
	pulses[inst] = t
	t:Play()
end

function UiKit.stopPulse(inst: GuiObject)
	local t = pulses[inst]
	if t then
		t:Cancel()
		pulses[inst] = nil
	end
	local scale = inst:FindFirstChild("PulseScale") :: UIScale?
	if scale then
		scale.Scale = 1
	end
end

local toastHolder: Frame? = nil

function UiKit.toast(text: string, color: Color3?)
	if not toastHolder or not toastHolder.Parent then
		local gui = UiKit.screenGui("Toasts", 100)
		local holder = UiKit.frame({
			Name = "ToastHolder",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0.12),
			Size = UDim2.fromScale(0.5, 0.3),
			parent = gui,
		})
		UiKit.list(holder, { HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0.02, 0) })
		local limit = Instance.new("UISizeConstraint")
		limit.MaxSize = Vector2.new(480, 10000)
		limit.Parent = holder
		toastHolder = holder
	end
	local t = UiKit.frame({
		Name = "Toast",
		Size = UDim2.fromScale(1, 0.14),
		BackgroundColor3 = color or theme.UiDark,
		parent = toastHolder,
	})
	UiKit.corner(t, 12)
	local l = UiKit.label({
		Text = text,
		Size = UDim2.fromScale(0.92, 0.7),
		Position = UDim2.fromScale(0.04, 0.15),
		parent = t,
	})
	task.delay(2.5, function()
		tween(t, 0.3, { BackgroundTransparency = 1 })
		tween(l, 0.3, { TextTransparency = 1 })
		task.wait(0.3)
		t:Destroy()
	end)
end

return UiKit
